# Base URL of the API. Stated explicitly rather than guessed, because frontend and
# backend do not necessarily share an origin.
VITE_API_URL=http://localhost:8000/api/v1

# Optional: point the dev server at a remote backend instead of running one locally.
# The server then fetches the data, so for the browser everything comes from one
# origin and CORS never comes into play.
#
#   VITE_API_URL=/api/v1
#   VITE_API_PROXY=https://address-of-the-backend
VITE_API_PROXY=
