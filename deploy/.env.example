# Settings of Plagevo on the server (deploy/docker-compose.yml, spec 79).
# Copy this file to deploy/.env on the server and fill it in. Never commit .env:
# it holds the database password, the SMTP password and the tunnel token.
# The step-by-step guide is docs/betrieb.md.
#
# Every setting of the API and the web version may also be written in .NET's
# notation, as in appsettings: Duofy__Mail__Host instead of DUOFY_MAIL_HOST,
# Duofy__PublicUrl instead of DUOFY_PUBLIC_URL, Duofy__TrustedProxies instead of
# TRUSTED_PROXIES and so on (the sender name also as Duofy__Mail__From__Name).
# If both are set, the .NET notation wins; if neither is set, the default of
# docker-compose.yml applies. Secrets stay empty in this example.

# --- Version ------------------------------------------------------------------
# Written into the image labels org.opencontainers.image.version and .created.
PLAGEVO_VERSION=0.3.0
PLAGEVO_BUILD_DATE=2026-10-26T00:00:00Z

# --- Database -----------------------------------------------------------------
# Connection of the API and the backup to PostgreSQL, in Npgsql's notation; no
# value may contain a semicolon. Plagevo uses a PostgreSQL server at home, reached
# over Tailscale: Host is its tailnet address (100.x.y.z). The traffic runs inside
# Tailscale's WireGuard tunnel; add ;SSL Mode=Require if that server offers TLS.
# Required: without it docker compose stops with a message.
ConnectionStrings__Duofy=Host=100.64.0.10;Port=5432;Database=plagevo;Username=plagevo;Password=

# Only with the own database of own-db.yml (docker compose -f docker-compose.yml
# -f own-db.yml ...). Then point the connection above at it:
# Host=172.30.11.10;Port=5432;Database=duofy;Username=duofy;Password=<POSTGRES_PASSWORD>
# Run both files every time, for example with this line (remove the leading #):
# COMPOSE_FILE=docker-compose.yml:own-db.yml
POSTGRES_DB=duofy
POSTGRES_USER=duofy
# A long random value, for example from: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Duofy API ----------------------------------------------------------------
# Hosted version: mail on, new accounts confirm their address. With true the API
# refuses to start without https in DUOFY_PUBLIC_URL or with DUOFY_MAIL_USE_TLS=false.
DUOFY_HOSTED=true
# Name and logo in the header, on the sign-in page and in the browser tab. Empty: Plagevo (with its logo) when
# DUOFY_HOSTED=true, otherwise Duofy. "Plagevo" or "Duofy" force that brand; any other name is shown without a logo.
DUOFY_APP_NAME=
# The address people open; links in mails and invitations point there.
DUOFY_PUBLIC_URL=https://portal.plagevo.de
# open, invite or closed. The first release runs with invite.
DUOFY_REGISTRATION_MODE=invite
# Makes the first administrator; at least 16 characters, for example from:
# openssl rand -base64 24   Remove it once the administrator exists.
DUOFY_SETUP_CODE=
# Legal texts as plain text files in deploy/legal/ (mounted read-only as /legal).
DUOFY_IMPRINT_FILE=/legal/impressum.txt
DUOFY_PRIVACY_FILE=/legal/datenschutz.txt
DUOFY_TERMS_FILE=/legal/nutzungsbedingungen.txt

# --- Mail through noreply@example.org ---------------------------------------------
# SMTP access of the mailbox noreply@example.org, here netcup's: port 465 encrypts
# from the start (SSL/TLS), 587 uses STARTTLS. Host and port as the provider names them.
DUOFY_MAIL_HOST=mx2f38.netcup.net
DUOFY_MAIL_PORT=465
DUOFY_MAIL_USER=noreply@example.org
# The password of the mailbox; only here, nowhere else.
DUOFY_MAIL_PASSWORD=
DUOFY_MAIL_FROM=noreply@example.org
# Name shown next to the sender address in mail programs.
DUOFY_MAIL_FROM_NAME=Plagevo
# Must stay true on the hosted version.
DUOFY_MAIL_USE_TLS=true

# --- Rate limit ---------------------------------------------------------------
# Sign-in requests per minute and client on /api/v1/auth/* (the app through
# api.plagevo.de). The web container is exempt; Cloudflare's rate limit rule
# limits web users per client in front of it.
RATE_LIMIT_AUTH_PERMIT_LIMIT=10

# --- Cloudflare -----------------------------------------------------------------
# Name of Plagevo's own Docker network (subnet 172.30.10.0/24). This compose file
# creates it; the cloudflared container of the separate infrastructure compose
# joins it as an external network with the fixed address 172.30.10.2.
PLAGEVO_NETWORK=plagevo
# Only with own-db.yml: the internal network of database, API and backup (subnet
# 172.30.11.0/24, no way out); the tunnel never joins it.
PLAGEVO_BACKEND_NETWORK=plagevo-backend
# Only from this address may a request name the client address (CF-Connecting-IP):
# the tunnel's fixed address in the network plagevo.
TRUSTED_PROXIES=172.30.10.2/32
# Only for a fresh server whose tunnel this setup starts itself (profile own-tunnel):
# token of the tunnel (Zero Trust, Networks, Tunnels, the tunnel, Install connector).
TUNNEL_TOKEN=
# Token of Web Analytics from the MANUAL setup (switch off Cloudflare's automatic
# setup, or the script loads without consent). With a token the page asks for consent
# and loads Cloudflare's script only after agreement. Empty means no question, no
# analytics, nothing is loaded. See docs/betrieb.md, step 2.5.
CLOUDFLARE_ANALYTICS_TOKEN=
# Website ID of the Crisp chat (Crisp dashboard, Settings, Website Settings, Setup instructions).
# With an ID the page asks for consent and loads the chat from Crisp only after agreement.
# Empty means no chat, no question, nothing is loaded. The chat image (logo) is set in
# the Crisp account, not here. See docs/betrieb.md, step 2.6.
CRISP_WEBSITE_ID=

# --- Backup -------------------------------------------------------------------
# Daily pg_dump into deploy/backups at this local time, kept this many days.
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14
# Owner of deploy/backups on the server (id -u and id -g); the backup does not run as root.
BACKUP_UID=1000
BACKUP_GID=1000
