# Settings of Plagevo on the server (deploy/docker-compose.yml, spec 79).
# Copy this file to deploy/.env on the server and fill it in. Never commit .env:
# it holds the database password, the SMTP password and the tunnel token.
# The step-by-step guide is docs/betrieb.md.

# --- Version ------------------------------------------------------------------
# Written into the image labels org.opencontainers.image.version and .created.
PLAGEVO_VERSION=0.3.0
PLAGEVO_BUILD_DATE=2026-10-26T00:00:00Z

# --- Database -----------------------------------------------------------------
POSTGRES_DB=duofy
POSTGRES_USER=duofy
# A long random value, for example from: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Duofy API ----------------------------------------------------------------
# Hosted version: mail on, new accounts confirm their address. With true the API
# refuses to start without https in DUOFY_PUBLIC_URL or with DUOFY_MAIL_USE_TLS=false.
DUOFY_HOSTED=true
# The address people open; links in mails and invitations point there.
DUOFY_PUBLIC_URL=https://app.plagevo.de
# open, invite or closed. The first release runs with invite.
DUOFY_REGISTRATION_MODE=invite
# Makes the first administrator; at least 16 characters, for example from:
# openssl rand -base64 24   Remove it once the administrator exists.
DUOFY_SETUP_CODE=
# Legal texts as plain text files in deploy/legal/ (mounted read-only as /legal).
DUOFY_IMPRINT_FILE=/legal/impressum.txt
DUOFY_PRIVACY_FILE=/legal/datenschutz.txt
DUOFY_TERMS_FILE=/legal/nutzungsbedingungen.txt

# --- Mail through noreply@example.org ---------------------------------------------
# SMTP access of the mailbox noreply@example.org; host and port as the provider names them.
DUOFY_MAIL_HOST=
DUOFY_MAIL_PORT=587
DUOFY_MAIL_USER=noreply@example.org
# The password of the mailbox; only here, nowhere else.
DUOFY_MAIL_PASSWORD=
DUOFY_MAIL_FROM=noreply@example.org
# Must stay true on the hosted version.
DUOFY_MAIL_USE_TLS=true

# --- Rate limit ---------------------------------------------------------------
# Sign-in requests per minute and client on /api/v1/auth/* (the app through
# api.plagevo.de). The web container is exempt; Cloudflare's rate limit rule
# limits web users per client in front of it.
RATE_LIMIT_AUTH_PERMIT_LIMIT=10

# --- Cloudflare -----------------------------------------------------------------
# Docker network of the existing cloudflared container; web and api join it.
CLOUDFLARED_NETWORK=infrastructure_cloudflared_network
# The subnet of that network (CIDR). Only from there may a request name the client
# address (CF-Connecting-IP). Find it on the server with:
# docker network inspect infrastructure_cloudflared_network --format '{{(index .IPAM.Config 0).Subnet}}'
TRUSTED_PROXIES=
# Only for a fresh server whose tunnel this setup starts itself (profile own-tunnel):
# token of the tunnel (Zero Trust, Networks, Tunnels, the tunnel, Install connector).
TUNNEL_TOKEN=
# Token of Web Analytics for app.plagevo.de; empty means no analytics.
CLOUDFLARE_ANALYTICS_TOKEN=

# --- Backup -------------------------------------------------------------------
# Daily pg_dump into deploy/backups at this local time, kept this many days.
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14
# Owner of deploy/backups on the server (id -u and id -g); the backup does not run as root.
BACKUP_UID=1000
BACKUP_GID=1000
