<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Die Texte ohne Sprachzusatz (SharedResources.resx) sind Deutsch. -->
    <NeutralLanguage>de</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Die Tabler-Symbole reisen als eingebettete Ressourcen mit (Spec 7). -->
    <EmbeddedResource Include="Icons\svg\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.12" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Duofy.ApiClient\Duofy.ApiClient.csproj" />
  </ItemGroup>

</Project>
