@* Ein Tabler-Symbol als Inline-SVG; die Strichfarbe erbt die aktuelle Textfarbe (Spec 7). *@
@using Microsoft.Extensions.Logging
@inject ILogger<TablerIcon> Logger

@if (_body is not null)
{
    <svg xmlns="http://www.w3.org/2000/svg"
         width="@Size" height="@Size" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round"
         class="@($"icon icon-tabler icon-tabler-{Name}")"
         role="@(Labelled ? "img" : null)"
         aria-label="@(Labelled ? Label : null)"
         aria-hidden="@(Labelled ? null : "true")">
        @((MarkupString)_body)
    </svg>
}

@code {
    /// <summary>Der Name aus <see cref="TablerIcons.Names"/>, zum Beispiel credit-card.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Die Beschriftung für Screenreader; ohne sie ist das Symbol dekorativ und verborgen.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Kantenlänge in Pixeln.</summary>
    [Parameter] public int Size { get; set; } = 24;

    private bool Labelled => !string.IsNullOrWhiteSpace(Label);

    private string? _body;

    protected override void OnParametersSet()
    {
        _body = TablerIcons.Body(Name);
        if (_body is not null) return;

        Logger.LogError("Unbekanntes Tabler-Symbol '{Name}'; erlaubt sind: {Names}", Name, string.Join(", ", TablerIcons.Names));
#if DEBUG
        // Im Entwicklungsbetrieb soll ein fehlendes Symbol sofort auffallen.
        throw new ArgumentException($"Unbekanntes Tabler-Symbol '{Name}'.", nameof(Name));
#endif
    }
}
