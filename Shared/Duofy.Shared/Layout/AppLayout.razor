@inherits ThemedLayoutBase
@implements IDisposable
@inject AppChrome Chrome
@inject AppBrand Brand
@inject IStringLocalizer<SharedResources> L

@* Das Layout der Android-App: obere Leiste mit dem Titel der Seite, der Inhalt, unten die
   Navigationsleiste und darüber der runde Plus-Knopf der Seite. Der Browser benutzt weiter
   MainLayout.

   Titel und Plus-Knopf kommen von der Seite über AppChrome. Rechts in der oberen Leiste steht der Umschalter
   "wessen Zahlen" (Spec 68) als Profil-Knopf mit Menü (Spec 44), immer, und ab dem Desktop unten in der Seitenleiste. Die vier "Provider" braucht MudBlazor
   einmal pro Anwendung (Farben, Popups, Dialoge, Meldungen), wie in MainLayout. *@

<MudThemeProvider @ref="ThemeProvider" Theme="DuofyTheme.Instance" @bind-IsDarkMode="IsDarkMode" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<SkipLink Target="() => mainContent" />

<MudLayout>
    <MudAppBar Elevation="0">
        @* Die obere Leiste ist in beiden Modi dunkel (DuofyTheme), das Zeichen also immer das für dunklen Grund. *@
        <BrandMark Dark="true" Symbol="true" />
        <MudText Typo="Typo.h6" HtmlTag="div" Class="app-title" data-testid="app-title">@(Chrome.Title ?? Brand.Name)</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MemberSwitch />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    @* Der Schalter für hell und dunkel steht unten auf "Mehr"; die Seitenleiste zeigt "Mehr" nicht und braucht ihn selbst. *@
    <CascadingValue Value="@(new ModeSwitch(Choice, SelectChoiceAsync))">
        <SideNavigation>
            <Footer>
                <AuthorizeView>
                    <Authorized>
                        <MemberSwitch Up="true" />
                    </Authorized>
                </AuthorizeView>
            </Footer>
        </SideNavigation>
    </CascadingValue>

    <MudMainContent Class="app-main">
        <div class="app-page" id="@SkipLink.TargetId" tabindex="-1" @ref="mainContent">
            <CascadingValue Value="@(new ModeSwitch(Choice, SelectChoiceAsync))">
                @Body
            </CascadingValue>
        </div>
    </MudMainContent>
</MudLayout>

@if (Chrome.PlusAction is not null && Chrome.PlusLockedBy is not null)
{
    @* Ohne Freigabe zum Anlegen (Spec 68): ausgegraut und ohne Wirkung, aber erreichbar, mit dem Grund auf der Seite. *@
    <MudFab StartIcon="@Icons.Material.Filled.Add" Ripple="false" Class="app-fab grant-locked"
            aria-label="@Chrome.PlusLabel" aria-disabled="true" aria-describedby="@Chrome.PlusLockedBy" data-testid="app-plus" />
}
else if (Chrome.PlusAction is not null)
{
    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="Chrome.PlusDisabled"
            OnClick="@(() => Chrome.PlusAction!())" Class="app-fab" aria-label="@Chrome.PlusLabel" data-testid="app-plus" />
}

<BottomNavigation />

<div id="blazor-error-ui" data-nosnippet role="alert">
    @L["Layout_ErrorMessage"]
    <a href="." class="reload">@L["Layout_Reload"]</a>
    <button type="button" class="dismiss" aria-label="@L["Layout_Dismiss"]">&#10005;</button>
</div>

@code {
    private ElementReference mainContent;

    protected override void OnInitialized() => Chrome.Changed += OnChromeChanged;

    private void OnChromeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Chrome.Changed -= OnChromeChanged;
}
