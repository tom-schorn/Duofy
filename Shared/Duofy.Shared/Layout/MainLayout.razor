@inherits ThemedLayoutBase
@inject IStringLocalizer<SharedResources> L

@* Das Layout des Browsers: App-Leiste oben, der Seiteninhalt in der Mitte und die Navigation, je nach Breite
   links als Seitenleiste (ab 1280 px) oder unten als Leiste (Spec 10).

   Die vier "Provider" oben braucht MudBlazor einmal pro Anwendung: Sie bringen
   Farben, Popups, Dialoge und Meldungen auf den Bildschirm. *@

<MudThemeProvider @ref="ThemeProvider" Theme="DuofyTheme.Instance" @bind-IsDarkMode="IsDarkMode" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<SkipLink Target="() => mainContent" />

<MudLayout>
    <MudAppBar Elevation="0">
        @* Die obere Leiste ist in beiden Modi dunkel (DuofyTheme), das Logo also immer das für dunklen Grund. *@
        <MudText Typo="Typo.h6" HtmlTag="div" Class="app-title"><BrandMark Dark="true" /></MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MemberSwitch />
            </Authorized>
        </AuthorizeView>
        <ThemeChoiceSwitch Choice="Choice" ChoiceSelected="SelectChoiceAsync" />
    </MudAppBar>

    <SideNavigation>
        <Footer>
            <AuthorizeView>
                <Authorized>
                    <MemberSwitch Up="true" />
                </Authorized>
            </AuthorizeView>
        </Footer>
    </SideNavigation>

    <MudMainContent Class="app-main">
        <div class="app-page" id="@SkipLink.TargetId" tabindex="-1" @ref="mainContent">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<BottomNavigation />

<div id="blazor-error-ui" data-nosnippet role="alert">
    @L["Layout_ErrorMessage"]
    <a href="." class="reload">@L["Layout_Reload"]</a>
    <button type="button" class="dismiss" aria-label="@L["Layout_Dismiss"]">&#10005;</button>
</div>

@code {
    private ElementReference mainContent;
}
