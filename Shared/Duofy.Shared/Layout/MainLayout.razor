@inherits ThemedLayoutBase

@* Das Layout des Browsers. Die App benutzt AppLayout; beide zeigen denselben Rahmen (AppShell). *@

<ThemeVariables Dark="IsDarkMode" Settled="ThemeSettled" DeviceDarkChanged="OnDeviceDarkChangedAsync" />

<AppShell Dark="IsDarkMode" Choice="Choice" ChoiceSelected="SelectChoiceAsync">
    @Body
</AppShell>
