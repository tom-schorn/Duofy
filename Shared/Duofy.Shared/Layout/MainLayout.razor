@inherits ThemedLayoutBase
@inject IStringLocalizer<SharedResources> L

@* Das Layout des Browsers: App-Leiste oben, der Seiteninhalt in der Mitte und die Navigation, je nach Breite
   links als Seitenleiste (ab 1280 px) oder unten als Leiste (Spec 10).

   Die vier "Provider" oben braucht MudBlazor einmal pro Anwendung: Sie bringen
   Farben, Popups, Dialoge und Meldungen auf den Bildschirm. *@

<MudThemeProvider @ref="ThemeProvider" Theme="DuofyTheme.Instance" @bind-IsDarkMode="IsDarkMode" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0">
        <MudText Typo="Typo.h6" Class="app-title">@L["App_Name"]</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MemberSwitch />
            </Authorized>
        </AuthorizeView>
        <ThemeChoiceSwitch Choice="Choice" ChoiceSelected="SelectChoiceAsync" />
    </MudAppBar>

    <SideNavigation>
        <Footer>
            <AuthorizeView>
                <Authorized>
                    <MemberSwitch Up="true" />
                </Authorized>
            </AuthorizeView>
        </Footer>
    </SideNavigation>

    <MudMainContent Class="app-main">
        <div class="app-page">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<BottomNavigation />

<div id="blazor-error-ui" data-nosnippet>
    @L["Layout_ErrorMessage"]
    <a href="." class="reload">@L["Layout_Reload"]</a>
    <span class="dismiss">&#10005;</span>
</div>
