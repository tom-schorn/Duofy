@using Radzen.Blazor
@inject IAuthApi AuthApi
@inject IUserApi UserApi
@inject ILegalApi LegalApi
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L
@using Duofy.ApiClient
@using Duofy.Shared.Services

@* Der Teil des Menüs der Seitenleiste, der den Server fragt oder etwas tut (Spec 10, Änderung vom 01.11.2026):
   Admin nur für Personen, die den Server verwalten, die Rechtstexte dieses Servers und das Abmelden. Dieselben Einträge
   stehen am Handy auf der Seite "Mehr".

   Die Einträge erscheinen erst mit der Antwort des Servers und dann zusammen: Das Radzen-Menü führt die Pfeiltasten in der
   Reihenfolge, in der sich seine Einträge anmelden, und ein nachträglich angemeldeter Eintrag käme sonst ans Ende.

   Steht nur für angemeldete Personen im Layout (AuthorizeView in SideNavigation), damit vor der Anmeldung niemand
   den Server nach dem Benutzerkonto fragt. *@

@if (loaded)
{
    @if (isAdmin)
    {
        <RadzenPanelMenuItem Text="@L["More_Admin"]" Icon="admin_panel_settings" Path="/admin" data-testid="side-admin" />
    }
    <RadzenPanelMenuItem Text="@L["More_Licenses"]" Icon="gavel" Path="/lizenzen" data-testid="side-licenses" />
    @foreach (var name in legalDocuments)
    {
        <RadzenPanelMenuItem Text="@L[LegalPages.LabelKeyOf(name)]" Icon="article" Path="@LegalPages.PathOf(name)" data-testid="@($"side-legal-{name}")" />
    }
    <RadzenPanelMenuItem Text="@L["Account_SignOut"]" Icon="logout" Click="SignOutAsync" data-testid="side-sign-out" />
}

@code {
    // Die Rechtstexte, die dieser Server anbietet (Spec 70, R8); ohne Antwort des Servers gibt es keine Links.
    private IReadOnlyList<string> legalDocuments = [];

    // Ob die Person den Server verwaltet; ohne Antwort des Servers nicht.
    private bool isAdmin;

    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        var result = await LegalApi.ListAsync();
        if (result.Succeeded)
        {
            legalDocuments = LegalPages.Known(result.Value!.Documents);
        }

        var me = await UserApi.GetMeAsync();
        isAdmin = me.Succeeded && me.Value!.IsInstanceAdmin;
        loaded = true;
    }

    private async Task SignOutAsync()
    {
        await AuthApi.LogoutAsync();
        Navigation.NavigateTo("/anmelden");
    }
}
