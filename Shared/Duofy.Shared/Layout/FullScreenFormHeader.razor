@using Radzen
@using Radzen.Blazor
@inject IStringLocalizer<SharedResources> L

@* Die Kopfzeile eines Vollbild-Formulars in der App: Schließen links, der Titel in der Mitte,
   Speichern rechts. Die Dialoge zeichnen sie nur in der App; im Browser bleibt ihre
   gewohnte Kopf- und Fußzeile. *@

<div class="app-form-header" data-testid="form-header">
    <RadzenButton Icon="close" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(_ => OnClose.InvokeAsync())"
                  aria-label="@L["AppLayout_Close"]" data-testid="form-close" />
    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.Div" Class="app-form-header-title">@Title</RadzenText>
    @if (ShowSave)
    {
        <RadzenButton Text="@SaveText" ButtonStyle="ButtonStyle.Primary" Disabled="Busy" Click="@(_ => OnSave.InvokeAsync())"
                      data-testid="@SaveTestId" />
    }
</div>

@code {
    [Parameter, EditorRequired] public string? Title { get; set; }

    [Parameter, EditorRequired] public string SaveText { get; set; } = "";

    /// <summary>Das data-testid des Speichern-Knopfs; es ist dasselbe wie im Browser-Dialog.</summary>
    [Parameter, EditorRequired] public string SaveTestId { get; set; } = "";

    [Parameter] public bool Busy { get; set; }

    /// <summary>Ohne Speichern-Knopf, wenn das Formular gerade eine eigene Entscheidung verlangt.</summary>
    [Parameter] public bool ShowSave { get; set; } = true;

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback OnSave { get; set; }
}
