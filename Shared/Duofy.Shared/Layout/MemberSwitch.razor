@using BlazorBlueprint.Primitives
@using BlazorBlueprint.Components
@implements IDisposable
@inject ActiveMember Member
@inject IStringLocalizer<SharedResources> L

@* Die Auswahl "wessen Zahlen" (Spec 44, Spec 68 R8, Spec 82 R11): Ich, jedes Mitglied, das mir in irgendeinem Bereich
   mindestens Ansehen freigegeben hat, dann "Haushalt" (Spec 69, R9). Sie sitzt im Profil-Menü unten in der Seitenleiste
   (InMenu, als Einträge des Menüs von UserMenu) und am Handy im Profil auf der Seite Mehr (als Gruppe von Knöpfen).

   "Haushalt" gibt es nur ab zwei Mitgliedern; sonst steht er als nicht verfügbar da, nennt den Grund und führt zur
   Haushalt-Seite. Die Auswahl ändert keine Rechte: Wer nichts freigegeben hat, steht gar nicht in der Liste. *@

@if (InMenu)
{
    <BbDropdownMenuLabel>@L["MemberSwitch_Label"]</BbDropdownMenuLabel>
    <BbDropdownMenuItem OnClick="ChooseMe" Class="@CurrentClass(IsMe)" aria-current="@Current(IsMe)" data-testid="member-choice-me">
        @L["MemberSwitch_Me"]
    </BbDropdownMenuItem>
    @foreach (var person in Member.Sharing)
    {
        var id = person.UserId;
        <BbDropdownMenuItem @key="id" OnClick="@(() => Member.Choose(id))" Class="@CurrentClass(IsPerson(id))"
                            aria-current="@Current(IsPerson(id))" data-testid="@($"member-choice-{id}")">
            @person.FirstName
        </BbDropdownMenuItem>
    }
    @if (Member.CanShowHousehold)
    {
        <BbDropdownMenuItem OnClick="Member.ChooseHousehold" Class="@CurrentClass(Member.IsHousehold)"
                            aria-current="@Current(Member.IsHousehold)" data-testid="member-choice-household">
            @L["MemberSwitch_Household"]
        </BbDropdownMenuItem>
    }
    else
    {
        @* Nicht verfügbar, aber erreichbar: ausgegraut, mit dem Grund und dem Weg zur Haushalt-Seite. *@
        <BbDropdownMenuItem Href="/haushalt" Class="grant-locked" aria-disabled="true" aria-describedby="member-household-reason"
                            data-testid="member-choice-household">
            @L["MemberSwitch_Household"]
        </BbDropdownMenuItem>
        <div class="member-menu-reason" id="member-household-reason">@L["MemberSwitch_HouseholdReason"]</div>
    }
}
else
{
    <div class="member-choices" role="group" aria-label="@L["MemberSwitch_Label"]" data-testid="member-switch">
        <DuofyButton Kind="@Kind(IsMe)" Small="true" Text="@L["MemberSwitch_Me"]" OnClick="@(_ => ChooseMe())"
                     aria-pressed="@Pressed(IsMe)" TestId="member-choice-me" />
        @foreach (var person in Member.Sharing)
        {
            var id = person.UserId;
            <DuofyButton @key="id" Kind="@Kind(IsPerson(id))" Small="true" Text="@person.FirstName" OnClick="@(_ => Member.Choose(id))"
                         aria-pressed="@Pressed(IsPerson(id))" TestId="@($"member-choice-{id}")" />
        }
        @if (Member.CanShowHousehold)
        {
            <DuofyButton Kind="@Kind(Member.IsHousehold)" Small="true" Text="@L["MemberSwitch_Household"]" OnClick="@(_ => Member.ChooseHousehold())"
                         aria-pressed="@Pressed(Member.IsHousehold)" TestId="member-choice-household" />
        }
    </div>
    @if (!Member.CanShowHousehold)
    {
        <p class="small muted mt-2" data-testid="member-household-reason">@L["MemberSwitch_HouseholdReason"]</p>
    }
}

@code {
    /// <summary>True: als Einträge in einem Menü (innerhalb von BbDropdownMenuContent); sonst als Gruppe von Knöpfen.</summary>
    [Parameter] public bool InMenu { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Member.Changed += OnMemberChanged;
        await Member.LoadAsync();
    }

    private bool IsMe => !Member.IsHousehold && Member.Owner is null;

    private bool IsPerson(Guid id) => !Member.IsHousehold && Member.Owner == id;

    private static string? Current(bool value) => value ? "true" : null;

    private static string Pressed(bool value) => value ? "true" : "false";

    private static ButtonKind Kind(bool value) => value ? ButtonKind.Secondary : ButtonKind.Ghost;

    private static string? CurrentClass(bool value) => value ? "member-menu-current" : null;

    private void ChooseMe() => Member.Choose(null);

    private void OnMemberChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Member.Changed -= OnMemberChanged;
}
