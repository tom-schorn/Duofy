@using BlazorBlueprint.Components
@using BlazorBlueprint.Primitives
@inherits ThemedLayoutBase
@inject IStringLocalizer<SharedResources> L
@inject IAppHost Host
@inject AppBrand Brand

@* Das Layout für Anmelden und Registrieren, nach dem Vorbild von AuthLayout.tsx im alten Duofy: ohne Leisten und ohne
   Navigation. Auf dem Handy nur das Formular; ab 1280 px links zusätzlich die dunkelblaue Markenfläche, die in beiden
   Modi dunkel ist (class dark). Der Schalter für hell und dunkel sitzt oben rechts, damit man auch vor der Anmeldung den
   Modus wechseln kann. *@

<ThemeVariables Dark="IsDarkMode" Settled="ThemeSettled" DeviceDarkChanged="OnDeviceDarkChangedAsync" />

<div class="auth-layout">
    <aside class="auth-brand dark" data-testid="auth-brand">
        <span class="auth-brand-name"><BrandMark Dark="true" /></span>

        <div class="auth-brand-middle">
            <blockquote class="auth-claim">@L["Auth_Claim", Brand.Name]</blockquote>
            <ul class="auth-pots">
                <li><span class="dot dot--needs"></span>@L["Auth_PotNeeds"]</li>
                <li><span class="dot dot--wants"></span>@L["Auth_PotWants"]</li>
                <li><span class="dot dot--savings"></span>@L["Auth_PotSavings"]</li>
            </ul>
        </div>

        <p class="auth-tagline">@L["Auth_Tagline"]</p>
    </aside>

    <main class="auth-main">
        <div class="auth-mode-switch">
            <ThemeToggle Dark="IsDarkMode" ChoiceSelected="SelectChoiceAsync" />
        </div>

        @* Die Markenfläche links gibt es erst ab 1280 px; davor steht die Marke über dem Formular. *@
        <div class="auth-mobile-brand"><BrandMark Dark="IsDarkMode" /></div>

        <div class="auth-form">@Body</div>

        @* Nur die Rechtstexte, die der Server anbietet (Spec 70, R8). *@
        <LegalLinks />

        @* Die Wahl des Servers gibt es nur in der App; die Web-Version spricht mit ihrem eigenen Server. *@
        @if (Host.IsApp)
        {
            <ServerLine />
        }

        @* Die Wahl des Servers gibt es nur in der App; die Web-Version spricht mit ihrem eigenen Server. *@

    </main>
</div>

<BbDialogProvider />
<BbPortalHost />

<div id="blazor-error-ui" data-nosnippet role="alert">
    @L["Layout_ErrorMessage"]
    <a href="." class="reload">@L["Layout_Reload"]</a>
    <button type="button" class="dismiss" aria-label="@L["Layout_Dismiss"]">&#10005;</button>
</div>
