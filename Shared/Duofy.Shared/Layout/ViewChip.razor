@using BlazorBlueprint.Primitives
@using BlazorBlueprint.Components
@implements IDisposable
@inject ActiveMember Member
@inject IStringLocalizer<SharedResources> L

@* Wessen Zahlen gerade offen sind, von jeder Seite aus in der oberen Leiste zu sehen (Spec 82, R11) und dort auch zu wechseln
   (Spec 126, R2): Am Handy gibt es keine Seitenleiste mit dem Profil-Menü, die Auswahl stünde sonst nur auf der Seite Mehr und
   ein Wechsel dort zeigte nichts. Die Marke zeigt "Ansicht: Anna", bei "Ich" nur "Ich"; sie erscheint, sobald jemand etwas
   teilt oder eine Person gewählt ist. Dieselbe Auswahl (MemberSwitch) steht darin als Menü. *@
@if (Member.Sharing.Count > 0 || Member.Name is not null)
{
    <BbDropdownMenu>
        <BbDropdownMenuTrigger AsChild="false" Class="pill shell-view" aria-label="@L["MemberSwitch_Label"]" data-testid="shell-view">@(ViewLabel ?? L["MemberSwitch_Me"].Value)</BbDropdownMenuTrigger>
        <BbDropdownMenuContent Side="PopoverSide.Bottom" Align="PopoverAlign.End">
            <MemberSwitch InMenu="true" />
        </BbDropdownMenuContent>
    </BbDropdownMenu>
}

@code {
    private string? ViewLabel => Member.Name is { } name ? L["UserMenu_ViewOf", name].Value : null;

    protected override void OnInitialized() => Member.Changed += OnMemberChanged;

    private void OnMemberChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Member.Changed -= OnMemberChanged;
}
