@using BlazorBlueprint.Icons.Lucide.Components
@inherits DestinationNavigationBase
@inject IStringLocalizer<SharedResources> L

@* Die untere Leiste am Handy: Start, Plan, Haushalt, Sparen und Mehr (Tom, 03.11.2026) mit Symbol und Beschriftung, das aktuelle ist
   hervorgehoben. Ziele und Adresswechsel kommen aus DestinationNavigationBase, wie bei der Seitenleiste. *@

<nav class="bottom-bar" aria-label="@L["AppLayout_Navigation"]" data-testid="bottom-bar" data-print="hide">
    @foreach (var item in Destinations)
    {
        var active = item.Destination == Current;
        <a href="@item.Href" class="@(active ? "bottom-item bottom-item-active" : "bottom-item")"
           aria-current="@(active ? "page" : null)" data-testid="@($"bottom-{item.Destination}".ToLowerInvariant())">
            <LucideIcon Name="@item.Icon" Size="20" aria-hidden="true" />
            <span>@L[item.LabelKey]</span>
        </a>
    }
</nav>
