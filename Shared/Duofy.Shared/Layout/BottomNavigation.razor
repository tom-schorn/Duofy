@using Radzen.Blazor
@inherits DestinationNavigationBase
@inject IStringLocalizer<SharedResources> L

@* Die untere Leiste: Start, Plan, Haushalt und Mehr (Tom, 01.11.2026) mit Symbol und Beschriftung, das aktuelle ist hervorgehoben.
   Radzen hat keine fertige Leiste dafür (Plan, Frage 1), sie besteht aus einfachen Links mit Radzen-Symbolen. Ziele und
   Adresswechsel kommen aus DestinationNavigationBase, wie bei der Seitenleiste (SideNavigation).

   Unten kommt der Abstand zur Systemleiste dazu (siehe .app-bottom-bar in app.css). *@

<nav class="app-bottom-bar" aria-label="@L["AppLayout_Navigation"]" data-testid="bottom-bar">
    @foreach (var item in Destinations)
    {
        var active = item.Destination == Current;
        <a href="@item.Href" class="@(active ? "app-bottom-item app-bottom-item-active" : "app-bottom-item")"
           aria-current="@(active ? "page" : null)" data-testid="@($"bottom-{item.Destination}".ToLowerInvariant())">
            <RadzenIcon Icon="@item.Icon" />
            <span class="app-bottom-label">@L[item.LabelKey]</span>
        </a>
    }
</nav>
