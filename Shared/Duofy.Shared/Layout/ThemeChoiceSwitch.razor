@inject IStringLocalizer<SharedResources> L

@* Die Auswahl für Hell, Dunkel und "wie das Gerät": drei Knöpfe in einer Gruppe, genau einer ist aktiv.
   Für Screenreader ist es eine Optionsgruppe (radiogroup), die aktive Möglichkeit ist aria-checked.
   Die Klasse mode-switch bleibt vom alten Knopf erhalten, damit Tests und Stile sie weiter finden. *@

<div class="mode-switch" role="radiogroup" aria-label="@L["Layout_ThemeLabel"]" data-testid="theme-choice">
    @foreach (var option in options)
    {
        var active = option.Choice == Choice;
        <MudIconButton Icon="@option.Icon" Size="Size.Small" Color="Color.Inherit"
                       Variant="@(active ? Variant.Outlined : Variant.Text)"
                       OnClick="@(() => ChoiceSelected.InvokeAsync(option.Choice))"
                       role="radio" aria-checked="@(active ? "true" : "false")"
                       aria-label="@L[option.LabelKey]" title="@L[option.LabelKey]"
                       data-testid="@($"theme-{option.Choice.ToString().ToLowerInvariant()}")" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ThemeChoice Choice { get; set; }

    [Parameter]
    public EventCallback<ThemeChoice> ChoiceSelected { get; set; }

    private static readonly (ThemeChoice Choice, string Icon, string LabelKey)[] options =
    [
        (ThemeChoice.Light, Icons.Material.Filled.LightMode, "Layout_ThemeLight"),
        (ThemeChoice.Dark, Icons.Material.Filled.DarkMode, "Layout_ThemeDark"),
        (ThemeChoice.Device, Icons.Material.Filled.SettingsBrightness, "Layout_ThemeDevice"),
    ];
}
