@using Radzen
@using Radzen.Blazor
@inject IStringLocalizer<SharedResources> L

@* Die Auswahl für Hell, Dunkel und "wie das Gerät": drei Knöpfe in einer Gruppe, genau einer ist aktiv.
   Für Screenreader ist es eine Gruppe von Knöpfen; der aktive trägt aria-pressed="true". Eine radiogroup wäre falsch,
   weil sie Pfeiltasten und einen Tab-Stopp versprechen würde, die es hier nicht gibt.
   Die Klasse mode-switch bleibt vom alten Knopf erhalten, damit Tests und Stile sie weiter finden. *@

<div class="mode-switch" role="group" aria-label="@L["Layout_ThemeLabel"]" data-testid="theme-choice">
    @foreach (var option in options)
    {
        var active = option.Choice == Choice;
        <RadzenButton Icon="@option.Icon" ButtonStyle="ButtonStyle.Base"
                      Variant="@(active ? Variant.Outlined : Variant.Text)"
                      Click="@(() => ChoiceSelected.InvokeAsync(option.Choice))"
                      aria-pressed="@(active ? "true" : "false")"
                      aria-label="@L[option.LabelKey]" title="@L[option.LabelKey]"
                      data-testid="@($"theme-{option.Choice.ToString().ToLowerInvariant()}")" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ThemeChoice Choice { get; set; }

    [Parameter]
    public EventCallback<ThemeChoice> ChoiceSelected { get; set; }

    private static readonly (ThemeChoice Choice, string Icon, string LabelKey)[] options =
    [
        (ThemeChoice.Light, "light_mode", "Layout_ThemeLight"),
        (ThemeChoice.Dark, "dark_mode", "Layout_ThemeDark"),
        (ThemeChoice.Device, "brightness_auto", "Layout_ThemeDevice"),
    ];
}
