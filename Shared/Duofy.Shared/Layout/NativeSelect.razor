@* Ein Auswahlfeld mit der Auswahl des Geräts: Auf dem Handy öffnet sich das Auswahlfenster des Systems, im Browser die
   gewohnte Liste.

       <NativeSelect Label="Konto" @bind-Value="kontoId">
           <option value="a">Girokonto</option>
       </NativeSelect>

   Die Auswahl ist immer ein Text; leer ist "". Weitere Attribute (zum Beispiel data-testid) landen am select-Element. *@

<div class="field">
    @if (Label is not null)
    {
        <FieldLabel For="@SelectId" Text="@Label" />
    }
    <select value="@Value" @onchange="OnChangeAsync" @attributes="AdditionalAttributes" id="@SelectId" class="native-select">
        @ChildContent
    </select>
</div>

@code {

    private readonly string generatedId = $"select-{Guid.NewGuid():N}";

    // Eine mitgegebene Id gewinnt (StepField hängt seine Beschriftung daran), sonst braucht die eigene Beschriftung eine.
    private string SelectId => AdditionalAttributes?.GetValueOrDefault("id")?.ToString() ?? generatedId;

    /// <summary>Die Beschriftung über dem Feld.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>Der Wert der gewählten Option, "" wenn nichts gewählt ist.</summary>
    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Die Optionen: <c>&lt;option value="..."&gt;</c> oder Gruppen mit <c>&lt;optgroup&gt;</c>.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private Task OnChangeAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
