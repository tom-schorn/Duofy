@using Radzen
@using Radzen.Blazor
@* Der Knopf in drei Arten (primär, sekundär, gefährlich). Radzen liefert Aussehen und Verhalten (Klick, gesperrt);
   die Klassen duofy-button und duofy-button--art bleiben als Anker für Tests und Stile. Ein Knopf nur mit Zeichen
   braucht AriaLabel. *@
<RadzenButton Class="@($"duofy-button duofy-button--{KindName}")"
              ButtonStyle="Style"
              Disabled="Disabled"
              Click="OnClick"
              @attributes="Attributes">@ChildContent</RadzenButton>

@code {
    [Parameter] public ButtonKind Kind { get; set; } = ButtonKind.Primary;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Die Kennung für Tests (data-testid) am Knopf.</summary>
    [Parameter] public string? TestId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }

    private string KindName => Kind switch
    {
        ButtonKind.Secondary => "secondary",
        ButtonKind.Danger => "danger",
        _ => "primary",
    };

    private ButtonStyle Style => Kind switch
    {
        ButtonKind.Secondary => ButtonStyle.Base,
        ButtonKind.Danger => ButtonStyle.Danger,
        _ => ButtonStyle.Primary,
    };

    private Dictionary<string, object> Attributes
    {
        get
        {
            Dictionary<string, object> attributes = [];
            if (AriaLabel is not null)
            {
                attributes["aria-label"] = AriaLabel;
            }
            if (TestId is not null)
            {
                attributes["data-testid"] = TestId;
            }
            return attributes;
        }
    }
}
