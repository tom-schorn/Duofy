@* Der eckige Knopf in drei Arten. Aussehen und Fokuskontur stehen in app.css (.duofy-button);
   MudButton liefert Verhalten (Klick, Link, gesperrt). Ein Knopf nur mit Zeichen braucht AriaLabel. *@
<MudButton Class="@($"duofy-button duofy-button--{KindName}")"
           Variant="Variant.Filled"
           Disabled="Disabled"
           Href="@Href"
           OnClick="OnClick"
           UserAttributes="@Attributes">@ChildContent</MudButton>

@code {
    [Parameter] public ButtonKind Kind { get; set; } = ButtonKind.Primary;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Die Kennung für Tests (data-testid) am Knopf.</summary>
    [Parameter] public string? TestId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }

    private string KindName => Kind switch
    {
        ButtonKind.Secondary => "secondary",
        ButtonKind.Danger => "danger",
        _ => "primary",
    };

    private Dictionary<string, object> Attributes
    {
        get
        {
            Dictionary<string, object> attributes = [];
            if (AriaLabel is not null)
            {
                attributes["aria-label"] = AriaLabel;
            }
            if (TestId is not null)
            {
                attributes["data-testid"] = TestId;
            }
            return attributes;
        }
    }
}
