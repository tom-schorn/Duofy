@using Duofy.ApiClient
@using Duofy.Schemas
@inject IReminderApi ReminderApi
@inject IStringLocalizer<SharedResources> L

@* Die Benachrichtigungen einer Person (Spec 84, 118): vier Schalter, die Uhrzeit am Morgen, der Abend mit eigener Uhrzeit und die
   Tage der Vorwarnung. Der Baustein steht auf der eigenen Seite "Benachrichtigungen" (Pages/Notifications). Es gibt keinen
   Speichern-Knopf: Jede Wahl gilt sofort und die Meldung "Gespeichert" bestätigt sie; bei einer Uhrzeit ist die Wahl im
   Zeitfenster des Geräts ("Festlegen") das Speichern. Nur auf dem gehosteten Server mit eingeschalteten Erinnerungen; sonst
   antwortet er 404, und der Baustein zeigt nichts. Das Feld zeigt immer, was der Server gespeichert hat. Ist niemand mehr
   angemeldet, bleibt die Meldung weg: Die Seite wechselt ohnehin zur Anmeldung.

   Issue 117: Das Zeitfenster von Android liefert die Zeit mit Sekunden oder gar nicht ("Löschen"). Mit Sekunden gilt die Zeit
   ohne sie; ohne Uhrzeit bleibt die gespeicherte stehen und ein Hinweis erklärt es, statt einen Fehler zu zeigen. *@
@if (settings is not null)
{
    <section class="card @Class" aria-labelledby="notifications-title" data-testid="notifications">
        <h2 class="sub-title" id="notifications-title">@L["Notify_Title"]</h2>
        <p class="small muted">@L["Notify_Lead"]</p>

        <div class="stack-sm mt-2">
            @foreach (var option in Switches)
            {
                var current = option;
                <label class="row" data-testid="@($"notify-{option.Key}-row")">
                    <TickBox Checked="option.IsOn(settings)" Label="" OnToggle="@(() => ToggleAsync(current))" data-testid="@($"notify-{option.Key}")" />
                    <span class="stack-sm fill">
                        <span>@L[option.TextKey]</span>
                        <span class="small muted">@L[option.HintKey]</span>
                    </span>
                </label>
            }
        </div>

        <div class="field mt-3">
            <FieldLabel For="notify-morning-time" Text="@L["Notify_Morning"]" />
            <TextInput Type="time" Value="@settings.MorningTime" ValueChanged="ChangeMorningAsync" Reset="morningReset" id="notify-morning-time" data-testid="notify-morning-time" />
        </div>

        <label class="row mt-3">
            <TickBox Checked="settings.EveningEnabled" Label="" OnToggle="ToggleEveningAsync" data-testid="notify-evening-enabled" />
            <span>@L["Notify_Evening"]</span>
        </label>
        @if (settings.EveningEnabled)
        {
            <div class="field mt-2">
                <FieldLabel For="notify-evening-time" Text="@L["Notify_EveningTime"]" />
                <TextInput Type="time" Value="@settings.EveningTime" ValueChanged="ChangeEveningAsync" Reset="eveningReset" id="notify-evening-time" data-testid="notify-evening-time" />
            </div>
        }

        <NativeSelect Label="@L["Notify_WarningDays"]" Value="@settings.WarningDays.ToString()" ValueChanged="ChangeWarningDaysAsync" id="notify-warning-days" data-testid="notify-warning-days">
            @for (var days = ReminderSettingsLimits.MinWarningDays; days <= ReminderSettingsLimits.MaxWarningDays; days++)
            {
                <option value="@days">@L[days == 1 ? "Notify_WarningDay" : "Notify_WarningDaysN", days]</option>
            }
        </NativeSelect>
        <p class="small muted">@L["Notify_TimeZone"]</p>
        <Notice Message="message" />
    </section>
}

@code {
    // Wie eine Seite am Schalter hängt: Schlüssel für die Test-Kennung, Texte und wie der Schalter gelesen und gesetzt wird.
    private sealed record SwitchOption(
        string Key, string TextKey, string HintKey, Func<ReminderSettingsResponse, bool> IsOn, Func<bool, UpdateReminderSettingsRequest> Request);

    private static readonly SwitchOption[] Switches =
    [
        new("due-today", "Notify_DueToday", "Notify_DueTodayHint", s => s.DueToday, on => new UpdateReminderSettingsRequest(DueToday: on)),
        new("overdue", "Notify_Overdue", "Notify_OverdueHint", s => s.Overdue, on => new UpdateReminderSettingsRequest(Overdue: on)),
        new("advance", "Notify_Advance", "Notify_AdvanceHint", s => s.AdvanceWarning, on => new UpdateReminderSettingsRequest(AdvanceWarning: on)),
        new("household", "Notify_Household", "Notify_HouseholdHint", s => s.Household, on => new UpdateReminderSettingsRequest(Household: on)),
    ];

    [Parameter] public string? Class { get; set; }

    private ReminderSettingsResponse? settings;
    private NoticeMessage? message;
    private int morningReset;
    private int eveningReset;
    private int morningRequests;
    private int eveningRequests;

    protected override async Task OnInitializedAsync()
    {
        // Ohne Erinnerungen auf dem Server (404) bleibt der Baustein leer.
        var result = await ReminderApi.GetSettingsAsync();
        settings = result.Succeeded ? result.Value : null;
    }

    private Task ToggleAsync(SwitchOption option) => SaveAsync(option.Request(!option.IsOn(settings!)), reset: null);

    private Task ToggleEveningAsync() => SaveAsync(new UpdateReminderSettingsRequest(EveningEnabled: !settings!.EveningEnabled), reset: null);

    private Task ChangeWarningDaysAsync(string days) =>
        int.TryParse(days, out var value) ? SaveAsync(new UpdateReminderSettingsRequest(WarningDays: value), reset: null) : Task.CompletedTask;

    private Task ChangeMorningAsync(string time) => ChangeTimeAsync(time, evening: false);

    private Task ChangeEveningAsync(string time) => ChangeTimeAsync(time, evening: true);

    // Eine gewählte Uhrzeit: "HH:mm:ss" wird zu "HH:mm"; ohne Uhrzeit ("Löschen" im Zeitfenster) bleibt die gespeicherte stehen.
    private async Task ChangeTimeAsync(string time, bool evening)
    {
        int request;
        if (evening)
        {
            request = ++eveningRequests;
        }
        else
        {
            request = ++morningRequests;
        }
        if (!ReminderTime.TryNormalize(time, out var normal))
        {
            Restore(evening, request);
            message = new NoticeMessage(L["Notify_TimeEmpty"], NoticeSeverity.Info);
            return;
        }
        await SaveAsync(evening ? new UpdateReminderSettingsRequest(EveningTime: normal) : new UpdateReminderSettingsRequest(MorningTime: normal), (evening, request));
    }

    // Das Feld bekommt seinen gespeicherten Wert zurück, aber nur nach der jüngsten Eingabe; eine späte Antwort überschriebe sonst,
    // was inzwischen gewählt wurde.
    private void Restore(bool evening, int request)
    {
        if (request != (evening ? eveningRequests : morningRequests))
        {
            return;
        }
        if (evening)
        {
            eveningReset++;
        }
        else
        {
            morningReset++;
        }
    }

    private async Task SaveAsync(UpdateReminderSettingsRequest request, (bool Evening, int Request)? reset)
    {
        var result = await ReminderApi.UpdateSettingsAsync(request);
        if (result.Succeeded)
        {
            settings = result.Value;
            message = new NoticeMessage(L["Notify_Saved"], NoticeSeverity.Success);
            return;
        }
        // Gespeichert bleibt, was der Server hatte (neu gezeichnet); die Meldung sagt, warum nicht.
        settings = settings! with { };
        if (reset is { } r)
        {
            Restore(r.Evening, r.Request);
        }
        message = result.ErrorCode == ClientErrorCodes.NotSignedIn
            ? null
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
    }
}
