@using Duofy.ApiClient
@using Duofy.Schemas
@inject IReminderApi ReminderApi
@inject IStringLocalizer<SharedResources> L

@* Die Einstellung der Erinnerungen (Spec 84): an oder aus und die Uhrzeit. Ein eigener Baustein, weil sie am Handy auf der
   Seite Mehr und am PC und Tablet auf der Kontoseite steht. Nur auf dem gehosteten Server mit eingeschalteten Erinnerungen;
   sonst antwortet er 404, und der Baustein zeigt nichts. Jede Wahl gilt sofort. Das Kästchen zeigt immer, was der Server
   gespeichert hat. Ist niemand mehr angemeldet, bleibt die Meldung weg: Die Seite wechselt ohnehin zur Anmeldung. *@
@if (reminders is not null)
{
    <section class="card @Class" aria-labelledby="more-reminders-title" data-testid="more-reminders">
        <h2 class="sub-title" id="more-reminders-title">@L["More_Reminders"]</h2>
        <p class="small muted">@L["More_RemindersLead"]</p>
        <label class="row mt-2">
            <TickBox Checked="reminders.Enabled" Label="" OnToggle="ToggleAsync" data-testid="more-reminders-enabled" />
            <span>@L["More_RemindersEnabled"]</span>
        </label>
        <div class="field mt-2">
            <FieldLabel For="more-reminders-time" Text="@L["More_RemindersTime"]" />
            <TextInput Type="time" Value="@reminders.Time" ValueChanged="ChangeTimeAsync" Reset="resetCount" id="more-reminders-time" data-testid="more-reminders-time" />
        </div>
        <Notice Message="message" />
    </section>
}

@code {
    [Parameter] public string? Class { get; set; }

    private ReminderSettingsResponse? reminders;
    private NoticeMessage? message;
    private int resetCount;
    private int timeRequests;

    protected override async Task OnInitializedAsync()
    {
        // Ohne Erinnerungen auf dem Server (404) bleibt der Baustein leer.
        var settings = await ReminderApi.GetSettingsAsync();
        reminders = settings.Succeeded ? settings.Value : null;
    }

    private Task ToggleAsync() => SaveAsync(new UpdateReminderSettingsRequest(Enabled: !reminders!.Enabled), timeRequest: null);

    private Task ChangeTimeAsync(string time) => SaveAsync(new UpdateReminderSettingsRequest(Time: time), ++timeRequests);

    // timeRequest ist die laufende Nummer einer Zeitänderung (null beim Schalter). Das Feld wird nur zurückgesetzt, wenn die
    // abgelehnte Anfrage eine Zeitänderung und noch die jüngste ist; sonst überschriebe eine späte Antwort, was inzwischen getippt wurde.
    private async Task SaveAsync(UpdateReminderSettingsRequest request, int? timeRequest)
    {
        var result = await ReminderApi.UpdateSettingsAsync(request);
        if (result.Succeeded)
        {
            reminders = result.Value;
            message = new NoticeMessage(L["More_RemindersSaved"], NoticeSeverity.Success);
        }
        else
        {
            // Das Feld bekommt seinen gespeicherten Wert zurück (neu gezeichnet); die Meldung sagt, warum nicht.
            reminders = reminders! with { };
            if (timeRequest == timeRequests)
            {
                resetCount++;
            }
            message = result.ErrorCode == ClientErrorCodes.NotSignedIn
                ? null
                : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        }
    }
}
