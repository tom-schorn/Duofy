@* Der Balken eines Topfs: Anteil in der festen Farbe des Topfs (--pot-needs, --pot-wants, --pot-savings), bei Überschreitung mit
   rotem Ende in der reservierten Farbe (Issue #94, R3). Der Wert steht immer auch als Text daneben (der Name und bei
   Überschreitung das Wort "überzogen"), deshalb ist der Balken für Vorlese-Programme verborgen. *@
<span class="bar" aria-hidden="true">
    <span class="@FillClass" style="width: @Width"></span>
</span>

@code {
    /// <summary>Der Schlüssel des Topfs (PotKeys), zum Beispiel "Needs"; ohne Angabe die Hauptfarbe.</summary>
    [Parameter] public string? Pot { get; set; }

    /// <summary>Der Anteil in Prozent, auf 0 bis 100 begrenzt.</summary>
    [Parameter] public decimal Percent { get; set; }

    [Parameter] public bool Over { get; set; }

    private string Width => Duofy.Shared.Charts.ChartMath.CssPercent(Percent);

    private string FillClass => Pot is null
        ? (Over ? "bar-fill bar-fill--over" : "bar-fill bar-fill--neutral")
        : Over ? $"bar-fill bar-fill--{Pot} bar-fill--over-end" : $"bar-fill bar-fill--{Pot}";
}
