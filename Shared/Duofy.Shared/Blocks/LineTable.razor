@* Die Linientabelle: Zeilen mit Bezeichnung und Betrag, getrennt durch Linien statt Schatten.
   Die Überschrift (caption) gibt der Tabelle für Vorlese-Programme einen Namen. Eine Zeile darf vorne etwas tragen
   (Haken), hinten etwas (Knöpfe) und unter der Bezeichnung eine Zeile Nebentext; die Spalten dafür gibt es nur,
   wenn mindestens eine Zeile sie braucht. *@
<table class="line-table">
    <caption class="@(HideCaption ? "visually-hidden" : "line-table-caption")">@Caption</caption>
    <tbody>
        @foreach (var row in Rows)
        {
            <tr data-testid="@row.TestId">
                @if (HasLeading)
                {
                    <td class="line-table-lead">@row.Leading</td>
                }
                <th scope="row" class="line-table-label">
                    @row.Label
                    @if (row.Detail is not null)
                    {
                        <span class="line-table-detail">@row.Detail</span>
                    }
                </th>
                <td class="line-table-amount">@(row.Amount is { } amount ? MoneyText.Format(amount) : "")</td>
                @if (HasTrailing)
                {
                    <td class="line-table-trail">@row.Trailing</td>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public string Caption { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<LineTableRow> Rows { get; set; } = [];

    /// <summary>Die Überschrift nur für Vorlese-Programme, wenn die Seite schon einen sichtbaren Titel hat.</summary>
    [Parameter] public bool HideCaption { get; set; }

    private bool HasLeading => Rows.Any(r => r.Leading is not null);
    private bool HasTrailing => Rows.Any(r => r.Trailing is not null);
}
