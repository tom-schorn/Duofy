@inject IStringLocalizer<SharedResources> L
@inject FormDialogs Forms

@* Der Rahmen für Dialoge in Schritten (Spec 11). Er ist die Wurzel eines Dialogs.

   Der Dialog geht über FormDialogs.OpenStepAsync auf; der Rahmen zeichnet Kopf, Schritte und Knöpfe selbst, der Titel
   kommt als Parameter Title.

   Die Schritte stehen als DialogStep im Inhalt. Alle Schritte bleiben gezeichnet, nur der aktuelle
   ist sichtbar; so bleiben Eingaben beim Zurückgehen stehen, auch in Feldern ohne Bindung.
   Weiter prüft die Felder des aktuellen Schritts (StepField), im letzten Schritt ruft es OnFinish.
   Zurück steht links, Weiter rechts am unteren Rand; im ersten Schritt hält ein Platzhalter die Stelle frei.

   Escape bricht ab wie der Knopf Abbrechen, also mit der Rückfrage bei Eingaben (Issue #22). Das eigene Escape der
   Bibliothek ist aus (FormDialogs.StepOptions), damit die Rückfrage nicht umgangen wird. *@

@* Kopf und Knöpfe bleiben stehen, nur die Schritte rollen. *@
<div class="step-dialog" data-testid="step-dialog">
    <div class="step-dialog-top">
        @HeadContent
    </div>
    <div class="step-dialog-scroll">
        @StepsContent
    </div>
    <div class="step-dialog-foot">
        @ActionsContent
    </div>
</div>

@code {
    [CascadingParameter] private BlazorBlueprint.Components.IDialogReference? DialogRef { get; set; }

    private RenderFragment HeadContent => @<text>
        <div class="step-dialog-head" @onkeydown="OnKeyDown">
            <div class="step-dialog-heading">
                @* Den Namen für Vorlese-Programme trägt die Überschrift des Fensters (FormDialogs); sie ist nur unsichtbar, damit sie
                   hier neben dem Fortschritt und Abbrechen stehen kann. So steht der Titel nur einmal da. *@
                <p class="step-dialog-title" aria-hidden="true">@Title</p>
                @* Mit nur einem Schritt gibt es nichts zu zählen: kein Fortschritt, kein Balken. *@
                @if (steps.Count != 1)
                {
                    <p class="step-dialog-progress" aria-live="polite" data-testid="step-dialog-progress">@ProgressText</p>
                }
            </div>
            <DuofyButton Kind="ButtonKind.Secondary" OnClick="CancelAsync" TestId="step-dialog-cancel">@L["StepDialog_Cancel"]</DuofyButton>
        </div>
        @if (steps.Count != 1)
        {
            <div class="step-dialog-bar" aria-hidden="true">
                @for (var i = 0; i < steps.Count; i++)
                {
                    <span class="@(i <= current ? "step-dialog-bar-segment step-dialog-bar-segment--reached" : "step-dialog-bar-segment")"></span>
                }
            </div>
        }
    </text>;

    private RenderFragment StepsContent => @<text>
        @* Tippen, Auswählen und Ankreuzen lösen input aus, und input steigt in Blazor bis hierher auf
           (change nicht); daran merkt der Rahmen, dass etwas eingegeben ist. *@
        <div class="step-dialog-steps" @oninput="MarkInput" @onkeydown="OnKeyDown">
            <CascadingValue Value="this" IsFixed="true">
                @ChildContent
            </CascadingValue>
        </div>
    </text>;

    private RenderFragment ActionsContent => @<text>
        <div class="step-dialog-actions" @onkeydown="OnKeyDown">
            @if (current > 0)
            {
                <DuofyButton Kind="ButtonKind.Secondary" OnClick="Back">@L["StepDialog_Back"]</DuofyButton>
            }
            else
            {
                <span class="step-dialog-actions-spacer"></span>
            }
            @if (FootStart is not null)
            {
                @FootStart
                <span class="fill"></span>
            }
            @if (EarlyFinishShown)
            {
                @* Spec 124, R6: ab Schritt 2 speichert dieser Knopf sofort, wie der Knopf im letzten Schritt. *@
                <DuofyButton Kind="ButtonKind.Secondary" Disabled="Busy" OnClick="EarlyFinishAsync" TestId="@EarlyFinishTestId">@(FinishText ?? L["StepDialog_Finish"])</DuofyButton>
            }
            <DuofyButton Kind="ButtonKind.Primary" Disabled="Busy" OnClick="NextAsync" TestId="@(IsLast ? FinishTestId : NextTestId)">@(IsLast ? FinishText ?? L["StepDialog_Finish"] : L["StepDialog_Next"])</DuofyButton>
        </div>
    </text>;

    /// <summary>Was unten neben Zurück steht, etwa Löschen im Dialog eines Postens.</summary>
    [Parameter]
    public RenderFragment? FootStart { get; set; }

    /// <summary>Der Titel im Kopf.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Die Schritte als DialogStep, in ihrer Reihenfolge.</summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Wird im letzten Schritt nach bestandener Prüfung gerufen; der Dialog speichert und schließt sich dort selbst.</summary>
    [Parameter]
    public EventCallback OnFinish { get; set; }

    /// <summary>Text des Knopfs im letzten Schritt; ohne Angabe "Speichern".</summary>
    [Parameter]
    public string? FinishText { get; set; }

    /// <summary>Die Kennung (data-testid) des Knopfs im letzten Schritt, zum Beispiel "booking-save".</summary>
    [Parameter]
    public string? FinishTestId { get; set; }

    /// <summary>Die Kennung (data-testid) des Knopfs "Weiter" in den Schritten davor.</summary>
    [Parameter]
    public string? NextTestId { get; set; }

    /// <summary>
    /// Ob der Dialog schon vor dem letzten Schritt speichern darf (der Aufrufer sagt, ob genug eingegeben ist). Dann steht ab dem
    /// zweiten Schritt neben Weiter ein Knopf mit dem Text von FinishText, der OnFinish ruft, ohne die Schritte davor zu durchlaufen.
    /// Im ersten und im letzten Schritt gibt es ihn nicht.
    /// </summary>
    [Parameter]
    public bool EarlyFinish { get; set; }

    /// <summary>Die Kennung (data-testid) des frühen Knopfs zum Speichern.</summary>
    [Parameter]
    public string? EarlyFinishTestId { get; set; }

    /// <summary>Sperrt Weiter, etwa während gespeichert wird.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>
    /// Sagt zusätzlich, ob schon etwas eingegeben ist, für Eingaben, die kein input im Inhalt auslösen
    /// (etwa Auswahllisten in einem Popover). Eingaben in Feldern bemerkt der Rahmen selbst.
    /// </summary>
    [Parameter]
    public Func<bool>? HasInput { get; set; }

    // Alle angemeldeten Schritte in ihrer Reihenfolge; gezählt und angesteuert werden nur die, die nicht übersprungen sind.
    private readonly List<DialogStep> all = [];
    private List<DialogStep> steps => all.Where(step => !step.Skipped).ToList();
    private int current;
    private bool typed;

    private bool IsLast => current >= steps.Count - 1;

    private bool EarlyFinishShown => EarlyFinish && current > 0 && !IsLast;

    /// <summary>Zeigt den letzten Schritt, etwa damit ein Fehler beim frühen Speichern dort zu lesen ist.</summary>
    public void ShowLast()
    {
        current = Math.Max(steps.Count - 1, 0);
        StateHasChanged();
    }

    // Wie Weiter im letzten Schritt: erst die Felder des aktuellen Schritts prüfen, dann OnFinish.
    private async Task EarlyFinishAsync()
    {
        if (steps.Count == 0 || !steps[current].Check())
        {
            return;
        }
        await OnFinish.InvokeAsync();
    }

    private string ProgressText => steps.Count == 0
        ? ""
        : $"{L["StepDialog_Progress", current + 1, steps.Count]}: {steps[current].Title}";

    internal bool IsCurrent(DialogStep step) => steps.IndexOf(step) == current;

    // Die Nummer im Test-Kennzeichen zählt alle Schritte, auch übersprungene; so behält jeder Schritt seine Nummer.
    internal int StepNumber(DialogStep step) => all.IndexOf(step) + 1;

    internal void Add(DialogStep step)
    {
        all.Add(step);
        StateHasChanged();
    }

    // Ein Schritt wird übersprungen oder kommt wieder dazu; Fortschritt und Weiter richten sich danach.
    internal void StepsChanged()
    {
        current = Math.Clamp(current, 0, Math.Max(steps.Count - 1, 0));
        StateHasChanged();
    }

    internal void Remove(DialogStep step)
    {
        // Kein Neuzeichnen: Meist geht hier der ganze Dialog zu.
        all.Remove(step);
        current = Math.Clamp(current, 0, Math.Max(steps.Count - 1, 0));
    }

    private void MarkInput() => typed = true;

    // Escape wirkt wie Abbrechen, auch mit der Rückfrage. Ein Escape, das nur ein offenes Auswahlfeld schließt, kommt
    // hier ebenfalls an; die Rückfrage erscheint dann nur, wenn schon etwas eingegeben ist.
    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? CancelAsync() : Task.CompletedTask;

    private void Back()
    {
        if (current > 0)
        {
            current--;
        }
    }

    private async Task NextAsync()
    {
        if (steps.Count == 0 || !steps[current].Check())
        {
            return;
        }

        if (IsLast)
        {
            await OnFinish.InvokeAsync();
            return;
        }
        current++;
    }

    // Ohne Eingaben schließt Abbrechen sofort, mit Eingaben fragt es erst nach (Spec 11, R5).
    private async Task CancelAsync()
    {
        if (typed || HasInput?.Invoke() == true)
        {
            var discard = await Forms.ConfirmAsync(L["StepDialog_DiscardText"], L["StepDialog_DiscardTitle"],
                L["StepDialog_DiscardConfirm"], L["StepDialog_DiscardKeep"]);
            if (!discard)
            {
                return;
            }
        }

        await (DialogRef?.CancelAsync() ?? Task.CompletedTask);
    }
}
