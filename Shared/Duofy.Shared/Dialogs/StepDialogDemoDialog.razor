@using BlazorBlueprint.Components
@inherits FormDialogBase

@* Der Beispieldialog der Testseite (Spec 11): drei Schritte, zwei davon mit Pflichtfeld.
   Er zeigt, wie ein Dialog den StepDialog benutzt; ein echter Dialog hält seine Werte genauso
   in eigenen Feldern und schließt sich in OnFinish mit dem Ergebnis. *@

<StepDialog Title="@Title" OnFinish="Finish">
    <DialogStep Title="@NameStep">
        <StepField Label="@NameLabel" InputId="demo-name-input" Required IsFilled="() => !string.IsNullOrWhiteSpace(name)"
                   TestId="demo-name-field">
            <TextInput id="demo-name-input" @bind-Value="name" aria-describedby="demo-name-input-error" data-testid="demo-name" />
        </StepField>
    </DialogStep>
    <DialogStep Title="@AmountStep">
        <StepField Label="@AmountLabel" InputId="demo-amount-input" Required IsFilled="() => amount is not null"
                   TestId="demo-amount-field">
            <MoneyInput id="demo-amount-input" @bind-Value="amount" data-testid="demo-amount" />
        </StepField>
    </DialogStep>
    <DialogStep Title="@CheckStep">
        <LineTable Caption="@CheckStep" Rows="Summary" />
    </DialogStep>
</StepDialog>

@code {
    /// <summary>Der Titel im Kopf.</summary>
    [Parameter]
    public string? Title { get; set; }

    // Die Testseite ist nur für das Team: Ihre Texte stehen hier statt in den Textdateien (SharedResources).
    private const string NameStep = "Name";
    private const string NameLabel = "Name des Vertrags";
    private const string AmountStep = "Betrag";
    private const string AmountLabel = "Betrag im Monat";
    private const string CheckStep = "Prüfen";

    private string name = "";
    private decimal? amount;

    private LineTableRow[] Summary => [new(name, amount ?? 0m)];

    private Task Finish() => CloseAsync(name);
}
