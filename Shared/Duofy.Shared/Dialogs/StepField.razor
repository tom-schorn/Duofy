@using Microsoft.Extensions.Logging
@inject IStringLocalizer<SharedResources> L
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject ILogger<StepField> Log

@* Ein Feld in einem DialogStep: Beschriftung, das Eingabefeld als Inhalt und darunter sein Fehler.
   Der Fehler hat role alert, damit Vorlese-Programme ihn sofort ansagen, und die Id "{InputId}-error";
   das Eingabefeld kann ihn mit aria-describedby verbinden. Er erscheint erst nach dem ersten Weiter
   und verschwindet, sobald das Feld in Ordnung ist. Pflicht und Fehler stehen auch am Eingabefeld selbst
   (aria-required, aria-invalid); das setzt step-field.js über die Id, weil das Feld im ChildContent steckt. *@

<div class="step-field" data-testid="@TestId">
    <FieldLabel For="@(AriaLabelled ? "" : InputId)" id="@($"{InputId}-label")" Text="@Label" />
    @ChildContent
    @if (Step.ShowErrors && Error is { } error)
    {
        <div class="step-field-error" role="alert" id="@($"{InputId}-error")">@error</div>
    }
</div>

@code {
    private IJSObjectReference? module;
    private (bool Required, bool Invalid) lastMark;

    [CascadingParameter]
    private DialogStep Step { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>
    /// Die Id des Eingabefelds; daran hängen Beschriftung und Fehler. Bei einem Feld ohne Id (RadzenNumeric) ist es nur der
    /// Name des Felds: Die Beschriftung hat die Id "{InputId}-label" und das Feld verweist mit aria-labelledby darauf.
    /// </summary>
    [Parameter, EditorRequired]
    public string InputId { get; set; } = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// True für ein Feld, das keine Id am input zulässt (RadzenNumeric): Die Beschriftung zeigt dann nicht mit for darauf,
    /// und das Feld trägt aria-labelledby="{InputId}-label" (InputAttributes).
    /// </summary>
    [Parameter]
    public bool AriaLabelled { get; set; }

    /// <summary>Pflichtfeld: Weiter geht erst, wenn <see cref="IsFilled"/> true sagt.</summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>Ob das Feld gefüllt ist; gefragt wird beim Weiter und bei jedem Zeichnen danach.</summary>
    [Parameter]
    public Func<bool>? IsFilled { get; set; }

    /// <summary>Eine weitere Regel: null, wenn alles passt, sonst der Fehlertext.</summary>
    [Parameter]
    public Func<string?>? Validate { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    /// <summary>Der aktuelle Fehler des Felds oder null.</summary>
    internal string? Error => Required && IsFilled?.Invoke() != true
        ? L["Validation_Required"]
        : Validate?.Invoke();

    protected override void OnInitialized()
    {
        if (Step is null)
        {
            throw new InvalidOperationException("StepField steht nur in einem DialogStep.");
        }
        Step.Add(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var mark = (Required, Invalid: Step.ShowErrors && Error is not null);
        if (mark == lastMark)
        {
            return;
        }
        lastMark = mark;

        try
        {
            module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Duofy.Shared/step-field.js");
            if (module is not null)
            {
                await module.InvokeVoidAsync("markField", InputId, mark.Required, mark.Invalid, $"{InputId}-error");
            }
        }
        catch (JSDisconnectedException)
        {
            Log.LogDebug("Die Verbindung zum Browser ist weg; das Feld {Field} bleibt unmarkiert.", InputId);
        }
        catch (JSException exception)
        {
            Log.LogWarning(exception, "Das Feld {Field} ließ sich nicht markieren.", InputId);
        }
    }

    public async ValueTask DisposeAsync()
    {
        Step.Remove(this);
        if (module is null)
        {
            return;
        }

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            Log.LogDebug("Die Verbindung zum Browser ist weg; das Skript von {Field} ist schon frei.", InputId);
        }
    }
}
