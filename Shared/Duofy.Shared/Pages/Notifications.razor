@page "/benachrichtigungen"
@attribute [Authorize]
@implements IDisposable
@inject AppChrome Chrome
@inject IStringLocalizer<SharedResources> L

@* Die Seite "Benachrichtigungen" (Spec 118, R1): alle Einstellungen an einem Ort, in der App und im Portal. Den Inhalt trägt
   der Baustein ReminderSettings; ohne Erinnerungen auf dem Server (selbst betrieben) bleibt die Seite leer bis auf die Erklärung. *@

<PageTitle>@L["Notify_Title"]</PageTitle>
<PageHead Title="@L["Notify_Title"]" />

<ReminderSettings />

@code {
    protected override void OnInitialized() => Chrome.Set(this, L["Notify_Title"]);

    public void Dispose() => Chrome.Release(this);
}
