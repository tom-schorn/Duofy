@page "/email-bestaetigen"
@using Radzen
@using Radzen.Blazor
@layout AuthLayout
@using Duofy.ApiClient
@using Duofy.Schemas
@inject IAuthApi AuthApi
@inject IStringLocalizer<SharedResources> L

@* Die Seite hinter dem Link, der an eine neue Adresse ging (Spec 53, R5):
   /email-bestaetigen?id=<Konto>&email=<neue Adresse>&token=<Token>. Sie zeigt die neue Adresse und übernimmt sie erst
   auf Knopfdruck. Danach meldet sich die Person mit der neuen Adresse an; die alte bekommt einen Hinweis per Mail. *@

<PageTitle>@L["EmailConfirm_Title"]</PageTitle>

<div class="auth-header">
    <RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1">@L["EmailConfirm_Title"]</RadzenText>
    @if (Complete)
    {
        <p class="auth-lead" data-testid="email-confirm-address">@L["EmailConfirm_Lead", NewEmail!]</p>
    }
</div>

<Notice Message="message" />

@if (done)
{
    <LinkButton Href="/anmelden" FullWidth="true" data-testid="email-confirm-sign-in">@L["Auth_ToSignIn"]</LinkButton>
}
else if (!Complete)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" AllowClose="false"
                 data-testid="email-confirm-incomplete">@L["Link_Incomplete"]</RadzenAlert>
}
else
{
    <RadzenButton Text="@L["EmailConfirm_Submit"]" ButtonStyle="ButtonStyle.Primary" Class="rz-w-100"
                  Disabled="busy" Click="@(_ => ConfirmAsync())" data-testid="email-confirm-submit" />
}

@code {
    [SupplyParameterFromQuery(Name = "id")]
    [Parameter]
    public string? Id { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    [Parameter]
    public string? NewEmail { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    [Parameter]
    public string? Token { get; set; }

    private bool busy;
    private bool done;
    private NoticeMessage? message;

    private bool Complete => Guid.TryParse(Id, out _) && !string.IsNullOrWhiteSpace(NewEmail) && !string.IsNullOrEmpty(Token);

    private async Task ConfirmAsync()
    {
        if (busy || !Complete) return;
        busy = true;
        try
        {
            var result = await AuthApi.ConfirmEmailChangeAsync(new ConfirmEmailChangeRequest(Guid.Parse(Id!), NewEmail!.Trim(), Token!));
            done = result.Succeeded;
            message = result.Succeeded
                ? new NoticeMessage(L["EmailConfirm_Done"], NoticeSeverity.Success)
                : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        }
        finally
        {
            busy = false;
        }
    }
}
