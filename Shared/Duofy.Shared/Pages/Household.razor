@page "/haushalt"
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@using Duofy.Shared.Dialogs
@implements IDisposable
@inject IHouseholdApi HouseholdApi
@inject ActiveMember Member
@inject IInstanceApi InstanceApi
@inject FormDialogs Forms
@inject IAppHost Host
@inject AppChrome Chrome
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L

@* Der Haushalt (Spec 67): wer zusammen plant. Ohne Haushalt bietet die Seite "Haushalt gründen" mit
   einem Namensfeld an und darunter das Feld für einen Einladungslink, den jemand geschickt hat. Mit
   Haushalt zeigt die Karte Name, Mitgliederzahl und Richtwerte, darunter stehen die Mitglieder. Nur der
   Gründer sieht Einladen, Richtwerte, die offenen Einladungen und je Mitglied Entfernen; Mitglieder sehen
   alles nur zum Lesen und können austreten. Der Gründer kann nur auflösen, solange er allein ist; solange
   andere im Haushalt sind, sieht er Austreten ausgegraut mit dem Grund darunter. Ein Knopf, den jemand nicht
   benutzen darf, fehlt oder ist so ausgegraut, statt angeboten und dann abgelehnt zu werden. Von hier geht es
   für alle zu den Freigaben (Spec 68).

   Folgenreiches (Austreten, Auflösen, Entfernen, Zurückziehen) fragt einmal nach. Nach jeder Änderung
   holt die Seite den Haushalt neu; sie rechnet nichts selbst. Ändert sich, wer im Haushalt ist (Gründen,
   Austreten, Auflösen, Entfernen), frischt sie auch den Umschalter auf (Spec 69, A12), damit er "Haushalt"
   ohne Neustart anbietet oder nicht mehr anbietet. *@

<PageTitle>@L["Household_Title"]</PageTitle>

<AppPageHeading Text="@L["Household_Title"]" />
@if (!Host.IsApp)
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-mb-2">@L["Household_Title"]</RadzenText>
}

<Notice Message="message" />

@if (loaded && household is null)
{
    @* Ab 1280 px stehen Gründen und Einladungslink nebeneinander, darunter untereinander wie bisher. *@
    <div class="household-columns page-wide">
    <RadzenCard Variant="Variant.Outlined" Class="rz-mb-4" data-testid="household-none">
        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2">@L["Household_NoneTitle"]</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" Class="rz-text-secondary-color rz-mb-2">@L["Household_NoneText"]</RadzenText>
        <FieldLabel For="household-found-name-input" Text="@L["HouseholdDialog_Name"]" />
        <RadzenTextBox @bind-Value="newName" id="household-found-name-input" MaxLength="100"
                       aria-describedby="household-found-name-hint" data-testid="household-found-name" />
        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color"
                    id="household-found-name-hint">@L["Household_FoundNameHint"]</RadzenText>
        <RadzenButton Text="@L["Household_Found"]" Icon="home" ButtonStyle="ButtonStyle.Primary" Class="rz-mt-3"
                      Disabled="busy" Click="@(_ => FoundAsync())" data-testid="household-found" />
    </RadzenCard>

    @* Ein Link, den jemand per Messenger geschickt hat: Einfügen öffnet die Seite der Einladung. *@
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="1rem" Class="household-paste-row">
        <div class="flex-grow-1">
            <FieldLabel For="household-paste-input" Text="@L["Household_PasteLabel"]" />
            <RadzenTextBox @bind-Value="pasted" id="household-paste-input" data-testid="household-paste" />
        </div>
        <RadzenButton Text="@L["Household_PasteOpen"]" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base"
                      Click="@(_ => OpenPasted())" data-testid="household-paste-open" />
    </RadzenStack>
    </div>
}

@if (household is not null)
{
    @* Ab 1280 px steht die Karte links, Mitglieder und Einladungen rechts; darunter untereinander wie bisher. *@
    <div class="household-columns page-wide">
    <div>
    <RadzenCard Variant="Variant.Outlined" Class="rz-mb-4" data-testid="household-card">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="flex-grow-1" data-testid="household-name">@household.Name</RadzenText>
            @if (IsFounder)
            {
                <RadzenButton Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                              Click="@(_ => EditAsync())" aria-label="@L["Household_Edit"]" data-testid="household-edit" />
            }
        </RadzenStack>
        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" Class="rz-text-secondary-color">
            @(household.Members.Count == 1 ? L["Household_MemberCountOne"] : L["Household_MemberCount", household.Members.Count])
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" Class="rz-mt-1" data-testid="household-quota-line">@QuotaLine</RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap" Class="rz-mt-3">
            @* Am PC gibt es die untere Leiste nicht: Von hier geht es dort zum Haushaltsplan (Spec 51, R2). *@
            <LinkButton Href="/haushaltsplan" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base"
                        data-testid="household-plan"><RadzenIcon Icon="calendar_month" /> @L["HouseholdPlan_Title"]</LinkButton>
            <LinkButton Href="/haushalt/freigaben" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base"
                        data-testid="household-grants"><RadzenIcon Icon="lock" /> @L["Household_Grants"]</LinkButton>
            @if (IsFounder && InvitationsFull)
            {
                @* Bei 10 offenen Einladungen antwortet die API too_many_invitations (A23). Ausgegraut wie Austreten:
                   aria-disabled statt disabled, damit ein Screenreader den Knopf findet und den Grund vorliest. *@
                <RadzenButton Text="@L["Household_Invite"]" Icon="person_add" ButtonStyle="ButtonStyle.Base"
                              Class="unavailable"
                              aria-disabled="true" aria-describedby="household-invite-reason"
                              data-testid="household-invite" />
            }
            else if (IsFounder)
            {
                <RadzenButton Text="@L["Household_Invite"]" Icon="person_add" ButtonStyle="ButtonStyle.Primary"
                              Click="@(_ => InviteAsync())" data-testid="household-invite" />
            }
            @if (IsFounder)
            {
                <RadzenButton Text="@L["Household_QuotasButton"]" Icon="tune" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base"
                              Click="@(_ => EditAsync())" data-testid="household-quotas" />
            }
            @if (!IsFounder)
            {
                <RadzenButton Text="@L["Household_Leave"]" Icon="logout" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                              Click="@(_ => LeaveAsync())" data-testid="household-leave" />
            }
            else if (household.Members.Count == 1)
            {
                <RadzenButton Text="@L["Household_Dissolve"]" Icon="delete_forever" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                              Click="@(_ => DissolveAsync())" data-testid="household-dissolve" />
            }
            else
            {
                @* Mit anderen im Haushalt antwortet die API founder_cannot_leave. Der Knopf ist deshalb ausgegraut
                   und tut nichts, bleibt aber erreichbar: aria-disabled statt disabled, damit ein Screenreader
                   ihn findet und den Grund darunter vorliest. *@
                <RadzenButton Text="@L["Household_Leave"]" Icon="logout" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                              Class="unavailable"
                              aria-disabled="true" aria-describedby="household-leave-reason"
                              data-testid="household-leave" />
            }
        </RadzenStack>
        @if (IsFounder && InvitationsFull)
        {
            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color rz-display-block"
                        id="household-invite-reason" data-testid="household-invite-reason">@L["Error_too_many_invitations"]</RadzenText>
        }
        @if (IsFounder && household.Members.Count > 1)
        {
            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color"
                        id="household-leave-reason" data-testid="household-leave-reason">@L["Household_FounderLeaveReason"]</RadzenText>
        }
        @if (IsFounder && hosted)
        {
            @* Spec 53, R6: Auf der gehosteten Version geht der Link auf Wunsch per Mail, aber nur an ein bestätigtes Konto. *@
            <div class="field rz-mt-3">
                <FieldLabel For="household-invite-email-input" Text="@L["Household_InviteEmail"]" />
                <RadzenTextBox @bind-Value="inviteEmail" id="household-invite-email-input" type="email"
                               Placeholder="@L["Auth_EmailPlaceholder"]" aria-describedby="household-invite-email-hint"
                               autocomplete="off" data-testid="household-invite-email" />
                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color"
                            id="household-invite-email-hint">@L["Household_InviteEmailHint"]</RadzenText>
            </div>
        }
    </RadzenCard>

    </div>
    <div>
    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-mb-2">@L["Household_MembersHeading"]</RadzenText>
    <RadzenStack Gap="0.5rem" Class="rz-mb-4 data-table members-table">
        <div class="data-table-head" aria-hidden="true">
            <span class="data-column-1">@L["Table_Name"]</span>
            <span class="data-column-2">@L["Table_Email"]</span>
            <span class="data-column-3">@L["Table_Role"]</span>
        </div>
        @foreach (var member in household.Members)
        {
            <RadzenCard Variant="Variant.Outlined" Class="data-row-frame" data-testid="@($"household-member-{member.UserId}")">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Class="data-row">
                    <RadzenStack Gap="0" Class="flex-grow-1 data-cells">
                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="data-column-1">@member.FirstName @member.LastName @(member.IsMe ? L["Household_Me"] : "")</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color data-column-2">@member.Email</RadzenText>
                    </RadzenStack>
                    <RadzenBadge BadgeStyle="@(member.Role == HouseholdRoles.Founder ? BadgeStyle.Primary : BadgeStyle.Base)" IsPill="true"
                                 Text="@L[$"HouseholdRole_{member.Role}"].Value" Class="data-column-3" />
                    @* Sich selbst entfernt man nicht (cannot_remove_self); der Gründer löst auf, wenn er allein ist. *@
                    @if (IsFounder && !member.IsMe)
                    {
                        <RadzenButton Icon="person_remove" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                      Click="@(_ => RemoveAsync(member))" Class="data-column-4"
                                      aria-label="@L["Household_RemoveMember", member.FirstName]"
                                      data-testid="@($"household-member-remove-{member.UserId}")" />
                    }
                </RadzenStack>
            </RadzenCard>
        }
    </RadzenStack>

    @if (IsFounder && invitations.Count > 0)
    {
        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-mb-2">@L["Household_InvitationsHeading"]</RadzenText>
        <RadzenStack Gap="0.5rem" Class="rz-mb-4">
            @foreach (var invitation in invitations)
            {
                <RadzenCard Variant="Variant.Outlined" data-testid="@($"household-invitation-{invitation.Id}")">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="flex-grow-1">@L["Household_InvitationUntil", Day(invitation.ExpiresAt)]</RadzenText>
                        <RadzenButton Text="@L["Household_Revoke"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                      Click="@(_ => RevokeAsync(invitation))"
                                      data-testid="@($"household-invitation-revoke-{invitation.Id}")" />
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    }
    </div>
    </div>
}

@code {
    private static readonly CultureInfo German = new("de-DE");

    private HouseholdResponse? household;
    private bool loaded;
    private List<InvitationResponse> invitations = [];
    private string pasted = "";
    private string newName = "";
    private bool busy;
    private NoticeMessage? message;

    // Spec 53: Nur die gehostete Version verschickt Einladungen auch per Mail.
    private bool hosted;
    private string inviteEmail = "";

    // Wie HouseholdRules.MaxOpenInvitations in der API; die Seite kennt die Domäne nicht.
    private const int MaxOpenInvitations = 10;

    private bool IsFounder => household?.Members.Any(m => m.IsMe && m.Role == HouseholdRoles.Founder) == true;

    private bool InvitationsFull => invitations.Count >= MaxOpenInvitations;

    private string QuotaLine => household is null ? "" : string.Join(" · ",
        L["Household_QuotaPart", L[$"Pot_{PotKeys.Needs}"], household.QuotaNeeds],
        L["Household_QuotaPart", L[$"Pot_{PotKeys.Wants}"], household.QuotaWants],
        L["Household_QuotaPart", L[$"Pot_{PotKeys.Savings}"], household.QuotaSavings]);

    protected override async Task OnInitializedAsync()
    {
        Chrome.Set(this, L["Household_Title"]);
        var instance = await InstanceApi.GetAsync();
        hosted = instance.Succeeded && instance.Value!.Hosted;
        await LoadAsync();
    }

    public void Dispose() => Chrome.Release(this);

    private async Task LoadAsync()
    {
        var result = await HouseholdApi.GetMineAsync();
        invitations = [];
        if (!result.Succeeded)
        {
            household = null;
            // Ohne Haushalt antwortet die API 404 (no_household); das ist kein Fehler, sondern das Angebot zu gründen.
            loaded = result.ErrorCode == ClientErrorCodes.NotFound;
            if (!loaded)
            {
                message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
            }
            return;
        }
        household = result.Value!;
        loaded = true;

        // Die offenen Einladungen sieht nur der Gründer; für alle anderen fragt die Seite gar nicht erst.
        if (IsFounder)
        {
            var open = await HouseholdApi.ListInvitationsAsync(household.Id);
            if (open.Succeeded)
            {
                invitations = open.Value!.ToList();
            }
            else
            {
                message = new NoticeMessage(ErrorTexts.For(L, open.ErrorCode), NoticeSeverity.Error);
            }
        }
    }

    // Ein leeres Feld schickt keinen Namen; die API nennt den Haushalt dann "Haushalt von Vorname".
    private async Task FoundAsync()
    {
        busy = true;
        try
        {
            var result = await HouseholdApi.CreateAsync(string.IsNullOrWhiteSpace(newName) ? null : newName.Trim());
            if (!result.Succeeded)
            {
                message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
                return;
            }
            newName = "";
            message = new NoticeMessage(L["Household_Founded"], NoticeSeverity.Success);
            await Member.RefreshAsync();
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private string Day(DateTimeOffset moment) => moment.ToLocalTime().ToString("dd.MM.yyyy", German);

    private async Task InviteAsync()
    {
        // Den Link baut die API mit der öffentlichen Adresse des Servers, nicht die Seite mit der Adresse,
        // über die sie gerade verbunden ist. Ohne diese Adresse antwortet die API public_url_missing.
        var address = hosted && !string.IsNullOrWhiteSpace(inviteEmail) ? inviteEmail.Trim() : null;
        var created = await HouseholdApi.CreateInvitationAsync(household!.Id, address);
        if (!created.Succeeded || created.Value!.Url is not { } link)
        {
            message = new NoticeMessage(ErrorTexts.For(L, created.Succeeded ? ErrorCodes.PublicUrlMissing : created.ErrorCode), NoticeSeverity.Error);
            return;
        }

        var parameters = new FormParameters<InviteDialog>()
            .Add(x => x.Link, link)
            .Add(x => x.ExpiresAt, created.Value!.ExpiresAt)
            .Add(x => x.HouseholdName, household.Name)
            .Add(x => x.Mailed, address is not null);
        inviteEmail = "";
        await Forms.OpenWindowAsync<InviteDialog, bool>(L["InviteDialog_Title"], parameters);
        await LoadAsync();
    }

    private async Task RevokeAsync(InvitationResponse invitation)
    {
        if (!await ConfirmAsync(L["Household_RevokeTitle"], L["Household_RevokeText"], L["Household_Revoke"]))
        {
            return;
        }
        var result = await HouseholdApi.RevokeInvitationAsync(household!.Id, invitation.Id);
        message = result.Succeeded
            ? new NoticeMessage(L["Household_Revoked"], NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await LoadAsync();
    }

    private void OpenPasted()
    {
        if (InvitationLink.TokenOf(pasted) is { } token)
        {
            Navigation.NavigateTo($"/einladung/{token}");
            return;
        }
        message = new NoticeMessage(L["Household_PasteInvalid"], NoticeSeverity.Warning);
    }

    // Folgenreiches fragt einmal nach; erst die Bestätigung führt es aus.
    private async Task<bool> ConfirmAsync(string title, string text, string yes) =>
        await Forms.ConfirmAsync(text, title, yes, L["Household_Cancel"]);

    private async Task EditAsync()
    {
        var title = L["HouseholdDialog_Title"];
        var parameters = new FormParameters<HouseholdDialog>().Add(x => x.Title, title).Add(x => x.Household, household!);
        var outcome = await Forms.OpenStepAsync<HouseholdDialog, bool>(title, parameters);
        if (outcome.Saved)
        {
            message = new NoticeMessage(L["Household_Saved"], NoticeSeverity.Success);
            await LoadAsync();
        }
    }

    private async Task LeaveAsync()
    {
        if (!await ConfirmAsync(L["Household_LeaveTitle"], L["Household_LeaveText"], L["Household_Leave"]))
        {
            return;
        }
        var result = await HouseholdApi.LeaveAsync(household!.Id);
        message = result.Succeeded
            ? new NoticeMessage(L["Household_Left"], NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await RefreshSwitchAsync(result);
        await LoadAsync();
    }

    // Der Gründer allein tritt aus; die API löst den Haushalt dann mit seinen Einladungen auf.
    private async Task DissolveAsync()
    {
        if (!await ConfirmAsync(L["Household_DissolveTitle"], L["Household_DissolveText"], L["Household_Dissolve"]))
        {
            return;
        }
        var result = await HouseholdApi.LeaveAsync(household!.Id);
        message = result.Succeeded
            ? new NoticeMessage(L["Household_Dissolved"], NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await RefreshSwitchAsync(result);
        await LoadAsync();
    }

    private async Task RemoveAsync(MemberResponse member)
    {
        if (!await ConfirmAsync(L["Household_RemoveTitle", member.FirstName], L["Household_RemoveText", member.FirstName], L["Household_RemoveConfirm"]))
        {
            return;
        }
        var result = await HouseholdApi.RemoveMemberAsync(household!.Id, member.UserId);
        message = result.Succeeded
            ? new NoticeMessage(L["Household_Removed", member.FirstName], NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await RefreshSwitchAsync(result);
        await LoadAsync();
    }

    // Nur eine gelungene Änderung der Mitglieder ändert, was der Umschalter anbietet.
    private async Task RefreshSwitchAsync(ApiResult result)
    {
        if (result.Succeeded)
        {
            await Member.RefreshAsync();
        }
    }
}
