@page "/haushalt"
@using BlazorBlueprint.Components
@using BlazorBlueprint.Icons.Lucide.Components
@attribute [Authorize]
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@using Duofy.Shared.Dialogs
@implements IDisposable
@inject IHouseholdApi HouseholdApi
@inject ActiveMember Member
@inject IInstanceApi InstanceApi
@inject FormDialogs Forms
@inject AppChrome Chrome
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L

@* Der Haushalt (Spec 67): wer zusammen plant. Ohne Haushalt bietet die Seite "Haushalt gründen" mit
   einem Namensfeld an und darunter das Feld für einen Einladungslink, den jemand geschickt hat. Mit
   Haushalt ist das der Reiter "Mitglieder" des Haushaltsbereichs (Spec 82, R11): Kopf mit dem Namen des Haushalts,
   Mitgliederzahl, Einladen und Austreten, darunter die Mitglieder; die Richtwerte haben einen eigenen Reiter. Nur der
   Gründer sieht Bearbeiten, Einladen, die offenen Einladungen und je Mitglied Entfernen; Mitglieder sehen
   alles nur zum Lesen und können austreten. Der Gründer kann nur auflösen, solange er allein ist; solange
   andere im Haushalt sind, sieht er Austreten ausgegraut mit dem Grund darunter. Ein Knopf, den jemand nicht
   benutzen darf, fehlt oder ist so ausgegraut, statt angeboten und dann abgelehnt zu werden.

   Folgenreiches (Austreten, Auflösen, Entfernen, Zurückziehen) fragt einmal nach. Nach jeder Änderung
   holt die Seite den Haushalt neu; sie rechnet nichts selbst. Ändert sich, wer im Haushalt ist (Gründen,
   Austreten, Auflösen, Entfernen), frischt sie auch den Umschalter auf (Spec 69, A12), damit er "Haushalt"
   ohne Neustart anbietet oder nicht mehr anbietet. *@

<PageTitle>@(household?.Name ?? L["Nav_OurHousehold"])</PageTitle>
@if (household is null)
{
    <PageHead Title="@L["Nav_OurHousehold"]" Lead="@L["Household_Lead"]" />
}
else
{
    <HouseholdHead Current="@HouseholdHead.Members" Name="@household.Name">
        <Actions>
            @if (IsFounder)
            {
                <DuofyButton Kind="ButtonKind.Secondary" Icon="pencil" Text="@L["Household_Edit"]" OnClick="@(_ => EditAsync())" TestId="household-edit" />
            }
        </Actions>
    </HouseholdHead>
}


<Notice Message="message" />

@if (loaded && household is null)
{
    @* Ab 1280 px stehen Gründen und Einladungslink nebeneinander, darunter untereinander wie bisher. *@
    <div class="stack">
    <div class="card mb-4" data-testid="household-none">
        <h2 class="section-title">@L["Household_NoneTitle"]</h2>
        <p class="muted mb-2">@L["Household_NoneText"]</p>
        <FieldLabel For="household-found-name-input" Text="@L["HouseholdDialog_Name"]" />
        <TextInput id="household-found-name-input" maxlength="@(100)" @bind-Value="newName" aria-describedby="household-found-name-hint" data-testid="household-found-name" />
        <p class="small muted" id="household-found-name-hint">@L["Household_FoundNameHint"]</p>
        <DuofyButton Icon="house" Text="@L["Household_Found"]" OnClick="@(_ => FoundAsync())" TestId="household-found" Class="mt-3" Disabled="busy" />
    </div>

    @* Ein Link, den jemand per Messenger geschickt hat: Einfügen öffnet die Seite der Einladung. *@
    <div class="row household-paste-row">
        <div class="flex-grow-1">
            <FieldLabel For="household-paste-input" Text="@L["Household_PasteLabel"]" />
            <TextInput id="household-paste-input" @bind-Value="pasted" data-testid="household-paste" />
        </div>
        <DuofyButton Kind="ButtonKind.Secondary" Text="@L["Household_PasteOpen"]" OnClick="@(_ => OpenPasted())" TestId="household-paste-open" />
    </div>
    </div>
}

@if (household is not null)
{
    @* Ab 1280 px steht die Karte links, Mitglieder und Einladungen rechts; darunter untereinander wie bisher. *@
    <div class="stack">
    <div>
    <div class="card mb-4" data-testid="household-card">
        <p class="muted" data-testid="household-member-count">
            @(household.Members.Count == 1 ? L["Household_MemberCountOne"] : L["Household_MemberCount", household.Members.Count])
        </p>
        <div class="row mt-3">
            @if (IsFounder && InvitationsFull)
            {
                @* Bei 10 offenen Einladungen antwortet die API too_many_invitations (A23). Ausgegraut wie Austreten:
                   aria-disabled statt disabled, damit ein Screenreader den Knopf findet und den Grund vorliest. *@
                <DuofyButton Kind="ButtonKind.Secondary" Icon="user-plus" Text="@L["Household_Invite"]" TestId="household-invite" Class="unavailable" aria-disabled="true" aria-describedby="household-invite-reason" />
            }
            else if (IsFounder)
            {
                <DuofyButton Icon="user-plus" Text="@L["Household_Invite"]" OnClick="@(_ => InviteAsync())" TestId="household-invite" />
            }
            @if (!IsFounder)
            {
                <DuofyButton Kind="ButtonKind.Ghost" Icon="log-out" Text="@L["Household_Leave"]" OnClick="@(_ => LeaveAsync())" TestId="household-leave" />
            }
            else if (household.Members.Count == 1)
            {
                <DuofyButton Kind="ButtonKind.Ghost" Icon="trash-2" Text="@L["Household_Dissolve"]" OnClick="@(_ => DissolveAsync())" TestId="household-dissolve" />
            }
            else
            {
                @* Mit anderen im Haushalt antwortet die API founder_cannot_leave. Der Knopf ist deshalb ausgegraut
                   und tut nichts, bleibt aber erreichbar: aria-disabled statt disabled, damit ein Screenreader
                   ihn findet und den Grund darunter vorliest. *@
                <DuofyButton Kind="ButtonKind.Ghost" Icon="log-out" Text="@L["Household_Leave"]" TestId="household-leave" Class="unavailable" aria-disabled="true" aria-describedby="household-leave-reason" />
            }
        </div>
        @if (IsFounder && InvitationsFull)
        {
            <p class="small muted" id="household-invite-reason" data-testid="household-invite-reason">@L["Error_too_many_invitations"]</p>
        }
        @if (IsFounder && household.Members.Count > 1)
        {
            <p class="small muted" id="household-leave-reason" data-testid="household-leave-reason">@L["Household_FounderLeaveReason"]</p>
        }
        @if (IsFounder && hosted)
        {
            @* Spec 53, R6: Auf der gehosteten Version geht der Link auf Wunsch per Mail, aber nur an ein bestätigtes Konto. *@
            <div class="field mt-3">
                <FieldLabel For="household-invite-email-input" Text="@L["Household_InviteEmail"]" />
                <TextInput id="household-invite-email-input" Type="email" placeholder="@L["Auth_EmailPlaceholder"]" @bind-Value="inviteEmail" aria-describedby="household-invite-email-hint" autocomplete="off" data-testid="household-invite-email" />
                <p class="small muted" id="household-invite-email-hint">@L["Household_InviteEmailHint"]</p>
            </div>
        }
    </div>

    </div>
    <div>
    <h2 class="visually-hidden">@L["Household_MembersHeading"]</h2>
    <div class="card data-table members-table mb-4">
        @foreach (var member in household.Members)
        {
            <div class="data-row-frame" data-testid="@($"household-member-{member.UserId}")">
                <div class="data-row">
                    <span class="avatar" aria-hidden="true">@($"{member.FirstName.FirstOrDefault()}{member.LastName.FirstOrDefault()}")</span>
                    <div class="data-cells">
                        <p class="data-title">@member.FirstName @member.LastName @(member.IsMe ? L["Household_Me"] : "")</p>
                        <p class="small muted wrap-anywhere">@member.Email</p>
                    </div>
                    <span class="pill">@L[$"HouseholdRole_{member.Role}"]</span>
                    @* Sich selbst entfernt man nicht (cannot_remove_self); der Gründer löst auf, wenn er allein ist. *@
                    @if (IsFounder && !member.IsMe)
                    {
                        <DuofyButton Kind="ButtonKind.Ghost" Icon="user-minus" IconOnly="true" Small="true" OnClick="@(_ => RemoveAsync(member))" AriaLabel="@L["Household_RemoveMember", member.FirstName]" TestId="@($"household-member-remove-{member.UserId}")" />
                    }
                </div>
            </div>
        }
    </div>

    @if (IsFounder && invitations.Count > 0)
    {
        <h2 class="section-title mb-2">@L["Household_InvitationsHeading"]</h2>
        <div class="stack mb-4">
            @foreach (var invitation in invitations)
            {
                <div class="card" data-testid="@($"household-invitation-{invitation.Id}")">
                    <div class="row">
                        <p class="flex-grow-1">@L["Household_InvitationUntil", Day(invitation.ExpiresAt)]</p>
                        <DuofyButton Kind="ButtonKind.Ghost" Text="@L["Household_Revoke"]" Small="true" OnClick="@(_ => RevokeAsync(invitation))" TestId="@($"household-invitation-revoke-{invitation.Id}")" />
                    </div>
                </div>
            }
        </div>
    }
    </div>
    </div>
}

@code {
    private static readonly CultureInfo German = new("de-DE");

    private HouseholdResponse? household;
    private bool loaded;
    private List<InvitationResponse> invitations = [];
    private string pasted = "";
    private string newName = "";
    private bool busy;
    private NoticeMessage? message;

    // Spec 53: Nur die gehostete Version verschickt Einladungen auch per Mail.
    private bool hosted;
    private string inviteEmail = "";

    // Wie HouseholdRules.MaxOpenInvitations in der API; die Seite kennt die Domäne nicht.
    private const int MaxOpenInvitations = 10;

    private bool IsFounder => household?.Members.Any(m => m.IsMe && m.Role == HouseholdRoles.Founder) == true;

    private bool InvitationsFull => invitations.Count >= MaxOpenInvitations;

    protected override async Task OnInitializedAsync()
    {
        Chrome.Set(this, L["Household_Title"]);
        var instance = await InstanceApi.GetAsync();
        hosted = instance.Succeeded && instance.Value!.Hosted;
        await LoadAsync();
    }

    public void Dispose() => Chrome.Release(this);

    private async Task LoadAsync()
    {
        var result = await HouseholdApi.GetMineAsync();
        invitations = [];
        if (!result.Succeeded)
        {
            household = null;
            // Ohne Haushalt antwortet die API 404 (no_household); das ist kein Fehler, sondern das Angebot zu gründen.
            loaded = result.ErrorCode == ClientErrorCodes.NotFound;
            if (!loaded)
            {
                message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
            }
            return;
        }
        household = result.Value!;
        loaded = true;

        // Die offenen Einladungen sieht nur der Gründer; für alle anderen fragt die Seite gar nicht erst.
        if (IsFounder)
        {
            var open = await HouseholdApi.ListInvitationsAsync(household.Id);
            if (open.Succeeded)
            {
                invitations = open.Value!.ToList();
            }
            else
            {
                message = new NoticeMessage(ErrorTexts.For(L, open.ErrorCode), NoticeSeverity.Error);
            }
        }
    }

    // Ein leeres Feld schickt keinen Namen; die API nennt den Haushalt dann "Haushalt von Vorname".
    private async Task FoundAsync()
    {
        busy = true;
        try
        {
            var result = await HouseholdApi.CreateAsync(string.IsNullOrWhiteSpace(newName) ? null : newName.Trim());
            if (!result.Succeeded)
            {
                message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
                return;
            }
            newName = "";
            message = new NoticeMessage(L["Household_Founded"], NoticeSeverity.Success);
            await Member.RefreshAsync();
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private string Day(DateTimeOffset moment) => moment.ToLocalTime().ToString("dd.MM.yyyy", German);

    private async Task InviteAsync()
    {
        // Den Link baut die API mit der öffentlichen Adresse des Servers, nicht die Seite mit der Adresse,
        // über die sie gerade verbunden ist. Ohne diese Adresse antwortet die API public_url_missing.
        var address = hosted && !string.IsNullOrWhiteSpace(inviteEmail) ? inviteEmail.Trim() : null;
        var created = await HouseholdApi.CreateInvitationAsync(household!.Id, address);
        if (!created.Succeeded || created.Value!.Url is not { } link)
        {
            message = new NoticeMessage(ErrorTexts.For(L, created.Succeeded ? ErrorCodes.PublicUrlMissing : created.ErrorCode), NoticeSeverity.Error);
            return;
        }

        var parameters = new FormParameters<InviteDialog>()
            .Add(x => x.Link, link)
            .Add(x => x.ExpiresAt, created.Value!.ExpiresAt)
            .Add(x => x.HouseholdName, household.Name)
            .Add(x => x.Mailed, address is not null);
        inviteEmail = "";
        await Forms.OpenAsync<InviteDialog, bool>(L["InviteDialog_Title"], parameters);
        await LoadAsync();
    }

    private async Task RevokeAsync(InvitationResponse invitation)
    {
        if (!await ConfirmAsync(L["Household_RevokeTitle"], L["Household_RevokeText"], L["Household_Revoke"]))
        {
            return;
        }
        var result = await HouseholdApi.RevokeInvitationAsync(household!.Id, invitation.Id);
        message = result.Succeeded
            ? new NoticeMessage(L["Household_Revoked"], NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await LoadAsync();
    }

    private void OpenPasted()
    {
        if (InvitationLink.TokenOf(pasted) is { } token)
        {
            Navigation.NavigateTo($"/einladung/{token}");
            return;
        }
        message = new NoticeMessage(L["Household_PasteInvalid"], NoticeSeverity.Warning);
    }

    // Folgenreiches fragt einmal nach; erst die Bestätigung führt es aus.
    private async Task<bool> ConfirmAsync(string title, string text, string yes) =>
        await Forms.ConfirmAsync(text, title, yes, L["Household_Cancel"]);

    private async Task EditAsync()
    {
        var title = L["HouseholdDialog_Title"];
        var parameters = new FormParameters<HouseholdDialog>().Add(x => x.Title, title).Add(x => x.Household, household!);
        var outcome = await Forms.OpenStepAsync<HouseholdDialog, bool>(title, parameters);
        if (outcome.Saved)
        {
            message = new NoticeMessage(L["Household_Saved"], NoticeSeverity.Success);
            await LoadAsync();
        }
    }

    private async Task LeaveAsync()
    {
        if (!await ConfirmAsync(L["Household_LeaveTitle"], L["Household_LeaveText"], L["Household_Leave"]))
        {
            return;
        }
        var result = await HouseholdApi.LeaveAsync(household!.Id);
        message = result.Succeeded
            ? new NoticeMessage(L["Household_Left"], NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await RefreshSwitchAsync(result);
        await LoadAsync();
    }

    // Der Gründer allein tritt aus; die API löst den Haushalt dann mit seinen Einladungen auf.
    private async Task DissolveAsync()
    {
        if (!await ConfirmAsync(L["Household_DissolveTitle"], L["Household_DissolveText"], L["Household_Dissolve"]))
        {
            return;
        }
        var result = await HouseholdApi.LeaveAsync(household!.Id);
        message = result.Succeeded
            ? new NoticeMessage(L["Household_Dissolved"], NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await RefreshSwitchAsync(result);
        await LoadAsync();
    }

    private async Task RemoveAsync(MemberResponse member)
    {
        if (!await ConfirmAsync(L["Household_RemoveTitle", member.FirstName], L["Household_RemoveText", member.FirstName], L["Household_RemoveConfirm"]))
        {
            return;
        }
        var result = await HouseholdApi.RemoveMemberAsync(household!.Id, member.UserId);
        message = result.Succeeded
            ? new NoticeMessage(L["Household_Removed", member.FirstName], NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await RefreshSwitchAsync(result);
        await LoadAsync();
    }

    // Nur eine gelungene Änderung der Mitglieder ändert, was der Umschalter anbietet.
    private async Task RefreshSwitchAsync(ApiResult result)
    {
        if (result.Succeeded)
        {
            await Member.RefreshAsync();
        }
    }
}
