@* "Jetzt verfügbar" (Spec 139): die Kontostände von heute ohne Sparkonten minus die offenen Ausgaben bis Monatsende, mit der
   Aufschlüsselung darunter. Eine Komponente für Startseite, Monatsplan und Haushaltsmonat; ohne Wert (anderer Monat, keine
   Freigabe) steht nichts da. Im Haushalt nennt der Zusatz, wer nicht eingerechnet ist. *@
@inject IStringLocalizer<SharedResources> L
@if (Value is not null)
{
    <div data-testid="month-block-available-now">
        <Metric Title="@L["Month_AvailableNow"]" Amount="Value.Value" Over="Value.Value < 0m" Note="@Note" />
    </div>
}

@code {
    [Parameter] public AvailableNowResponse? Value { get; set; }

    private string Note
    {
        get
        {
            var note = L["Month_AvailableNowBreakdown", MoneyText.Format(Value!.Balances), MoneyText.Format(Value.OpenExpenses)].Value;
            return Value.Missing is { Count: > 0 } missing
                ? $"{note} {L["Month_AvailableNowMissing", string.Join(", ", missing)].Value}"
                : note;
        }
    }
}
