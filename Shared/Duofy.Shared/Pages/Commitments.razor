@page "/vertraege"
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@using Duofy.Shared.Dialogs
@inject ICommitmentApi CommitmentApi
@inject ISavingsGoalApi GoalApi
@inject IDebtApi DebtApi
@inject ICategoryApi CategoryApi
@inject IAccountChoices AccountChoices
@implements IDisposable
@inject FormDialogs Forms
@inject IAppHost Host
@inject AppChrome Chrome
@inject ActiveMember Member
@inject TimeProvider Time
@inject IStringLocalizer<SharedResources> L

@* Die Vertragsseite: alle laufenden Verträge mit Art, Betrag, Abstand und nächster Zahlung,
   sortiert nach der nächsten Zahlung. Beendete Verträge kommen mit dem Schalter dazu.

   Die Seite rechnet keine Fälligkeiten selbst. Die nächste Zahlung und ob ein Vertrag noch läuft,
   schickt die API mit; nach jeder Änderung holt die Seite die Liste neu.

   Mit dem Umschalter zeigt die Seite die Verträge eines anderen Mitglieds (Spec 68); Beenden zählt als Löschen.

   Sparziele und Schulden stehen weiter in der Liste, lassen sich hier aber nicht mehr ändern (Spec 17, R4):
   Der Vertragsdialog bietet nur Ausgabe und Einnahme an, für sie kommt ein eigener Bereich. *@

<PageTitle>@L["Commitments_Title"]</PageTitle>

@* In der App steht der Titel in der oberen Leiste und das Plus im Layout (AppChrome). *@
<AppPageHeading Text="@L["Commitments_Title"]" />
@if (!Host.IsApp)
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mb-2">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@L["Commitments_Title"]</RadzenText>
        @if (Sees)
        {
            <RadzenButton Text="@L["Commitments_Add"]" Icon="add" ButtonStyle="ButtonStyle.Primary"
                          Click="@(_ => AddAsync())" Class="@GrantLock.Class(CanAdd)" @attributes="GrantLock.Attributes(CanAdd)"
                          data-testid="commitments-add" />
        }
    </RadzenStack>
}

<Notice Message="message" />

@if (!Sees)
{
    <NotShared />
}
else
{
<GrantReason Show="@(!(CanAdd && CanEdit && CanEnd))" />

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
    <RadzenSwitch @bind-Value="showEnded" Name="commitments-show-ended" data-testid="commitments-show-ended" />
    <RadzenLabel Component="commitments-show-ended" Text="@L["Commitments_ShowEnded"]" />
</RadzenStack>

@if (loaded && all.Count == 0)
{
    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-text-secondary-color rz-mb-2">@L["Commitments_Empty"]</RadzenText>
}
else if (loaded && !Shown.Any())
{
    @* Es gibt nur beendete Verträge und der Schalter ist aus: sonst sähe die Seite leer aus. *@
    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-text-secondary-color rz-mb-2"
                data-testid="commitments-ended-hidden">@L["Commitments_EndedHidden"]</RadzenText>
}

@* Ab 1280 px eine Tabelle mit Spalten (siehe .data-table in app.css), darunter Karten wie bisher. *@
<RadzenStack Gap="0.5rem" Class="rz-mt-2 data-table commitments-table page-wide">
    @if (Shown.Any())
    {
        <div class="data-table-head" aria-hidden="true">
            <span class="data-column-1">@L["Table_Name"]</span>
            <span class="data-column-2">@L["Table_Type"]</span>
            <span class="data-column-3">@L["Table_Interval"]</span>
            <span class="data-column-4">@L["Table_NextDue"]</span>
            <span class="data-column-5 data-amount">@L["Table_Amount"]</span>
        </div>
    }
    @foreach (var commitment in Shown)
    {
        <RadzenCard Variant="Variant.Outlined" Class="data-row-frame" data-testid="@($"commitment-{commitment.Id}")">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Class="data-row">
                <RadzenStack Gap="0" Class="flex-grow-1 data-cells">
                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="@($"data-column-1{(commitment.Running ? "" : " rz-text-secondary-color")}")">@commitment.Name</RadzenText>
                    @* Liest sich wie eine Zeile; ab 1280 px sind die Teile Spalten und die Punkte dazwischen ausgeblendet. *@
                    <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color data-cells"><span class="data-column-2">@L[$"CommitmentType_{commitment.Type}"]</span><span class="data-separator"> · </span><span class="data-column-3">@IntervalTexts.For(L, commitment.IntervalMonths)</span>@if (!commitment.Running)
                        {<span class="data-separator"> · </span><span class="data-column-4">@L["Commitments_EndedOnly"]</span>}
                        else if (commitment.NextDueDate is { } next)
                        {<span class="data-separator"> · </span><span class="data-column-4"><span class="data-separator">@($"{L["Commitments_NextDueLabel"]} ")</span>@next.ToString("dd.MM.yyyy", German)</span>}</RadzenText>
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" Class="@($"data-column-5 data-amount{(commitment.Running ? "" : " rz-text-secondary-color")}")">@Money(commitment.Amount)</RadzenText>
                @if (CommitmentDraft.OfferedTypes.Contains(commitment.Type))
                {
                    <RadzenButton Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                  Click="@(_ => EditAsync(commitment))"
                                  Class="@($"data-column-6 {GrantLock.Class(CanEdit)}")" @attributes="GrantLock.Attributes(CanEdit)"
                                  aria-label="@L["Commitments_Edit", commitment.Name]" data-testid="@($"commitment-edit-{commitment.Id}")" />
                }
                @if (commitment.Running)
                {
                    <RadzenButton Text="@L["Commitments_End"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                  Click="@(_ => EndAsync(commitment))"
                                  Class="@($"data-column-7 {GrantLock.Class(CanEnd)}")" @attributes="GrantLock.Attributes(CanEnd)"
                                  aria-label="@L["Commitments_EndFor", commitment.Name]" data-testid="@($"commitment-end-{commitment.Id}")" />
                }
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>
}

@code {

    // Deutsche Schreibweise für Beträge (1.234,50) und Daten (01.11.2026), auch wenn das Gerät anders eingestellt ist.
    private static readonly CultureInfo German = new("de-DE");

    private List<CommitmentResponse> all = [];
    private List<CategoryResponse> categories = [];
    private IReadOnlyList<AccountChoice> accounts = [];
    private bool showEnded;
    private bool loaded;
    private NoticeMessage? message;

    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

    // Die API liefert schon in der richtigen Reihenfolge; der Schalter blendet nur aus oder ein.
    private IEnumerable<CommitmentResponse> Shown => all.Where(c => showEnded || c.Running);

    // Was die Freigabe des gewählten Mitglieds erlaubt (Spec 68); bei "Ich" alles.
    private bool Sees => Member.Allows(GrantAreas.Commitments, AccessLevelKeys.View);
    private bool CanAdd => Member.Allows(GrantAreas.Commitments, AccessLevelKeys.Create);
    private bool CanEdit => Member.Allows(GrantAreas.Commitments, AccessLevelKeys.Edit);
    private bool CanEnd => Member.Allows(GrantAreas.Commitments, AccessLevelKeys.Delete);

    protected override async Task OnInitializedAsync()
    {
        Chrome.Set(this, L["Commitments_Title"], AddAsync, L["Commitments_Add"]);
        // Erst nach dem ersten Laden zuhören: Das Laden selbst meldet sich auch als Änderung.
        await Member.LoadAsync();
        Member.Changed += OnMemberChanged;
        await LoadAllAsync();
    }

    public void Dispose()
    {
        Member.Changed -= OnMemberChanged;
        Chrome.Release(this);
    }

    private void OnMemberChanged() => _ = InvokeAsync(async () =>
    {
        message = null;
        await LoadAllAsync();
        StateHasChanged();
    });

    /// <summary>Kategorien, Konten und Verträge der gewählten Person; was sie nicht teilt, bleibt leer.</summary>
    private async Task LoadAllAsync()
    {
        Chrome.LockPlus(this, Sees && !CanAdd ? GrantLock.ReasonId : null);
        all = [];
        loaded = false;
        if (!Sees)
        {
            return;
        }

        // Kategorien und Konten braucht der Dialog; die Seite holt sie einmal mit.
        var categoryResult = await CategoryApi.ListAsync(Member.Owner);
        categories = categoryResult.Succeeded ? categoryResult.Value!.ToList() : [];
        var accountResult = Member.Allows(GrantAreas.Accounts, AccessLevelKeys.View)
            ? await AccountChoices.ListAsync(Member.Owner)
            : ApiResult<IReadOnlyList<AccountChoice>>.Success([]);
        accounts = accountResult.Succeeded ? accountResult.Value! : [];
        if (!categoryResult.Succeeded || !accountResult.Succeeded)
        {
            message = new NoticeMessage(ErrorTexts.For(L, categoryResult.ErrorCode ?? accountResult.ErrorCode), NoticeSeverity.Error);
        }
        await LoadAsync();
    }

    // Alle Verträge holen, laufende und beendete. Ein- und ausgeblendet wird ohne neue Anfrage.
    private async Task LoadAsync()
    {
        var result = await CommitmentApi.ListAsync(includeEnded: true, Member.Owner);
        if (result.Succeeded)
        {
            all = result.Value!.ToList();
        }
        else
        {
            message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        }
        loaded = true;
    }

    private async Task AddAsync()
    {
        if (CanAdd)
        {
            await ShowDialogAsync(existing: null, L["CommitmentDialog_TitleNew"]);
        }
    }

    private async Task EditAsync(CommitmentResponse commitment)
    {
        if (CanEdit)
        {
            await ShowDialogAsync(commitment, L["CommitmentDialog_TitleEdit"]);
        }
    }

    // Die Sparziele für die Wahl im Dialog (Issue 32); ohne Freigabe im Bereich Sparen oder bei einem Fehler gibt es keine zur Wahl.
    private async Task<IReadOnlyList<SavingsGoalResponse>> LoadGoalsAsync()
    {
        if (!Member.Allows(GrantAreas.Savings, AccessLevelKeys.View))
        {
            return [];
        }
        var result = await GoalApi.ListAsync(Member.Owner);
        return result.Succeeded ? result.Value! : [];
    }

    // Die Schulden für die Wahl im Dialog (Issue 31): die noch offenen und die schon gewählte; ohne Freigabe im Bereich Sparen keine.
    private async Task<IReadOnlyList<DebtResponse>> LoadDebtsAsync(Guid? stored)
    {
        if (!Member.Allows(GrantAreas.Savings, AccessLevelKeys.View))
        {
            return [];
        }
        var result = await DebtApi.ListAsync(Member.Owner);
        return result.Succeeded ? result.Value!.Where(d => !d.Settled || d.Id == stored).ToList() : [];
    }

    private async Task ShowDialogAsync(CommitmentResponse? existing, string title)
    {
        var parameters = new FormParameters<CommitmentDialog>()
            .Add(x => x.Title, title)
            .Add(x => x.Existing, existing)
            .Add(x => x.Categories, categories)
            .Add(x => x.Accounts, accounts)
            .Add(x => x.SavingsGoals, await LoadGoalsAsync())
            .Add(x => x.Debts, await LoadDebtsAsync(existing?.DebtId))
            .Add(x => x.Today, Today);

        // Der Dialog hat Schritte (Spec 17); er geht wie jeder Schritt-Dialog auf und füllt in der App den Bildschirm.
        var outcome = await Forms.OpenStepAsync<CommitmentDialog, bool>(title, parameters);

        if (outcome.Saved)
        {
            message = new NoticeMessage(L["Commitments_Saved"], NoticeSeverity.Success);
            await LoadAsync();
        }
    }

    // Beenden setzt die letzte Zahlung auf die letzte bis heute; der Vertrag verschwindet dann aus den laufenden.
    private async Task EndAsync(CommitmentResponse commitment)
    {
        if (!CanEnd)
        {
            return;
        }
        // Beenden fragt einmal nach (A16); Abbrechen lässt den Vertrag laufen.
        var confirmed = await Forms.ConfirmAsync(L["Commitments_EndText", commitment.Name], L["Commitments_EndTitle"],
            L["Commitments_EndConfirm"], L["Commitments_EndCancel"]);
        if (!confirmed)
        {
            return;
        }

        var result = await CommitmentApi.EndAsync(commitment.Id);
        message = result.Succeeded
            ? new NoticeMessage(L["Commitments_Ended"], NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await LoadAsync();
    }

    private static string Money(decimal amount) => amount.ToString("N2", German) + " €";
}
