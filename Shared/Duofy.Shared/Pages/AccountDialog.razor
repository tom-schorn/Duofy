@using Radzen
@using Radzen.Blazor
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@using Duofy.Shared.Dialogs
@inject IAccountApi AccountApi
@inject ActiveMember Member
@inject DialogService Dialogs
@inject IStringLocalizer<SharedResources> L

@* Der Dialog zum Anlegen und Ändern eines Kontos, auf dem Schritt-Dialog (Spec 11) mit einem Schritt (Issue #22, Spec 22).

   Alle Eingaben stehen in `draft`, einem AccountDraft. Dort steht auch die eine Regel des
   Dialogs: Die Art stellt den Schalter "zählt als verfügbar" vor, solange die Person ihn nicht
   selbst gestellt hat. Geprüft wird beim Speichern von der API; ihre Fehler stehen oben im Dialog. *@

<StepDialog Title="@Title" OnFinish="SaveAsync" FinishText="@L["AccountDialog_Save"]" Busy="busy" FinishTestId="account-save">
    <DialogStep Title="@L["AccountDialog_StepAll"]">
        @if (error is not null)
        {
            <ErrorAlert AlertStyle="AlertStyle.Danger" Text="@error" data-testid="account-error" />
        }

        <StepField Label="@L["Field_AccountName"]" InputId="account-name-input" TestId="account-name-field">
            <RadzenTextBox @bind-Value="draft.Name" id="account-name-input" MaxLength="MoneyAccountRules.NameMaxLength"
                           data-testid="account-name" />
        </StepField>

        <StepField Label="@L["Field_AccountType"]" InputId="account-type-input" TestId="account-type-field">
            <NativeSelect Value="@draft.Type" ValueChanged="OnTypeChanged" id="account-type-input" data-testid="account-type">
                @foreach (var type in AccountTypes.All)
                {
                    <option value="@type">@L[$"AccountType_{type}"]</option>
                }
            </NativeSelect>
        </StepField>

        @* Das Symbol (Issue 14): Das der Art ist vorgewählt, bis die Person eines wählt. *@
        <AccountIconPicker Value="@draft.Icon" ValueChanged="OnIconChanged" TestId="account-icon" />

        @* Startbetrag und Starttag gehören zusammen: der Stand am Ende dieses Tages. *@
        <StepField Label="@L["Field_OpeningBalance"]" InputId="account-opening-balance-input" AriaLabelled="true" TestId="account-opening-balance-field">
            <RadzenNumeric TValue="decimal?" Culture="German" @bind-Value="draft.OpeningBalance" Format="0.00" ShowUpDown="false"
                           InputAttributes="@OpeningBalanceAttributes" data-testid="account-opening-balance" />
            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color"
                        id="account-opening-balance-hint">@L["Field_OpeningBalanceHint"]</RadzenText>
        </StepField>
        <StepField Label="@L["Field_OpeningDate"]" InputId="account-opening-date-input" TestId="account-opening-date-field">
            <RadzenTextBox Value="@dateText" ValueChanged="OnDateChanged" type="date" id="account-opening-date-input"
                           data-testid="account-opening-date" />
        </StepField>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenSwitch Value="draft.CountsAsAvailable" ValueChanged="OnCountsAsAvailableChanged" Name="account-counts-as-available"
                          data-testid="account-counts-as-available" />
            <RadzenLabel Component="account-counts-as-available" Text="@L["Field_CountsAsAvailable"]" />
        </RadzenStack>

        <StepField Label="@L["Field_Iban"]" InputId="account-iban-input" TestId="account-iban-field">
            <RadzenTextBox @bind-Value="draft.Iban" id="account-iban-input" MaxLength="42"
                           data-testid="account-iban" />
        </StepField>
    </DialogStep>
</StepDialog>

@code {

    private static readonly CultureInfo German = new("de-DE");

    /// <summary>Der Titel im Kopf des Schritt-Dialogs ("Neues Konto" oder "Konto ändern").</summary>
    [Parameter]
    public string? Title { get; set; }

    // Zahlenfelder von Radzen lassen keine Id am input zu: Das Feld verweist auf Beschriftung und Hinweis.
    private static readonly Dictionary<string, object> OpeningBalanceAttributes = new()
    {
        ["aria-labelledby"] = "account-opening-balance-input-label",
        ["aria-describedby"] = "account-opening-balance-hint",
    };

    /// <summary>Das Konto, das geändert wird; null beim Anlegen.</summary>
    [Parameter]
    public AccountResponse? Existing { get; set; }

    /// <summary>Das Datum von heute; so ist der Starttag beim Anlegen vorbelegt.</summary>
    [Parameter]
    public DateOnly Today { get; set; }

    private AccountDraft draft = default!;
    private string dateText = "";
    private string? error;
    private bool busy;

    // Die Person, für die der Dialog geöffnet wurde; sie bleibt, auch wenn der Umschalter inzwischen woanders steht (Spec 68, A15).
    private Guid? owner;

    protected override void OnInitialized()
    {
        owner = Member.Owner;
        draft = Existing is null ? AccountDraft.ForNew(Today) : AccountDraft.From(Existing);
        dateText = draft.OpeningDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    private void OnTypeChanged(string type) => draft.SetType(type);

    private void OnIconChanged(string icon) => draft.SetIcon(icon);

    private void OnCountsAsAvailableChanged(bool value) => draft.SetCountsAsAvailable(value);

    private void OnDateChanged(string value)
    {
        dateText = value;
        if (DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            draft.OpeningDate = date;
        }
    }

    private async Task SaveAsync()
    {
        error = null;
        busy = true;
        try
        {
            var result = Existing is null
                ? await AccountApi.CreateAsync(draft.ToCreateRequest() with { OwnerId = owner })
                : await AccountApi.UpdateAsync(Existing.Id, draft.ToUpdateRequest());

            if (result.Succeeded)
            {
                Dialogs.Close(true);
            }
            else
            {
                error = ErrorTexts.For(L, result.ErrorCode);
            }
        }
        finally
        {
            busy = false;
        }
    }
}
