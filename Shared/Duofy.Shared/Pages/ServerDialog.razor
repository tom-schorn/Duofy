@using Duofy.ApiClient
@using Radzen
@using Radzen.Blazor
@inject IServerStore Servers
@inject IServerSelector Selector
@inject IAppHost Host
@inject DialogService Dialogs
@inject IStringLocalizer<SharedResources> L

@* Der Dialog zur Wahl des Servers: der gehostete Dienst Plagevo oder ein eigener Server mit Adresse.
   Beim Übernehmen prüft der IServerSelector die Adresse; antwortet dort kein Duofy-Server
   oder fehlt https, steht der Grund oben im Dialog und der bisherige Server bleibt.

   Er geht über FormDialogs auf (Title kommt als Parameter mit). In der App zeichnet er die Vollbild-Kopfzeile
   selbst; im Browser hat das Fenster die Titelzeile von Radzen, und Übernehmen steht unten. Schließt er sich
   ohne Ergebnis (Schließen, Esc), hat sich nichts geändert.

   Muster für die folgenden Formulare (Plan R5): data-testid, id und aria-* an einem RadzenTextBox landen am
   input selbst; bei RadzenNumeric sitzen data-testid und id am Rahmen darum (Field() in den Tests findet das input). *@

<div>
    @if (Host.IsApp)
    {
        <FullScreenFormHeader Title="@Title" SaveText="@L["Server_Save"]" SaveTestId="server-save"
                              Busy="busy" OnClose="Cancel" OnSave="SaveAsync" />
    }
    <RadzenStack Gap="1rem">

        @if (error is not null)
        {
            <ErrorAlert AlertStyle="AlertStyle.Danger" Text="@error" data-testid="server-error" />
        }

        <NativeSelect Value="@choice" ValueChanged="OnChoiceChanged" Label="@L["Server_Choice"]"
                      data-testid="server-choice">
            <option value="@Hosted">@L["Server_ChoiceHosted"]</option>
            <option value="@Own">@L["Server_ChoiceOwn"]</option>
        </NativeSelect>

        @if (choice == Own)
        {
            <div class="field">
                <FieldLabel For="server-address-input" Text="@L["Server_Address"]" />
                <RadzenTextBox @bind-Value="address" id="server-address-input" type="url"
                               Placeholder="@L["Server_AddressPlaceholder"]" autocomplete="url"
                               data-testid="server-address" />
            </div>
        }

        @if (!Host.IsApp)
        {
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton Text="@L["Server_Save"]" ButtonStyle="ButtonStyle.Primary" Disabled="busy"
                              Click="@(_ => SaveAsync())" data-testid="server-save" />
            </RadzenStack>
        }
    </RadzenStack>
</div>

@code {

    private const string Hosted = "hosted";
    private const string Own = "own";

    /// <summary>Der Titel für die Kopfzeile in der App; im Browser steht er in der Titelzeile des Fensters.</summary>
    [Parameter]
    public string? Title { get; set; }

    private string choice = Hosted;
    private string address = "";
    private string? error;
    private bool busy;

    // Vorbelegt ist, was gerade gilt (R2): bei einem eigenen Server mit dessen Adresse.
    protected override void OnInitialized()
    {
        if (!Servers.IsHosted)
        {
            choice = Own;
            address = Servers.CurrentAddress.AbsoluteUri;
        }
    }

    private void OnChoiceChanged(string value)
    {
        choice = value;
        error = null;
    }

    private void Cancel() => Dialogs.Close();

    private async Task SaveAsync()
    {
        error = null;
        busy = true;
        try
        {
            if (choice == Hosted)
            {
                await Selector.UseHostedAsync();
                Dialogs.Close(true);
                return;
            }

            var outcome = await Selector.TryUseAsync(address);
            switch (outcome)
            {
                case ServerChoiceOutcome.Taken:
                    Dialogs.Close(true);
                    break;
                case ServerChoiceOutcome.NeedsHttps:
                    error = L["Server_NeedsHttps"];
                    break;
                default:
                    error = L["Server_NoServer"];
                    break;
            }
        }
        finally
        {
            busy = false;
        }
    }
}
