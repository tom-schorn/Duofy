@using BlazorBlueprint.Components
@using Duofy.Shared.Dialogs
@inherits FormDialogBase
@using Duofy.ApiClient
@using Duofy.Schemas
@using Duofy.Shared.Dialogs
@inject IHouseholdApi HouseholdApi
@inject IStringLocalizer<SharedResources> L

@* Name und Richtwerte des Haushalts (R7), nur für den Gründer, auf dem Schritt-Dialog (Spec 11) mit einem Schritt (Issue #22). Die Richtwerte sind ganze Prozent für
   Grundbedarf, Wünsche und Sparen und ergeben zusammen 100; ob das stimmt, prüft die API (quota_invalid).
   Jede Person behält daneben ihre eigenen Quoten. *@

<StepDialog Title="@Title" OnFinish="SaveAsync" FinishText="@L["HouseholdDialog_Save"]" Busy="busy" FinishTestId="household-dialog-save">
    <DialogStep Title="@L["HouseholdDialog_StepAll"]">
        @if (error is not null)
        {
            <ErrorAlert Text="@error" data-testid="household-dialog-error" />
        }
        <StepField Label="@L["HouseholdDialog_Name"]" InputId="household-dialog-name-input" TestId="household-dialog-name-field">
            <TextInput id="household-dialog-name-input" maxlength="@(100)" @bind-Value="name" data-testid="household-dialog-name" />
        </StepField>
        <p>@L["HouseholdDialog_QuotasHint"]</p>
        @foreach (var pot in Pots)
        {
            var key = pot;
            <StepField Label="@L["Account_QuotaField", L[$"Pot_{key}"]]" InputId="@($"household-dialog-quota-{key}-input")">
                <NumberInput id="@($"household-dialog-quota-{key}-input")" min="0" max="@(100)" Value="quotas[key]" ValueChanged="v => quotas[key] = v ?? 0" data-testid="@($"household-dialog-quota-{key}")" />
            </StepField>
        }
    </DialogStep>
</StepDialog>

@code {
    private static readonly string[] Pots = [PotKeys.Needs, PotKeys.Wants, PotKeys.Savings];

    /// <summary>Der Titel im Kopf des Schritt-Dialogs.</summary>
    [Parameter] public string? Title { get; set; }

    [Parameter] public HouseholdResponse Household { get; set; } = default!;

    private string name = "";
    private readonly Dictionary<string, int> quotas = [];
    private string? error;
    private bool busy;

    protected override void OnInitialized()
    {
        name = Household.Name;
        quotas[PotKeys.Needs] = Household.QuotaNeeds;
        quotas[PotKeys.Wants] = Household.QuotaWants;
        quotas[PotKeys.Savings] = Household.QuotaSavings;
    }

    private async Task SaveAsync()
    {
        busy = true;
        error = null;
        try
        {
            var result = await HouseholdApi.UpdateAsync(Household.Id,
                new UpdateHouseholdRequest(name, quotas[PotKeys.Needs], quotas[PotKeys.Wants], quotas[PotKeys.Savings]));
            if (!result.Succeeded)
            {
                error = ErrorTexts.For(L, result.ErrorCode);
                return;
            }
            await CloseAsync(true);
        }
        finally
        {
            busy = false;
        }
    }
}
