@page "/haushalt/freigaben"
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]
@using Duofy.ApiClient
@using Duofy.Schemas
@implements IDisposable
@inject IHouseholdApi HouseholdApi
@inject AppChrome Chrome
@inject IAppHost Host
@inject IStringLocalizer<SharedResources> L

@* Die Freigaben (Spec 68, R6, R7): was ich jedem anderen Mitglied mit meinen Daten erlaube. Eine Karte je
   Person, denn die Entscheidung gilt genau ihr. Jede Wahl gilt sofort und meldet sich; es gibt kein Formular
   zum Abschicken. Während gespeichert wird, ist die Karte gesperrt, damit zwei schnelle Wahlen nicht in der
   falschen Reihenfolge ankommen: aria-disabled statt disabled, damit der Fokus bleibt, wo er war.

   Auch der Gründer sieht hier nichts zusätzlich: Niemand setzt Freigaben für die Daten eines anderen. Die
   Hinweise darunter ändern nie etwas von selbst. *@

<PageTitle>@L["Grants_Title"]</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" Class="rz-mb-2">
    <RadzenIcon Icon="arrow_back" />
    <RadzenLink Path="/haushalt" Text="@L["Grants_Back"]" data-testid="grants-back" />
</RadzenStack>

<AppPageHeading Text="@L["Grants_Title"]" />
@if (!Host.IsApp)
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-mb-2">@L["Grants_Title"]</RadzenText>
}
<RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-text-secondary-color rz-mb-4">@L["Grants_Lead"]</RadzenText>

<Notice Message="message" />

@if (loaded && Others.Count == 0)
{
    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-text-secondary-color" data-testid="grants-empty">@L["Grants_Empty"]</RadzenText>
}

<RadzenStack Gap="1rem">
    @foreach (var member in Others)
    {
        var current = member;
        var levels = member.MyGrants;
        var preset = GrantPresets.PresetOf(levels);
        var locked = saving.Contains(member.UserId);
        var headingId = $"grants-heading-{member.UserId}";
        <RadzenCard Variant="Variant.Outlined" aria-labelledby="@headingId" data-testid="@($"grants-card-{member.UserId}")">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" id="@headingId" Class="rz-mb-2">@member.FirstName @member.LastName</RadzenText>

            <fieldset class="grants-presets">
                <legend class="visually-hidden">@L["Grants_PresetsFor", member.FirstName]</legend>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center">
                    @foreach (var key in GrantPresets.Order)
                    {
                        var chosen = preset == key;
                        <RadzenButton Text="@L[$"Grants_Preset_{key}"].Value" Variant="@(chosen ? Variant.Filled : Variant.Outlined)"
                                      Size="ButtonSize.Small" ButtonStyle="@(chosen ? ButtonStyle.Primary : ButtonStyle.Base)"
                                      Click="@(_ => SetAsync(current, Request(GrantPresets.Levels(key))))"
                                      aria-pressed="@(chosen ? "true" : "false")" @attributes="Busy(locked)"
                                      data-testid="@($"grants-{member.UserId}-preset-{key}")" />
                    }
                    @if (preset is null)
                    {
                        <RadzenBadge Variant="Variant.Outlined" BadgeStyle="BadgeStyle.Base" IsPill="true" Text="@L["Grants_OwnChoice"].Value"
                                     data-testid="@($"grants-{member.UserId}-own-choice")" />
                    }
                </RadzenStack>
            </fieldset>

            @foreach (var area in GrantAreas.All)
            {
                var currentArea = area;
                @* Nur dieser Bereich wird geschickt; die anderen behalten ihre Stufe. Der Schlüssel wechselt, wenn eine
                   Wahl nicht gespeichert wurde: Dann legt Blazor das Feld neu an, und es zeigt wieder die gespeicherte
                   Stufe statt der gewählten (Spec 68, A20). *@
                <NativeSelect @key="@($"{member.UserId}-{area}-{Revision(member.UserId)}")" Label="@L[$"Grants_Area_{area}"]" Value="@levels.For(area)"
                              ValueChanged="value => SetAsync(current, Request(currentArea, value))"
                              @attributes="Busy(locked)" data-testid="@($"grants-{member.UserId}-{area}")">
                    @foreach (var level in AccessLevelKeys.All)
                    {
                        <option value="@level">@L[$"Grants_Level_{level}"]</option>
                    }
                </NativeSelect>
            }

            @* Nur Hinweise, nichts hebt sich selbst an. Höflich angesagt, damit ein Screenreader einen Hinweis hört,
               der nach einer Wahl erscheint. *@
            <div aria-live="polite">
                @foreach (var hint in GrantPresets.Hints(levels))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" AllowClose="false" Size="AlertSize.Small" Class="rz-mt-2"
                                 data-testid="@($"grants-{member.UserId}-hint")">@L[hint, member.FirstName]</RadzenAlert>
                }
            </div>
        </RadzenCard>
    }
</RadzenStack>

@code {
    private HouseholdResponse? household;
    private bool loaded;
    private NoticeMessage? message;
    private readonly HashSet<Guid> saving = [];

    // Je Karte ein Zähler, der nach jeder nicht gespeicherten Wahl steigt; er steckt im Schlüssel der Auswahlfelder.
    private readonly Dictionary<Guid, int> revisions = [];

    private int Revision(Guid memberId) => revisions.GetValueOrDefault(memberId);

    private void ShowStored(Guid memberId) => revisions[memberId] = Revision(memberId) + 1;

    private static readonly IReadOnlyDictionary<string, object> Free = new Dictionary<string, object>();

    private static readonly IReadOnlyDictionary<string, object> Locked = new Dictionary<string, object> { ["aria-disabled"] = "true" };

    private IReadOnlyList<MemberResponse> Others => household?.Members.Where(m => !m.IsMe).ToList() ?? [];

    private static IReadOnlyDictionary<string, object> Busy(bool locked) => locked ? Locked : Free;

    private static UpdateGrantsRequest Request(GrantLevels levels) => new(levels.Plan, levels.Book, levels.Accounts, levels.Commitments, levels.Savings);

    private static UpdateGrantsRequest Request(string area, string level) => area switch
    {
        GrantAreas.Plan => new(Plan: level),
        GrantAreas.Book => new(Book: level),
        GrantAreas.Accounts => new(Accounts: level),
        GrantAreas.Commitments => new(Commitments: level),
        _ => new(Savings: level),
    };

    protected override async Task OnInitializedAsync()
    {
        Chrome.Set(this, L["Grants_Title"]);
        var result = await HouseholdApi.GetMineAsync();
        if (result.Succeeded)
        {
            household = result.Value!;
        }
        else if (result.ErrorCode != ClientErrorCodes.NotFound)
        {
            // Ohne Haushalt (NotFound) gibt es niemanden, dem man etwas freigibt; das sagt der leere Zustand.
            message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        }
        loaded = true;
    }

    public void Dispose() => Chrome.Release(this);

    /// <summary>Speichert eine Wahl sofort; während des Speicherns ist die Karte gesperrt.</summary>
    private async Task SetAsync(MemberResponse member, UpdateGrantsRequest request)
    {
        if (household is null || !saving.Add(member.UserId))
        {
            // Die Karte ist gesperrt; die Wahl zählt nicht, das Feld zeigt wieder die gespeicherte Stufe.
            ShowStored(member.UserId);
            return;
        }
        try
        {
            var result = await HouseholdApi.SetGrantsAsync(household.Id, member.UserId, request);
            if (result.Succeeded)
            {
                var saved = result.Value!;
                household = household with { Members = household.Members.Select(m => m.UserId == saved.UserId ? saved : m).ToList() };
                message = new NoticeMessage(L["Grants_Saved", member.FirstName], NoticeSeverity.Success);
            }
            else
            {
                message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
                ShowStored(member.UserId);
            }
        }
        finally
        {
            saving.Remove(member.UserId);
        }
    }
}
