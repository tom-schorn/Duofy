@page "/lizenzen"
@using Radzen
@using Radzen.Blazor
@implements IDisposable
@inject IAppHost Host
@inject AppChrome Chrome
@inject IStringLocalizer<SharedResources> L

@* Die Lizenzen der Bausteine anderer Leute, die Duofy mitliefert (ThirdPartyLicenses). Ohne Anmeldung
   lesbar: Ein Lizenzhinweis gehört niemandem allein. *@

<PageTitle>@L["Licenses_Title"]</PageTitle>

<AppPageHeading Text="@L["Licenses_Title"]" />
@if (!Host.IsApp)
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@L["Licenses_Title"]</RadzenText>
}

<RadzenText TextStyle="TextStyle.Body1">@L["Licenses_Intro"]</RadzenText>

<RadzenStack Gap="1rem">
    @foreach (var license in ThirdPartyLicenses.All)
    {
        <RadzenCard Variant="Variant.Outlined" data-testid="@($"license-{license.Name}")">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2">@license.Name @license.Version</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">@license.License · @license.Url</RadzenText>
            <pre class="plain-text plain-text-small">@license.Text</pre>
        </RadzenCard>
    }
</RadzenStack>

@code {
    protected override void OnInitialized() => Chrome.Set(this, L["Licenses_Title"]);

    public void Dispose() => Chrome.Release(this);
}
