@page "/lizenzen"
@implements IDisposable
@inject IAppHost Host
@inject AppChrome Chrome
@inject IStringLocalizer<SharedResources> L

@* Die Lizenzen der Bausteine anderer Leute, die Duofy mitliefert (ThirdPartyLicenses). Ohne Anmeldung
   lesbar: Ein Lizenzhinweis gehört niemandem allein. *@

<PageTitle>@L["Licenses_Title"]</PageTitle>

<AppPageHeading Text="@L["Licenses_Title"]" />
@if (!Host.IsApp)
{
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">@L["Licenses_Title"]</MudText>
}

<MudText Class="mb-4">@L["Licenses_Intro"]</MudText>

<MudStack Spacing="2">
    @foreach (var license in ThirdPartyLicenses.All)
    {
        <MudPaper Class="pa-4" Outlined="true" data-testid="@($"license-{license.Name}")">
            <MudText Typo="Typo.h6">@license.Name @license.Version</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@license.License · @license.Url</MudText>
            <pre style="white-space: pre-wrap; font-size: 0.75rem; margin: 0.5rem 0 0;">@license.Text</pre>
        </MudPaper>
    }
</MudStack>

@code {
    protected override void OnInitialized() => Chrome.Set(this, L["Licenses_Title"]);

    public void Dispose() => Chrome.Release(this);
}
