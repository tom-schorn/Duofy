@using BlazorBlueprint.Components
@using Duofy.Shared.Dialogs
@inherits FormDialogBase
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@inject ISavingsGoalApi GoalApi
@inject ActiveMember Member
@inject IStringLocalizer<SharedResources> L

@* Der Dialog zum Anlegen und Ändern eines Sparziels (Issue 30): Name, Zielbetrag und Zieldatum sind freiwillig bis auf
   den Namen, dazu das Sparkonto, auf dem das Geld liegt. Geprüft wird beim Speichern von der API; ihre Fehler stehen
   oben im Dialog. *@

<div>

        <div class="stack">
            @if (error is not null)
            {
                <ErrorAlert Text="@error" data-testid="savings-goal-error" />
            }

            <div class="field">
                <FieldLabel For="savings-goal-name-input" Text="@L["Field_SavingsGoalName"]" />
                <TextInput id="savings-goal-name-input" maxlength="@(SavingsGoalRules.NameMaxLength)" @bind-Value="name" data-testid="savings-goal-name" />
            </div>

            <div class="field">
                <FieldLabel id="savings-goal-start-label" Text="@L["Field_SavingsGoalStart"]" />
                <MoneyInput aria-labelledby="savings-goal-start-label" aria-describedby="savings-goal-start-hint" @bind-Value="start" data-testid="savings-goal-start" />
                <p class="small muted" id="savings-goal-start-hint">@L["Field_SavingsGoalStartHint"]</p>
            </div>

            <div class="field">
                <FieldLabel id="savings-goal-target-label" Text="@L["Field_SavingsGoalTarget"]" />
                <MoneyInput aria-labelledby="savings-goal-target-label" aria-describedby="savings-goal-target-hint" @bind-Value="target" data-testid="savings-goal-target" />
                <p class="small muted" id="savings-goal-target-hint">@L["Field_SavingsGoalTargetHint"]</p>
            </div>

            <div class="field">
                <FieldLabel For="savings-goal-date-input" Text="@L["Field_SavingsGoalDate"]" />
                <TextInput id="savings-goal-date-input" Type="date" Value="@dateText" ValueChanged="OnDateChanged" data-testid="savings-goal-date" />
            </div>

            <NativeSelect Value="@(accountId?.ToString() ?? "")" ValueChanged="OnAccountChanged"
                          Label="@L["Field_SavingsGoalAccount"]" data-testid="savings-goal-account">
                <option value="">@L["Field_SavingsGoalNoAccount"]</option>
                @foreach (var account in Accounts.Where(a => a.Active || a.Id == accountId))
                {
                    <option value="@account.Id">@account.Name</option>
                }
            </NativeSelect>


                <div class="row-end">
                    <DuofyButton Kind="ButtonKind.Ghost" Text="@L["SavingsGoalDialog_Cancel"]" OnClick="@(_ => Cancel())" />
                    <DuofyButton Text="@L["SavingsGoalDialog_Save"]" OnClick="@(_ => SaveAsync())" TestId="savings-goal-save" Disabled="busy" />
                </div>
            
        </div>
</div>

@code {

    private static readonly CultureInfo German = new("de-DE");

    /// <summary>Der Titel für die Kopfzeile in der App; im Browser steht er in der Titelzeile des Fensters.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Das Ziel, das geändert wird; null beim Anlegen.</summary>
    [Parameter]
    public SavingsGoalResponse? Existing { get; set; }

    /// <summary>Die Konten der Person für die Wahl des Sparkontos.</summary>
    [Parameter]
    public IReadOnlyList<AccountChoice> Accounts { get; set; } = [];

    private string name = "";
    private decimal? target;
    private decimal? start = 0m;
    private DateOnly? date;
    private string dateText = "";
    private Guid? accountId;
    private string? error;
    private bool busy;

    // Die Person, für die der Dialog geöffnet wurde; sie bleibt, auch wenn der Umschalter inzwischen woanders steht.
    private Guid? owner;

    protected override void OnInitialized()
    {
        owner = Member.Owner;
        if (Existing is { } existing)
        {
            name = existing.Name;
            target = existing.TargetAmount;
            start = existing.StartAmount;
            date = existing.TargetDate;
            accountId = existing.AccountId;
            dateText = date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "";
        }
    }

    private void OnAccountChanged(string value) => accountId = Guid.TryParse(value, out var id) ? id : null;

    private void OnDateChanged(string value)
    {
        dateText = value;
        date = DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed) ? parsed : null;
    }

    private Task Cancel() => CancelAsync();

    private async Task SaveAsync()
    {
        error = null;
        busy = true;
        try
        {
            var result = Existing is null
                ? await GoalApi.CreateAsync(new CreateSavingsGoalRequest(name, target, date, accountId, owner, start ?? 0m))
                : await GoalApi.UpdateAsync(Existing.Id, new UpdateSavingsGoalRequest(
                    name, target, date, accountId,
                    ClearTargetAmount: target is null && Existing.TargetAmount is not null ? true : null,
                    ClearTargetDate: date is null && Existing.TargetDate is not null ? true : null,
                    ClearAccountId: accountId is null && Existing.AccountId is not null ? true : null,
                    StartAmount: start ?? 0m));

            if (result.Succeeded)
            {
                await CloseAsync(true);
            }
            else
            {
                error = ErrorTexts.For(L, result.ErrorCode);
            }
        }
        finally
        {
            busy = false;
        }
    }
}
