@using Radzen
@using Radzen.Blazor
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@using Duofy.Shared.Pages.Month
@implements IDisposable
@inject IHouseholdApi HouseholdApi
@inject IAppHost Host
@inject ActiveMember Member
@inject TimeProvider Time
@inject IStringLocalizer<SharedResources> L

@* Der Haushaltsplan eines Monats (Spec 69), nur zum Lesen: der Name des Haushalts, die Posten aller Mitglieder nach
   Topf mit dem Vornamen dessen, der sie trägt, geplant und gebucht, die Summen und Quoten des Haushalts und die
   Konten der Mitglieder, die sie freigegeben haben. Es gibt keinen Knopf zum Anlegen, Abhaken oder Ändern: Das geht
   im Plan der jeweiligen Person, mit deren Freigaben (Spec 68).

   Die Seite rechnet nichts; die API setzt den Plan bei jedem Öffnen aus den Monaten der Mitglieder zusammen.

   Seit Spec 24 hat der Haushaltsmonat dieselben drei Tabs wie der Monat einer Person (Übersicht, Plan, Buchungen),
   alle nur zum Lesen. *@

<AppPageHeading Text="@L["Nav_Plan"]" />
@if (!Host.IsApp)
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-mb-2">@L["Nav_Plan"]</RadzenText>
}

<RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-m-0" data-testid="household-name">@(plan?.HouseholdName ?? Member.Household?.Name)</RadzenText>
<RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color rz-mb-2" data-testid="household-read-only">@L["HouseholdPlan_ReadOnly"]</RadzenText>

@* Blättern zwischen den Monaten. *@
<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mb-2 month-nav">
    <RadzenButton Icon="chevron_left" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(_ => MoveAsync(-1))"
                  aria-label="@L["Plan_PreviousMonth"]" data-testid="plan-previous" />
    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H3" Class="rz-m-0" data-testid="plan-month">@MonthTitle</RadzenText>
    <RadzenButton Icon="chevron_right" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(_ => MoveAsync(1))"
                  aria-label="@L["Plan_NextMonth"]" data-testid="plan-next" />
</RadzenStack>

<Notice Message="message" />

<MonthTabs Active="tab" ActiveChanged="SelectTab" />
<div role="tabpanel" id="month-panel" class="page-wide" aria-labelledby="@($"month-tab-{MonthTabs.Key(tab)}")">
@if (plan is not null)
{
    @if (tab == MonthTab.Overview)
    {
        <MonthOverview Model="MonthView.ForHousehold(plan, Today)" ReadOnly="true" BookingsMissing="plan.BookingsMissing ?? []" />
        <HouseholdGuidelines Model="GuidelineView.From(plan)" />
    }
    else if (tab == MonthTab.Bookings)
    {
        <MonthBookings Rows="MonthView.HouseholdBookingRows(plan)" Missing="plan.BookingsMissing ?? []" CarryOvers="MonthView.CarryOverRows(plan.CarryOvers)" />
    }
    else if (tab == MonthTab.Review)
    {
        <MonthReview Model="MonthView.ForHousehold(plan, Today)" BookingsMissing="plan.BookingsMissing ?? []" />
    }
    else
    {
    @* Ab 1280 px stehen die Posten links, Summen und Konten rechts daneben, wie im Plan einer Person. *@
    <div class="plan-layout page-wide">
    @* Summen und Quoten. *@
    <RadzenCard Variant="Variant.Outlined" Class="rz-mb-4 plan-layout-side" data-testid="plan-sums">
        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-m-0">@L["HouseholdPlan_SumsIncome", Money(plan.Income)]</RadzenText>
        @foreach (var pot in plan.Pots)
        {
            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-m-0">@L["HouseholdPlan_SumsPot", L[$"Pot_{pot.Pot}"], Money(pot.Planned), Money(pot.Booked)]</RadzenText>
        }
        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-m-0">@L["HouseholdPlan_SumsUnpaid", Money(plan.Unpaid)]</RadzenText>
        @foreach (var quota in plan.Quotas)
        {
            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-m-0" data-testid="@($"plan-quota-{quota.Pot}")">@L["Plan_Quota", L[$"Pot_{quota.Pot}"], quota.Target, quota.Actual.ToString("0.#", German)]</RadzenText>
        }
        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-m-0" data-testid="household-unplanned">
            @L["HouseholdPlan_Unplanned", Money(plan.Unplanned.Income), Money(plan.Unplanned.Needs), Money(plan.Unplanned.Wants), Money(plan.Unplanned.Savings)]
        </RadzenText>
    </RadzenCard>

    <div class="plan-groups">
    @if (plan.Positions.Count == 0)
    {
        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-text-secondary-color rz-mb-2" data-testid="plan-empty">@L["HouseholdPlan_Empty"]</RadzenText>
    }

    @* Die Posten nach Topf, jeder mit dem Vornamen seiner Person. *@
    @foreach (var group in Groups(plan))
    {
        <div>
        <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.H3" Class="rz-mt-3 rz-mb-1" data-testid="@($"plan-group-{group.Pot}")">@L[$"Pot_{group.Pot}"]</RadzenText>
        <RadzenStack Gap="0.5rem">
            @foreach (var position in group.Positions)
            {
                var done = position.DoneAt is not null;
                <RadzenCard Variant="Variant.Outlined" data-testid="@($"household-position-{position.Id}")">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        <RadzenStack Gap="0" Class="fill-wrap">
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="@(done ? "rz-text-secondary-color rz-m-0" : "rz-m-0")">@position.Label</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color rz-m-0" data-testid="@($"household-owner-{position.Id}")">@Caption(position)</RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.Span">@L["Plan_Amounts", Money(position.AmountPlanned), Money(position.Booked)]</RadzenText>
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
        </div>
    }
    </div>

    @* Die Überträge als eigene Zeilen, nur von denen, die ihre Buchungen freigegeben haben (Spec 66, R9). *@
    @if (plan.CarryOvers is { Count: > 0 })
    {
        <div class="rz-mt-4 plan-layout-side" data-testid="household-carry-overs">
            <LineTable Caption="@L["Plan_CarryOver"]" HideCaption="true" Rows="MonthCarryOverText.Rows(MonthView.CarryOverRows(plan.CarryOvers), L)" />
        </div>
    }

    @* Die Konten der Mitglieder, die sie freigegeben haben (R8); wer fehlt, steht mit Namen darunter. *@
    @if (plan.Accounts.Count > 0)
    {
        <RadzenCard Variant="Variant.Outlined" Class="rz-mt-4 plan-layout-side" data-testid="household-accounts">
            <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.H3" Class="rz-mb-1">@L["HouseholdPlan_Accounts"]</RadzenText>
            @foreach (var account in plan.Accounts)
            {
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-m-0">@account.Name <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Span" Class="rz-text-secondary-color">(@account.OwnerFirstName)</RadzenText></RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-m-0">@Money(account.Balance)</RadzenText>
                </RadzenStack>
            }
        </RadzenCard>
    }
    @if (plan.AccountsMissing.Count > 0)
    {
        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color rz-mt-2 plan-layout-side" data-testid="household-accounts-missing">
            @L["HouseholdPlan_AccountsMissing", string.Join(", ", plan.AccountsMissing)]
        </RadzenText>
    }
    </div>
    }
}
</div>

@code {

    private static readonly CultureInfo German = new("de-DE");

    /// <summary>Der Monat, den die Planseite zeigt; sie gibt ihn aus der Adresse /plan/{Jahr}/{Monat} weiter.</summary>
    [Parameter, EditorRequired] public int Year { get; set; }

    [Parameter, EditorRequired] public int Month { get; set; }

    /// <summary>Wird mit +1 oder -1 gerufen, wenn der Pfeil einen Monat weiterblättert; die Planseite hält den Monat.</summary>
    [Parameter] public EventCallback<int> OnMove { get; set; }

    private MonthTab tab = MonthTab.Overview;
    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

    private void SelectTab(MonthTab selected) => tab = selected;

    private int year;
    private int month;
    private HouseholdPlanResponse? plan;
    private NoticeMessage? message;

    private string MonthTitle => new DateOnly(year, month, 1).ToString("MMMM yyyy", German);

    protected override async Task OnInitializedAsync()
    {
        await Member.LoadAsync();
        // Geht ein Mitglied, während die Sicht offen ist, endet sie; die Planseite zeichnet dann den eigenen Plan.
        Member.Changed += OnMemberChanged;
    }

    // Der erste Aufruf lädt den Monat der Adresse, jeder weitere den neu gewählten.
    protected override async Task OnParametersSetAsync()
    {
        if ((year, month) == (Year, Month))
        {
            return;
        }
        (year, month) = (Year, Month);
        await LoadAsync();
    }

    public void Dispose() => Member.Changed -= OnMemberChanged;

    private void OnMemberChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        if (Member.Household is not { } household)
        {
            plan = null;
            return;
        }
        var result = await HouseholdApi.GetPlanAsync(household.Id, year, month);
        if (result.Succeeded)
        {
            plan = result.Value;
            message = null;
        }
        else
        {
            plan = null;
            message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        }
    }

    private async Task MoveAsync(int by)
    {
        message = null;
        await OnMove.InvokeAsync(by);
    }

    /// <summary>Die Posten je Topf in der Reihenfolge der API (Topf, Fälligkeitstag, Name); leere Töpfe fehlen.</summary>
    private static IReadOnlyList<(string Pot, IReadOnlyList<HouseholdPlanPositionResponse> Positions)> Groups(HouseholdPlanResponse plan) =>
        PlanView.PotOrder
            .Select(pot => (pot, (IReadOnlyList<HouseholdPlanPositionResponse>)plan.Positions.Where(p => p.Pot == pot).ToList()))
            .Where(group => group.Item2.Count > 0)
            .ToList();

    // Unter der Bezeichnung: wer den Posten trägt und der Tag.
    private string Caption(HouseholdPlanPositionResponse position)
    {
        var parts = new List<string> { position.OwnerFirstName, L["Plan_DueDay", position.DueDay] };
        if (position.PassThrough)
        {
            parts.Add(L["Plan_PassThrough"]);
        }
        return string.Join(" · ", parts);
    }

    private static string Money(decimal amount) => amount.ToString("N2", German) + " €";
}
