@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@using Duofy.Shared.Charts
@using Duofy.Shared.Pages.Month
@implements IDisposable
@inject IHouseholdApi HouseholdApi
@inject IPlanApi PlanApi
@inject ICategoryApi CategoryApi
@inject IAccountChoices AccountChoices
@inject BookingDialogLauncher Launcher
@inject FormDialogs Forms
@inject IPrintService Printer
@inject ActiveMember Member
@inject TimeProvider Time
@inject IStringLocalizer<SharedResources> L

@* Der Haushaltsplan eines Monats (Spec 69, Spec 82) im selben Aufbau wie der Monat einer Person: Kennzahlen, Reiter, Sankey und die
   Posten aller Mitglieder nach Topf mit dem Vornamen dessen, der sie trägt, dazu die Summen und die Konten der Mitglieder, die sie
   freigegeben haben. Er ist die Zentrale (Spec 125): Der Kopf mit Drucken, Buchung und Posten anlegen ist derselbe wie im eigenen
   Plan; jeder Knopf fragt zuerst nach der Person, und Abhaken und Ändern gehen für jede Zeile unter den Freigaben ihrer Person
   (Spec 68). Die Seite rechnet nichts; die API setzt den Plan bei jedem Öffnen aus den Monaten der Mitglieder zusammen. *@

<PlanHead Title="@(Heading ?? MonthTitle)" Lead="@L["HouseholdPlan_Lead"]" OnPrint="PrintAsync" OnBooking="NewBookingAsync" OnAdd="AddAsync" />

<h2 class="section-title notice" data-testid="household-name">@(plan?.HouseholdName ?? Member.Household?.Name)</h2>

<Notice Message="message" />

@if (plan is not null && LockedNames.Count > 0)
{
    @foreach (var name in LockedNames)
    {
        <p class="small muted mb-2" data-testid="grant-reason">@L["Grant_NotGranted", name]</p>
    }
}

@if (plan is not null)
{
    <div class="metrics" data-testid="month-metrics">
        <div data-testid="month-block-income"><Metric Title="@L["Month_Income"]" Amount="plan.Income" /></div>
        <div data-testid="month-block-free"><Metric Title="@L["Month_Allocatable"]" Amount="plan.Free" Over="plan.Free < 0m" AmountText="@(plan.Free == 0m ? L["Month_AllPlanned"].Value : null)" Note="@FreeNote" /></div>
        <div data-testid="month-block-unpaid"><Metric Title="@L["Month_Unpaid"]" Amount="plan.Unpaid" AmountText="@(plan.Unpaid == 0m ? L["Month_AllPaid"].Value : null)" Note="@L["Month_UnpaidNote"]" /></div>
        @* Die Überträge als vierte Kennzahl, nur von denen, die ihre Buchungen freigegeben haben (Spec 66, R9; Spec 82, R15). *@
        <div data-testid="household-carry-overs">
            <div class="metric metric--carry" role="group" aria-labelledby="household-carry-over-title">
                <p class="metric-title" id="household-carry-over-title">@L["Plan_CarryOver"]</p>
                @if (plan.CarryOvers is { Count: > 0 })
                {
                    @foreach (var row in MonthView.CarryOverRows(plan.CarryOvers))
                    {
                        <p class="metric-line" data-testid="@(row.Incoming ? "plan-carry-over-in" : "plan-carry-over-out")">
                            <span>@L[row.Incoming ? "Month_CarryOverIn" : "Month_CarryOverOut", row.Month.ToString("MMMM", German)]@(row.Owner is null ? "" : $" · {row.Owner}")</span>
                            <b class="num @(row.Amount < 0m ? "over" : null)">@Money(row.Amount)</b>
                        </p>
                    }
                }
                else
                {
                    <p class="metric-note">@L["Plan_CarryOverNone"]</p>
                }
            </div>
        </div>
    </div>
}

<MonthTabs Active="tab" ActiveChanged="SelectTab" BookingCount="@(plan?.Bookings?.Count)" />
<div role="tabpanel" id="month-panel" aria-labelledby="@($"month-tab-{MonthTabs.Key(tab)}")">
@if (plan is not null)
{
    @if (tab == MonthTab.Bookings)
    {
        <MonthBookings Household="true" Rows="MonthView.HouseholdBookingRows(plan)" Missing="plan.BookingsMissing ?? []" CarryOvers="MonthView.CarryOverRows(plan.CarryOvers)" />
    }
    else if (tab == MonthTab.Review)
    {
        var review = MonthView.ForHousehold(plan, Today);
        <MonthReview Model="review" BookingsMissing="plan.BookingsMissing ?? []" Today="Today">
            <Balances>
                @* Die Konten der Mitglieder, die sie freigegeben haben (Spec 69, R8), je Person; wer fehlt, steht darunter. *@
                <AccountBalances Rows="BalanceRows" ByOwner="true" Missing="plan.AccountsMissing" TestId="household-accounts"
                                 AsOf="@L["Month_AccountsAsOfMonth"]" />
            </Balances>
            <Extra>
                <HouseholdGuidelines Model="GuidelineView.From(plan)" />
            </Extra>
        </MonthReview>
    }
    else
    {
        @if (plan.Positions.Count == 0)
        {
            <p class="empty-state notice" data-testid="plan-empty">@L["HouseholdPlan_Empty"]</p>
        }

        @* Die Posten nach Topf wie im Monat einer Person, mit Kopf, Balken und Summe (Spec 82, R16, R17); innerhalb eines Topfs
           zusätzlich nach Haushaltsmitglied (Tom, 03.11.2026: "sie sollten quasi zusätzlich mit den personen gruppiert werden"),
           der Vorname als Zwischenkopf mit der Summe dieser Person im Topf. *@
        @foreach (var group in Groups(plan))
        {
            <PotSection Pot="@group.Pot" Sum="PotPlanned(group.Pot)" Limit="LimitOf(group.Pot)">
                @foreach (var member in Members(plan, group.Positions))
                {
                    <li class="pot-member" data-testid="@($"household-member-group-{group.Pot}-{member.OwnerId}")">
                        <div class="pot-member-head">
                            <span class="avatar" aria-hidden="true">@member.Initials</span>
                            <h4 class="pot-member-name">@member.Name</h4>
                            <span class="pot-member-sum num">@Money(member.Total)</span>
                        </div>
                        <ul class="pot-rows">
                        @foreach (var position in member.Positions)
                        {
                            var done = position.DoneAt is not null;
                            <li class="@(done ? "plan-row row-done" : "plan-row")" data-testid="@($"household-position-{position.Id}")">
                                <div class="list-row">
                                    @{ var current = position; var tickOk = CanTick(position); var editOk = CanEdit(position); }
                                    <span class="list-row-lift">
                                        <TickBox Checked="done" Label="@L[done ? "Plan_Untick" : "Plan_Tick", position.Label]" OnToggle="@(() => ToggleAsync(current))"
                                                 Class="@GrantLock.Class(tickOk)" @attributes="GrantLock.Attributes(tickOk)"
                                                 data-testid="@($"household-tick-{position.Id}")" />
                                    </span>
                                    <button type="button" class="list-row-body list-row-open @GrantLock.Class(editOk)" @onclick="() => EditAsync(current)" @attributes="GrantLock.Attributes(editOk)"
                                            aria-label="@L["Plan_Edit", position.Label]" data-testid="@($"household-edit-{position.Id}")">
                                        <span class="list-row-title">@position.Label</span>
                                        <span class="list-row-detail" data-testid="@($"household-owner-{position.Id}")">@Caption(position)</span>
                                    </button>
                                    @{ var lines = BookingPurpose.LinesOf(plan.Bookings ?? [], position.Id); }
                                    @if (lines.Count > 0)
                                    {
                                        var id = position.Id;
                                        <span class="list-row-lift">
                                            <PositionBookingsToggle Count="lines.Count" Label="@position.Label" PanelId="@($"position-bookings-panel-{position.Id}")"
                                                                    Open="expanded.Contains(position.Id)" OnToggle="@(() => Toggle(id))"
                                                                    TestId="@($"position-bookings-{position.Id}-toggle")" />
                                        </span>
                                    }
                                    <span class="list-row-amount">
                                        @Money(position.AmountPlanned)
                                        @if (position.Booked != 0m && position.Booked != position.AmountPlanned)
                                        {
                                            <span class="list-row-detail">@L["Plan_BookedOf", Money(position.Booked)]</span>
                                        }
                                    </span>
                                </div>
                                @if (lines.Count > 0)
                                {
                                    <PositionBookings Label="@position.Label" Rows="lines" TestId="@($"position-bookings-{position.Id}")"
                                                      PanelId="@($"position-bookings-panel-{position.Id}")" Open="expanded.Contains(position.Id)" />
                                }
                            </li>
                        }
                        </ul>
                    </li>
                }
            </PotSection>
        }
        <UnplannedLine Amounts="UnplannedPerPot" People="UnplannedPerPerson" Missing="plan.BookingsMissing ?? []" />

    }
}
</div>
@if (printPlan is not null && printOwner is { } who)
{
    @* Der Plan einer einzelnen Person, nur solange gedruckt wird: Zwei Druckbilder zugleich druckten beide. *@
    <PersonMonthPrint Plan="printPlan" Title="@(Heading ?? MonthTitle)" Subject="@L["Print_PlanOf", who.FirstName].Value" Year="Year" Month="Month" />
}
else if (plan is not null)
{
    <MonthPrint Title="@(Heading ?? MonthTitle)" Subject="@plan.HouseholdName" Today="Today" Year="Year" Month="Month" ShowOwner="true"
                Income="plan.Income" Free="plan.Free" Unpaid="plan.Unpaid" PlannedExpenses="plan.Fixed"
                BookedIncome="(plan.Bookings ?? []).Where(b => b.Kind == BookingKinds.Income).Sum(b => b.Amount)"
                BookedExpenses="(plan.Bookings ?? []).Where(b => b.Kind == BookingKinds.Expense).Sum(b => b.Amount)"
                CarryOver="@(MonthView.CarryOverRows(plan.CarryOvers).Where(c => c.Incoming).Sum(c => c.Amount) is var carry && carry != 0m ? MoneyText.Format(carry) : "—")"
                Pots="PrintPots" Unplanned="UnplannedPerPot" />
}

@code {
    // Was in Verplanbar steckt (Spec 66, R9), und wessen Übertrag fehlen kann, ohne zu verraten, ob es einen gibt.
    private string FreeNote
    {
        get
        {
            var incoming = MonthView.CarryOverRows(plan?.CarryOvers).Where(c => c.Incoming).ToList();
            var parts = new List<string>();
            if (incoming.Count > 0)
            {
                parts.Add(L["Month_FreeCarryOver", MoneyText.Format(incoming.Sum(c => c.Amount))].Value);
            }
            if (plan?.BookingsMissing is { Count: > 0 } missing)
            {
                parts.Add(L["Month_FreeCarryOverMissing", string.Join(", ", missing)].Value);
            }
            return parts.Count > 0 ? string.Join(" ", parts) : L["Month_FreeNote"].Value;
        }
    }


    private static readonly CultureInfo German = new("de-DE");

    // Das Druckbild einer einzelnen Person (Spec 125, R4): nur zwischen der Wahl und dem Drucken gesetzt.
    private PlanResponse? printPlan;
    private MemberResponse? printOwner;
    private bool printPending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!printPending)
        {
            return;
        }
        printPending = false;
        await Printer.PrintAsync();
        printPlan = null;
        printOwner = null;
        StateHasChanged();
    }

    // --- Was die Freigaben jeder Zeile erlauben (Spec 125, R3): die Stufe der Person, der die Zeile gehört. ---
    private bool CanTick(HouseholdPlanPositionResponse position) => position.DoneAt is null
        ? Member.AllowsFor(position.OwnerId, GrantAreas.Book, AccessLevelKeys.Edit) && Member.AllowsFor(position.OwnerId, GrantAreas.Accounts, AccessLevelKeys.View)
        : Member.AllowsFor(position.OwnerId, GrantAreas.Book, AccessLevelKeys.Delete);

    private bool CanEdit(HouseholdPlanPositionResponse position) => Member.AllowsFor(position.OwnerId, GrantAreas.Plan, AccessLevelKeys.Edit);

    // Wessen Freigabe auf dieser Seite etwas sperrt: ihr Name steht einmal oben, wie im Plan einer Person.
    private IReadOnlyList<string> LockedNames => (plan?.Positions ?? [])
        .Where(p => !CanTick(p) || !CanEdit(p))
        .Select(p => p.OwnerFirstName)
        .Distinct()
        .ToList();

    private Guid? OwnerArgument(Guid ownerId) => Member.Household?.Members.FirstOrDefault(m => m.UserId == ownerId)?.IsMe == false ? ownerId : null;

    // Der Schritt "Für wen?" vor jedem Knopf; null, wenn die Person abbricht.
    private async Task<Guid?> PickAsync(string title, string question, IReadOnlyList<MemberResponse> people, bool offerHousehold = false)
    {
        var parameters = new FormParameters<PersonPickerDialog>()
            .Add(x => x.Question, question)
            .Add(x => x.People, people)
            .Add(x => x.OfferHousehold, offerHousehold);
        var outcome = await Forms.OpenAsync<PersonPickerDialog, Guid>(title, parameters);
        return outcome.Saved ? outcome.Value : null;
    }

    private async Task PrintAsync()
    {
        if (Member.Household is null)
        {
            return;
        }
        // Wessen Plan man drucken darf, ist, wessen Plan man sehen darf; der ganze Haushalt steht immer zur Wahl.
        var chosen = await PickAsync(L["Plan_Print"], L["Picker_PrintQuestion"], Member.PeopleWith(GrantAreas.Plan, AccessLevelKeys.View), offerHousehold: true);
        if (chosen is null)
        {
            return;
        }
        if (chosen == Guid.Empty)
        {
            printPlan = null;
            printOwner = null;
        }
        else
        {
            var owner = Member.Household.Members.First(m => m.UserId == chosen);
            var result = await PlanApi.GetAsync(Year, Month, OwnerArgument(owner.UserId));
            if (!result.Succeeded)
            {
                message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
                return;
            }
            (printPlan, printOwner) = (result.Value, owner);
        }
        printPending = true;
        StateHasChanged();
    }

    private async Task AddAsync()
    {
        var chosen = await PickAsync(L["Plan_AddPosition"], L["Picker_AddPositionQuestion"], Member.PeopleWith(GrantAreas.Plan, AccessLevelKeys.Create));
        if (chosen is null)
        {
            return;
        }
        using (Member.ActAs(chosen))
        {
            var (categories, accounts) = await ChoicesAsync();
            if (categories is not null)
            {
                await ShowPositionDialogAsync(null, categories, accounts, L["PlanPositionDialog_TitleNew"]);
            }
        }
    }

    private async Task NewBookingAsync()
    {
        // Eine Buchung braucht Anlegen bei den Buchungen und Ansehen bei den Konten der Person (wie im eigenen Plan).
        var people = Member.PeopleWith(GrantAreas.Book, AccessLevelKeys.Create)
            .Where(m => m.IsMe || AccessLevelKeys.Includes(m.GrantsToMe.Accounts, AccessLevelKeys.View))
            .ToList();
        var chosen = await PickAsync(L["Month_ActionBooking"], L["Picker_BookingQuestion"], people);
        if (chosen is null)
        {
            return;
        }
        using (Member.ActAs(chosen))
        {
            message = await Launcher.OpenAsync(null, null, null, new DateOnly(Year, Month, 1), null) ?? message;
        }
        await LoadAsync();
    }

    /// <summary>Kategorien und Konten der Person, für die gerade gehandelt wird; null bei einem Fehler, der in der Meldung steht.</summary>
    private async Task<(List<CategoryResponse>? Categories, IReadOnlyList<AccountChoice> Accounts)> ChoicesAsync()
    {
        var categories = await CategoryApi.ListAsync(Member.Owner);
        var accounts = await AccountChoices.ListAsync(Member.Owner);
        if (!categories.Succeeded || !accounts.Succeeded)
        {
            message = new NoticeMessage(ErrorTexts.For(L, categories.ErrorCode ?? accounts.ErrorCode), NoticeSeverity.Error);
            return (null, []);
        }
        return (categories.Value!.ToList(), accounts.Value!);
    }

    private async Task ShowPositionDialogAsync(PlanPositionResponse? existing, List<CategoryResponse> categories, IReadOnlyList<AccountChoice> accounts, string title)
    {
        var parameters = new FormParameters<PlanPositionDialog>()
            .Add(x => x.Title, title)
            .Add(x => x.Year, Year)
            .Add(x => x.Month, Month)
            .Add(x => x.Existing, existing)
            .Add(x => x.Categories, categories)
            .Add(x => x.Accounts, accounts)
            .Add(x => x.OfferDelete, existing is not null && PlanView.CanDelete(existing))
            .Add(x => x.CanDelete, Member.Allows(GrantAreas.Plan, AccessLevelKeys.Delete));
        var outcome = await Forms.OpenStepAsync<PlanPositionDialog, bool>(title, parameters);
        if (outcome.Saved && outcome.Value)
        {
            message = new NoticeMessage(L["Plan_PositionSaved"], NoticeSeverity.Success);
            await LoadAsync();
        }
        else if (outcome.Saved && existing is not null && Member.Allows(GrantAreas.Plan, AccessLevelKeys.Delete))
        {
            var result = await PlanApi.DeletePositionAsync(Year, Month, existing.Id, Member.Owner);
            message = result.Succeeded
                ? new NoticeMessage(L["Plan_PositionDeleted"], NoticeSeverity.Success)
                : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
            await LoadAsync();
        }
    }

    private async Task EditAsync(HouseholdPlanPositionResponse position)
    {
        if (!CanEdit(position))
        {
            RefuseMissing(position, GrantAreas.Plan, AccessLevelKeys.Edit);
            return;
        }
        using (Member.ActAs(position.OwnerId))
        {
            var full = await FullPositionAsync(position);
            var (categories, accounts) = await ChoicesAsync();
            if (full is not null && categories is not null)
            {
                await ShowPositionDialogAsync(full, categories, accounts, L["PlanPositionDialog_TitleEdit"]);
            }
        }
    }

    // Der Posten mit allen Feldern aus dem Monat seiner Person; die Zeile des Haushalts kennt nur einen Teil davon.
    private async Task<PlanPositionResponse?> FullPositionAsync(HouseholdPlanPositionResponse position)
    {
        var result = await PlanApi.GetAsync(Year, Month, Member.Owner);
        if (!result.Succeeded)
        {
            message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
            return null;
        }
        return result.Value!.Positions.FirstOrDefault(p => p.Id == position.Id);
    }

    /// <summary>
    /// Abhaken und Zurücknehmen für die Person der Zeile, unter ihren Freigaben (Spec 125, R3). Wie im eigenen Plan: Ein Posten ohne
    /// Buchungen fragt nach Datum und Betrag, einer mit Buchungen wird nur als erledigt markiert.
    /// </summary>
    private async Task ToggleAsync(HouseholdPlanPositionResponse position)
    {
        if (!CanTick(position))
        {
            RefuseMissing(position, GrantAreas.Book, position.DoneAt is null ? AccessLevelKeys.Edit : AccessLevelKeys.Delete);
            return;
        }
        var owner = OwnerArgument(position.OwnerId);
        if (position.DoneAt is not null)
        {
            await AfterAsync(await PlanApi.UntickAsync(Year, Month, position.Id, owner), "Plan_Unticked");
            return;
        }
        if (position.Booked != 0m)
        {
            await AfterAsync(await PlanApi.TickAsync(Year, Month, position.Id, new TickPositionRequest(Amount: 0m), owner), "Plan_Ticked");
            return;
        }
        using (Member.ActAs(position.OwnerId))
        {
            // Der Dialog braucht nur Bezeichnung, Betrag und Kennung des Postens; Ansehen des Plans ist dafür nicht nötig.
            var forDialog = new PlanPositionResponse(position.Id, null, position.Label, position.AmountPlanned, position.DueDay, position.Type,
                position.CategoryId, position.Pot, null, null, position.PassThrough, PaymentMethods.Other, position.Booked, position.DoneAt, false, null);
            string title = L["PlanTickDialog_Title"];
            var parameters = new FormParameters<PlanTickDialog>()
                .Add(x => x.Year, Year)
                .Add(x => x.Month, Month)
                .Add(x => x.Position, forDialog);
            var outcome = await Forms.OpenAsync<PlanTickDialog, bool>(title, parameters);
            if (outcome.Saved)
            {
                message = new NoticeMessage(L["Plan_Ticked"], NoticeSeverity.Success);
                await LoadAsync();
            }
        }
    }

    private async Task AfterAsync<T>(ApiResult<T> result, string successKey)
    {
        message = result.Succeeded
            ? new NoticeMessage(L[successKey], NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await LoadAsync();
    }

    // Eine Freigabe fehlt: Die Meldung nennt, wessen und welche (Spec 125, A3).
    private void RefuseMissing(HouseholdPlanPositionResponse position, string area, string level) =>
        message = new NoticeMessage(
            L["HouseholdPlan_Missing", position.OwnerFirstName, $"{L[$"Grants_Area_{area}"]}: {L[$"Grants_Level_{level}"]}"], NoticeSeverity.Warning);

    // Das Druckbild des Haushalts (Spec 82, R20): je Topf die Posten aller Mitglieder mit der Person.
    private IReadOnlyList<PrintPot> PrintPots => plan is null ? [] : Groups(plan)
        .Select(g => new PrintPot(g.Pot, PotPlanned(g.Pot), g.Pot == PotKeys.Income ? null : LimitOf(g.Pot),
            g.Positions.Select(p => new PrintRow(p.Label, p.DueDay, p.AmountPlanned, p.Booked, p.DoneAt is not null, p.OwnerFirstName)).ToList()))
        .ToList();

    private static IReadOnlyList<(string Pot, IReadOnlyList<HouseholdPlanPositionResponse> Positions)> Groups(HouseholdPlanResponse plan) =>
        PlanView.PotOrder
            .Select(pot => (pot, (IReadOnlyList<HouseholdPlanPositionResponse>)plan.Positions.Where(p => p.Pot == pot).ToList()))
            .Where(group => group.Item2.Count > 0)
            .ToList();

    // Die Posten, deren Buchungen gerade aufgeklappt sind.
    private readonly HashSet<Guid> expanded = [];

    private void Toggle(Guid positionId)
    {
        if (!expanded.Remove(positionId))
        {
            expanded.Add(positionId);
        }
    }

    /// <summary>Die Überschrift; ohne Angabe "Plan". Die Seite Haushaltsplan nennt sich selbst.</summary>
    [Parameter] public string? Heading { get; set; }

    /// <summary>Der Monat, den die Planseite zeigt; sie gibt ihn aus der Adresse /plan/{Jahr}/{Monat} weiter.</summary>
    [Parameter, EditorRequired] public int Year { get; set; }

    [Parameter, EditorRequired] public int Month { get; set; }

    private MonthTab tab = MonthTab.Plan;
    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

    private void SelectTab(MonthTab selected) => tab = selected;

    private int year;
    private int month;
    private HouseholdPlanResponse? plan;
    private NoticeMessage? message;

    // Aus den Parametern: Die Sicht zeichnet schon, während die Mitglieder noch laden und year und month noch leer sind.
    private string MonthTitle => new DateOnly(Year, Month, 1).ToString("MMMM yyyy", German);

    protected override async Task OnInitializedAsync()
    {
        await Member.LoadAsync();
        // Geht ein Mitglied, während die Sicht offen ist, endet sie; die Planseite zeichnet dann den eigenen Plan.
        Member.Changed += OnMemberChanged;
    }

    // Der erste Aufruf lädt den Monat der Adresse, jeder weitere den neu gewählten.
    protected override async Task OnParametersSetAsync()
    {
        if ((year, month) == (Year, Month))
        {
            return;
        }
        (year, month) = (Year, Month);
        await LoadAsync();
    }

    public void Dispose() => Member.Changed -= OnMemberChanged;

    private void OnMemberChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        if (Member.Household is not { } household)
        {
            plan = null;
            return;
        }
        var result = await HouseholdApi.GetPlanAsync(household.Id, year, month);
        if (result.Succeeded)
        {
            plan = result.Value;
            message = null;
        }
        else
        {
            plan = null;
            message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        }
    }

    private decimal Unplanned(string pot) => pot switch
    {
        PotKeys.Income => plan!.Unplanned.Income,
        PotKeys.Needs => plan!.Unplanned.Needs,
        PotKeys.Wants => plan!.Unplanned.Wants,
        PotKeys.Savings => plan!.Unplanned.Savings,
        _ => 0m,
    };

    // Das Geplante eines Topfs aus der API, dieselbe Zahl wie im Flussdiagramm (Spec 82, R17).
    private decimal PotPlanned(string pot) => pot == PotKeys.Income
        ? plan!.Income
        : plan!.Pots.FirstOrDefault(p => p.Pot == pot)?.Planned ?? 0m;

    private IReadOnlyDictionary<string, decimal> UnplannedPerPot =>
        new[] { PotKeys.Needs, PotKeys.Wants, PotKeys.Savings }.ToDictionary(pot => pot, Unplanned);

    // Was die Quote eines Topfs bei diesen Einnahmen erlaubt.
    private decimal LimitOf(string pot) => Math.Round(plan!.Income * (plan.Quotas.FirstOrDefault(q => q.Pot == pot)?.Target ?? 0) / 100m, 2);


    /// <summary>Die Posten eines Mitglieds in einem Topf.</summary>
    private sealed record MemberGroup(Guid OwnerId, string Name, IReadOnlyList<HouseholdPlanPositionResponse> Positions)
    {
        public decimal Total => Positions.Sum(p => p.AmountPlanned);

        // Der Kreis wie im Profil-Menü; der Haushalt kennt nur den Vornamen, also ein Buchstabe.
        public string Initials => string.Concat(Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    // Die Mitglieder in der Reihenfolge des Plans, jedes mit seinen Posten des Topfs nach Fälligkeit und Name.
    private static IReadOnlyList<MemberGroup> Members(HouseholdPlanResponse plan, IReadOnlyList<HouseholdPlanPositionResponse> positions)
    {
        var order = plan.Members.Select(m => m.UserId).ToList();
        return positions
            .GroupBy(p => (p.OwnerId, p.OwnerFirstName))
            .OrderBy(g => order.IndexOf(g.Key.OwnerId) is var i && i < 0 ? int.MaxValue : i)
            .ThenBy(g => g.Key.OwnerFirstName, StringComparer.CurrentCultureIgnoreCase)
            .Select(g => new MemberGroup(g.Key.OwnerId, g.Key.OwnerFirstName,
                g.OrderBy(p => p.DueDay).ThenBy(p => p.Label, StringComparer.CurrentCultureIgnoreCase).ToList()))
            .ToList();
    }

    // Ungeplant je Person: die Ausgabezeilen ohne Posten aus den Buchungen, die der Betrachter sieht. Wer seine Buchungen nicht
    // teilt, fehlt hier und wird in der Zeile genannt.
    private IReadOnlyList<(string Name, decimal Amount)> UnplannedPerPerson => (plan?.Bookings ?? [])
        .Where(b => b.Kind == BookingKinds.Expense)
        .SelectMany(b => (b.Lines ?? []).Where(l => l.PositionId is null).Select(l => (b.OwnerId, b.OwnerFirstName, l.Amount)))
        .GroupBy(x => (x.OwnerId, x.OwnerFirstName))
        .Select(g => (g.Key.OwnerFirstName, g.Sum(x => x.Amount)))
        .Where(x => x.Item2 != 0m)
        .OrderBy(x => x.OwnerFirstName, StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    // Unter der Bezeichnung: der Tag; der Topf steht schon darüber.
    private string Caption(HouseholdPlanPositionResponse position)
    {
        var parts = new List<string> { L["Plan_DueDay", position.DueDay] };
        if (position.PassThrough)
        {
            parts.Add(L["Plan_PassThrough"]);
        }
        return string.Join(" · ", parts);
    }

    private IReadOnlyList<AccountBalanceRow> BalanceRows => (plan?.Accounts ?? [])
        .Select(a => new AccountBalanceRow(a.AccountId, a.Name, null, a.Balance, true, a.OwnerFirstName))
        .ToList();

    private static string Money(decimal amount) => amount.ToString("N2", German) + " €";
}
