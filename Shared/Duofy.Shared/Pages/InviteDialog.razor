@using BlazorBlueprint.Components
@using Duofy.Shared.Dialogs
@inherits FormDialogBase
@using System.Globalization
@inject IShareService Share
@inject IStringLocalizer<SharedResources> L

@* Eine neue Einladung (R4): der Link, sein QR-Code zum Abscannen vom Bildschirm und Teilen. In der App
   öffnet Teilen den Teilen-Dialog von Android, im Browser kopiert es den Link. Der Link ist der
   Nachweis: Wer ihn hat, kann einmal beitreten. Ging eine Adresse mit, sagt der Dialog, dass die Einladung
   unterwegs ist, falls die Adresse zu einem bestätigten Konto gehört.

   Er geht über FormDialogs.OpenWindowAsync als Fenster auf (auch in der App); Schließen und Teilen stehen unten im Inhalt. *@

<div class="stack">
    <p>@L["InviteDialog_Text", ExpiresAt.ToLocalTime().ToString("dd.MM.yyyy", German)]</p>
    @if (Mailed)
    {
        <BbAlert Variant="AlertVariant.Info" data-testid="invite-mail-note">@L["InviteDialog_MailNote"]</BbAlert>
    }
    @* Der QR-Code bleibt weiß, auch im Dunkelmodus, damit er sich scannen lässt. *@
    <div role="img" aria-label="@L["InviteDialog_Qr"]" class="qr-code"
         data-testid="invite-qr">@((MarkupString)InvitationQr.Svg(Link))</div>
    <p class="long-link" data-testid="invite-link">@Link</p>
    <div class="row-end w-full">
        <DuofyButton Kind="ButtonKind.Ghost" Text="@L["InviteDialog_Close"]" OnClick="@(_ => Close())" TestId="invite-close" />
        <DuofyButton Icon="share-2" Text="@L["InviteDialog_Share"]" OnClick="@(_ => ShareAsync())" TestId="invite-share" />
    </div>
</div>

@code {
    private static readonly CultureInfo German = new("de-DE");

    /// <summary>Der ganze Link, zum Beispiel https://duofy.example/einladung/abc.</summary>
    [Parameter] public string Link { get; set; } = "";

    [Parameter] public DateTimeOffset ExpiresAt { get; set; }

    [Parameter] public string HouseholdName { get; set; } = "";

    /// <summary>
    /// True, wenn die Einladung mit einer Adresse angelegt wurde (gehostete Version, Spec 53): Ob eine Mail hinausging,
    /// verrät die API nicht; der Dialog sagt deshalb "wenn".
    /// </summary>
    [Parameter] public bool Mailed { get; set; }

    private Task ShareAsync() => Share.ShareAsync(L["InviteDialog_ShareTitle", HouseholdName], Link);

    private Task Close() => CloseAsync(true);
}
