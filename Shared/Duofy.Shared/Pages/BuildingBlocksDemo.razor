@page "/bausteine"
@inject IServiceProvider Services
@inject NavigationManager Navigation

@* Die Testseite der Bausteine (Spec 6): alle Bausteine hell und dunkel nebeneinander.
   Nur im Entwicklungsbetrieb da. Ohne Meldung des Hosts (Produktion, App) zeigt sie nichts
   und die Adresse gilt als nicht gefunden (der Web-Host antwortet dann 404, siehe Web-Test).
   Der dunkle Teil trägt die Klasse dark; so zeigt eine Seite beide Modi. *@

@if (IsDevelopment)
{
    <PageTitle>@Heading</PageTitle>
    <h1 class="page-title mb-4">@Heading</h1>

    <div class="blocks-panels">
        <section class="blocks-panel" data-testid="blocks-panel-light" aria-label="@LightName">
            @Panel()
        </section>
        <section class="blocks-panel dark" data-testid="blocks-panel-dark" aria-label="@DarkName">
            @Panel()
        </section>
    </div>
}
else
{
    <NotFound />
}

@code {
    private bool IsDevelopment => (Services.GetService(typeof(IDevelopmentMode)) as IDevelopmentMode)?.IsDevelopment == true;

    // Ohne Entwicklungsbetrieb antwortet der Server mit 404 wie bei jeder unbekannten Adresse.
    protected override void OnInitialized()
    {
        if (!IsDevelopment)
        {
            Navigation.NotFound();
        }
    }

    // Die Testseite ist nur für das Team: Ihre Texte stehen hier statt in den Textdateien (SharedResources).
    private const string Heading = "Bausteine";
    private const string LightName = "Hell";
    private const string DarkName = "Dunkel";

    private static readonly LineTableRow[] Rows = [new("Miete", 850m), new("Strom", 62.4m), new("Internet", 39.99m)];

    private RenderFragment Panel() => @<text>
        <Metric Title="Einnahmen" Amount="3200m" />
        <Metric Title="Anstehend" Amount="952.39m" />
        <Metric Title="Verplanbar" Amount="2247.61m" />
        <LineTable Caption="Feste Kosten" Rows="Rows" />
        <div class="blocks-panel-buttons">
            <DuofyButton Kind="ButtonKind.Primary">Speichern</DuofyButton>
            <DuofyButton Kind="ButtonKind.Secondary">Abbrechen</DuofyButton>
            <DuofyButton Kind="ButtonKind.Danger">Löschen</DuofyButton>
        </div>
    </text>;
}
