@using Duofy.Schemas
@inject IStringLocalizer<SharedResources> L

@* Die Art einer Buchung als Wort mit Punkt (Spec 51, R9, Issue 51): Die Farbe hilft beim Überfliegen, gesagt wird es mit dem Wort. *@
<span class="pill booking-kind" data-kind="@Kind"><span class="@DotClass" aria-hidden="true"></span>@L[$"BookingKind_{Kind}"]</span>

@code {
    /// <summary>Eine Art aus <see cref="BookingKinds"/> oder <see cref="MonthBookingText.CarryOver"/>.</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "";

    private string DotClass => Kind switch
    {
        BookingKinds.Income => "dot dot--savings",
        BookingKinds.Expense => "dot dot--needs",
        BookingKinds.Transfer => "dot dot--wants",
        _ => "dot",
    };
}
