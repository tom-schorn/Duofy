@using System.Globalization
@using Duofy.Shared.Charts
@inject IStringLocalizer<SharedResources> L

@* Die Übersicht eines Monats (Spec 24): oben drei Blöcke, dann die schnellen Aktionen, der Soll-Ist-Balken je Topf, das
   Lückendiagramm, die letzten fünf Buchungen und was bald fällig oder überfällig ist. Sie gilt für eine Person und für
   den Haushalt (dann ReadOnly, ohne Aktionen).

   Die Seite rechnet nichts: Alle Zahlen stehen im Modell (aus der API, siehe MonthView). Das Diagramm zeigt die Lücke
   als Länge ohne Alarmfarbe; ob mehr oder weniger als geplant, steht im Namen jedes Balkens.

   Ohne Sicht auf die Buchungen (Spec 68) schickt die API jeden gebuchten Betrag als 0. Lücke, Liste und offene Beträge
   wären dann falsch; dort steht stattdessen, dass die Person das nicht teilt. *@
<div data-testid="month-overview">
    <div class="month-blocks">
        <div data-testid="month-block-income"><ColorBlock Variant="BlockVariant.Income" Title="@L["Month_Income"]" Amount="Model.Income" /></div>
        <div data-testid="month-block-fixed"><ColorBlock Variant="BlockVariant.Fixed" Title="@L["Month_Fixed"]" Amount="Model.Fixed" /></div>
        <div data-testid="month-block-free">
            <ColorBlock Variant="BlockVariant.Free" Title="@L["Month_Free"]" Amount="Model.Free"
                        AmountText="@(Model.Free == 0m ? L["Month_AllPlanned"].Value : null)" Note="@FreeNote" />
        </div>
    </div>

    @if (!ReadOnly)
    {
        <div class="month-actions" role="group" aria-label="@L["Month_ActionsLabel"]" data-testid="month-actions">
            <DuofyButton Kind="ButtonKind.Primary" Disabled="!CanBook" OnClick="OnNewBooking"><span data-testid="month-action-booking">@L["Month_ActionBooking"]</span></DuofyButton>
            <DuofyButton Kind="ButtonKind.Secondary" Disabled="!CanAddPosition" OnClick="OnNewPosition"><span data-testid="month-action-position">@L["Month_ActionPosition"]</span></DuofyButton>
            <DuofyButton Kind="ButtonKind.Secondary" OnClick="OnTick"><span data-testid="month-action-tick">@L["Month_ActionTick"]</span></DuofyButton>
        </div>
    }

    @* Die vier Abschnitte stehen ab 1280 px in zwei Spalten, darunter untereinander wie bisher. *@
    <div class="month-sections page-wide">
    <section class="month-section" aria-labelledby="month-pots-heading" data-testid="month-pots">
        <h2 class="month-section-title" id="month-pots-heading">@L["Month_PotsHeading"]</h2>
        @foreach (var pot in Model.Pots)
        {
            <div data-testid="@($"month-pot-{pot.Pot}")">
                <TargetActualBar Caption="@L["Plan_Quota", L[$"Pot_{pot.Pot}"], pot.Target, pot.Actual.ToString("0.#", German)]"
                                 Target="pot.Target" Actual="pot.Actual" />
            </div>
        }
    </section>

    <section class="month-section" data-testid="month-gap">
        @if (SeesBookings)
        {
            <BarChart Caption="@L["Month_GapCaption"]" Items="GapBars" ValueText="MoneyText.Format" />
        }
        else
        {
            <p class="month-hint" data-testid="month-gap-not-shared">@L["Grant_NotShared"]</p>
        }
    </section>

    <section class="month-section" aria-labelledby="month-recent-heading" data-testid="month-recent">
        <h2 class="month-section-title" id="month-recent-heading">@L["Month_RecentHeading"]</h2>
        @if (!SeesBookings)
        {
            <p class="month-hint" data-testid="month-recent-not-shared">@L["Grant_NotShared"]</p>
        }
        else if (Model.Bookings.Count > 0 || Model.CarryOvers.Count > 0)
        {
            <LineTable Caption="@L["Month_RecentHeading"]" HideCaption="true" Rows="RecentRows" />
        }
        else if (BookingsMissing.Count == 0)
        {
            <p class="month-hint" data-testid="month-recent-empty">@L["Month_RecentEmpty"]</p>
        }
        @if (SeesBookings && BookingsMissing.Count > 0)
        {
            <p class="month-hint" data-testid="month-recent-missing">@L["Month_BookingsMissing", string.Join(", ", BookingsMissing)]</p>
        }
    </section>

    <section class="month-section" aria-labelledby="month-due-heading" data-testid="month-due">
        <h2 class="month-section-title" id="month-due-heading">@L["Month_DueHeading"]</h2>
        @if (!SeesBookings)
        {
            <p class="month-hint" data-testid="month-due-not-shared">@L["Grant_NotShared"]</p>
        }
        else if (Model.Due.Count == 0)
        {
            <p class="month-hint" data-testid="month-due-empty">@L["Month_DueEmpty"]</p>
        }
        else
        {
            <LineTable Caption="@L["Month_DueCaption"]" HideCaption="true" Rows="DueRows" />
        }
    </section>
    </div>
</div>

@code {
    private static readonly CultureInfo German = new("de-DE");

    [Parameter, EditorRequired] public MonthOverviewModel Model { get; set; } = default!;

    /// <summary>Im Haushalt: nur lesen, keine Aktionen.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>False, wenn die gewählte Person ihre Buchungen nicht teilt (Spec 68).</summary>
    [Parameter] public bool SeesBookings { get; set; } = true;

    /// <summary>Die Vornamen derer, deren Buchungen fehlen, weil sie sie nicht freigegeben haben (nur im Haushalt).</summary>
    [Parameter] public IReadOnlyList<string> BookingsMissing { get; set; } = [];

    [Parameter] public bool CanBook { get; set; } = true;
    [Parameter] public bool CanAddPosition { get; set; } = true;
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnNewBooking { get; set; }
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnNewPosition { get; set; }
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnTick { get; set; }

    // Was im Frei-Betrag steckt (Spec 66, R9): der Übertrag, sobald einer da ist. Im Haushalt steht dazu, wessen Übertrag
    // fehlen kann. Das steht bei jedem ohne Freigabe der Buchungen und verrät so nicht, ob es wirklich einen gibt.
    private string? FreeNote
    {
        get
        {
            var incoming = Model.CarryOvers.Where(c => c.Incoming).ToList();
            var parts = new List<string>();
            if (incoming.Count > 0)
            {
                parts.Add(L["Month_FreeCarryOver", MoneyText.Format(incoming.Sum(c => c.Amount))].Value);
            }
            if (BookingsMissing.Count > 0)
            {
                parts.Add(L["Month_FreeCarryOverMissing", string.Join(", ", BookingsMissing)].Value);
            }
            return parts.Count > 0 ? string.Join(" ", parts) : null;
        }
    }

    // Die Lücke je Topf als Länge ohne Vorzeichen; ob mehr oder weniger, sagt der Name des Balkens.
    private IReadOnlyList<ChartBar> GapBars => Model.Pots
        .Select(pot => new ChartBar(
            L[pot.Gap > 0m ? "Month_GapMore" : pot.Gap < 0m ? "Month_GapLess" : "Month_GapEqual", L[$"Pot_{pot.Pot}"].Value].Value,
            Math.Abs(pot.Gap)))
        .ToList();

    // Der Übertrag steht als eigene Zeile über den Buchungen (Spec 66, R9).
    private IReadOnlyList<LineTableRow> RecentRows => MonthCarryOverText.Rows(Model.CarryOvers, L)
        .Concat(Model.Bookings.Select(b => new LineTableRow(b.Date.ToString("d", German), b.Amount, b.Detail, TestId: $"month-recent-{b.Id}")))
        .ToList();

    private IReadOnlyList<LineTableRow> DueRows => Model.Due
        .Select(d => new LineTableRow(
            d.Label,
            d.Open,
            string.Join(" · ", new[] { L["Month_DueOn", d.Due.ToString("d", German)].Value, d.Owner }.OfType<string>()),
            Trailing: Badge(d.Overdue),
            TestId: $"month-due-item-{(d.Overdue ? "overdue" : "upcoming")}"))
        .ToList();

    // Beides ist gekennzeichnet, getrennt durch das Wort und nicht nur durch eine Farbe.
    private RenderFragment Badge(bool overdue) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "month-due-badge");
        builder.AddAttribute(2, "data-testid", overdue ? "month-overdue-badge" : "month-upcoming-badge");
        builder.AddContent(3, L[overdue ? "Month_Overdue" : "Month_Upcoming"].Value);
        builder.CloseElement();
    };
}
