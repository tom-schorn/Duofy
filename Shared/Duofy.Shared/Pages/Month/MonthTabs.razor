@inject IStringLocalizer<SharedResources> L

@* Die Tabs der Monatsseite: eine Leiste mit drei Knöpfen (Übersicht, Plan, Buchungen). Der gewählte hat die Rolle
   "ausgewählt" und eine Linie darunter, nicht nur eine Farbe. Mit den Pfeiltasten wechselt man vom gewählten Tab zum
   Nachbarn, und der Fokus geht mit; nur der gewählte Tab ist mit der Tabulatortaste erreichbar. Der Inhalt
   steht darunter in der Seite, die den gewählten Tab hält (so bleibt er beim Blättern zwischen Monaten). *@
<div class="month-tabs" role="tablist" aria-label="@L["Month_TabsLabel"]">
    @foreach (var tab in Tabs)
    {
        var current = tab;
        <button @ref="buttons[current]" type="button" role="tab" class="month-tab" id="@($"month-tab-{Key(tab)}")"
                aria-selected="@(tab == Active ? "true" : "false")" aria-controls="month-panel"
                tabindex="@(tab == Active ? 0 : -1)" data-testid="@($"month-tab-{Key(tab)}")"
                @onclick="() => Select(current)" @onkeydown="OnKey">@L[$"Month_Tab{tab}"]</button>
    }
</div>

@code {
    private static readonly MonthTab[] Tabs = [MonthTab.Overview, MonthTab.Plan, MonthTab.Bookings];

    private readonly Dictionary<MonthTab, ElementReference> buttons = [];

    // Nach einem Pfeil: den Fokus auf den neuen Tab legen, sobald er gezeichnet ist.
    private bool moveFocus;

    [Parameter, EditorRequired] public MonthTab Active { get; set; }

    [Parameter] public EventCallback<MonthTab> ActiveChanged { get; set; }

    /// <summary>Die Kennung eines Tabs für Tests und Beschriftungen: overview, plan, bookings.</summary>
    public static string Key(MonthTab tab) => tab.ToString().ToLowerInvariant();

    private Task Select(MonthTab tab) => ActiveChanged.InvokeAsync(tab);

    private Task OnKey(KeyboardEventArgs e)
    {
        var step = e.Key switch { "ArrowRight" => 1, "ArrowLeft" => Tabs.Length - 1, _ => 0 };
        if (step == 0)
        {
            return Task.CompletedTask;
        }
        moveFocus = true;
        return Select(Tabs[(Array.IndexOf(Tabs, Active) + step) % Tabs.Length]);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (moveFocus)
        {
            moveFocus = false;
            await buttons[Active].FocusAsync();
        }
    }
}
