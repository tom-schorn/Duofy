@using System.Globalization
@using Duofy.Schemas
@inject IStringLocalizer<SharedResources> L

@* Der Reiter Buchungen (Spec 24; Spec 82, R15): die Buchungen, die diesem Planmonat zugeordnet sind, neueste zuerst, als
   Tabelle in voller Breite mit Datum, Name, Posten, Konto (im Haushalt der Vorname), Topf und Betrag. Ausgaben stehen rot mit
   Minus, Einnahmen ohne Vorzeichen, eine Umbuchung ohne Richtung. Die Art steht als Wort an der Zeile (Spec 51, R9). Liegt das
   Datum in einem anderen Monat als dem Planmonat, steht das unter dem Datum. Ein Übertrag ist keine Buchung, sondern eine eigene Zeile; "Übertrag aus" gilt als am
   1. des Planmonats gebucht und steht am Ende der neuesten-zuerst-Liste, "Übertrag nach" behält den letzten Tag des Monats und steht
   oben (Spec 66, R9; Spec 123, R2).
   Die Reihenfolge entsteht hier und nicht beim Aufrufer, damit der persönliche Plan und der Haushaltsplan nicht auseinanderlaufen.
   Am Handy wird jede Zeile eine kleine Karte (Stylesheet); dazwischen scrollt die Tabelle waagerecht in ihrem eigenen Bereich,
   wo sie nicht passt (Spec 123, R1), statt abgeschnitten zu werden. *@
<div class="month-bookings card" data-testid="month-bookings">
    @* "Noch keine Buchungen" wäre falsch, wenn Buchungen nur nicht freigegeben sind (Spec 46, A8). *@
    @if (Rows.Count == 0 && CarryOvers.Count == 0)
    {
        @if (Missing.Count == 0)
        {
            <p class="month-hint" data-testid="month-bookings-empty">@L["Month_BookingsEmpty"]</p>
        }
    }
    else
    {
        <div class="bookings-scroll" role="region" tabindex="0" aria-label="@L["Month_BookingsCaption"]" data-testid="month-bookings-scroll">
        <table class="bookings-table">
            <caption class="visually-hidden">@L["Month_BookingsCaption"]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["Month_ColDate"]</th>
                    <th scope="col">@L["Month_ColName"]</th>
                    <th scope="col">@L["Month_ColPosition"]</th>
                    <th scope="col">@(Household ? L["Month_ColPerson"] : L["Month_ColAccount"])</th>
                    <th scope="col">@L["Month_ColPot"]</th>
                    <th scope="col" class="bookings-amount">@L["Month_ColAmount"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Lines)
                {
                    @if (line.Booking is { } row)
                    {
                        <tr class="bookings-row" data-testid="@($"month-booking-{row.Id}")">
                            <td class="bookings-date">
                                @row.Date.ToString("d", German)
                                @if (row.OtherMonth)
                                {
                                    <span class="month-hint" data-testid="@($"month-booking-other-{row.Id}")">@L["Month_OtherMonth", row.Date.ToString("MMMM", German)]</span>
                                }
                            </td>
                            <td class="bookings-name">
                                <span class="bookings-title">@(row.Name ?? row.Purpose ?? L[$"BookingKind_{row.Kind}"].Value)</span>
                                <BookingKindBadge Kind="@row.Kind" />
                            </td>
                            <td class="bookings-position">
                                @if (row.Positions is { Count: > 0 } positions)
                                {
                                    @string.Join(", ", positions)
                                }
                                else
                                {
                                    <span class="muted">@(row.Kind == BookingKinds.Transfer ? "—" : L["Plan_Unplanned"])</span>
                                }
                            </td>
                            <td class="bookings-account">@row.Detail</td>
                            <td class="bookings-pot">
                                @foreach (var pot in row.Pots ?? [])
                                {
                                    <span class="bookings-pot-item"><span class="@($"dot dot--{pot}")" aria-hidden="true"></span>@L[$"Pot_{pot}"]</span>
                                }
                            </td>
                            <td class="@AmountClass(row.Kind)">@Amount(row)</td>
                        </tr>
                    }
                    else if (line.Carry is { } carry)
                    {
                        <tr class="bookings-row bookings-row--carry" data-testid="@(carry.Incoming ? "month-carry-over-in" : "month-carry-over-out")">
                            <td class="bookings-date">@CarryDate(carry).ToString("d", German)</td>
                            <td class="bookings-name">
                                <span class="bookings-title">@L[carry.Incoming ? "Month_CarryOverIn" : "Month_CarryOverOut", carry.Month.ToString("MMMM", German)]</span>
                                <BookingKindBadge Kind="@MonthBookingText.CarryOver" />
                            </td>
                            <td class="bookings-position muted">—</td>
                            <td class="bookings-account">@carry.Owner</td>
                            <td class="bookings-pot muted">—</td>
                            <td class="bookings-amount num @(carry.Amount < 0m ? "over" : null)">@MoneyText.Format(carry.Amount)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        </div>
    }
    @if (Missing.Count > 0)
    {
        <p class="month-hint" data-testid="month-bookings-missing">@L["Month_BookingsMissing", string.Join(", ", Missing)]</p>
    }
</div>

@code {
    private static readonly CultureInfo German = new("de-DE");

    [Parameter, EditorRequired] public IReadOnlyList<MonthBookingRow> Rows { get; set; } = [];

    /// <summary>Die Vornamen derer, deren Buchungen fehlen, weil sie sie nicht freigegeben haben (nur im Haushalt).</summary>
    [Parameter] public IReadOnlyList<string> Missing { get; set; } = [];

    /// <summary>Die Überträge des Monats als eigene Zeilen.</summary>
    [Parameter] public IReadOnlyList<MonthCarryOverRow> CarryOvers { get; set; } = [];

    /// <summary>Im Haushaltsplan nennt die vierte Spalte die Person statt des Kontos.</summary>
    [Parameter] public bool Household { get; set; }

    // Eine Zeile der Tabelle: eine Buchung oder ein Übertrag, dazu das Datum, nach dem sortiert wird.
    private sealed record Line(DateOnly Date, int Tie, MonthBookingRow? Booking, MonthCarryOverRow? Carry);

    // Neueste zuerst nach Datum; OrderBy ist stabil, gleiche Tage behalten die Reihenfolge der API. Bei gleichem Tag steht der
    // ausgehende Übertrag (Ende des Tages) vor den Buchungen und der eingehende (Beginn des Tages) danach (Spec 123, R2).
    private IEnumerable<Line> Lines => Rows.Select(r => new Line(r.Date, 1, r, null))
        .Concat(CarryOvers.Select(c => new Line(CarryDate(c), c.Incoming ? 2 : 0, null, c)))
        .OrderByDescending(l => l.Date).ThenBy(l => l.Tie);

    // Der eingehende Übertrag gilt als am 1. des Planmonats gebucht ("aus Oktober" steht im November am 1.11.). Der ausgehende
    // behält sein Buchungsdatum, den letzten Tag des Planmonats; Month ist dort der Folgemonat (Spec 123, R2, Ergänzung 2026-11-11).
    private static DateOnly CarryDate(MonthCarryOverRow row) => row.Incoming ? row.Month.AddMonths(1) : row.Month.AddDays(-1);

    // Ausgaben rot mit Minus, Einnahmen ohne Vorzeichen (Tom, 03.11.2026), Umbuchungen ohne Richtung.
    private static string Amount(MonthBookingRow row) =>
        row.Kind == BookingKinds.Expense ? $"−{MoneyText.Format(row.Amount)}" : MoneyText.Format(row.Amount);

    private static string AmountClass(string kind) =>
        kind == BookingKinds.Expense ? "bookings-amount num amount-expense" : "bookings-amount num";
}
