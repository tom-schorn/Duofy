@using System.Globalization
@inject IStringLocalizer<SharedResources> L

@* Der Tab Buchungen (Spec 24): die Buchungen, die diesem Planmonat zugeordnet sind, neueste zuerst, mit Datum, Betrag und
   Konto (im Haushalt mit dem Vornamen). Liegt das Datum in einem anderen Monat als dem Planmonat, steht das daneben.
   Ein Übertrag ist keine Buchung und steht als eigene Zeile darüber (Spec 66, R9). *@
<div class="month-bookings" data-testid="month-bookings">
    @if (Rows.Count == 0 && CarryOvers.Count == 0)
    {
        <p class="month-hint" data-testid="month-bookings-empty">@L["Month_BookingsEmpty"]</p>
    }
    else
    {
        <LineTable Caption="@L["Month_BookingsCaption"]" HideCaption="true" Rows="TableRows" />
    }
    @if (Missing.Count > 0)
    {
        <p class="month-hint" data-testid="month-bookings-missing">@L["Month_BookingsMissing", string.Join(", ", Missing)]</p>
    }
</div>

@code {
    private static readonly CultureInfo German = new("de-DE");

    [Parameter, EditorRequired] public IReadOnlyList<MonthBookingRow> Rows { get; set; } = [];

    /// <summary>Die Vornamen derer, deren Buchungen fehlen, weil sie sie nicht freigegeben haben (nur im Haushalt).</summary>
    [Parameter] public IReadOnlyList<string> Missing { get; set; } = [];

    /// <summary>Die Überträge des Monats als eigene Zeilen.</summary>
    [Parameter] public IReadOnlyList<MonthCarryOverRow> CarryOvers { get; set; } = [];

    private IReadOnlyList<LineTableRow> TableRows => MonthCarryOverText.Rows(CarryOvers, L)
        .Concat(Rows.Select(b => new LineTableRow(
            b.Date.ToString("d", German),
            b.Amount,
            b.Detail,
            Trailing: b.OtherMonth ? Hint(b) : null,
            TestId: $"month-booking-{b.Id}")))
        .ToList();

    private RenderFragment Hint(MonthBookingRow row) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "month-hint");
        builder.AddAttribute(2, "data-testid", $"month-booking-other-{row.Id}");
        builder.AddContent(3, L["Month_OtherMonth", row.Date.ToString("MMMM", German)].Value);
        builder.CloseElement();
    };
}
