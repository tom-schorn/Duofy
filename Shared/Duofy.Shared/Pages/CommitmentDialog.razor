@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@using Duofy.Shared.Dialogs
@inject ICommitmentApi CommitmentApi
@inject ActiveMember Member
@inject IStringLocalizer<SharedResources> L

@* Der Dialog zum Anlegen und Ändern eines Vertrags, in drei Schritten (Spec 17) auf dem Schritt-Dialog (Spec 11):
   1 Was (Bezeichnung, Art, Betrag, Kategorie, Topf), 2 Wann (Rhythmus, erste und letzte Zahlung, nächster Termin),
   3 Wer und Wohin (Konten, Zahlungsart, durchlaufender Posten) mit der Zusammenfassung vor dem Speichern.

   Alle Eingaben stehen in `draft`, einem CommitmentDraft. Dort stehen auch die Regeln, was zu welcher Art gehört:
   fester Topf bei der Einnahme, kein Zielkonto bei einer Einnahme. Angeboten werden nur Ausgabe und Einnahme;
   Sparziel und Schuld bekommen einen eigenen Bereich, ihre gespeicherten Verträge öffnet die Vertragsseite nicht hier.

   Weiter prüft die Felder des Schritts mit denselben Regeln und Texten wie die API; was nur die API prüfen kann
   (gehört das Konto der Person, gibt es die Kategorie noch), steht nach dem Speichern oben in Schritt 3. *@

<StepDialog OnFinish="SaveAsync" FinishText="@L["CommitmentDialog_Save"]" Busy="busy">
    <DialogStep Title="@L["CommitmentDialog_StepWhat"]">
        <StepField Label="@L["Field_CommitmentName"]" InputId="commitment-name-input" Required
                   IsFilled="() => !string.IsNullOrWhiteSpace(draft.Name)" TestId="commitment-name-field">
            <MudTextField T="string" @bind-Value="draft.Name" MaxLength="CommitmentRules.NameMaxLength" Variant="Variant.Outlined"
                          InputId="commitment-name-input" aria-describedby="commitment-name-input-error" data-testid="commitment-name" />
        </StepField>

        <StepField Label="@L["Field_CommitmentType"]" InputId="commitment-type-input" TestId="commitment-type-field">
            @if (draft.IsOfferedType)
            {
                <NativeSelect Value="@draft.Type" ValueChanged="OnTypeChanged" id="commitment-type-input" data-testid="commitment-type">
                    @foreach (var type in CommitmentDraft.OfferedTypes)
                    {
                        <option value="@type">@L[$"CommitmentDialog_Kind_{type}"]</option>
                    }
                </NativeSelect>
            }
            else
            {
                @* Ein gespeichertes Sparziel oder eine Schuld behält ihre Art; anlegen lassen sie sich hier nicht mehr. *@
                <MudTextField T="string" Value="@L[$"CommitmentType_{draft.Type}"]" ReadOnly="true" Variant="Variant.Outlined"
                              InputId="commitment-type-input" data-testid="commitment-type-fixed" />
            }
        </StepField>

        <StepField Label="@L["Field_CommitmentAmount"]" InputId="commitment-amount-input" Required IsFilled="() => draft.Amount is not null"
                   Validate="AmountError" TestId="commitment-amount-field">
            <MudNumericField T="decimal?" @bind-Value="draft.Amount" Culture="German" Format="0.00" Min="0" HideSpinButtons="true"
                             Variant="Variant.Outlined" InputId="commitment-amount-input" aria-describedby="commitment-amount-input-error"
                             data-testid="commitment-amount" />
        </StepField>

        @* Die Kategorie war schon vorher Pflicht, bevor etwas an die API ging; ihr Satz bleibt derselbe. *@
        <StepField Label="@L["Field_Category"]" InputId="commitment-category-input"
                   Validate="@(() => draft.CategoryId is null ? L["CommitmentDialog_CategoryRequired"].Value : null)"
                   TestId="commitment-category-field">
            <NativeSelect Value="@Key(draft.CategoryId)" ValueChanged="OnCategoryChanged" id="commitment-category-input"
                          aria-describedby="commitment-category-input-error" data-testid="commitment-category">
                <option value="">@L["CommitmentDialog_Choose"]</option>
                @foreach (var group in OfferedCategories())
                {
                    <optgroup label="@L[$"CategoryGroup_{group.Key}"]">
                        @foreach (var category in group)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </optgroup>
                }
            </NativeSelect>
        </StepField>

        <StepField Label="@L["Field_Pot"]" InputId="commitment-pot-input" TestId="commitment-pot-field">
            @if (draft.PotIsFixed)
            {
                @* Die Einnahme hat ihren Topf fest; er steht nur zur Ansicht da. *@
                <MudTextField T="string" Value="@L[$"Pot_{draft.Pot}"]" ReadOnly="true" Variant="Variant.Outlined"
                              HelperText="@L["Field_PotFixedHint"]" InputId="commitment-pot-input" data-testid="commitment-pot-fixed" />
            }
            else
            {
                <NativeSelect Value="@draft.Pot" ValueChanged="OnPotChanged" id="commitment-pot-input" data-testid="commitment-pot">
                    @foreach (var pot in draft.OfferedPots)
                    {
                        <option value="@pot">@L[$"Pot_{pot}"]</option>
                    }
                </NativeSelect>
            }
        </StepField>
    </DialogStep>

    <DialogStep Title="@L["CommitmentDialog_StepWhen"]">
        <StepField Label="@L["Field_IntervalMonths"]" InputId="commitment-interval-input" Required
                   IsFilled="() => draft.IntervalMonths is not null"
                   Validate="@(() => draft.HasValidInterval ? null : ErrorTexts.For(L, ErrorCodes.CommitmentIntervalInvalid))"
                   TestId="commitment-interval-field">
            <MudNumericField T="int?" @bind-Value="draft.IntervalMonths" Min="1" Max="CommitmentRules.MaxIntervalMonths"
                             HelperText="@L["Field_IntervalMonthsHint"]" Variant="Variant.Outlined" InputId="commitment-interval-input"
                             aria-describedby="commitment-interval-input-error" data-testid="commitment-interval" />
        </StepField>

        @* Die erste Zahlung legt auch den Zahltag fest; die letzte ist freiwillig. *@
        <StepField Label="@L["Field_FirstDueDate"]" InputId="commitment-first-due-input" TestId="commitment-first-due-field">
            <MudTextField T="string" Value="@DateText(draft.FirstDueDate)" ValueChanged="OnFirstDueDateChanged" InputType="InputType.Date"
                          Variant="Variant.Outlined" InputId="commitment-first-due-input" data-testid="commitment-first-due" />
        </StepField>

        @* Die letzte Zahlung eines bestehenden Vertrags zu setzen oder zu leeren, beendet ihn oder holt ihn zurück;
           das braucht die Freigabe Löschen (Spec 68, A17). Ohne sie ist das Feld nur lesbar und nennt den Grund. *@
        <StepField Label="@L["Field_LastDueDate"]" InputId="commitment-last-due-input" Validate="EndError" TestId="commitment-last-due-field">
            <MudTextField T="string" Value="@DateText(draft.LastDueDate)" ValueChanged="OnLastDueDateChanged" InputType="InputType.Date"
                          HelperText="@L["Field_LastDueDateHint"]" Variant="Variant.Outlined" ReadOnly="endLocked"
                          Class="@GrantLock.Class(!endLocked)" InputId="commitment-last-due-input"
                          aria-describedby="@LastDueDescribedBy" data-testid="commitment-last-due" />
            @if (endLocked)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" id="@LastDueReasonId"
                         data-testid="commitment-last-due-reason">@L["Grant_NotGranted", ownerName ?? ""]</MudText>
            }
        </StepField>

        @if (draft.HasValidInterval)
        {
            <p class="mud-typography mud-typography-body1" aria-live="polite" data-testid="commitment-next-due">
                @(draft.NextDueDate(Today) is { } next
                    ? L["CommitmentDialog_NextDue", next.ToString("dd.MM.yyyy", German)]
                    : L["CommitmentDialog_NoNextDue"])
            </p>
        }
    </DialogStep>

    <DialogStep Title="@L["CommitmentDialog_StepWhereTo"]">
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" data-testid="commitment-error">@error</MudAlert>
        }

        @* Leer heißt beim zahlenden Konto: das Standardkonto, und zwar das, das am Tag der Zahlung Standard ist.
           Eine Ausgabe geht von einem Konto ab und auf Wunsch auf ein eigenes (dann ist sie eine Umbuchung);
           eine Einnahme kommt von außen und geht auf ein Konto. *@
        @if (draft.OffersTargetAccount)
        {
            <StepField Label="@L["CommitmentDialog_PaidFrom"]" InputId="commitment-account-input" TestId="commitment-account-field">
                <CommitmentAccountSelect Value="draft.AccountId" ValueChanged="OnAccountChanged" Accounts="Accounts"
                                         EmptyText="@L["CommitmentDialog_DefaultAccount"]" InputId="commitment-account-input"
                                         Label="@L["CommitmentDialog_PaidFrom"]" TestId="commitment-account" />
            </StepField>
            <StepField Label="@L["CommitmentDialog_PaidTo"]" InputId="commitment-counter-account-input" Validate="SameAccountError"
                       TestId="commitment-counter-account-field">
                <CommitmentAccountSelect Value="draft.CounterAccountId" ValueChanged="OnCounterAccountChanged" Accounts="Accounts"
                                         EmptyText="@L["CommitmentDialog_PaidToOutside"]" InputId="commitment-counter-account-input"
                                         Label="@L["CommitmentDialog_PaidTo"]" TestId="commitment-counter-account" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CommitmentDialog_PaidToHint"]</MudText>
            </StepField>
            @* Ein Sparziel gibt es nur, wenn die Person welche hat: Die Rate fließt dann dem Ziel zu (Issue 32). *@
            @* Eine Schuld oder ein Kredit: Die Rate zahlt dann darauf ein; sie geht an den Gläubiger, nicht auf ein eigenes Konto (Issue 31). *@
            @if (draft.OffersSavingsGoal && Debts.Count > 0 && draft.CounterAccountId is null)
            {
                <StepField Label="@L["CommitmentDialog_Debt"]" InputId="commitment-debt-input" TestId="commitment-debt-field">
                    <NativeSelect Value="@Key(draft.DebtId)" ValueChanged="OnDebtChanged" id="commitment-debt-input"
                                  aria-describedby="commitment-debt-input-error" data-testid="commitment-debt">
                        <option value="">@L["CommitmentDialog_NoDebt"]</option>
                        @foreach (var debt in Debts)
                        {
                            <option value="@debt.Id">@debt.Name</option>
                        }
                    </NativeSelect>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CommitmentDialog_DebtHint"]</MudText>
                </StepField>
            }
            @if (draft.OffersSavingsGoal && SavingsGoals.Count > 0)
            {
                <StepField Label="@L["CommitmentDialog_Goal"]" InputId="commitment-goal-input" Validate="GoalError"
                           TestId="commitment-goal-field">
                    <NativeSelect Value="@Key(draft.SavingsGoalId)" ValueChanged="OnGoalChanged" id="commitment-goal-input"
                                  aria-describedby="commitment-goal-input-error" data-testid="commitment-goal">
                        <option value="">@L["CommitmentDialog_NoGoal"]</option>
                        @foreach (var goal in SavingsGoals)
                        {
                            <option value="@goal.Id">@goal.Name</option>
                        }
                    </NativeSelect>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["CommitmentDialog_GoalHint"]</MudText>
                </StepField>
            }
        }
        else
        {
            <StepField Label="@L["CommitmentDialog_PaidTo"]" InputId="commitment-account-input" TestId="commitment-account-field">
                <CommitmentAccountSelect Value="draft.AccountId" ValueChanged="OnAccountChanged" Accounts="Accounts"
                                         EmptyText="@L["CommitmentDialog_DefaultAccount"]" InputId="commitment-account-input"
                                         Label="@L["CommitmentDialog_PaidTo"]" TestId="commitment-account" />
            </StepField>
        }

        <StepField Label="@L["Field_PaymentMethod"]" InputId="commitment-payment-method-input"
                   Validate="@(() => draft.PaymentMethod.Length == 0 ? ErrorTexts.For(L, ErrorCodes.PaymentMethodInvalid) : null)"
                   TestId="commitment-payment-method-field">
            <CommitmentPaymentMethodSelect @bind-Value="draft.PaymentMethod" InputId="commitment-payment-method-input"
                                           TestId="commitment-payment-method" />
        </StepField>

        <MudSwitch T="bool" @bind-Value="draft.PassThrough" Color="Color.Primary" Label="@L["Field_PassThrough"]"
                   data-testid="commitment-pass-through" />

        <table class="line-table" data-testid="commitment-summary">
            <caption class="line-table-caption">@L["CommitmentDialog_Summary"]</caption>
            <tbody>
                <tr data-testid="commitment-summary-name">
                    <th scope="row">@L["Field_CommitmentName"]</th>
                    <td>@draft.Name.Trim()</td>
                </tr>
                <tr data-testid="commitment-summary-kind">
                    <th scope="row">@L["Field_CommitmentType"]</th>
                    <td>@KindText</td>
                </tr>
                <tr data-testid="commitment-summary-amount">
                    <th scope="row">@L["Field_CommitmentAmount"]</th>
                    <td class="line-table-amount">@(draft.Amount is { } amount ? MoneyText.Format(amount) : "")</td>
                </tr>
                <tr data-testid="commitment-summary-interval">
                    <th scope="row">@L["CommitmentDialog_Interval"]</th>
                    <td>@(draft.HasValidInterval ? IntervalTexts.For(L, draft.IntervalMonths!.Value) : "")</td>
                </tr>
                @if (draft.OffersTargetAccount)
                {
                    <tr data-testid="commitment-summary-from">
                        <th scope="row">@L["CommitmentDialog_PaidFrom"]</th>
                        <td>@AccountText(draft.AccountId, L["CommitmentDialog_DefaultAccount"])</td>
                    </tr>
                    <tr data-testid="commitment-summary-to">
                        <th scope="row">@L["CommitmentDialog_PaidTo"]</th>
                        <td>@AccountText(draft.CounterAccountId, L["CommitmentDialog_PaidToOutside"])</td>
                    </tr>
                    @if (draft.EffectiveDebtId is { } debtId)
                    {
                        <tr data-testid="commitment-summary-debt">
                            <th scope="row">@L["CommitmentDialog_Debt"]</th>
                            <td>@DebtName(debtId)</td>
                        </tr>
                    }
                    @if (draft.EffectiveSavingsGoalId is { } goalId)
                    {
                        <tr data-testid="commitment-summary-goal">
                            <th scope="row">@L["CommitmentDialog_Goal"]</th>
                            <td>@GoalName(goalId)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr data-testid="commitment-summary-to">
                        <th scope="row">@L["CommitmentDialog_PaidTo"]</th>
                        <td>@AccountText(draft.AccountId, L["CommitmentDialog_DefaultAccount"])</td>
                    </tr>
                }
                <tr data-testid="commitment-summary-payment-method">
                    <th scope="row">@L["Field_PaymentMethod"]</th>
                    <td>@(draft.PaymentMethod.Length == 0 ? L["CommitmentDialog_Choose"] : L[$"PaymentMethod_{draft.PaymentMethod}"])</td>
                </tr>
            </tbody>
        </table>
    </DialogStep>
</StepDialog>

@code {

    private static readonly CultureInfo German = new("de-DE");

    // Der Dialog selbst, über den er sich nach dem Speichern schließt.
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Der Vertrag, der geändert wird; null beim Anlegen.</summary>
    [Parameter]
    public CommitmentResponse? Existing { get; set; }

    /// <summary>Alle Kategorien der Person, eingebaute und eigene, nach Gruppen geordnet.</summary>
    [Parameter]
    public IReadOnlyList<CategoryResponse> Categories { get; set; } = [];

    /// <summary>Alle Konten der Person. Aufgelöste werden nicht zur Wahl angeboten.</summary>
    [Parameter]
    public IReadOnlyList<AccountChoice> Accounts { get; set; } = [];

    /// <summary>Die Sparziele der Person für die Wahl im Schritt "Wer und Wohin"; leer, wenn es keine gibt oder die Person sie nicht sehen darf.</summary>
    [Parameter]
    public IReadOnlyList<SavingsGoalResponse> SavingsGoals { get; set; } = [];

    /// <summary>Die Schulden und Kredite der Person für die Wahl im Schritt "Wer und Wohin"; leer, wenn es keine gibt oder die Person sie nicht sehen darf.</summary>
    [Parameter]
    public IReadOnlyList<DebtResponse> Debts { get; set; } = [];

    /// <summary>Das Datum von heute; so ist die erste Zahlung beim Anlegen vorbelegt, und ab heute zählt der nächste Termin.</summary>
    [Parameter]
    public DateOnly Today { get; set; }

    private CommitmentDraft draft = default!;
    private string? error;
    private bool busy;

    // Die Person, für die der Dialog geöffnet wurde; sie bleibt, auch wenn der Umschalter inzwischen woanders steht (Spec 68, A15).
    private Guid? owner;
    private string? ownerName;

    // True, wenn die letzte Zahlung nicht geändert werden darf: ein bestehender Vertrag ohne die Freigabe Löschen.
    private bool endLocked;

    // Eine eigene Kennung für den Grund, weil die Vertragsseite unter dem Dialog ihren Grund mit der Kennung von GrantLock zeigt.
    private const string LastDueReasonId = "commitment-last-due-reason";

    // Das Feld verweist auf seinen Fehler im Schritt und, wenn es gesperrt ist, auf den Grund.
    private string LastDueDescribedBy => endLocked
        ? $"commitment-last-due-input-error {LastDueReasonId}"
        : "commitment-last-due-input-error";

    protected override void OnInitialized()
    {
        owner = Member.Owner;
        ownerName = Member.Name;
        endLocked = Existing is not null && !Member.Allows(GrantAreas.Commitments, AccessLevelKeys.Delete);
        draft = Existing is null ? CommitmentDraft.ForNew(Today) : CommitmentDraft.From(Existing);
    }

    // Leere Auswahl heißt "", sonst die Kennung als Text. So lassen sich Auswahlfelder an Guid? binden.
    private static string Key(Guid? id) => id?.ToString() ?? "";

    private static Guid? ParseId(string? text) => Guid.TryParse(text, out var id) ? id : null;

    private static string DateText(DateOnly? date) => date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "";

    // Ein leeres oder unvollständiges Datumsfeld ergibt null.
    private static DateOnly? ParseDate(string? value) =>
        DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) ? date : null;

    private string KindText => draft.IsOfferedType ? L[$"CommitmentDialog_Kind_{draft.Type}"] : L[$"CommitmentType_{draft.Type}"];

    private string GoalName(Guid id) => SavingsGoals.FirstOrDefault(g => g.Id == id)?.Name ?? string.Empty;

    private string AccountText(Guid? id, string empty) => id is null ? empty : Accounts.FirstOrDefault(a => a.Id == id)?.Name ?? empty;

    // Dieselbe Regel und derselbe Satz wie in der API: größer als 0, höchstens zwei Nachkommastellen, nicht zu groß.
    private string? AmountError() => draft.Amount is { } amount
        && (amount <= 0 || amount > CommitmentRules.MaxAmount || decimal.Round(amount, 2) != amount)
            ? ErrorTexts.For(L, ErrorCodes.AmountInvalid)
            : null;

    // Ende vor Start lehnt der Dialog ab (Spec 17, R2). Ein gespeicherter Vertrag, der vor seiner ersten Zahlung beendet
    // wurde (Beenden setzt dann den Tag davor), bleibt änderbar, solange erste und letzte Zahlung bleiben, wie sie sind.
    private string? EndError()
    {
        var unchanged = Existing is not null
            && draft.FirstDueDate == Existing.FirstDueDate
            && draft.LastDueDate == Existing.LastDueDate;
        return draft.EndsBeforeStart && !unchanged ? L["CommitmentDialog_EndBeforeStart"].Value : null;
    }

    // Wie in der API: Das Zielkonto muss ein anderes sein als das zahlende, auch wenn das das Standardkonto ist.
    private string? SameAccountError()
    {
        var paying = draft.AccountId ?? Accounts.FirstOrDefault(a => a.IsDefault)?.Id;
        return draft.CounterAccountId is { } counter && counter == paying
            ? ErrorTexts.For(L, ErrorCodes.CommitmentTargetSameAccount)
            : null;
    }

    private void OnTypeChanged(string type)
    {
        // Nur die angebotenen Arten; ein gespeichertes Sparziel zeigt gar keine Auswahl.
        if (CommitmentDraft.OfferedTypes.Contains(type))
        {
            draft.SetType(type);
        }
    }

    private void OnPotChanged(string pot) => draft.SetPot(pot);

    private void OnCategoryChanged(string value) =>
        draft.ChooseCategory(Categories.FirstOrDefault(c => c.Id == ParseId(value)));

    private void OnAccountChanged(Guid? id) => draft.AccountId = id;

    private void OnCounterAccountChanged(Guid? id) => draft.ChooseCounterAccount(id);

    private void OnDebtChanged(string value) => draft.ChooseDebt(ParseId(value));

    private string DebtName(Guid id) => Debts.FirstOrDefault(d => d.Id == id)?.Name ?? string.Empty;

    private void OnGoalChanged(string value)
    {
        var goal = SavingsGoals.FirstOrDefault(g => g.Id == ParseId(value));
        draft.ChooseSavingsGoal(goal?.Id, goal?.AccountId);
    }

    // Ein Sparziel braucht das Zielkonto, auf das die Rate geht.
    private string? GoalError() =>
        draft.GoalNeedsTargetAccount ? ErrorTexts.For(L, ErrorCodes.CommitmentGoalInvalid) : null;

    // Die erste Zahlung ist Pflicht; ein halb getipptes Datum lässt den alten Wert stehen.
    private void OnFirstDueDateChanged(string value)
    {
        if (ParseDate(value) is { } date)
        {
            draft.FirstDueDate = date;
        }
    }

    private void OnLastDueDateChanged(string value)
    {
        if (!endLocked)
        {
            draft.LastDueDate = ParseDate(value);
        }
    }

    // Einnahmen bieten nur Einnahme-Kategorien an, Ausgaben die übrigen.
    // Die Kategorien kommen von der API schon nach Gruppen geordnet; GroupBy behält die Reihenfolge.
    private IEnumerable<IGrouping<string, CategoryResponse>> OfferedCategories() => Categories
        .Where(c => (c.Group == CategoryGroupKeys.Income) == draft.WantsIncomeCategories)
        .GroupBy(c => c.Group);

    // Der StepDialog ruft das erst, wenn alle drei Schritte ihre Prüfung bestanden haben.
    private async Task SaveAsync()
    {
        error = null;
        busy = true;
        try
        {
            var result = Existing is null
                ? await CommitmentApi.CreateAsync(draft.ToCreateRequest() with { OwnerId = owner })
                : await CommitmentApi.UpdateAsync(Existing.Id, draft.ToUpdateRequest(Existing));

            if (result.Succeeded)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                error = ErrorTexts.For(L, result.ErrorCode);
            }
        }
        finally
        {
            busy = false;
        }
    }
}
