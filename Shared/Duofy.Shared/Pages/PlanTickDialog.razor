@using BlazorBlueprint.Components
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@using Duofy.Shared.Dialogs
@inherits FormDialogBase
@inject IPlanApi PlanApi
@inject ActiveMember Member
@inject TimeProvider Time
@inject IStringLocalizer<SharedResources> L

@* Das Abhaken eines offenen Postens wie im alten Duofy (Spec 82): Der Dialog zeigt Datum und Betrag vorbelegt, heute und den
   geplanten Betrag, und bucht erst nach der Bestätigung. Ein Posten, auf dem schon Buchungen liegen, kommt gar nicht hierher:
   Dort entsteht keine weitere (siehe Plan.razor). Ein abweichendes Datum verschiebt den Posten nicht. *@

<div class="dialog-body">
    <ErrorAlert Text="@error" data-testid="tick-error" />
    <p data-testid="tick-summary">@L["PlanTickDialog_Summary", Position.Label, MoneyText.Format(Position.AmountPlanned)]</p>
    <div class="field">
        <FieldLabel For="tick-date" Text="@L["Field_Date"]" />
        <TextInput id="tick-date" Type="date" @bind-Value="date" data-testid="tick-date" />
    </div>
    <div class="field">
        <FieldLabel For="tick-amount" Text="@L["Field_Amount"]" />
        <MoneyInput id="tick-amount" @bind-Value="amount" Min="0" data-testid="tick-amount" />
    </div>
    <div class="dialog-actions">
        <DuofyButton Kind="ButtonKind.Secondary" Text="@L["PlanDialog_Cancel"]" OnClick="@(_ => CancelAsync())" TestId="tick-cancel" />
        <DuofyButton Text="@L["PlanTickDialog_Save"]" Disabled="busy" OnClick="@(_ => SaveAsync())" TestId="tick-save" />
    </div>
</div>

@code {
    [Parameter] public int Year { get; set; }

    [Parameter] public int Month { get; set; }

    [Parameter] public PlanPositionResponse Position { get; set; } = default!;

    private string? date;
    private decimal? amount;
    private string? error;
    private bool busy;

    // Die Person, für die der Dialog geöffnet wurde; sie bleibt, auch wenn der Umschalter inzwischen woanders steht (Spec 68, A15).
    private Guid? owner;

    protected override void OnInitialized()
    {
        owner = Member.Owner;
        amount = Position.AmountPlanned;
        date = DateOnly.FromDateTime(Time.GetLocalNow().DateTime).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    private async Task SaveAsync()
    {
        error = null;
        busy = true;
        try
        {
            DateOnly? day = DateOnly.TryParseExact(date, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed) ? parsed : null;
            var result = await PlanApi.TickAsync(Year, Month, Position.Id, new TickPositionRequest(Amount: amount ?? 0m, Date: day), owner);
            if (result.Succeeded)
            {
                await CloseAsync(true);
            }
            else
            {
                error = ErrorTexts.For(L, result.ErrorCode);
            }
        }
        finally
        {
            busy = false;
        }
    }
}
