@using Radzen
@using Radzen.Blazor
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@inject IPlanApi PlanApi
@inject ActiveMember Member
@inject DialogService Dialogs
@inject IStringLocalizer<SharedResources> L
@inject IAppHost Host

@* Abhaken eines Postens, auf dem schon Buchungen liegen (R5): Der Dialog bietet einen Ausgleich für
   den Unterschied an, vorbelegt mit dem offenen Rest. 0 hakt ab, ohne etwas zu buchen; ein
   Unterschied zwischen geplant und gebucht darf bleiben. *@

<div>
    @if (Host.IsApp)
    {
        <FullScreenFormHeader Title="@Title" SaveText="@L["PlanTickDialog_Save"]" SaveTestId="tick-save"
                              Busy="busy" OnClose="Cancel" OnSave="SaveAsync" />
    }
    <RadzenStack Gap="1rem">
        @if (error is not null)
        {
            <ErrorAlert AlertStyle="AlertStyle.Danger" Text="@error" data-testid="tick-error" />
        }
        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-m-0" data-testid="tick-summary">@L["PlanTickDialog_Summary", Position.Label, Money(Position.AmountPlanned), Money(Position.Booked)]</RadzenText>
        <div class="field">
            <FieldLabel id="tick-amount-label" Text="@L["Field_BalancingAmount"]" />
            <RadzenNumeric TValue="decimal?" @bind-Value="amount" Culture="German" Format="0.00" Min="0" ShowUpDown="false"
                           InputAttributes="@(new Dictionary<string, object> { ["aria-labelledby"] = "tick-amount-label", ["aria-describedby"] = "tick-amount-hint" })"
                           data-testid="tick-amount" />
            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color rz-m-0" id="tick-amount-hint">@L["PlanTickDialog_Hint"]</RadzenText>
        </div>
        @if (!Host.IsApp)
        {
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text="@L["PlanDialog_Cancel"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(_ => Cancel())" />
                <RadzenButton Text="@L["PlanTickDialog_Save"]" ButtonStyle="ButtonStyle.Primary" Disabled="busy" Click="@(_ => SaveAsync())"
                              data-testid="tick-save" />
            </RadzenStack>
        }
    </RadzenStack>
</div>

@code {

    private static readonly CultureInfo German = new("de-DE");

    /// <summary>Der Titel für die Kopfzeile in der App; im Browser steht er in der Titelzeile des Fensters.</summary>
    [Parameter] public string? Title { get; set; }

    [Parameter] public int Year { get; set; }

    [Parameter] public int Month { get; set; }

    [Parameter] public PlanPositionResponse Position { get; set; } = default!;

    private decimal? amount;
    private string? error;
    private bool busy;

    // Die Person, für die der Dialog geöffnet wurde; sie bleibt, auch wenn der Umschalter inzwischen woanders steht (Spec 68, A15).
    private Guid? owner;

    protected override void OnInitialized()
    {
        owner = Member.Owner;
        amount = PlanView.OpenAmount(Position);
    }

    private void Cancel() => Dialogs.Close();

    private async Task SaveAsync()
    {
        error = null;
        busy = true;
        try
        {
            var result = await PlanApi.TickAsync(Year, Month, Position.Id, new TickPositionRequest(Amount: amount ?? 0m), owner);
            if (result.Succeeded)
            {
                Dialogs.Close(true);
            }
            else
            {
                error = ErrorTexts.For(L, result.ErrorCode);
            }
        }
        finally
        {
            busy = false;
        }
    }

    private static string Money(decimal value) => value.ToString("N2", German) + " €";
}
