@using Radzen
@using Radzen.Blazor
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@inject IBookingApi BookingApi
@inject ActiveMember Member
@inject DialogService Dialogs
@inject IStringLocalizer<SharedResources> L
@inject IAppHost Host

@* Der Dialog "Zahlung eintragen" bei einer Schuld oder einem Kredit (Issue 31): Daraus entsteht eine Ausgabe, deren Zeile
   dem Eintrag zugeordnet ist. Was danach noch offen ist, kommt neu von der API. *@

<div>
    @if (Host.IsApp)
        {
            <FullScreenFormHeader Title="@Title" SaveText="@L["DebtPayment_Save"]" SaveTestId="debt-payment-save"
                                  Busy="busy" OnClose="Cancel" OnSave="SaveAsync" />
        }
        <RadzenStack Gap="1rem">
            @if (error is not null)
            {
                <ErrorAlert AlertStyle="AlertStyle.Base" Text="@error" data-testid="debt-payment-error" />
            }

            <div class="field">
                <FieldLabel id="debt-payment-amount-label" Text="@L["Field_Amount"]" />
                <RadzenNumeric TValue="decimal?" @bind-Value="draft.Amount" Culture="German" Format="0.00" ShowUpDown="false"
                               InputAttributes="@(new Dictionary<string, object> { ["aria-labelledby"] = "debt-payment-amount-label" })"
                               data-testid="debt-payment-amount" />
            </div>

            <NativeSelect Value="@Key(draft.AccountId)" ValueChanged="OnAccountChanged"
                          Label="@L["DebtPayment_Account"]" data-testid="debt-payment-account">
                <option value="">@L["SavingsMove_ChooseAccount"]</option>
                @foreach (var account in Accounts.Where(a => a.Active))
                {
                    <option value="@account.Id">@account.Name</option>
                }
            </NativeSelect>

            <NativeSelect Value="@draft.Pot" ValueChanged="OnPotChanged" Label="@L["DebtPayment_Pot"]"
                          data-testid="debt-payment-pot">
                <option value="@PotKeys.Needs">@L["Pot_needs"]</option>
                <option value="@PotKeys.Wants">@L["Pot_wants"]</option>
            </NativeSelect>

            @if (!Host.IsApp)
            {
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Text="@L["SavingsGoalDialog_Cancel"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(_ => Cancel())" />
                    <RadzenButton Text="@L["DebtPayment_Save"]" ButtonStyle="ButtonStyle.Primary" Disabled="busy" Click="@(_ => SaveAsync())"
                                  data-testid="debt-payment-save" />
                </RadzenStack>
            }
        </RadzenStack>
</div>

@code {

    private static readonly CultureInfo German = new("de-DE");

    /// <summary>Der Titel für die Kopfzeile in der App; im Browser steht er in der Titelzeile des Fensters.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Die Eingaben, vorbelegt mit Eintrag, Kategorie, Konto und Datum von heute.</summary>
    [Parameter, EditorRequired]
    public DebtPaymentDraft Draft { get; set; } = default!;

    /// <summary>Die Konten der Person.</summary>
    [Parameter]
    public IReadOnlyList<AccountChoice> Accounts { get; set; } = [];

    private DebtPaymentDraft draft = default!;
    private string? error;
    private bool busy;
    private Guid? owner;

    protected override void OnInitialized()
    {
        owner = Member.Owner;
        draft = Draft;
    }

    private static string Key(Guid? id) => id?.ToString() ?? "";

    private void OnAccountChanged(string value) => draft = draft with { AccountId = Guid.TryParse(value, out var id) ? id : null };

    private void OnPotChanged(string value) => draft.SetPot(value);

    private void Cancel() => Dialogs.Close();

    private async Task SaveAsync()
    {
        error = null;
        if (!draft.IsAmountValid)
        {
            error = ErrorTexts.For(L, ErrorCodes.AmountInvalid);
            return;
        }
        if (draft.AccountId is null)
        {
            error = L["DebtPayment_NeedAccount"];
            return;
        }

        busy = true;
        try
        {
            var result = await BookingApi.CreateAsync(draft.ToRequest(owner));
            if (result.Succeeded)
            {
                Dialogs.Close(true);
            }
            else
            {
                error = ErrorTexts.For(L, result.ErrorCode);
            }
        }
        finally
        {
            busy = false;
        }
    }
}
