@page "/admin"
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@implements IDisposable
@inject IUserApi UserApi
@inject IInstanceApi InstanceApi
@inject IAdminApi AdminApi
@inject IShareService Share
@inject FormDialogs Forms
@inject IAppHost Host
@inject AppChrome Chrome
@inject IStringLocalizer<SharedResources> L

@* Admin (Spec 70, R4 und R6): wer auf diesen Server kommen darf. Hier legt der Admin Einladungen zur Registrierung
   an, auf Wunsch nur für eine Adresse, und sieht die offenen mit Link, QR-Code, Teilen und Zurückziehen. Den Link
   baut die API mit der öffentlichen Adresse des Servers.

   Nur für Admins; unter "Mehr" sehen alle anderen den Eintrag gar nicht. Wer die Adresse trotzdem aufruft, sieht
   nur einen Hinweis; die API lehnt ohnehin ab. Nichts hier zeigt Pläne, Buchungen oder Konten anderer: Ein Admin
   betreibt den Server, er schaut nicht hinein.

   Auf einem selbst betriebenen Server gibt es keine Mails (Spec 53, R4): Wer sein Passwort vergessen hat, bekommt vom
   Admin einen Link, 24 Stunden gültig und einmal, mit QR-Code und Teilen. Auf der gehosteten Version fehlt dieser
   Abschnitt, dort geht "Passwort vergessen" per Mail; dafür geht eine Einladung mit Adresse auch per Mail hinaus. *@

<PageTitle>@L["Admin_Title"]</PageTitle>

<AppPageHeading Text="@L["Admin_Title"]" />
@if (!Host.IsApp)
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-mb-2">@L["Admin_Title"]</RadzenText>
}

<Notice Message="message" />

@if (loaded && !isAdmin)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" AllowClose="false" Size="AlertSize.Small"
                 data-testid="admin-not-allowed">@L["Admin_NotAllowed"]</RadzenAlert>
}

@if (isAdmin)
{
    <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" Class="rz-mb-1">@L["Admin_Lead"]</RadzenText>
    @if (mode is not null)
    {
        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" Class="rz-mb-4" data-testid="admin-mode">@L[$"Admin_Mode_{mode}"]</RadzenText>
    }

    <RadzenCard Variant="Variant.Outlined" Class="rz-mb-4">
        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-mb-2">@L["Admin_CreateHeading"]</RadzenText>
        <div class="field">
            <FieldLabel For="admin-email-input" Text="@L["Admin_Email"]" />
            <RadzenTextBox @bind-Value="email" id="admin-email-input" type="email" Placeholder="@L["Auth_EmailPlaceholder"]"
                           aria-describedby="admin-email-hint" Immediate="true"
                           data-testid="admin-email" />
            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color"
                        id="admin-email-hint">@L["Admin_EmailHint"]</RadzenText>
        </div>
        <RadzenButton Text="@L["Admin_Create"]" Icon="person_add" ButtonStyle="ButtonStyle.Primary" Class="rz-mt-3"
                      Disabled="busy" Click="@(_ => CreateAsync())" data-testid="admin-create" />
    </RadzenCard>

    @if (!hosted)
    {
        <RadzenCard Variant="Variant.Outlined" Class="rz-mb-4" data-testid="admin-reset">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-mb-1">@L["Admin_ResetHeading"]</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" Class="rz-mb-2">@L["Admin_ResetText"]</RadzenText>
            <Notice Message="resetMessage" />
            <div class="field">
                <FieldLabel For="admin-reset-email-input" Text="@L["Admin_ResetEmail"]" />
                <RadzenTextBox @bind-Value="resetEmail" id="admin-reset-email-input" type="email"
                               Placeholder="@L["Auth_EmailPlaceholder"]" autocomplete="off"
                               data-testid="admin-reset-email" />
            </div>
            <RadzenButton Text="@L["Admin_ResetCreate"]" Icon="lock_reset" ButtonStyle="ButtonStyle.Primary" Class="rz-mt-3"
                          Disabled="resetBusy" Click="@(_ => CreateResetLinkAsync())" data-testid="admin-reset-create" />
            @if (resetLink is { } reset)
            {
                <RadzenStack Gap="1rem" Class="rz-mt-3">
                    <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color">@L["Admin_ResetValidUntil", Moment(reset.ExpiresAt)]</RadzenText>
                    @* Der QR-Code bleibt weiß, auch im Dunkelmodus, damit er sich scannen lässt. *@
                    <div role="img" aria-label="@L["Admin_ResetQr"]" class="qr-code qr-code-small"
                         data-testid="admin-reset-qr">@((MarkupString)InvitationQr.Svg(reset.Url))</div>
                    <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" Class="long-link" data-testid="admin-reset-link">@reset.Url</RadzenText>
                    <RadzenButton Text="@L["InviteDialog_Share"]" Icon="share" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Small" Class="align-start"
                                  Click="@(_ => ShareResetAsync(reset.Url))" data-testid="admin-reset-share" />
                </RadzenStack>
            }
        </RadzenCard>
    }

    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-mb-2">@L["Admin_OpenHeading"]</RadzenText>
    @if (invitations.Count == 0)
    {
        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" Class="rz-text-secondary-color">@L["Admin_Empty"]</RadzenText>
    }
    <RadzenStack Gap="0.5rem" Class="rz-mb-4">
        @foreach (var invitation in invitations)
        {
            <RadzenCard Variant="Variant.Outlined" data-testid="@($"admin-invitation-{invitation.Id}")">
                <RadzenStack Gap="1rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
                        <RadzenStack Gap="0" Class="flex-grow-1">
                            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="long-link">@(invitation.Email ?? L["Admin_Anyone"])</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color">@L["Admin_ValidUntil", Day(invitation.ExpiresAt)]</RadzenText>
                        </RadzenStack>
                        <RadzenButton Text="@L["Admin_Revoke"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                      Click="@(_ => RevokeAsync(invitation))"
                                      data-testid="@($"admin-invitation-revoke-{invitation.Id}")" />
                    </RadzenStack>
                    @if (invitation.Url is { } link)
                    {
                        <div role="img" aria-label="@L["InviteDialog_Qr"]" class="qr-code qr-code-small"
                             data-testid="@($"admin-invitation-qr-{invitation.Id}")">@((MarkupString)InvitationQr.Svg(link))</div>
                        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" Class="long-link"
                                    data-testid="@($"admin-invitation-link-{invitation.Id}")">@link</RadzenText>
                        <RadzenButton Text="@L["InviteDialog_Share"]" Icon="share" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Small" Class="align-start"
                                      Click="@(_ => ShareAsync(link))"
                                      data-testid="@($"admin-invitation-share-{invitation.Id}")" />
                    }
                </RadzenStack>
            </RadzenCard>
        }
    </RadzenStack>
}

@code {
    private static readonly CultureInfo German = new("de-DE");

    private bool loaded;
    private bool isAdmin;
    private string? mode;
    private List<RegistrationInvitationResponse> invitations = [];
    private string email = "";
    private bool busy;
    private NoticeMessage? message;

    // Spec 53: gehostet oder selbst betrieben; ohne Antwort des Servers gilt selbst betrieben.
    private bool hosted;
    private string resetEmail = "";
    private bool resetBusy;
    private PasswordResetLinkResponse? resetLink;
    private NoticeMessage? resetMessage;

    protected override async Task OnInitializedAsync()
    {
        Chrome.Set(this, L["Admin_Title"]);
        var me = await UserApi.GetMeAsync();
        isAdmin = me.Succeeded && me.Value!.IsInstanceAdmin;
        loaded = me.Succeeded;
        if (!me.Succeeded)
        {
            message = new NoticeMessage(ErrorTexts.For(L, me.ErrorCode), NoticeSeverity.Error);
            return;
        }
        if (!isAdmin)
        {
            return;
        }

        var instance = await InstanceApi.GetAsync();
        mode = instance.Succeeded && instance.Value!.RegistrationMode is { } known && RegistrationModes.All.Contains(known) ? known : null;
        hosted = instance.Succeeded && instance.Value!.Hosted;
        await LoadAsync();
    }

    public void Dispose() => Chrome.Release(this);

    private async Task LoadAsync()
    {
        var open = await AdminApi.ListInvitationsAsync();
        if (open.Succeeded)
        {
            invitations = open.Value!.ToList();
        }
        else
        {
            message = new NoticeMessage(ErrorTexts.For(L, open.ErrorCode), NoticeSeverity.Error);
        }
    }

    private string Day(DateTimeOffset moment) => moment.ToLocalTime().ToString("dd.MM.yyyy", German);

    private string Moment(DateTimeOffset moment) => moment.ToLocalTime().ToString("dd.MM.yyyy, HH:mm", German);

    // Ob es zur Adresse ein Konto gibt, erfährt nur der Admin (user_not_found).
    private async Task CreateResetLinkAsync()
    {
        if (string.IsNullOrWhiteSpace(resetEmail))
        {
            resetMessage = new NoticeMessage(ErrorTexts.For(L, ErrorCodes.EmailInvalid), NoticeSeverity.Error);
            return;
        }
        resetBusy = true;
        resetLink = null;
        try
        {
            var created = await AdminApi.CreatePasswordResetLinkAsync(resetEmail.Trim());
            if (!created.Succeeded)
            {
                resetMessage = new NoticeMessage(ErrorTexts.For(L, created.ErrorCode), NoticeSeverity.Error);
                return;
            }
            resetLink = created.Value;
            resetMessage = null;
            resetEmail = "";
        }
        finally
        {
            resetBusy = false;
        }
    }

    // Ein leeres Feld heißt: für jede Adresse. Ob die Adresse gültig ist, prüft die API (email_invalid).
    private async Task CreateAsync()
    {
        busy = true;
        try
        {
            var address = string.IsNullOrWhiteSpace(email) ? null : email.Trim();
            var created = await AdminApi.CreateInvitationAsync(address);
            if (!created.Succeeded)
            {
                message = new NoticeMessage(ErrorTexts.For(L, created.ErrorCode), NoticeSeverity.Error);
                return;
            }
            email = "";
            message = new NoticeMessage(hosted && address is not null ? L["Admin_CreatedMailed"] : L["Admin_Created"], NoticeSeverity.Success);
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private Task ShareAsync(string link) => Share.ShareAsync(L["Admin_ShareTitle"], link);

    private Task ShareResetAsync(string link) => Share.ShareAsync(L["Admin_ResetShareTitle"], link);

    // Folgenreiches fragt einmal nach; erst die Bestätigung führt es aus.
    private async Task RevokeAsync(RegistrationInvitationResponse invitation)
    {
        var confirmed = await Forms.ConfirmAsync(L["Admin_RevokeText"], L["Admin_RevokeTitle"], L["Admin_Revoke"], L["Admin_Cancel"]);
        if (!confirmed)
        {
            return;
        }

        var result = await AdminApi.RevokeInvitationAsync(invitation.Id);
        message = result.Succeeded
            ? new NoticeMessage(L["Admin_Revoked"], NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await LoadAsync();
    }
}
