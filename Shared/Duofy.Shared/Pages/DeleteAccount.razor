@page "/konto/loeschen"
@using BlazorBlueprint.Components
@attribute [Authorize]
@using Duofy.ApiClient
@using Duofy.Schemas
@inject IUserApi UserApi
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L

@* Konto löschen. Diese Adresse nennen wir Google Play als "Konto löschen"-Seite,
   deshalb gibt es sie auch im Browser ohne die App. Wegen [Authorize] muss man dafür
   angemeldet sein; sonst geht es zur Anmeldung und danach hierher zurück.
   Zur Sicherheit fragen wir noch einmal nach dem Passwort. *@

<PageTitle>@L["Delete_Title"]</PageTitle>

<div class="field-grid" JustifyContent="JustifyContent.Center">
    <div>
        <div class="card">
            <h1 class="page-title mb-4">@L["Delete_Title"]</h1>
            <BbAlert Variant="AlertVariant.Warning" Class="mb-4">@L["Delete_Warning"]</BbAlert>

            @if (error is not null)
            {
                <BbAlert Variant="AlertVariant.Danger" Class="mb-4">@error</BbAlert>
            }

            <p class="mb-2">@L["Delete_PasswordPrompt"]</p>
            <div class="field">
                <FieldLabel For="delete-password-input" Text="@L["Field_Password"]" />
                <TextInput id="delete-password-input" Type="password" @bind-Value="password" autocomplete="current-password" @onkeydown="OnPasswordKeyDown" data-testid="delete-password" />
            </div>

            <div class="row mt-4">
                <DuofyButton Kind="ButtonKind.Danger" Text="@L["Delete_Submit"]" OnClick="@(_ => DeleteAsync())" TestId="delete-submit" Disabled="busy" />
                <DuofyButton Href="/konto" Kind="ButtonKind.Ghost">@L["Delete_Cancel"]</DuofyButton>
            </div>
        </div>
    </div>
</div>

@code {
    private string password = "";
    private bool busy;
    private string? error;

    private async Task OnPasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DeleteAsync();
    }

    private async Task DeleteAsync()
    {
        if (busy) return;
        if (string.IsNullOrEmpty(password))
        {
            error = L["Validation_Required"];
            return;
        }

        busy = true;
        error = null;
        try
        {
            var result = await UserApi.DeleteMeAsync(new DeleteMeRequest(password));
            if (result.Succeeded)
            {
                // Der Client hat die Tokens schon gelöscht; es ist niemand mehr angemeldet.
                Navigation.NavigateTo("/anmelden");
            }
            else
            {
                error = ErrorTexts.For(L, result.ErrorCode);
            }
        }
        finally
        {
            busy = false;
        }
    }
}
