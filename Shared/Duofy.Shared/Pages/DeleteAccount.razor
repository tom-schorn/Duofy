@page "/konto/loeschen"
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]
@using Duofy.ApiClient
@using Duofy.Schemas
@inject IUserApi UserApi
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L

@* Konto löschen. Diese Adresse nennen wir Google Play als "Konto löschen"-Seite,
   deshalb gibt es sie auch im Browser ohne die App. Wegen [Authorize] muss man dafür
   angemeldet sein; sonst geht es zur Anmeldung und danach hierher zurück.
   Zur Sicherheit fragen wir noch einmal nach dem Passwort. *@

<PageTitle>@L["Delete_Title"]</PageTitle>

<RadzenRow JustifyContent="JustifyContent.Center">
    <RadzenColumn Size="12" SizeMD="8" SizeLG="5">
        <RadzenCard Variant="Variant.Outlined">
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-mb-4">@L["Delete_Title"]</RadzenText>
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" AllowClose="false" Class="rz-mb-4">@L["Delete_Warning"]</RadzenAlert>

            @if (error is not null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Class="rz-mb-4">@error</RadzenAlert>
            }

            <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-mb-2">@L["Delete_PasswordPrompt"]</RadzenText>
            <div class="field">
                <FieldLabel For="delete-password-input" Text="@L["Field_Password"]" />
                <RadzenPassword @bind-Value="password" Immediate="true" id="delete-password-input" autocomplete="current-password"
                                @onkeydown="OnPasswordKeyDown" data-testid="delete-password" />
            </div>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Class="rz-mt-4">
                <RadzenButton Text="@L["Delete_Submit"]" ButtonStyle="ButtonStyle.Danger" Disabled="busy"
                              Click="@(_ => DeleteAsync())" data-testid="delete-submit" />
                <LinkButton Href="/konto" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base">@L["Delete_Cancel"]</LinkButton>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

@code {
    private string password = "";
    private bool busy;
    private string? error;

    private async Task OnPasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DeleteAsync();
    }

    private async Task DeleteAsync()
    {
        if (busy) return;
        if (string.IsNullOrEmpty(password))
        {
            error = L["Validation_Required"];
            return;
        }

        busy = true;
        error = null;
        try
        {
            var result = await UserApi.DeleteMeAsync(new DeleteMeRequest(password));
            if (result.Succeeded)
            {
                // Der Client hat die Tokens schon gelöscht; es ist niemand mehr angemeldet.
                Navigation.NavigateTo("/anmelden");
            }
            else
            {
                error = ErrorTexts.For(L, result.ErrorCode);
            }
        }
        finally
        {
            busy = false;
        }
    }
}
