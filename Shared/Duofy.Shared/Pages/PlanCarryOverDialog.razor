@using Radzen
@using Radzen.Blazor
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@inject IPlanApi PlanApi
@inject ActiveMember Member
@inject DialogService Dialogs
@inject IStringLocalizer<SharedResources> L
@inject IAppHost Host

@* Der Übertrag in diesen Monat (R9). Vorgeschlagen sind Einnahmen minus Ausgaben des Vormonats, auch
   unter 0: Ein negativer Rest wird genauso übertragen.
   Weicht ein eingetragener echter Kontostand vom gerechneten ab, zeigt der Dialog den Unterschied je Konto und
   bietet zwei Wege: Buchungen nachtragen schließt ohne Änderung, als Ausgleich übernehmen bucht den Unterschied am
   letzten Tag des Vormonats. Ohne Abweichung bucht er sofort; leere Felder bleiben, wie sie sind. *@

<div>
    @if (Host.IsApp)
    {
        <FullScreenFormHeader Title="@Title" SaveText="@L["PlanCarryOverDialog_Save"]" SaveTestId="carry-over-save"
                              Busy="busy" ShowSave="!Reviewing" OnClose="Cancel" OnSave="SaveAsync" />
    }
    <RadzenStack Gap="1rem">
        @if (error is not null)
        {
            <ErrorAlert AlertStyle="AlertStyle.Danger" Text="@error" data-testid="carry-over-error" />
        }
        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" Class="rz-m-0">@L["PlanCarryOverDialog_Lead"]</RadzenText>
        <div class="field">
            <FieldLabel id="carry-over-amount-label" Text="@L["Field_CarryOverAmount"]" />
            <RadzenNumeric TValue="decimal?" @bind-Value="amount" Culture="German" Format="0.00" ShowUpDown="false"
                           InputAttributes="@(new Dictionary<string, object> { ["aria-labelledby"] = "carry-over-amount-label" })"
                           data-testid="carry-over-amount" />
        </div>

        @foreach (var balance in CarryOver.Balances)
        {
            var accountId = balance.AccountId;
            <div class="field">
                <FieldLabel id="@($"carry-over-balance-{accountId}-label")" Text="@L["Field_RealBalance", AccountName(accountId)]" />
                <RadzenNumeric TValue="decimal?" Value="@real.GetValueOrDefault(accountId)" ValueChanged="v => real[accountId] = v"
                               Culture="German" Format="0.00" ShowUpDown="false"
                               InputAttributes="@(new Dictionary<string, object> { ["aria-labelledby"] = $"carry-over-balance-{accountId}-label", ["aria-describedby"] = $"carry-over-balance-{accountId}-hint" })"
                               data-testid="@($"carry-over-balance-{accountId}")" />
                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color rz-m-0" id="@($"carry-over-balance-{accountId}-hint")">@L["PlanCarryOverDialog_Computed", Money(balance.Balance)]</RadzenText>
            </div>
        }

        @if (Reviewing)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" AllowClose="false" data-testid="carry-over-differences">
                @* Kein RadzenText und kein p: Das Theme gibt beiden die Textfarbe der Seite, die auf der Warnfläche nicht lesbar ist. *@
                <div>@L["PlanCarryOverDialog_DifferencesLead"]</div>
                @foreach (var difference in Differences)
                {
                    <div data-testid="@($"carry-over-difference-{difference.AccountId}")">@L["PlanCarryOverDialog_Difference", AccountName(difference.AccountId), Money(difference.Computed), Money(difference.Real), SignedMoney(difference.Real - difference.Computed)]</div>
                }
            </RadzenAlert>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Wrap="FlexWrap.Wrap" Gap="0.5rem">
                <RadzenButton Text="@L["PlanCarryOverDialog_Backfill"]" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Primary" Disabled="busy" Click="@(_ => Cancel())"
                              data-testid="carry-over-backfill" />
                <RadzenButton Text="@L["PlanCarryOverDialog_Adopt"]" ButtonStyle="ButtonStyle.Primary" Disabled="busy" Click="@(_ => BookAsync())"
                              data-testid="carry-over-adopt" />
            </RadzenStack>
        }

        @if (!Host.IsApp)
        {
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text="@L["PlanDialog_Cancel"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(_ => Cancel())" />
                @if (!Reviewing)
                {
                    <RadzenButton Text="@L["PlanCarryOverDialog_Save"]" ButtonStyle="ButtonStyle.Primary" Disabled="busy" Click="@(_ => SaveAsync())"
                                  data-testid="carry-over-save" />
                }
            </RadzenStack>
        }
    </RadzenStack>
</div>

@code {

    private static readonly CultureInfo German = new("de-DE");

    /// <summary>Der Titel für die Kopfzeile in der App; im Browser steht er in der Titelzeile des Fensters.</summary>
    [Parameter] public string? Title { get; set; }

    [Parameter] public int Year { get; set; }

    [Parameter] public int Month { get; set; }

    [Parameter] public PlanCarryOverResponse CarryOver { get; set; } = default!;

    [Parameter] public IReadOnlyList<AccountChoice> Accounts { get; set; } = [];

    private decimal? amount;
    private readonly Dictionary<Guid, decimal?> real = [];
    private string? error;
    private bool busy;

    // Gesetzt, sobald die Person mit einer Abweichung buchen wollte. Wird sie weggetippt, gilt wieder der normale Dialog.
    private bool reviewRequested;

    private sealed record BalanceDifference(Guid AccountId, decimal Computed, decimal Real);

    private List<BalanceDifference> Differences => CarryOver.Balances
        .Where(balance => real.GetValueOrDefault(balance.AccountId) is { } entered && entered != balance.Balance)
        .Select(balance => new BalanceDifference(balance.AccountId, balance.Balance, real[balance.AccountId]!.Value))
        .ToList();

    private bool Reviewing => reviewRequested && Differences.Count > 0;

    // Die Person, für die der Dialog geöffnet wurde; sie bleibt, auch wenn der Umschalter inzwischen woanders steht (Spec 68, A15).
    private Guid? owner;

    protected override void OnInitialized()
    {
        owner = Member.Owner;
        amount = CarryOver.Suggested;
    }

    private string AccountName(Guid id) => Accounts.FirstOrDefault(a => a.Id == id)?.Name ?? "";

    private void Cancel() => Dialogs.Close();

    private async Task SaveAsync()
    {
        if (Differences.Count > 0)
        {
            error = null;
            reviewRequested = true;
            return;
        }
        await BookAsync();
    }

    private async Task BookAsync()
    {
        error = null;
        busy = true;
        try
        {
            var balances = real
                .Where(entry => entry.Value is not null)
                .Select(entry => new RealBalance(entry.Key, entry.Value!.Value))
                .ToList();
            var result = await PlanApi.CreateCarryOverAsync(Year, Month, new CreateCarryOverRequest(amount ?? 0m, balances), owner);
            if (result.Succeeded)
            {
                Dialogs.Close(true);
            }
            else
            {
                error = ErrorTexts.ForCarryOver(L, result.ErrorCode);
            }
        }
        finally
        {
            busy = false;
        }
    }

    private static string Money(decimal value) => value.ToString("N2", German) + " €";

    private static string SignedMoney(decimal value) => value.ToString("+#,##0.00;-#,##0.00", German) + " €";
}
