@page "/konten"
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@using Duofy.Shared.Dialogs
@inject IAccountApi AccountApi
@implements IDisposable
@inject FormDialogs Forms
@inject IAppHost Host
@inject AppChrome Chrome
@inject ActiveMember Member
@inject TimeProvider Time
@inject IStringLocalizer<SharedResources> L

@* Die Kontenseite: alle Konten mit ihrem heutigen Stand, das Standardkonto mit Stern.
   Aufgelöste Konten sind eingeklappt; ein Knopf klappt sie auf.

   Die Seite rechnet nichts selbst. Den Stand rechnet die API aus Startbetrag und Buchungen;
   nach jeder Änderung holt die Seite die Liste neu.

   Mit dem Umschalter zeigt die Seite die Konten eines anderen Mitglieds (Spec 68); Standardkonto, Auflösen und
   wieder Öffnen sind Ändern. *@

<PageTitle>@L["Accounts_Title"]</PageTitle>

@* In der App steht der Titel in der oberen Leiste und das Plus im Layout (AppChrome). *@
<AppPageHeading Text="@L["Accounts_Title"]" />
@if (!Host.IsApp)
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mb-2">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@L["Accounts_Title"]</RadzenText>
        @if (Sees)
        {
            <RadzenButton Text="@L["Accounts_Add"]" Icon="add" ButtonStyle="ButtonStyle.Primary"
                          Click="@(_ => AddAsync())" Class="@GrantLock.Class(CanAdd)" @attributes="GrantLock.Attributes(CanAdd)"
                          data-testid="accounts-add" />
        }
    </RadzenStack>
}

<Notice Message="message" />

@if (!Sees)
{
    <NotShared />
}
else
{
<GrantReason Show="@(!(CanAdd && CanEdit))" />

@if (loaded && open.Count == 0)
{
    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-text-secondary-color rz-mb-2">@L["Accounts_Empty"]</RadzenText>
}

@* Ab 1280 px eine Tabelle mit Spalten (siehe .data-table in app.css), darunter Karten wie bisher. *@
<RadzenStack Gap="0.5rem" Class="data-table accounts-table page-wide">
    @if (open.Count > 0)
    {
        <div class="data-table-head" aria-hidden="true">
            <span class="data-column-3">@L["Table_Name"]</span>
            <span class="data-column-4">@L["Table_Type"]</span>
            <span class="data-column-5 data-amount">@L["Table_Balance"]</span>
        </div>
    }
    @foreach (var account in open)
    {
        <RadzenCard Variant="Variant.Outlined" Class="data-row-frame" data-testid="@($"account-{account.Id}")">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Class="data-row">
                @* Der Stern: gefüllt beim Standardkonto. Ein Klick auf einen leeren Stern macht dieses Konto zum Standardkonto. *@
                @* Das Symbol "star" ist wie "star_border" nur ein Umriss; gefüllt wird es über die Achse FILL der Schrift. *@
                <RadzenButton Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                              Click="@(_ => MakeDefaultAsync(account))"
                              Class="@($"data-column-1 {GrantLock.Class(CanEdit)}")" @attributes="GrantLock.Attributes(CanEdit)"
                              aria-pressed="@(account.IsDefault ? "true" : "false")"
                              aria-label="@L[account.IsDefault ? "Accounts_IsDefault" : "Accounts_MakeDefault", account.Name]"
                              data-testid="@($"account-default-{account.Id}")">
                    <RadzenIcon Icon="star" Class="@(account.IsDefault ? "icon-filled" : null)" />
                </RadzenButton>
                <AccountIconMark Icon="@account.Icon" />
                <RadzenStack Gap="0" Class="flex-grow-1 data-cells">
                    <RadzenLink Path="@($"/konten/{account.Id}")" Text="@account.Name" Class="data-column-3 account-open"
                                aria-label="@L["Accounts_Open", account.Name]" data-testid="@($"account-open-{account.Id}")" />
                    <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color data-column-4">@L[$"AccountType_{account.Type}"]</RadzenText>
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" Class="data-column-5 data-amount">@Money(account.Balance)</RadzenText>
                <RadzenButton Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                              Click="@(_ => EditAsync(account))"
                              Class="@($"data-column-6 {GrantLock.Class(CanEdit)}")" @attributes="GrantLock.Attributes(CanEdit)"
                              aria-label="@L["Accounts_Edit", account.Name]" data-testid="@($"account-edit-{account.Id}")" />
                <RadzenButton Text="@L["Accounts_Close"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                              Click="@(_ => CloseAsync(account))"
                              Class="@($"data-column-7 {GrantLock.Class(CanEdit)}")" @attributes="GrantLock.Attributes(CanEdit)"
                              aria-label="@L["Accounts_CloseFor", account.Name]" data-testid="@($"account-close-{account.Id}")" />
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

@* Aufgelöste Konten: Ihre Buchungen bleiben erhalten, deshalb stehen sie hier und lassen sich wieder öffnen. *@
@if (closed.Count > 0)
{
    <RadzenButton Text="@L["Accounts_ShowClosed", closed.Count]" Icon="@(showClosed ? "expand_less" : "expand_more")"
                  Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary" Class="rz-mt-4"
                  Click="@(_ => showClosed = !showClosed)" aria-expanded="@(showClosed ? "true" : "false")"
                  data-testid="accounts-show-closed" />

    @if (showClosed)
    {
        <RadzenStack Gap="0.5rem" Class="rz-mt-2 data-table accounts-table">
            @foreach (var account in closed)
            {
                <RadzenCard Variant="Variant.Outlined" Class="data-row-frame" data-testid="@($"account-{account.Id}")">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Class="data-row">
                        <AccountIconMark Icon="@account.Icon" />
                        <RadzenStack Gap="0" Class="flex-grow-1 data-cells">
                            <RadzenLink Path="@($"/konten/{account.Id}")" Text="@account.Name" Class="data-column-3 account-open"
                                        aria-label="@L["Accounts_Open", account.Name]" data-testid="@($"account-open-{account.Id}")" />
                            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color data-column-4">@L["Accounts_ClosedMark", L[$"AccountType_{account.Type}"]]</RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" Class="rz-text-secondary-color data-column-5 data-amount">@Money(account.Balance)</RadzenText>
                        <RadzenButton Text="@L["Accounts_Reopen"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                      Click="@(_ => SetActiveAsync(account, true))"
                                      Class="@($"data-column-7 {GrantLock.Class(CanEdit)}")" @attributes="GrantLock.Attributes(CanEdit)"
                                      data-testid="@($"account-reopen-{account.Id}")" />
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    }
}

}

@code {

    // Deutsche Schreibweise für Beträge (1.234,50), auch wenn das Gerät anders eingestellt ist.
    private static readonly CultureInfo German = new("de-DE");

    private List<AccountResponse> open = [];
    private List<AccountResponse> closed = [];
    private bool showClosed;
    private bool loaded;
    private NoticeMessage? message;

    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

    // Was die Freigabe des gewählten Mitglieds erlaubt (Spec 68); bei "Ich" alles.
    private bool Sees => Member.Allows(GrantAreas.Accounts, AccessLevelKeys.View);
    private bool CanAdd => Member.Allows(GrantAreas.Accounts, AccessLevelKeys.Create);
    private bool CanEdit => Member.Allows(GrantAreas.Accounts, AccessLevelKeys.Edit);

    protected override async Task OnInitializedAsync()
    {
        Chrome.Set(this, L["Accounts_Title"], AddAsync, L["Accounts_Add"]);
        // Erst nach dem ersten Laden zuhören: Das Laden selbst meldet sich auch als Änderung.
        await Member.LoadAsync();
        Member.Changed += OnMemberChanged;
        await LoadAsync();
    }

    public void Dispose()
    {
        Member.Changed -= OnMemberChanged;
        Chrome.Release(this);
    }

    private void OnMemberChanged() => _ = InvokeAsync(async () =>
    {
        message = null;
        await LoadAsync();
        StateHasChanged();
    });

    // Alle Konten holen, offene und aufgelöste. Die API liefert das Standardkonto zuerst.
    private async Task LoadAsync()
    {
        Chrome.LockPlus(this, Sees && !CanAdd ? GrantLock.ReasonId : null);
        open = [];
        closed = [];
        loaded = false;
        if (!Sees)
        {
            return;
        }
        var result = await AccountApi.ListAsync(owner: Member.Owner);
        if (result.Succeeded)
        {
            open = result.Value!.Where(a => a.Active).ToList();
            closed = result.Value!.Where(a => !a.Active).ToList();
        }
        else
        {
            message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        }
        loaded = true;
    }

    private async Task AddAsync()
    {
        if (CanAdd)
        {
            await ShowDialogAsync(existing: null, L["AccountDialog_TitleNew"]);
        }
    }

    private async Task EditAsync(AccountResponse account)
    {
        if (CanEdit)
        {
            await ShowDialogAsync(account, L["AccountDialog_TitleEdit"]);
        }
    }

    private async Task ShowDialogAsync(AccountResponse? existing, string title)
    {
        var parameters = new FormParameters<AccountDialog>()
            .Add(x => x.Title, title)
            .Add(x => x.Existing, existing)
            .Add(x => x.Today, Today);

        var outcome = await Forms.OpenStepAsync<AccountDialog, bool>(title, parameters);

        if (outcome.Saved)
        {
            message = new NoticeMessage(L["Accounts_Saved"], NoticeSeverity.Success);
            await LoadAsync();
        }
    }

    private async Task MakeDefaultAsync(AccountResponse account)
    {
        if (account.IsDefault)
        {
            return;
        }
        await UpdateAsync(account, new UpdateAccountRequest(IsDefault: true), L["Accounts_DefaultSet", account.Name]);
    }

    // Auflösen fragt nach, weil es das Konto aus den Listen nimmt und ihm die Markierung als Standardkonto wegnimmt.
    private async Task CloseAsync(AccountResponse account)
    {
        if (CanEdit && await Forms.ConfirmAsync(L["Accounts_CloseText", account.Name], L["Accounts_CloseTitle"], L["Accounts_CloseConfirm"], L["Accounts_CloseCancel"]))
        {
            await SetActiveAsync(account, false);
        }
    }

    // Auflösen und wieder öffnen. Auflösen nimmt dem Konto auch die Markierung als Standardkonto.
    private async Task SetActiveAsync(AccountResponse account, bool active) =>
        await UpdateAsync(account, new UpdateAccountRequest(Active: active), L[active ? "Accounts_Reopened" : "Accounts_Closed"]);

    private async Task UpdateAsync(AccountResponse account, UpdateAccountRequest request, string success)
    {
        if (!CanEdit)
        {
            return;
        }
        var result = await AccountApi.UpdateAsync(account.Id, request);
        message = result.Succeeded
            ? new NoticeMessage(success, NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await LoadAsync();
    }

    private static string Money(decimal amount) => amount.ToString("N2", German) + " €";
}
