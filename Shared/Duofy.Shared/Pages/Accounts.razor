@page "/konten"
@using BlazorBlueprint.Icons.Lucide.Components
@attribute [Authorize]
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@using Duofy.Shared.Dialogs
@inject IAccountApi AccountApi
@implements IDisposable
@inject FormDialogs Forms
@inject AppChrome Chrome
@inject ActiveMember Member
@inject TimeProvider Time
@inject IStringLocalizer<SharedResources> L

@* Die Kontenseite: alle Konten mit ihrem heutigen Stand, das Standardkonto mit Stern.
   Aufgelöste Konten sind eingeklappt; ein Knopf klappt sie auf.

   Die Seite rechnet nichts selbst. Den Stand rechnet die API aus Startbetrag und Buchungen;
   nach jeder Änderung holt die Seite die Liste neu.

   Mit dem Umschalter zeigt die Seite die Konten eines anderen Mitglieds (Spec 68); Standardkonto, Auflösen und
   wieder Öffnen sind Ändern. *@

<PageTitle>@L["Accounts_Title"]</PageTitle>

@* Auf schmalen Breiten steht der Titel zusätzlich in der oberen Leiste (AppChrome). *@
<PageHead Title="@L["Accounts_Title"]" Lead="@(Member.Name is { } who ? L["Accounts_LeadOf", who].Value : L["Accounts_Lead"].Value)"><Actions>
        @if (Sees)
        {
            <DuofyButton Icon="plus" Text="@L["Accounts_Add"]" OnClick="@(_ => AddAsync())" TestId="accounts-add" Class="@GrantLock.Class(CanAdd)" @attributes="GrantLock.Attributes(CanAdd)" />
        }
</Actions></PageHead>


<Notice Message="message" />

@if (!Sees)
{
    <NotShared />
}
else
{
<GrantReason Show="@(!(CanAdd && CanEdit))" />

@if (loaded && open.Count == 0)
{
    <p class="muted mb-2">@(Member.Name is { } ofName ? L["Accounts_EmptyOf", ofName].Value : L["Accounts_Empty"].Value)</p>
}

@* Ab 1280 px eine Tabelle mit Spalten (siehe .data-table in app.css), darunter Karten wie bisher. *@
<div class="data-table accounts-table">
        @foreach (var account in open)
    {
        <div class="data-row-frame" data-testid="@($"account-{account.Id}")">
            <div class="data-row">
                @* Der Stern: gefüllt beim Standardkonto. Ein Klick auf einen leeren Stern macht dieses Konto zum Standardkonto. *@
                @* Das Symbol "star" ist wie "star_border" nur ein Umriss; gefüllt wird es über die Achse FILL der Schrift. *@
                <DuofyButton Kind="ButtonKind.Ghost" OnClick="@(_ => MakeDefaultAsync(account))" AriaLabel="@L[account.IsDefault ? "Accounts_IsDefault" : "Accounts_MakeDefault", account.Name]" TestId="@($"account-default-{account.Id}")" Class="@GrantLock.Class(CanEdit)" @attributes="GrantLock.Attributes(CanEdit)" aria-pressed="@(account.IsDefault ? "true" : "false")">
                    <LucideIcon Name="star" Size="16" aria-hidden="true" Class="@(account.IsDefault ? "icon-filled" : null)" />
                </DuofyButton>
                <AccountIconMark Icon="@account.Icon" />
                <div class="data-cells">
                    <a href="@($"/konten/{account.Id}")" class="data-title account-open" aria-label="@L["Accounts_Open", account.Name]" data-testid="@($"account-open-{account.Id}")">@account.Name</a>
                    <p class="small muted">@L[$"AccountType_{account.Type}"]</p>
                </div>
                <p class="data-amount num">@Money(account.Balance)</p>
                <DuofyButton Kind="ButtonKind.Ghost" Icon="pencil" IconOnly="true" Small="true" OnClick="@(_ => EditAsync(account))" AriaLabel="@L["Accounts_Edit", account.Name]" TestId="@($"account-edit-{account.Id}")" Class="@GrantLock.Class(CanEdit)" @attributes="GrantLock.Attributes(CanEdit)" />
                <DuofyButton Kind="ButtonKind.Ghost" Text="@L["Accounts_Close"]" Small="true" OnClick="@(_ => CloseAsync(account))" AriaLabel="@L["Accounts_CloseFor", account.Name]" TestId="@($"account-close-{account.Id}")" Class="@GrantLock.Class(CanEdit)" @attributes="GrantLock.Attributes(CanEdit)" />
            </div>
        </div>
    }
</div>

@* Aufgelöste Konten: Ihre Buchungen bleiben erhalten, deshalb stehen sie hier und lassen sich wieder öffnen. *@
@if (closed.Count > 0)
{
    <DuofyButton Kind="ButtonKind.Ghost" Icon="@(showClosed ? "chevron-up" : "chevron-down")" Text="@L["Accounts_ShowClosed", closed.Count]" OnClick="@(_ => showClosed = !showClosed)" TestId="accounts-show-closed" Class="mt-4" aria-expanded="@(showClosed ? "true" : "false")" />

    @if (showClosed)
    {
        <div class="mt-2 data-table accounts-table">
            @foreach (var account in closed)
            {
                <div class="data-row-frame" data-testid="@($"account-{account.Id}")">
                    <div class="data-row">
                        <AccountIconMark Icon="@account.Icon" />
                        <div class="data-cells">
                            <a href="@($"/konten/{account.Id}")" class="data-title account-open" aria-label="@L["Accounts_Open", account.Name]" data-testid="@($"account-open-{account.Id}")">@account.Name</a>
                            <p class="small muted">@L["Accounts_ClosedMark", L[$"AccountType_{account.Type}"]]</p>
                        </div>
                        <p class="data-amount num muted">@Money(account.Balance)</p>
                        <DuofyButton Kind="ButtonKind.Ghost" Text="@L["Accounts_Reopen"]" Small="true" OnClick="@(_ => SetActiveAsync(account, true))" TestId="@($"account-reopen-{account.Id}")" Class="@GrantLock.Class(CanEdit)" @attributes="GrantLock.Attributes(CanEdit)" />
                    </div>
                </div>
            }
        </div>
    }
}

}

@code {

    // Deutsche Schreibweise für Beträge (1.234,50), auch wenn das Gerät anders eingestellt ist.
    private static readonly CultureInfo German = new("de-DE");

    private List<AccountResponse> open = [];
    private List<AccountResponse> closed = [];
    private bool showClosed;
    private bool loaded;
    private NoticeMessage? message;

    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

    // Was die Freigabe des gewählten Mitglieds erlaubt (Spec 68); bei "Ich" alles.
    private bool Sees => Member.Allows(GrantAreas.Accounts, AccessLevelKeys.View);
    private bool CanAdd => Member.Allows(GrantAreas.Accounts, AccessLevelKeys.Create);
    private bool CanEdit => Member.Allows(GrantAreas.Accounts, AccessLevelKeys.Edit);

    protected override async Task OnInitializedAsync()
    {
        Chrome.Set(this, L["Accounts_Title"]);
        // Erst nach dem ersten Laden zuhören: Das Laden selbst meldet sich auch als Änderung.
        await Member.LoadAsync();
        Member.Changed += OnMemberChanged;
        await LoadAsync();
    }

    public void Dispose()
    {
        Member.Changed -= OnMemberChanged;
        Chrome.Release(this);
    }

    private void OnMemberChanged() => _ = InvokeAsync(async () =>
    {
        message = null;
        await LoadAsync();
        StateHasChanged();
    });

    // Alle Konten holen, offene und aufgelöste. Die API liefert das Standardkonto zuerst.
    private async Task LoadAsync()
    {
        open = [];
        closed = [];
        loaded = false;
        if (!Sees)
        {
            return;
        }
        var result = await AccountApi.ListAsync(owner: Member.Owner);
        if (result.Succeeded)
        {
            open = result.Value!.Where(a => a.Active).ToList();
            closed = result.Value!.Where(a => !a.Active).ToList();
        }
        else
        {
            message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        }
        loaded = true;
    }

    private async Task AddAsync()
    {
        if (CanAdd)
        {
            await ShowDialogAsync(existing: null, L["AccountDialog_TitleNew"]);
        }
    }

    private async Task EditAsync(AccountResponse account)
    {
        if (CanEdit)
        {
            await ShowDialogAsync(account, L["AccountDialog_TitleEdit"]);
        }
    }

    private async Task ShowDialogAsync(AccountResponse? existing, string title)
    {
        var parameters = new FormParameters<AccountDialog>()
            .Add(x => x.Title, title)
            .Add(x => x.Existing, existing)
            .Add(x => x.Today, Today);

        var outcome = await Forms.OpenStepAsync<AccountDialog, bool>(title, parameters);

        if (outcome.Saved)
        {
            message = new NoticeMessage(L["Accounts_Saved"], NoticeSeverity.Success);
            await LoadAsync();
        }
    }

    private async Task MakeDefaultAsync(AccountResponse account)
    {
        if (account.IsDefault)
        {
            return;
        }
        await UpdateAsync(account, new UpdateAccountRequest(IsDefault: true), L["Accounts_DefaultSet", account.Name]);
    }

    // Auflösen fragt nach, weil es das Konto aus den Listen nimmt und ihm die Markierung als Standardkonto wegnimmt.
    private async Task CloseAsync(AccountResponse account)
    {
        if (CanEdit && await Forms.ConfirmAsync(L["Accounts_CloseText", account.Name], L["Accounts_CloseTitle"], L["Accounts_CloseConfirm"], L["Accounts_CloseCancel"]))
        {
            await SetActiveAsync(account, false);
        }
    }

    // Auflösen und wieder öffnen. Auflösen nimmt dem Konto auch die Markierung als Standardkonto.
    private async Task SetActiveAsync(AccountResponse account, bool active) =>
        await UpdateAsync(account, new UpdateAccountRequest(Active: active), L[active ? "Accounts_Reopened" : "Accounts_Closed"]);

    private async Task UpdateAsync(AccountResponse account, UpdateAccountRequest request, string success)
    {
        if (!CanEdit)
        {
            return;
        }
        var result = await AccountApi.UpdateAsync(account.Id, request);
        message = result.Succeeded
            ? new NoticeMessage(success, NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await LoadAsync();
    }

    private static string Money(decimal amount) => amount.ToString("N2", German) + " €";
}
