@page "/bestaetigen"
@using Radzen
@using Radzen.Blazor
@layout AuthLayout
@using Duofy.ApiClient
@using Duofy.Schemas
@inject IAuthApi AuthApi
@inject IStringLocalizer<SharedResources> L

@* Die Seite hinter dem Link aus der Mail nach der Registrierung (Spec 53, R2): /bestaetigen?id=<Konto>&token=<Token>.
   Sie bestätigt erst auf Knopfdruck, nicht schon beim Öffnen: Manche Mailprogramme öffnen Links vorab, um sie zu
   prüfen. Keine Anmeldung nötig. *@

<PageTitle>@L["Confirm_Title"]</PageTitle>

<div class="auth-header">
    <RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1">@L["Confirm_Title"]</RadzenText>
    <p class="auth-lead">@L["Confirm_Lead"]</p>
</div>

<Notice Message="message" />

@if (done)
{
    <LinkButton Href="/anmelden" FullWidth="true" data-testid="confirm-sign-in">@L["Auth_ToSignIn"]</LinkButton>
}
else if (!Complete)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" AllowClose="false"
                 data-testid="confirm-incomplete">@L["Link_Incomplete"]</RadzenAlert>
}
else
{
    <RadzenButton Text="@(busy ? L["Confirm_Pending"] : L["Confirm_Submit"])" ButtonStyle="ButtonStyle.Primary"
                  Class="rz-w-100" Disabled="busy" Click="@(_ => ConfirmAsync())"
                  data-testid="confirm-submit" />
}

@code {
    [SupplyParameterFromQuery(Name = "id")]
    [Parameter]
    public string? Id { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    [Parameter]
    public string? Token { get; set; }

    private bool busy;
    private bool done;
    private NoticeMessage? message;

    private bool Complete => Guid.TryParse(Id, out _) && !string.IsNullOrEmpty(Token);

    private async Task ConfirmAsync()
    {
        if (busy || !Complete) return;
        busy = true;
        try
        {
            var result = await AuthApi.ConfirmEmailAsync(new ConfirmEmailRequest(Guid.Parse(Id!), Token!));
            done = result.Succeeded;
            message = result.Succeeded
                ? new NoticeMessage(L["Confirm_Done"], NoticeSeverity.Success)
                : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        }
        finally
        {
            busy = false;
        }
    }
}
