@page "/konten/{AccountId:guid}"
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@inject IBookingApi BookingApi
@inject ICategoryApi CategoryApi
@inject IAccountChoices AccountChoices
@implements IDisposable
@inject FormDialogs Forms
@inject IAppHost Host
@inject AppChrome Chrome
@inject ActiveMember Member
@inject BookingDialogLauncher Launcher
@inject TimeProvider Time
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L

@* Die Bewegungen eines Kontos (Spec 51, R5): ein Monat auf einmal nach Datum, mit Pfeilen zum Blättern und den Summen
   oben, Bearbeiten und Löschen je Zeile. Neu gebucht wird hier nicht: Neue Buchungen entstehen nur im Monat des Plans
   (Tom, 01.11.2026: "Nur im Monat, Menüpunkt weg").

   Die Seite rechnet nichts selbst. Sie fragt die API nach Monat und Konto und zeigt die
   Buchungen und Summen, die zurückkommen. Geänderte Buchungen prüft ebenfalls die API;
   die Seite zeigt deren Fehlertexte an.

   Mit dem Umschalter zeigt die Seite die Buchungen eines anderen Mitglieds (Spec 68). Ändern braucht
   dazu, dass es auch seine Konten zeigt. *@

<PageTitle>@Heading</PageTitle>

@* In der App steht der Titel in der oberen Leiste (AppChrome). *@
<AppPageHeading Text="@Heading" />
<RadzenLink Path="/konten" Text="@L["Accounts_BackToList"]" Class="plan-back rz-mb-2" data-testid="account-bookings-back" />
@if (!Host.IsApp)
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-mb-2" data-testid="account-bookings-title">@Heading</RadzenText>
}

<Notice Message="message" />

@if (!Sees)
{
    <NotShared />
}
else
{
<GrantReason Show="@(!(CanEdit && CanDelete))" />

@* Monat und Summen stehen ab 1280 px nebeneinander, darunter untereinander wie bisher. *@
<div class="bookings-top">
@* Blättern: ein Pfeil zurück, der Monat, ein Pfeil vor. *@
<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mb-2">
    <RadzenButton Icon="chevron_left" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(_ => PreviousMonthAsync())"
                  aria-label="@L["Bookings_PreviousMonth"]" data-testid="bookings-previous-month" />
    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" data-testid="bookings-month">@MonthLabel</RadzenText>
    <RadzenButton Icon="chevron_right" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(_ => NextMonthAsync())"
                  aria-label="@L["Bookings_NextMonth"]" data-testid="bookings-next-month" />
</RadzenStack>

@* Die Summen des Kontos in diesem Monat. *@
<RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" Class="rz-mb-2">
    <RadzenCard Variant="Variant.Outlined" Class="flex-grow-1">
        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P">@L["Bookings_Income"]</RadzenText>
        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.P" data-testid="bookings-sum-income">@Money(monthData?.Income ?? 0m)</RadzenText>
    </RadzenCard>
    <RadzenCard Variant="Variant.Outlined" Class="flex-grow-1">
        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P">@L["Bookings_Expenses"]</RadzenText>
        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.P" data-testid="bookings-sum-expenses">@Money(monthData?.Expenses ?? 0m)</RadzenText>
    </RadzenCard>
</RadzenStack>
</div>

@if (monthData is { Bookings.Count: 0 } && loaded)
{
    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-text-secondary-color">@L["Bookings_Empty"]</RadzenText>
}

@* Die Buchungen, die neueste zuerst. Eine aufgeteilte Buchung steht einmal da, mit ihrer Summe. *@
<RadzenStack Gap="0.5rem" Class="data-table bookings-table page-wide">
    @if (monthData is { Bookings.Count: > 0 })
    {
        <div class="data-table-head" aria-hidden="true">
            <span class="data-column-1">@L["Table_Date"]</span>
            <span class="data-column-2">@L["Table_Label"]</span>
            <span class="data-column-3">@L["Table_Details"]</span>
            <span class="data-column-4 data-amount">@L["Table_Amount"]</span>
        </div>
    }
    @foreach (var booking in monthData?.Bookings ?? [])
    {
        <RadzenCard Variant="Variant.Outlined" Class="data-row-frame" data-testid="@($"booking-{booking.Id}")">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" Class="data-row">
                <RadzenStack Gap="0" Class="flex-grow-1 data-cells">
                    <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="data-column-1">@booking.Date.ToString("d", German)</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="data-column-2"><BookingKindBadge Kind="@booking.Kind" /> @Title(booking)</RadzenText>
                    <div class="data-column-3">
                        @if (TransferPots(booking) is { } pots)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" data-testid="@($"booking-transfer-pots-{booking.Id}")">@pots</RadzenText>
                        }
                        @if (booking.Note is { Length: > 0 })
                        {
                            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color">@booking.Note</RadzenText>
                        }
                    </div>
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" Class="data-column-4 data-amount">@SignedMoney(booking)</RadzenText>
                <RadzenButton Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                              Click="@(_ => EditAsync(booking))"
                              Class="@($"data-column-5 {GrantLock.Class(CanEdit)}")" @attributes="GrantLock.Attributes(CanEdit)"
                              aria-label="@L["Bookings_Edit", RowName(booking)]" data-testid="@($"booking-edit-{booking.Id}")" />
                <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                              Click="@(_ => DeleteAsync(booking))"
                              Class="@($"data-column-6 {GrantLock.Class(CanDelete)}")" @attributes="GrantLock.Attributes(CanDelete)"
                              aria-label="@L["Bookings_Delete", RowName(booking)]" data-testid="@($"booking-delete-{booking.Id}")" />
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>
}

@code {

    // Deutsche Schreibweise für Datum und Beträge (21.10.2026, 1.234,50), auch wenn das Gerät anders eingestellt ist.
    private static readonly CultureInfo German = new("de-DE");

    /// <summary>Das Konto aus der Adresse; die API prüft, ob es der Person gehört oder freigegeben ist.</summary>
    [Parameter] public Guid AccountId { get; set; }

    private int year;
    private int month;
    private IReadOnlyList<AccountChoice> accounts = [];
    private List<CategoryResponse> categories = [];
    private BookingMonthResponse? monthData;
    private NoticeMessage? message;
    private bool loaded;

    // Die Überschrift nennt das Konto, sobald es geladen ist.
    private string Heading => accounts.FirstOrDefault(a => a.Id == AccountId)?.Name ?? L["Bookings_Title"];

    // Was die Freigabe des gewählten Mitglieds erlaubt (Spec 68); bei "Ich" alles. Wer bucht oder ändert, wählt
    // ein Konto und muss die Konten deshalb sehen dürfen.
    private bool Sees => Member.Allows(GrantAreas.Book, AccessLevelKeys.View);
    private bool SeesAccounts => Member.Allows(GrantAreas.Accounts, AccessLevelKeys.View);
    private bool CanEdit => Member.Allows(GrantAreas.Book, AccessLevelKeys.Edit) && SeesAccounts;
    private bool CanDelete => Member.Allows(GrantAreas.Book, AccessLevelKeys.Delete);

    private string MonthLabel => new DateTime(year, month, 1).ToString("MMMM yyyy", German);

    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

    // Beim Öffnen: den heutigen Monat wählen, Konten und Kategorien holen, den Monat laden.
    protected override async Task OnInitializedAsync()
    {
        PublishChrome();
        year = Today.Year;
        month = Today.Month;
        // Erst nach dem ersten Laden zuhören: Das Laden selbst meldet sich auch als Änderung.
        await Member.LoadAsync();
        Member.Changed += OnMemberChanged;
        await LoadAllAsync();
    }

    private void OnMemberChanged() => _ = InvokeAsync(async () =>
    {
        message = null;
        await LoadAllAsync();
        StateHasChanged();
    });

    /// <summary>Konten, Kategorien und der Monat der gewählten Person; was sie nicht teilt, bleibt leer.</summary>
    private async Task LoadAllAsync()
    {
        accounts = [];
        monthData = null;
        loaded = false;
        if (!Sees)
        {
            PublishChrome();
            return;
        }

        if (SeesAccounts)
        {
            var accountResult = await AccountChoices.ListAsync(Member.Owner);
            if (accountResult.Succeeded)
            {
                accounts = accountResult.Value!;
            }
            else
            {
                message = new NoticeMessage(ErrorTexts.For(L, accountResult.ErrorCode), NoticeSeverity.Error);
            }
        }

        var categoryResult = await CategoryApi.ListAsync(Member.Owner);
        if (categoryResult.Succeeded)
        {
            categories = categoryResult.Value!.ToList();
        }
        else
        {
            message = new NoticeMessage(ErrorTexts.For(L, categoryResult.ErrorCode), NoticeSeverity.Error);
        }

        PublishChrome();
        await LoadAsync();
    }

    // Der Titel für die App; ein Plus gibt es hier nicht, gebucht wird im Monat.
    private void PublishChrome() => Chrome.Set(this, Heading);

    public void Dispose()
    {
        Member.Changed -= OnMemberChanged;
        Chrome.Release(this);
    }

    private async Task LoadAsync()
    {
        var result = await BookingApi.ListMonthAsync(year, month, AccountId, Member.Owner);
        if (result.Succeeded)
        {
            monthData = result.Value;
        }
        else
        {
            message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        }
        loaded = true;
    }

    private async Task PreviousMonthAsync() => await ShowMonthAsync(new DateTime(year, month, 1).AddMonths(-1));

    private async Task NextMonthAsync() => await ShowMonthAsync(new DateTime(year, month, 1).AddMonths(1));

    private async Task ShowMonthAsync(DateTime first)
    {
        year = first.Year;
        month = first.Month;
        await LoadAsync();
    }

    private async Task EditAsync(BookingResponse booking)
    {
        if (!CanEdit)
        {
            return;
        }

        // Der Dialog geht über den gemeinsamen Aufruf auf (im Browser als Fenster, in der App als Vollbild).
        var outcome = await Launcher.OpenAsync(booking, accounts, categories);
        if (outcome is null)
        {
            return;
        }

        message = outcome;
        if (outcome.Severity == NoticeSeverity.Success)
        {
            await LoadAsync();
        }
    }

    // Löschen fragt immer nach (R7). Erst die Bestätigung löscht wirklich.
    private async Task DeleteAsync(BookingResponse booking)
    {
        if (!CanDelete)
        {
            return;
        }
        var confirmed = await Forms.ConfirmAsync(L["Bookings_DeleteText"], L["Bookings_DeleteTitle"], L["Bookings_DeleteConfirm"], L["Bookings_DeleteCancel"]);
        if (!confirmed)
        {
            return;
        }

        var result = await BookingApi.DeleteAsync(booking.Id);
        message = result.Succeeded
            ? new NoticeMessage(L["Bookings_Deleted"], NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await LoadAsync();
    }

    // Die Überschrift einer Buchung: bei einer Umbuchung "Von → Nach", sonst die Kategorie, sonst die Notiz,
    // und bei mehreren Zeilen der Hinweis "aufgeteilt". Die Art steht als Wort davor (Spec 51, R9).
    // Der Name einer Zeile für ihre Knöpfe; das Datum unterscheidet gleiche Kategorien im selben Monat.
    private string RowName(BookingResponse booking) => $"{Title(booking)} vom {booking.Date.ToString("d", German)}";

    private string Title(BookingResponse booking) =>
        BookingPurpose.For(booking, [], id => categories.FirstOrDefault(c => c.Id == id)?.Name, id => accounts.FirstOrDefault(a => a.Id == id)?.Name, L);

    // Bei einer Umbuchung die Töpfe als Text, "Topf: Sparen → Wünsche" (Spec 72, R9); Farbe allein sagt es nicht.
    // Eine ältere Umbuchung kennt nur ihre Zeile (Sparen) oder gar keinen Topf, dann steht dort weniger oder nichts.
    private string? TransferPots(BookingResponse booking)
    {
        if (booking.Kind != BookingKinds.Transfer || booking.Lines.FirstOrDefault()?.Pot is not { } source)
        {
            return null;
        }
        return booking.TargetPot is { } target
            ? L["Bookings_TransferPots", L[$"Pot_{source}"], L[$"Pot_{target}"]]
            : L["Bookings_TransferPotSource", L[$"Pot_{source}"]];
    }

    private string Money(decimal amount) => amount.ToString("N2", German) + " €";

    // Einnahmen mit Plus, Ausgaben mit Minus. Bei einer Umbuchung kommt für das Zielkonto Geld herein, für das Ausgangskonto geht es ab.
    private string SignedMoney(BookingResponse booking) => Direction(booking) switch
    {
        1 => "+" + Money(booking.Amount),
        -1 => "−" + Money(booking.Amount),
        _ => Money(booking.Amount),
    };

    private int Direction(BookingResponse booking) => booking.Kind switch
    {
        BookingKinds.Income => 1,
        BookingKinds.Expense => -1,
        _ => booking.CounterAccountId == AccountId ? 1 : -1,
    };
}
