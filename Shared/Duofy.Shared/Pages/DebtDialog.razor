@using BlazorBlueprint.Components
@using Duofy.Shared.Dialogs
@inherits FormDialogBase
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@inject IDebtApi DebtApi
@inject ActiveMember Member
@inject IStringLocalizer<SharedResources> L

@* Der Dialog zum Anlegen und Ändern einer Forderung oder eines Kredits (Issue 31): Name, Gläubiger und Betrag sind
   Pflicht, Fälligkeit und Notiz freiwillig. Die Art (Forderung oder Kredit) steht beim Anlegen fest und ändert sich
   später nicht. Geprüft wird beim Speichern von der API; ihre Fehler stehen oben im Dialog, ruhig und ohne Warnfarbe
   im Text. *@

<div>

        <div class="stack">
            @if (error is not null)
            {
                <ErrorAlert Text="@error" data-testid="debt-error" />
            }

            <div class="field">
                <FieldLabel For="debt-name-input" Text="@L["Field_DebtName"]" />
                <TextInput id="debt-name-input" maxlength="@(DebtRules.NameMaxLength)" @bind-Value="name" data-testid="debt-name" />
            </div>
            <div class="field">
                <FieldLabel For="debt-creditor-input" Text="@L["Field_DebtCreditor"]" />
                <TextInput id="debt-creditor-input" maxlength="@(DebtRules.CreditorMaxLength)" @bind-Value="creditor" data-testid="debt-creditor" />
            </div>
            <div class="field">
                <FieldLabel id="debt-amount-label" Text="@L["Field_DebtAmount"]" />
                <MoneyInput aria-labelledby="debt-amount-label" @bind-Value="amount" data-testid="debt-amount" />
            </div>
            <div class="field">
                <FieldLabel For="debt-due-date-input" Text="@L["Field_DebtDueDate"]" />
                <TextInput id="debt-due-date-input" Type="date" Value="@dateText" ValueChanged="OnDateChanged" data-testid="debt-due-date" />
            </div>
            <div class="field">
                <FieldLabel For="debt-note-input" Text="@L["Field_DebtNote"]" />
                <TextInput id="debt-note-input" maxlength="@(DebtRules.NoteMaxLength)" @bind-Value="note" data-testid="debt-note" />
            </div>


                <div class="row-end">
                    <DuofyButton Kind="ButtonKind.Ghost" Text="@L["SavingsGoalDialog_Cancel"]" OnClick="@(_ => Cancel())" />
                    <DuofyButton Text="@L["DebtDialog_Save"]" OnClick="@(_ => SaveAsync())" TestId="debt-save" Disabled="busy" />
                </div>
            
        </div>
</div>

@code {

    private static readonly CultureInfo German = new("de-DE");

    /// <summary>Der Titel für die Kopfzeile in der App; im Browser steht er in der Titelzeile des Fensters.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Der Eintrag, der geändert wird; null beim Anlegen.</summary>
    [Parameter]
    public DebtResponse? Existing { get; set; }

    /// <summary>Beim Anlegen die Art: Forderung oder Kredit (<see cref="DebtKinds"/>).</summary>
    [Parameter]
    public string Kind { get; set; } = DebtKinds.Claim;

    private string name = "";
    private string creditor = "";
    private decimal? amount;
    private DateOnly? date;
    private string dateText = "";
    private string note = "";
    private string? error;
    private bool busy;

    // Die Person, für die der Dialog geöffnet wurde; sie bleibt, auch wenn der Umschalter inzwischen woanders steht.
    private Guid? owner;

    protected override void OnInitialized()
    {
        owner = Member.Owner;
        if (Existing is { } existing)
        {
            name = existing.Name;
            creditor = existing.Creditor;
            amount = existing.OriginalAmount;
            date = existing.DueDate;
            note = existing.Note ?? "";
            dateText = date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "";
        }
    }

    private void OnDateChanged(string value)
    {
        dateText = value;
        date = DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed) ? parsed : null;
    }

    private Task Cancel() => CancelAsync();

    private async Task SaveAsync()
    {
        error = null;
        busy = true;
        try
        {
            var result = Existing is null
                ? await DebtApi.CreateAsync(new CreateDebtRequest(Kind, name, creditor, amount ?? 0m, date, NullIfEmpty(note), owner))
                : await DebtApi.UpdateAsync(Existing.Id, new UpdateDebtRequest(
                    name, creditor, amount ?? 0m, date, NullIfEmpty(note),
                    ClearDueDate: date is null && Existing.DueDate is not null ? true : null,
                    ClearNote: NullIfEmpty(note) is null && Existing.Note is not null ? true : null));

            if (result.Succeeded)
            {
                await CloseAsync(true);
            }
            else
            {
                error = ErrorTexts.For(L, result.ErrorCode);
            }
        }
        finally
        {
            busy = false;
        }
    }

    private static string? NullIfEmpty(string value) => value.Trim().Length == 0 ? null : value;
}
