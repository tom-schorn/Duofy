@page "/passwort-neu"
@using Radzen
@using Radzen.Blazor
@layout AuthLayout
@using Duofy.ApiClient
@using Duofy.Schemas
@inject IAuthApi AuthApi
@inject IStringLocalizer<SharedResources> L

@* Ein neues Passwort ohne das alte (Spec 53, R3 und R4). Zwei Wege führen her:
   - der Link aus der Mail "Passwort vergessen" auf der gehosteten Version: /passwort-neu?email=<Adresse>&token=<Token>
   - der Link des Administrators auf einem selbst betriebenen Server: /passwort-neu?link=<Token>
   Danach ist die Person überall abgemeldet und meldet sich mit dem neuen Passwort an. Keine Anmeldung nötig. *@

<PageTitle>@L["Reset_Title"]</PageTitle>

<div class="auth-header">
    <RadzenText TextStyle="TextStyle.H2" TagName="TagName.H1">@L["Reset_Title"]</RadzenText>
    <p class="auth-lead">@L["Reset_Lead"]</p>
</div>

<Notice Message="message" />

@if (done)
{
    <LinkButton Href="/anmelden" FullWidth="true" data-testid="reset-sign-in">@L["Auth_ToSignIn"]</LinkButton>
}
else if (!ByMail && !ByLink)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" AllowClose="false"
                 data-testid="reset-incomplete">@L["Link_Incomplete"]</RadzenAlert>
}
else
{
    <div class="field">
        <FieldLabel For="reset-password-input" Text="@L["Field_NewPassword"]" />
        <RadzenPassword @bind-Value="password" id="reset-password-input" autocomplete="new-password"
                        aria-describedby="reset-password-hint" data-testid="reset-password" />
        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color rz-display-block"
                    id="reset-password-hint">@L["Field_PasswordHint"]</RadzenText>
    </div>
    <RadzenButton Text="@L["Reset_Submit"]" ButtonStyle="ButtonStyle.Primary" Class="rz-mt-4 rz-w-100"
                  Disabled="busy" Click="@(_ => SaveAsync())" data-testid="reset-submit" />
}

@code {
    [SupplyParameterFromQuery(Name = "email")]
    [Parameter]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    [Parameter]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "link")]
    [Parameter]
    public string? Link { get; set; }

    private string password = "";
    private bool busy;
    private bool done;
    private NoticeMessage? message;

    private bool ByMail => !string.IsNullOrWhiteSpace(Email) && !string.IsNullOrEmpty(Token);

    private bool ByLink => !string.IsNullOrWhiteSpace(Link);

    private async Task SaveAsync()
    {
        if (busy) return;
        // Die Regel für Passwörter gilt auch hier; zu kurz geht gar nicht erst hinaus.
        if (password.Length < AccountRules.PasswordMinLength)
        {
            message = new NoticeMessage(ErrorTexts.For(L, ErrorCodes.PasswordTooShort), NoticeSeverity.Error);
            return;
        }
        busy = true;
        try
        {
            var result = ByMail
                ? await AuthApi.ResetPasswordAsync(new ResetPasswordRequest(Email!.Trim(), Token!, password))
                : await AuthApi.ResetPasswordByLinkAsync(new ResetPasswordByLinkRequest(Link!.Trim(), password));
            done = result.Succeeded;
            if (done)
            {
                password = "";
            }
            message = result.Succeeded
                ? new NoticeMessage(L["Reset_Done"], NoticeSeverity.Success)
                : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        }
        finally
        {
            busy = false;
        }
    }
}
