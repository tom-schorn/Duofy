@page "/passwort-neu"
@layout AuthLayout
@using Duofy.ApiClient
@using Duofy.Schemas
@inject IAuthApi AuthApi
@inject IStringLocalizer<SharedResources> L

@* Ein neues Passwort ohne das alte (Spec 53, R3 und R4). Zwei Wege führen her:
   - der Link aus der Mail "Passwort vergessen" auf der gehosteten Version: /passwort-neu?email=<Adresse>&token=<Token>
   - der Link des Administrators auf einem selbst betriebenen Server: /passwort-neu?link=<Token>
   Danach ist die Person überall abgemeldet und meldet sich mit dem neuen Passwort an. Keine Anmeldung nötig. *@

<PageTitle>@L["Reset_Title"]</PageTitle>

<div class="auth-header">
    <MudText Typo="Typo.h2" HtmlTag="h1">@L["Reset_Title"]</MudText>
    <p class="auth-lead">@L["Reset_Lead"]</p>
</div>

<Notice Message="message" />

@if (done)
{
    <MudButton Href="/anmelden" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
               data-testid="reset-sign-in">@L["Auth_ToSignIn"]</MudButton>
}
else if (!ByMail && !ByLink)
{
    <MudAlert Severity="Severity.Warning" data-testid="reset-incomplete">@L["Link_Incomplete"]</MudAlert>
}
else
{
    <div class="field">
        <FieldLabel For="reset-password-input" Text="@L["Field_NewPassword"]" />
        <MudTextField @bind-Value="password" Variant="Variant.Outlined" InputId="reset-password-input"
                      InputType="InputType.Password" HelperText="@L["Field_PasswordHint"]" autocomplete="new-password"
                      data-testid="reset-password" />
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4" Disabled="busy"
               OnClick="SaveAsync" data-testid="reset-submit">@L["Reset_Submit"]</MudButton>
}

@code {
    [SupplyParameterFromQuery(Name = "email")]
    [Parameter]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    [Parameter]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "link")]
    [Parameter]
    public string? Link { get; set; }

    private string password = "";
    private bool busy;
    private bool done;
    private NoticeMessage? message;

    private bool ByMail => !string.IsNullOrWhiteSpace(Email) && !string.IsNullOrEmpty(Token);

    private bool ByLink => !string.IsNullOrWhiteSpace(Link);

    private async Task SaveAsync()
    {
        if (busy) return;
        // Die Regel für Passwörter gilt auch hier; zu kurz geht gar nicht erst hinaus.
        if (password.Length < AccountRules.PasswordMinLength)
        {
            message = new NoticeMessage(ErrorTexts.For(L, ErrorCodes.PasswordTooShort), Severity.Error);
            return;
        }
        busy = true;
        try
        {
            var result = ByMail
                ? await AuthApi.ResetPasswordAsync(new ResetPasswordRequest(Email!.Trim(), Token!, password))
                : await AuthApi.ResetPasswordByLinkAsync(new ResetPasswordByLinkRequest(Link!.Trim(), password));
            done = result.Succeeded;
            if (done)
            {
                password = "";
            }
            message = result.Succeeded
                ? new NoticeMessage(L["Reset_Done"], Severity.Success)
                : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), Severity.Error);
        }
        finally
        {
            busy = false;
        }
    }
}
