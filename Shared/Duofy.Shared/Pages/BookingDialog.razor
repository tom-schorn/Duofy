@using BlazorBlueprint.Components
@using Duofy.Shared.Dialogs
@using Duofy.Shared.Layout
@inherits FormDialogBase
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@using Duofy.Shared.Dialogs
@inject IBookingApi BookingApi
@inject ICategoryApi CategoryApi
@inject IPlanApi PlanApi
@inject ActiveMember Member
@inject IStringLocalizer<SharedResources> L

@* Der Dialog zum Anlegen und Ändern einer Buchung, in Schritten (Spec 22, Spec 124) auf dem Schritt-Dialog (Spec 11):
   1 Was und wann (Art, Betrag, Datum, Planmonat),
   2 Konto und Kategorie (Konto, Topf und Kategorie; bei einer Umbuchung Von-Konto, Zielkonto, Von Topf und Zu Topf),
   3 Posten (freiwillig), dazu der Schalter "Betrag aufteilen",
   4 Aufteilen (nur wenn aufgeteilt wird: die weiteren Zeilen; Zeile 1 bekommt den Rest),
   5 Prüfen und speichern (Zusammenfassung, Notiz, Fehler der API).
   Sind Betrag, Konto, Topf und Kategorie gewählt (bei einer Umbuchung Zielkonto und beide Töpfe), speichert ab Schritt 2 der frühe Knopf "Speichern" (Spec 124, R6).
   Konto, Topf, Kategorie und Posten sind Auswahlfelder mit Suchfeld (ComboBox), keine Listen mit einem Knopf "Bitte wählen".
   Alle Buchungsarten und alle Regeln sind unverändert; auf dem Handy füllt der Dialog den Bildschirm, und nur der Inhalt rollt.

   Wer den Dialog öffnet (der Monat zum Anlegen, die Bewegungen am Konto zum Ändern), reicht ihm die Konten und Kategorien als Parameter und bekommt am Ende mit,
   ob gespeichert wurde.

   Alle Eingaben stehen in `draft`, einem BookingDraft. Dort stehen auch die Rechenregeln
   (die erste Zeile nimmt den Rest, der Topf folgt der Kategorie). Der Dialog zeigt sie nur an. Weiter verlangt ein Konto
   (derselbe Satz wie zuvor beim Speichern); alles andere prüft wie bisher die API, ihre Fehler stehen oben im letzten Schritt. *@

<StepDialog @ref="stepDialog" Title="@Title" OnFinish="SaveAsync" EarlyFinish="@CanSaveEarly" EarlyFinishTestId="booking-save-early" FinishText="@L["BookingDialog_Save"]" Busy="busy" FinishTestId="booking-save" NextTestId="booking-next" HasInput="@(() => touched)">
    <DialogStep Title="@L["BookingDialog_StepWhat"]">
        @* Ausgabe, Einnahme oder Umbuchung. Die gewählte Art ist gefüllt und trägt ein Häkchen (Spec 124, R2); aria-pressed sagt es auch Vorlesegeräten. *@
        <div class="booking-kinds" role="group" aria-label="@L["BookingDialog_KindLabel"]">
            @foreach (var kind in BookingKinds.All)
            {
                var selected = draft.Kind == kind;
                <DuofyButton Kind="ButtonKind.Secondary" Text="@L[$"BookingDialog_Kind_{kind}"]" OnClick="@(_ => SetKind(kind))" TestId="@($"booking-kind-{kind}")" aria-pressed="@(selected ? "true" : "false")" />
            }
        </div>

        @* Betrag und Datum. Der Betrag ist immer positiv; ob er abgeht oder hereinkommt, bestimmt die Art. *@
        @* Auf dem Handy öffnet inputmode="decimal" die Zifferntastatur. *@
        <StepField Label="@L["Field_Amount"]" InputId="booking-amount-input" TestId="booking-amount-field">
            <MoneyInput id="booking-amount-input" Value="draft.Amount" ValueChanged="@(v => OnAmountChanged(v))" Min="0" data-testid="booking-amount" />
        </StepField>
        <StepField Label="@L["Field_Date"]" InputId="booking-date-input" TestId="booking-date-field">
            <TextInput id="booking-date-input" Type="date" Value="@dateText" ValueChanged="OnDateChanged" data-testid="booking-date" />
        </StepField>

        @* Der Planmonat: in welchem Monat die Buchung im Plan zählt. Der Kontostand folgt immer dem Datum. *@
        <StepField Label="@L["Field_PlanMonth"]" InputId="booking-plan-month-input" TestId="booking-plan-month-field">
            <NativeSelect Value="@MonthKey(draft.PlanMonth)" ValueChanged="OnPlanMonthChanged" id="booking-plan-month-input"
                          data-testid="booking-plan-month">
                @foreach (var month in PlanMonths())
                {
                    <option value="@MonthKey(month)">@month.ToString("MMMM yyyy", German)</option>
                }
            </NativeSelect>
        </StepField>
    </DialogStep>

    <DialogStep Title="@L["BookingDialog_StepAccounts"]">
        @* Ohne Konto geht es nicht weiter; der Satz ist derselbe wie zuvor beim Speichern. *@
        <StepField Label="@L[draft.Kind == BookingKinds.Transfer ? "Field_FromAccount" : "Field_Account"]" InputId="booking-account-input"
                   Validate="@(() => draft.AccountId is null ? L["BookingDialog_AccountRequired"].Value : null)"
                   TestId="booking-account-field">
            <ComboBox Value="@Key(draft.AccountId)" ValueChanged="OnAccountChosen" Options="AccountOptions(draft.AccountId)"
                      Label="@L[draft.Kind == BookingKinds.Transfer ? "Field_FromAccount" : "Field_Account"]" Placeholder="@L["BookingDialog_ChooseAccount"]"
                      InputId="booking-account-input" DescribedBy="booking-account-input-error" aria-required="true" TestId="booking-account" />
        </StepField>

        @if (draft.Kind == BookingKinds.Transfer)
        {
            @* Bei einer Umbuchung gibt es keine Kategorie und nur eine Zeile (den Quelltopf), dazu ein zweites Konto. Quelle und Ziel
               verschieben den Betrag zwischen den Töpfen (Spec 72, R9; Spec 112): Pflicht, ohne Vorauswahl, aus den drei Töpfen. *@
            <StepField Label="@L["Field_ToAccount"]" InputId="booking-counter-account-input" TestId="booking-counter-account-field"
                       Validate="@(() => draft.CounterAccountId is null ? L["Error_counter_account_required"].Value : null)">
                <ComboBox Value="@Key(draft.CounterAccountId)" ValueChanged="OnCounterAccountChosen" Options="AccountOptions(draft.CounterAccountId)"
                          Label="@L["Field_ToAccount"]" Placeholder="@L["BookingDialog_ChooseAccount"]" InputId="booking-counter-account-input"
                          DescribedBy="booking-counter-account-input-error" aria-required="true" TestId="booking-counter-account" />
            </StepField>
            <StepField Label="@L["Field_TransferSourcePotRequired"]" InputId="booking-transfer-source-pot-input" TestId="booking-transfer-source-pot-field"
                       Validate="@(() => string.IsNullOrEmpty(draft.TransferSourcePot) ? L["Error_transfer_pots_required"].Value : null)">
                <ComboBox Value="@draft.TransferSourcePot" ValueChanged="OnTransferSourcePotChanged" Options="PotOptions()"
                          Label="@L["Field_TransferSourcePotRequired"]" Placeholder="@L["BookingDialog_ChoosePot"]" InputId="booking-transfer-source-pot-input"
                          DescribedBy="booking-transfer-source-pot-input-error" aria-required="true" TestId="booking-transfer-source-pot" />
            </StepField>
            <StepField Label="@L["Field_TransferTargetPotRequired"]" InputId="booking-transfer-target-pot-input" TestId="booking-transfer-target-pot-field"
                       Validate="@(() => string.IsNullOrEmpty(draft.TransferTargetPot) ? L["Error_transfer_pots_required"].Value : null)">
                <ComboBox Value="@draft.TransferTargetPot" ValueChanged="OnTransferTargetPotChanged" Options="PotOptions()"
                          Label="@L["Field_TransferTargetPotRequired"]" Placeholder="@L["BookingDialog_ChoosePot"]" InputId="booking-transfer-target-pot-input"
                          DescribedBy="booking-transfer-target-pot-input-error" aria-required="true" TestId="booking-transfer-target-pot" />
            </StepField>
        }
        else
        {
            @* Die erste Zeile: Kategorie und Topf. Der Posten folgt freiwillig im nächsten Schritt, der Betrag der Zeile steht im Schritt Aufteilen. *@
            @CategoryPotFields(0)
        }
    </DialogStep>

    <DialogStep Title="@L["BookingDialog_StepPosition"]">
        @if (draft.Kind == BookingKinds.Transfer)
        {
            <StepField Label="@L["Field_Position"]" InputId="booking-transfer-position-input" TestId="booking-transfer-position-field">
                <ComboBox Value="@Key(draft.TransferPositionId)" ValueChanged="OnTransferPositionChanged" Options="PositionOptions()" EmptyText="@L["BookingDialog_NoPosition"]"
                          Label="@L["Field_Position"]" InputId="booking-transfer-position-input" TestId="booking-transfer-position" />
            </StepField>
        }
        else
        {
            @PositionField(0)

            @if (draft.CanAddLine || splitting)
            {
                <div class="booking-split-switch">
                    <DuofyButton Kind="ButtonKind.Secondary" Text="@L["BookingDialog_SplitOn"]" OnClick="@(_ => ToggleSplit())" TestId="booking-split"
                                 aria-pressed="@(splitting ? "true" : "false")" />
                    <p class="field-hint">@L["BookingDialog_SplitHint"]</p>
                </div>
            }
        }
    </DialogStep>

    @* Nur wenn aufgeteilt wird: die weiteren Zeilen in einem eigenen Schritt, damit der Dialog nicht ohne Ende wächst (Spec 124, R4). *@
    <DialogStep Title="@L["BookingDialog_StepSplit"]" Skipped="@(!splitting || draft.Kind == BookingKinds.Transfer)">
        @for (var i = 0; i < draft.Lines.Count; i++)
        {
            var index = i;
            var line = draft.Lines[index];
            <div class="booking-line" data-testid="@($"booking-line-{index}")">
                @* Die erste Zeile trägt ihre Nummer schon in der Beschriftung ("Zeile 1 bekommt den Rest"), eine Überschrift darüber wäre doppelt. *@
                @if (index > 0)
                {
                    <h3 class="booking-line-title">@L["BookingDialog_Line", index + 1]</h3>
                }
                @* Die erste Zeile ist nicht bearbeitbar: Sie zeigt, was übrig bleibt. *@
                <StepField Label="@(index == 0 ? L["BookingDialog_SplitRest"] : L["Field_Amount"])" InputId="@($"booking-line-amount-{index}-input")">
                    <MoneyInput id="@($"booking-line-amount-{index}-input")" Value="line.Amount" ValueChanged="@(v => OnLineAmountChanged(index, v))" ReadOnly="@(index == 0)" data-testid="@($"booking-line-amount-{index}")" />
                </StepField>
                @if (index == 0)
                {
                    <p class="field-hint" data-testid="booking-line-0-summary">@LineText(line)</p>
                }
                else
                {
                    @CategoryPotFields(index)
                    @PositionField(index)
                    <div class="booking-line-actions">
                        <DuofyButton Kind="ButtonKind.Ghost" Text="@L["BookingDialog_RemoveLine"]" Small="true" OnClick="@(_ => RemoveLine(index))" TestId="@($"booking-line-remove-{index}")" />
                    </div>
                }
            </div>
        }
        <DuofyButton Kind="ButtonKind.Secondary" Text="@L["BookingDialog_AddLine"]" OnClick="@(_ => draft.AddLine())" TestId="booking-line-add" Disabled="@(!draft.CanAddLine)" />
    </DialogStep>

    <DialogStep Title="@L["BookingDialog_StepCheck"]">
        @if (error is not null)
        {
            <ErrorAlert Text="@error" data-testid="booking-error" />
        }

        @* Alles auf einen Blick, bevor gespeichert wird; geändert wird in den Schritten davor. *@
        <dl class="booking-summary" data-testid="booking-summary" aria-label="@L["BookingDialog_Summary"]">
            <div><dt>@L["BookingDialog_KindLabel"]</dt><dd>@L[$"BookingDialog_Kind_{draft.Kind}"]</dd></div>
            <div><dt>@L["Field_Amount"]</dt><dd>@(draft.Amount is { } amount ? Money(amount) : "–")</dd></div>
            <div><dt>@L["Field_Date"]</dt><dd>@draft.Date.ToString("d. MMMM yyyy", German)</dd></div>
            <div><dt>@L[draft.Kind == BookingKinds.Transfer ? "Field_FromAccount" : "Field_Account"]</dt><dd>@AccountName(draft.AccountId)</dd></div>
            @if (draft.Kind == BookingKinds.Transfer)
            {
                <div><dt>@L["Field_ToAccount"]</dt><dd>@AccountName(draft.CounterAccountId)</dd></div>
                <div><dt>@L["Field_TransferSourcePotRequired"]</dt><dd>@PotName(draft.TransferSourcePot)</dd></div>
                <div><dt>@L["Field_TransferTargetPotRequired"]</dt><dd>@PotName(draft.TransferTargetPot)</dd></div>
            }
            else
            {
                @foreach (var line in draft.Lines)
                {
                    <div><dt>@LineLabel(line)</dt><dd>@LineText(line)</dd></div>
                }
            }
        </dl>

        <StepField Label="@L["Field_Note"]" InputId="booking-note-input" TestId="booking-note-field">
            <TextInput id="booking-note-input" maxlength="@(BookingRules.NoteMaxLength)" @bind-Value="draft.Note" data-testid="booking-note" />
        </StepField>
    </DialogStep>
</StepDialog>

@code {

    private static readonly CultureInfo German = new("de-DE");

    /// <summary>Der Titel im Kopf des Schritt-Dialogs ("Neue Buchung" oder "Buchung ändern").</summary>
    [Parameter]
    public string? Title { get; set; }

    // Das Feld verweist auf seine Beschriftung.
    private static Dictionary<string, object> Labelled(string inputId) => new()
    {
        ["aria-labelledby"] = $"{inputId}-label",
        ["inputmode"] = "decimal",
    };

    /// <summary>Die Buchung, die geändert wird; null beim Anlegen.</summary>
    [Parameter]
    public BookingResponse? Existing { get; set; }

    /// <summary>Alle Konten der Person. Aufgelöste werden nicht zur Wahl angeboten.</summary>
    [Parameter]
    public IReadOnlyList<AccountChoice> Accounts { get; set; } = [];

    /// <summary>Alle Kategorien. Neue eigene Kategorien kommen im Dialog dazu.</summary>
    [Parameter]
    public List<CategoryResponse> Categories { get; set; } = [];

    /// <summary>Das Datum von heute; so ist das Datum beim Anlegen vorbelegt.</summary>
    [Parameter]
    public DateOnly Today { get; set; }

    /// <summary>Beim Anlegen: der Planmonat, in dem die Buchung zählen soll; ohne Angabe der Monat von heute.</summary>
    [Parameter]
    public DateOnly? PlanMonth { get; set; }

    /// <summary>Beim Anlegen: der Posten, zu dem die Buchung gehört; die Art folgt seinem Topf (Spec 51, R7).</summary>
    [Parameter]
    public Guid? PositionId { get; set; }

    private StepDialog? stepDialog;

    private BookingDraft draft = default!;

    // Die Person, für die der Dialog geöffnet wurde; sie bleibt, auch wenn der Umschalter inzwischen woanders steht (Spec 68, A15).
    private Guid? owner;

    // Der Plan des gewählten Planmonats; seine Posten stehen in der Auswahl je Zeile.
    private PlanResponse? plan;
    private string dateText = "";
    private string? error;
    private bool busy;

    // Ob der Betrag aufgeteilt wird; dann gibt es den Schritt Aufteilen. Beim Ändern einer Buchung mit mehreren Zeilen von Anfang an.
    private bool splitting;

    // Ob schon etwas gewählt ist, das keine Eingabe im Inhalt auslöst (die Auswahlfelder); Abbrechen fragt dann nach.
    private bool touched;

    // Für die Zeile, zu der gerade eine neue Kategorie angelegt wird.
    private int? newCategoryLine;
    private string newCategoryName = "";
    private string newCategoryGroup = "";
    private string newCategoryPot = PotKeys.Needs;
    private string? newCategoryError;

    protected override void OnInitialized()
    {
        owner = Member.Owner;
        // Beim Anlegen: Ausgabe, heute, Standardkonto (R9). Beim Ändern: die gespeicherten Werte.
        draft = Existing is null
            ? BookingDraft.ForNew(Today, Accounts.FirstOrDefault(a => a.IsDefault && a.Active)?.Id, PlanMonth)
            : BookingDraft.From(Existing);
        dateText = draft.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        splitting = draft.Lines.Count > 1 && draft.Kind != BookingKinds.Transfer;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPlanAsync();
        if (Existing is null && plan?.Positions.FirstOrDefault(p => p.Id == PositionId) is { } position)
        {
            draft.SetKind(position.Pot == PotKeys.Income ? BookingKinds.Income : BookingKinds.Expense);
            draft.ChoosePosition(0, position);
        }
    }

    private string PositionText(PlanPositionResponse position) =>
        position.DoneAt is null ? position.Label : L["BookingDialog_PositionDone", position.Label];

    // Lädt den Plan des Planmonats. Ohne Plan gibt es keine Posten zur Wahl; buchen geht trotzdem.
    private async Task LoadPlanAsync()
    {
        var month = draft.PlanMonth;
        var result = await PlanApi.GetAsync(month.Year, month.Month, owner);
        plan = result.Succeeded ? result.Value : null;
    }

    private static string MonthKey(DateOnly month) => month.ToString("yyyy-MM", CultureInfo.InvariantCulture);

    // Die drei Monate um das Datum; ein gespeicherter Planmonat außerhalb (über einen Posten) bleibt wählbar.
    private IEnumerable<DateOnly> PlanMonths() =>
        draft.PlanMonthOptions.Contains(draft.PlanMonth) ? draft.PlanMonthOptions : draft.PlanMonthOptions.Append(draft.PlanMonth).Order();

    private async Task OnPlanMonthChanged(string value)
    {
        if (DateOnly.TryParseExact(value + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var month)
            && month != draft.PlanMonth)
        {
            draft.SetPlanMonth(month);
            await LoadPlanAsync();
        }
    }

    private void OnPositionChanged(int index, string value)
    {
        touched = true;
        draft.ChoosePosition(index, plan?.Positions.FirstOrDefault(p => p.Id == ParseId(value)));
    }

    private void OnTransferPositionChanged(string value)
    {
        touched = true;
        draft.TransferPositionId = ParseId(value);
    }

    // Leere Auswahl heißt "", sonst die Kennung als Text. So lassen sich Auswahlfelder an Guid? binden.
    private static string Key(Guid? id) => id?.ToString() ?? "";

    private static Guid? ParseId(string? text) => Guid.TryParse(text, out var id) ? id : null;

    private void SetKind(string kind)
    {
        touched = true;
        draft.SetKind(kind);
    }

    // "Betrag aufteilen" an: Es kommt eine zweite Zeile, und der Schritt Aufteilen erscheint. Aus: Die weiteren Zeilen entfallen,
    // die erste nimmt wieder den ganzen Betrag.
    private void ToggleSplit()
    {
        touched = true;
        if (splitting)
        {
            for (var i = draft.Lines.Count - 1; i > 0; i--)
            {
                draft.RemoveLine(i);
            }
            splitting = false;
        }
        else
        {
            if (draft.Lines.Count < 2)
            {
                draft.AddLine();
            }
            splitting = true;
        }
    }

    private void OnAmountChanged(decimal? amount) => draft.SetAmount(amount);

    private void OnLineAmountChanged(int index, decimal? amount) => draft.SetLineAmount(index, amount);

    private void OnAccountChosen(string value)
    {
        touched = true;
        draft.AccountId = ParseId(value);
    }

    private void OnCounterAccountChosen(string value)
    {
        touched = true;
        draft.CounterAccountId = ParseId(value);
    }

    private void OnTransferSourcePotChanged(string pot)
    {
        touched = true;
        draft.TransferSourcePot = pot;
    }

    private void OnTransferTargetPotChanged(string pot)
    {
        touched = true;
        draft.TransferTargetPot = pot;
    }

    private void OnPotChanged(int index, string pot)
    {
        touched = true;
        draft.Lines[index].Pot = pot;
    }

    private async Task OnDateChanged(string value)
    {
        dateText = value;
        if (DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            // Rückt das Datum zu weit, wechselt der Planmonat mit; dann gelten die Posten des neuen Monats.
            var before = draft.PlanMonth;
            draft.Date = date;
            if (draft.PlanMonth != before)
            {
                await LoadPlanAsync();
            }
        }
    }

    // Wer eine Kategorie wählt, bekommt ihren vorgeschlagenen Topf vorgewählt und darf ihn ändern.
    private void OnCategoryChanged(int index, string value)
    {
        touched = true;
        var category = Categories.FirstOrDefault(c => c.Id == ParseId(value));
        draft.ChooseCategory(index, category);
    }

    private void RemoveLine(int index) => draft.RemoveLine(index);

    // Einnahmen bieten nur Einnahme-Kategorien an, Ausgaben alle anderen (R3). In der Liste stehen sie nach Topf geordnet (Spec 124, R3),
    // in der Reihenfolge der Töpfe; innerhalb eines Topfs bleibt die Reihenfolge der API.
    private IReadOnlyList<ComboOption> CategoryOptions() => Categories
        .Where(c => (c.Group == CategoryGroupKeys.Income) == (draft.Kind == BookingKinds.Income))
        .OrderBy(c => PotOrder(c.SuggestedPot))
        .Select(c => new ComboOption(c.Id.ToString(), c.Name, PotName(c.SuggestedPot)))
        .ToList();

    // Die Töpfe, die diese Art anbietet, mit ihrem Namen.
    private IReadOnlyList<ComboOption> PotOptions() => OfferedPots().Select(p => new ComboOption(p, L[$"Pot_{p}"].Value)).ToList();

    // Ob der frühe Knopf "Speichern" erscheint (Spec 124, R6): Betrag und Konto sind da, dazu Topf und Kategorie jeder Zeile,
    // bei einer Umbuchung das Zielkonto und beide Töpfe. Alles weitere (Posten, Aufteilen) ist freiwillig.
    private bool CanSaveEarly => draft.Amount is > 0 && draft.AccountId is not null
        && (draft.Kind == BookingKinds.Transfer
            ? draft.CounterAccountId is not null && draft.CounterAccountId != draft.AccountId
                && !string.IsNullOrEmpty(draft.TransferSourcePot) && !string.IsNullOrEmpty(draft.TransferTargetPot)
            : draft.Lines.All(l => l.Amount is > 0 && l.CategoryId is not null && !string.IsNullOrEmpty(l.Pot)));

    private static int PotOrder(string pot) => Math.Max(PotKeys.All.ToList().IndexOf(pot), 0);

    // Die Posten des Planmonats nach Fälligkeitstag geordnet, jeder mit Name und geplantem Betrag, der Fälligkeitstag steht als Gruppe darüber (Spec 124, R3).
    private IReadOnlyList<ComboOption> PositionOptions() => PlanView.OfferedPositions(plan, draft.Kind)
        .OrderBy(p => p.DueDay > 0 ? p.DueDay : int.MaxValue)
        .ThenBy(p => p.Label, StringComparer.CurrentCultureIgnoreCase)
        .Select(p => new ComboOption(
            p.Id.ToString(),
            PositionText(p),
            p.DueDay > 0 ? L["BookingDialog_PositionDue", p.DueDay].Value : L["BookingDialog_PositionNoDue"].Value,
            Money(p.AmountPlanned)))
        .ToList();

    // Die Konten mit Symbol; aufgelöste nur, wenn es das gewählte ist, damit es beim Ändern sichtbar bleibt.
    private IReadOnlyList<ComboOption> AccountOptions(Guid? chosen) => Accounts
        .Where(a => a.Active || a.Id == chosen)
        .Select(a => new ComboOption(a.Id.ToString(), a.Name, null, null, string.IsNullOrEmpty(a.Icon) ? null : a.Icon))
        .ToList();

    // Bei einer Zeile heißt der Eintrag der Zusammenfassung "Kategorie", bei mehreren "Zeile n".
    private string LineLabel(LineDraft line) =>
        draft.Lines.Count > 1 ? L["BookingDialog_Line", draft.Lines.IndexOf(line) + 1].Value : L["Field_Category"].Value;

    private static string Money(decimal amount) => amount.ToString("N2", German) + " €";

    private string AccountName(Guid? id) => Accounts.FirstOrDefault(a => a.Id == id)?.Name ?? "–";

    private string PotName(string? pot) => string.IsNullOrEmpty(pot) ? "–" : L[$"Pot_{pot}"].Value;

    // Eine Zeile als Satz für die Zusammenfassung: Betrag, Kategorie, Topf, Posten.
    private string LineText(LineDraft line)
    {
        var parts = new List<string>();
        if (line.Amount is { } amount)
        {
            parts.Add(Money(amount));
        }
        if (Categories.FirstOrDefault(c => c.Id == line.CategoryId) is { } category)
        {
            parts.Add(category.Name);
        }
        if (!string.IsNullOrEmpty(line.Pot))
        {
            parts.Add(PotName(line.Pot));
        }
        if (plan?.Positions.FirstOrDefault(p => p.Id == line.PositionId) is { } position)
        {
            parts.Add(PositionText(position));
        }
        return string.Join(" · ", parts);
    }

    // Kategorie und Topf einer Zeile (beide Pflicht), dazu die Eingabe einer eigenen Kategorie, wenn sie für diese Zeile gerade offen ist.
    // Eine Kategorie ist immer nötig, die API verlangt sie; es gibt keine Wahl "Keine Kategorie".
    private RenderFragment CategoryPotFields(int index) => @<text>
        @{
            var line = draft.Lines[index];
        }
        <StepField Label="@L["Field_Category"]" InputId="@($"booking-line-category-{index}-input")"
                   Validate="@(() => line.CategoryId is null ? L["Error_category_required"].Value : null)">
            <ComboBox Value="@Key(line.CategoryId)" ValueChanged="v => OnCategoryChanged(index, v)" Options="CategoryOptions()" Label="@L["Field_Category"]"
                      Placeholder="@L["BookingDialog_ChooseCategory"]" InputId="@($"booking-line-category-{index}-input")"
                      DescribedBy="@($"booking-line-category-{index}-input-error")" aria-required="true" TestId="@($"booking-line-category-{index}")" />
        </StepField>

        <StepField Label="@L["Field_PotRequired"]" InputId="@($"booking-line-pot-{index}-input")"
                   Validate="@(() => string.IsNullOrEmpty(line.Pot) ? L["Error_pot_required"].Value : null)">
            <ComboBox Value="@line.Pot" ValueChanged="v => OnPotChanged(index, v)" Options="PotOptions()" Label="@L["Field_PotRequired"]"
                      Placeholder="@L["BookingDialog_ChoosePot"]" InputId="@($"booking-line-pot-{index}-input")"
                      DescribedBy="@($"booking-line-pot-{index}-input-error")" aria-required="true" TestId="@($"booking-line-pot-{index}")" />
        </StepField>

        @* Eigene Kategorien legt nur ihre Person an (Spec 68); für ein anderes Mitglied gibt es den Knopf nicht. *@
        @if (owner is null && newCategoryLine != index)
        {
            <div class="booking-line-actions">
                <DuofyButton Kind="ButtonKind.Ghost" Text="@L["BookingDialog_NewCategory"]" Small="true" OnClick="@(_ => OpenNewCategory(index))" TestId="booking-new-category" />
            </div>
        }

        @* Eine eigene Kategorie anlegen, ohne den Dialog zu verlassen. *@
        @if (newCategoryLine == index)
        {
            <div class="booking-line">
                @if (newCategoryError is not null)
                {
                    <ErrorAlert Text="@newCategoryError" />
                }
                <StepField Label="@L["Field_CategoryName"]" InputId="booking-new-category-name-input">
                    <TextInput id="booking-new-category-name-input" maxlength="@(CategoryRules.NameMaxLength)" @bind-Value="newCategoryName" data-testid="booking-new-category-name" />
                </StepField>
                <StepField Label="@L["Field_Group"]" InputId="booking-new-category-group-input">
                    <NativeSelect @bind-Value="newCategoryGroup" id="booking-new-category-group-input"
                                  data-testid="booking-new-category-group">
                        @foreach (var group in CategoryGroupKeys.All.Where(g => (g == CategoryGroupKeys.Income) == (draft.Kind == BookingKinds.Income)))
                        {
                            <option value="@group">@L[$"CategoryGroup_{group}"]</option>
                        }
                    </NativeSelect>
                </StepField>
                <StepField Label="@L["Field_Pot"]" InputId="booking-new-category-pot-input">
                    <NativeSelect @bind-Value="newCategoryPot" id="booking-new-category-pot-input"
                                  data-testid="booking-new-category-pot">
                        @foreach (var pot in OfferedPots())
                        {
                            <option value="@pot">@L[$"Pot_{pot}"]</option>
                        }
                    </NativeSelect>
                </StepField>
                <div class="booking-line-actions">
                    <DuofyButton Text="@L["BookingDialog_NewCategorySave"]" OnClick="@(_ => SaveNewCategoryAsync())" TestId="booking-new-category-save" />
                    <DuofyButton Kind="ButtonKind.Ghost" Text="@L["BookingDialog_Cancel"]" OnClick="@(_ => CloseNewCategory())" />
                </div>
            </div>
        }
    </text>;

    // Der Posten des Planmonats, den diese Zeile füllt (freiwillig); auch ein abgehakter, er ist dann so benannt (Spec 51, R7).
    private RenderFragment PositionField(int index) => @<text>
        @{
            var line = draft.Lines[index];
        }
        <StepField Label="@L["Field_Position"]" InputId="@($"booking-line-position-{index}-input")">
            <ComboBox Value="@Key(line.PositionId)" ValueChanged="v => OnPositionChanged(index, v)" Options="PositionOptions()" EmptyText="@L["BookingDialog_NoPosition"]"
                      Label="@L["Field_Position"]" InputId="@($"booking-line-position-{index}-input")" TestId="@($"booking-line-position-{index}")" />
        </StepField>
    </text>;

    private IEnumerable<string> OfferedPots() => draft.Kind == BookingKinds.Income
        ? [PotKeys.Income]
        : PotKeys.All.Where(p => p != PotKeys.Income);

    private void OpenNewCategory(int index)
    {
        newCategoryLine = index;
        newCategoryName = "";
        newCategoryPot = OfferedPots().First();
        newCategoryGroup = CategoryGroupKeys.All.First(g => (g == CategoryGroupKeys.Income) == (draft.Kind == BookingKinds.Income));
        newCategoryError = null;
    }

    private void CloseNewCategory() => newCategoryLine = null;

    private async Task SaveNewCategoryAsync()
    {
        var result = await CategoryApi.CreateAsync(new SaveCategoryRequest(newCategoryName, newCategoryGroup, newCategoryPot));
        if (!result.Succeeded)
        {
            newCategoryError = ErrorTexts.For(L, result.ErrorCode);
            return;
        }

        // Die neue Kategorie ist sofort in der Liste und in der Zeile gewählt.
        Categories.Add(result.Value!);
        draft.ChooseCategory(newCategoryLine!.Value, result.Value);
        newCategoryLine = null;
    }

    private async Task SaveAsync()
    {
        error = null;
        if (draft.AccountId is null)
        {
            error = L["BookingDialog_AccountRequired"];
            return;
        }

        busy = true;
        try
        {
            var request = draft.ToRequest();
            // Neu angelegt gehört die Buchung der Person, deren Zahlen gerade offen sind (Spec 68).
            var result = Existing is null
                ? await BookingApi.CreateAsync(request with { OwnerId = owner })
                : await BookingApi.UpdateAsync(Existing.Id, request);

            if (result.Succeeded)
            {
                await CloseAsync(true);
            }
            else
            {
                error = ErrorTexts.For(L, result.ErrorCode);
                // Beim frühen Speichern steht der Fehler im letzten Schritt; dorthin geht der Dialog, damit er zu lesen ist.
                stepDialog?.ShowLast();
            }
        }
        finally
        {
            busy = false;
        }
    }
}
