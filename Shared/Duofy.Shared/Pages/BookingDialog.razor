@using BlazorBlueprint.Components
@using Duofy.Shared.Dialogs
@inherits FormDialogBase
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@using Duofy.Shared.Dialogs
@inject IBookingApi BookingApi
@inject ICategoryApi CategoryApi
@inject IPlanApi PlanApi
@inject ActiveMember Member
@inject IStringLocalizer<SharedResources> L

@* Der Dialog zum Anlegen und Ändern einer Buchung, in zwei Schritten (Issue #21, Spec 22) auf dem Schritt-Dialog (Spec 11):
   1 Was und wann (Art, Betrag, Datum, Planmonat, Konto; bei einer Umbuchung auch das Zielkonto),
   2 Einordnung (die Zeilen mit Kategorie, Topf und Posten, bei einer Umbuchung Von Topf, Zu Topf und Posten; dazu die Notiz).
   Alle Buchungsarten und alle Regeln sind unverändert; auf dem Handy füllt der Dialog den Bildschirm, und nur der Inhalt rollt.

   Wer den Dialog öffnet (der Monat zum Anlegen, die Bewegungen am Konto zum Ändern), reicht ihm die Konten und Kategorien als Parameter und bekommt am Ende mit,
   ob gespeichert wurde.

   Alle Eingaben stehen in `draft`, einem BookingDraft. Dort stehen auch die Rechenregeln
   (die erste Zeile nimmt den Rest, der Topf folgt der Kategorie). Der Dialog zeigt sie nur an. Weiter verlangt ein Konto
   (derselbe Satz wie zuvor beim Speichern); alles andere prüft wie bisher die API, ihre Fehler stehen oben in Schritt 2. *@

<StepDialog Title="@shownTitle" OnFinish="SaveAsync" FinishText="@L["BookingDialog_Save"]" Busy="busy" FinishTestId="booking-save" NextTestId="booking-next">
    @if (People.Count > 1)
    {
        <DialogStep Title="@L["Picker_StepTitle"]" Leave="@(() => personChoice!.LeaveAsync())">
            <PersonChoice @ref="personChoice" People="People" Question="@L["Picker_BookingQuestion"]" OnChosen="ChoosePersonAsync" />
        </DialogStep>
    }
    <DialogStep Title="@L["BookingDialog_StepWhat"]">
        @* Ausgabe, Einnahme oder Umbuchung. aria-pressed sagt Vorlesegeräten, welcher Knopf gewählt ist. *@
        <div class="booking-kinds" role="group" aria-label="@L["BookingDialog_KindLabel"]">
            @foreach (var kind in BookingKinds.All)
            {
                var selected = draft.Kind == kind;
                <DuofyButton Kind="ButtonKind.Secondary" Text="@L[$"BookingDialog_Kind_{kind}"]" OnClick="@(_ => SetKind(kind))" TestId="@($"booking-kind-{kind}")" aria-pressed="@(selected ? "true" : "false")" />
            }
        </div>

        @* Betrag und Datum. Der Betrag ist immer positiv; ob er abgeht oder hereinkommt, bestimmt die Art. *@
        @* Auf dem Handy öffnet inputmode="decimal" die Zifferntastatur. *@
        <StepField Label="@L["Field_Amount"]" InputId="booking-amount-input" TestId="booking-amount-field">
            <MoneyInput id="booking-amount-input" Value="draft.Amount" ValueChanged="@(v => OnAmountChanged(v))" Min="0" data-testid="booking-amount" />
        </StepField>
        <StepField Label="@L["Field_Date"]" InputId="booking-date-input" TestId="booking-date-field">
            <TextInput id="booking-date-input" Type="date" Value="@dateText" ValueChanged="OnDateChanged" data-testid="booking-date" />
        </StepField>

        @* Der Planmonat: in welchem Monat die Buchung im Plan zählt. Der Kontostand folgt immer dem Datum. *@
        <StepField Label="@L["Field_PlanMonth"]" InputId="booking-plan-month-input" TestId="booking-plan-month-field">
            <NativeSelect Value="@MonthKey(draft.PlanMonth)" ValueChanged="OnPlanMonthChanged" id="booking-plan-month-input"
                          data-testid="booking-plan-month">
                @foreach (var month in PlanMonths())
                {
                    <option value="@MonthKey(month)">@month.ToString("MMMM yyyy", German)</option>
                }
            </NativeSelect>
        </StepField>

        @* Ohne Konto geht es nicht weiter; der Satz ist derselbe wie zuvor beim Speichern. *@
        <StepField Label="@L[draft.Kind == BookingKinds.Transfer ? "Field_FromAccount" : "Field_Account"]" InputId="booking-account-input"
                   Validate="@(() => draft.AccountId is null ? L["BookingDialog_AccountRequired"].Value : null)"
                   TestId="booking-account-field">
            <AccountSelect Value="draft.AccountId" ValueChanged="OnAccountChosen" Accounts="Accounts"
                           Label="@L[draft.Kind == BookingKinds.Transfer ? "Field_FromAccount" : "Field_Account"]" HideLabel="true"
                           EmptyText="@L["BookingDialog_ChooseAccount"]" InputId="booking-account-input"
                           DescribedBy="booking-account-input-error" TestId="booking-account" />
        </StepField>

        @if (draft.Kind == BookingKinds.Transfer)
        {
            @* Bei einer Umbuchung gibt es keine Kategorie und nur eine Zeile (den Quelltopf), dazu ein zweites Konto. *@
            <StepField Label="@L["Field_ToAccount"]" InputId="booking-counter-account-input" TestId="booking-counter-account-field">
                <AccountSelect Value="draft.CounterAccountId" ValueChanged="OnCounterAccountChosen" Accounts="Accounts"
                               Label="@L["Field_ToAccount"]" HideLabel="true" EmptyText="@L["BookingDialog_ChooseAccount"]"
                               InputId="booking-counter-account-input" TestId="booking-counter-account" />
            </StepField>
        }
    </DialogStep>

    <DialogStep Title="@L["BookingDialog_StepWhere"]">
        @if (error is not null)
        {
            <ErrorAlert Text="@error" data-testid="booking-error" />
        }

        @if (draft.Kind == BookingKinds.Transfer)
        {
            @* Quelle und Ziel verschieben den Betrag zwischen den Töpfen (Spec 72, R9; Spec 112): Pflicht, ohne Vorauswahl, aus den drei Töpfen. *@
            <StepField Label="@L["Field_TransferSourcePotRequired"]" InputId="booking-transfer-source-pot-input" TestId="booking-transfer-source-pot-field">
                <NativeSelect Value="@draft.TransferSourcePot" ValueChanged="OnTransferSourcePotChanged" id="booking-transfer-source-pot-input"
                              aria-required="true" data-testid="booking-transfer-source-pot">
                    <option value="">@L["BookingDialog_ChoosePot"]</option>
                    @foreach (var pot in OfferedPots())
                    {
                        <option value="@pot">@L[$"Pot_{pot}"]</option>
                    }
                </NativeSelect>
            </StepField>
            <StepField Label="@L["Field_TransferTargetPotRequired"]" InputId="booking-transfer-target-pot-input" TestId="booking-transfer-target-pot-field">
                <NativeSelect Value="@draft.TransferTargetPot" ValueChanged="OnTransferTargetPotChanged" id="booking-transfer-target-pot-input"
                              aria-required="true" data-testid="booking-transfer-target-pot">
                    <option value="">@L["BookingDialog_ChoosePot"]</option>
                    @foreach (var pot in OfferedPots())
                    {
                        <option value="@pot">@L[$"Pot_{pot}"]</option>
                    }
                </NativeSelect>
            </StepField>
            <StepField Label="@L["Field_Position"]" InputId="booking-transfer-position-input" TestId="booking-transfer-position-field">
                <NativeSelect Value="@Key(draft.TransferPositionId)" ValueChanged="OnTransferPositionChanged" id="booking-transfer-position-input"
                              data-testid="booking-transfer-position">
                    <option value="">@L["BookingDialog_NoPosition"]</option>
                    @foreach (var position in PlanView.OfferedPositions(plan, draft.Kind))
                    {
                        <option value="@position.Id">@PositionText(position)</option>
                    }
                </NativeSelect>
            </StepField>
        }
        else
        {
            @* Die Zeilen. Eine Zeile ist ein Teil des Betrags mit Kategorie und Topf. *@
            @for (var i = 0; i < draft.Lines.Count; i++)
            {
                var index = i;
                var line = draft.Lines[index];
                <div class="booking-line">
                    @if (draft.Lines.Count > 1)
                    {
                        <h3 class="booking-line-title">@L["BookingDialog_Line", index + 1]</h3>
                    }

                    @* Die erste Zeile ist nicht bearbeitbar, solange es mehrere gibt: Sie zeigt, was übrig bleibt. *@
                    <StepField Label="@L["Field_Amount"]" InputId="@($"booking-line-amount-{index}-input")">
                        <MoneyInput id="@($"booking-line-amount-{index}-input")" Value="line.Amount" ValueChanged="@(v => OnLineAmountChanged(index, v))" ReadOnly="@(index == 0)" data-testid="@($"booking-line-amount-{index}")" />
                    </StepField>

                    <StepField Label="@L["Field_Category"]" InputId="@($"booking-line-category-{index}-input")">
                        <NativeSelect Value="@Key(line.CategoryId)" ValueChanged="v => OnCategoryChanged(index, v)"
                                      id="@($"booking-line-category-{index}-input")" data-testid="@($"booking-line-category-{index}")">
                            <option value="">@L["BookingDialog_ChooseCategory"]</option>
                            @foreach (var group in OfferedCategories())
                            {
                                <optgroup label="@L[$"CategoryGroup_{group.Key}"]">
                                    @foreach (var category in group)
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                </optgroup>
                            }
                        </NativeSelect>
                    </StepField>

                    <StepField Label="@L["Field_PotRequired"]" InputId="@($"booking-line-pot-{index}-input")">
                        <NativeSelect Value="@line.Pot" ValueChanged="v => OnPotChanged(index, v)"
                                      id="@($"booking-line-pot-{index}-input")" aria-required="true" data-testid="@($"booking-line-pot-{index}")">
                            @if (draft.Kind != BookingKinds.Income)
                            {
                                <option value="">@L["BookingDialog_ChoosePot"]</option>
                            }
                            @foreach (var pot in OfferedPots())
                            {
                                <option value="@pot">@L[$"Pot_{pot}"]</option>
                            }
                        </NativeSelect>
                    </StepField>

                    @* Der Posten des Planmonats, den diese Zeile füllt; auch ein abgehakter, er ist dann so benannt (Spec 51, R7). *@
                    <StepField Label="@L["Field_Position"]" InputId="@($"booking-line-position-{index}-input")">
                        <NativeSelect Value="@Key(line.PositionId)" ValueChanged="v => OnPositionChanged(index, v)"
                                      id="@($"booking-line-position-{index}-input")" data-testid="@($"booking-line-position-{index}")">
                            <option value="">@L["BookingDialog_NoPosition"]</option>
                            @foreach (var position in PlanView.OfferedPositions(plan, draft.Kind))
                            {
                                <option value="@position.Id">@PositionText(position)</option>
                            }
                        </NativeSelect>
                    </StepField>

                    <div class="booking-line-actions">
                        @* Eigene Kategorien legt nur ihre Person an (Spec 68); für ein anderes Mitglied gibt es den Knopf nicht. *@
                        @if (owner is null)
                        {
                            <DuofyButton Kind="ButtonKind.Ghost" Text="@L["BookingDialog_NewCategory"]" Small="true" OnClick="@(_ => OpenNewCategory(index))" TestId="booking-new-category" />
                        }
                        @if (index > 0)
                        {
                            <DuofyButton Kind="ButtonKind.Ghost" Text="@L["BookingDialog_RemoveLine"]" Small="true" OnClick="@(_ => RemoveLine(index))" TestId="@($"booking-line-remove-{index}")" />
                        }
                    </div>
                </div>
            }

            @* Eine eigene Kategorie anlegen, ohne den Dialog zu verlassen. *@
            @if (newCategoryLine is not null)
            {
                <div class="booking-line">
                    @if (newCategoryError is not null)
                    {
                        <ErrorAlert Text="@newCategoryError" />
                    }
                    <StepField Label="@L["Field_CategoryName"]" InputId="booking-new-category-name-input">
                        <TextInput id="booking-new-category-name-input" maxlength="@(CategoryRules.NameMaxLength)" @bind-Value="newCategoryName" data-testid="booking-new-category-name" />
                    </StepField>
                    <StepField Label="@L["Field_Group"]" InputId="booking-new-category-group-input">
                        <NativeSelect @bind-Value="newCategoryGroup" id="booking-new-category-group-input"
                                      data-testid="booking-new-category-group">
                            @foreach (var group in CategoryGroupKeys.All.Where(g => (g == CategoryGroupKeys.Income) == (draft.Kind == BookingKinds.Income)))
                            {
                                <option value="@group">@L[$"CategoryGroup_{group}"]</option>
                            }
                        </NativeSelect>
                    </StepField>
                    <StepField Label="@L["Field_Pot"]" InputId="booking-new-category-pot-input">
                        <NativeSelect @bind-Value="newCategoryPot" id="booking-new-category-pot-input"
                                      data-testid="booking-new-category-pot">
                            @foreach (var pot in OfferedPots())
                            {
                                <option value="@pot">@L[$"Pot_{pot}"]</option>
                            }
                        </NativeSelect>
                    </StepField>
                    <div class="booking-line-actions">
                        <DuofyButton Text="@L["BookingDialog_NewCategorySave"]" OnClick="@(_ => SaveNewCategoryAsync())" TestId="booking-new-category-save" />
                        <DuofyButton Kind="ButtonKind.Ghost" Text="@L["BookingDialog_Cancel"]" OnClick="@(_ => CloseNewCategory())" />
                    </div>
                </div>
            }

            @* "Aufteilen" hängt eine Zeile an. Ihr Betrag geht von der ersten Zeile ab. *@
            <DuofyButton Kind="ButtonKind.Secondary" Text="@L["BookingDialog_Split"]" OnClick="@(_ => draft.AddLine())" TestId="booking-split" Disabled="@(!draft.CanAddLine)" />
        }

        <StepField Label="@L["Field_Note"]" InputId="booking-note-input" TestId="booking-note-field">
            <TextInput id="booking-note-input" maxlength="@(BookingRules.NoteMaxLength)" @bind-Value="draft.Note" data-testid="booking-note" />
        </StepField>
    </DialogStep>
</StepDialog>

@code {

    private static readonly CultureInfo German = new("de-DE");

    /// <summary>Der Titel im Kopf des Schritt-Dialogs ("Neue Buchung" oder "Buchung ändern").</summary>
    [Parameter]
    public string? Title { get; set; }

    // Das Feld verweist auf seine Beschriftung.
    private static Dictionary<string, object> Labelled(string inputId) => new()
    {
        ["aria-labelledby"] = $"{inputId}-label",
        ["inputmode"] = "decimal",
    };

    /// <summary>Die Buchung, die geändert wird; null beim Anlegen.</summary>
    [Parameter]
    public BookingResponse? Existing { get; set; }

    /// <summary>Alle Konten der Person. Aufgelöste werden nicht zur Wahl angeboten.</summary>
    [Parameter]
    public IReadOnlyList<AccountChoice> Accounts { get; set; } = [];

    /// <summary>Alle Kategorien. Neue eigene Kategorien kommen im Dialog dazu.</summary>
    [Parameter]
    public List<CategoryResponse> Categories { get; set; } = [];

    /// <summary>Das Datum von heute; so ist das Datum beim Anlegen vorbelegt.</summary>
    [Parameter]
    public DateOnly Today { get; set; }

    /// <summary>Beim Anlegen: der Planmonat, in dem die Buchung zählen soll; ohne Angabe der Monat von heute.</summary>
    [Parameter]
    public DateOnly? PlanMonth { get; set; }

    /// <summary>Beim Anlegen: der Posten, zu dem die Buchung gehört; die Art folgt seinem Topf (Spec 51, R7).</summary>
    [Parameter]
    public Guid? PositionId { get; set; }

    /// <summary>
    /// Mehrere Personen zur Wahl (Haushaltsplan, Spec 125, R7): Der erste Schritt fragt, für wen die Buchung ist, und der Titel nennt sie.
    /// Mit höchstens einer Person gibt es den Schritt nicht.
    /// </summary>
    [Parameter]
    public IReadOnlyList<MemberResponse> People { get; set; } = [];

    /// <summary>Holt Konten und Kategorien der gewählten Person; nötig mit mehreren Personen.</summary>
    [Parameter]
    public Func<MemberResponse, Task<PersonChoices>>? ChoicesFor { get; set; }

    private PersonChoice? personChoice;
    private string shownTitle = "";

    private async Task<string?> ChoosePersonAsync(MemberResponse person)
    {
        var choices = await ChoicesFor!(person);
        if (choices.Error is not null)
        {
            return choices.Error;
        }
        (Categories, Accounts) = (choices.Categories, choices.Accounts);
        owner = person.IsMe ? null : person.UserId;
        draft = BookingDraft.ForNew(Today, Accounts.FirstOrDefault(a => a.IsDefault && a.Active)?.Id, PlanMonth);
        shownTitle = L["BookingDialog_TitleNewFor", person.FirstName];
        await LoadPlanAsync();
        StateHasChanged();
        return null;
    }

    private BookingDraft draft = default!;

    // Die Person, für die der Dialog geöffnet wurde; sie bleibt, auch wenn der Umschalter inzwischen woanders steht (Spec 68, A15).
    private Guid? owner;

    // Der Plan des gewählten Planmonats; seine Posten stehen in der Auswahl je Zeile.
    private PlanResponse? plan;
    private string dateText = "";
    private string? error;
    private bool busy;

    // Für die Zeile, zu der gerade eine neue Kategorie angelegt wird.
    private int? newCategoryLine;
    private string newCategoryName = "";
    private string newCategoryGroup = "";
    private string newCategoryPot = PotKeys.Needs;
    private string? newCategoryError;

    protected override void OnInitialized()
    {
        owner = Member.Owner;
        shownTitle = Title ?? "";
        // Beim Anlegen: Ausgabe, heute, Standardkonto (R9). Beim Ändern: die gespeicherten Werte.
        draft = Existing is null
            ? BookingDraft.ForNew(Today, Accounts.FirstOrDefault(a => a.IsDefault && a.Active)?.Id, PlanMonth)
            : BookingDraft.From(Existing);
        dateText = draft.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    protected override async Task OnInitializedAsync()
    {
        if (People.Count > 1)
        {
            // Der Plan kommt, sobald die Person gewählt ist.
            return;
        }
        await LoadPlanAsync();
        if (Existing is null && plan?.Positions.FirstOrDefault(p => p.Id == PositionId) is { } position)
        {
            draft.SetKind(position.Pot == PotKeys.Income ? BookingKinds.Income : BookingKinds.Expense);
            draft.ChoosePosition(0, position);
        }
    }

    private string PositionText(PlanPositionResponse position) =>
        position.DoneAt is null ? position.Label : L["BookingDialog_PositionDone", position.Label];

    // Lädt den Plan des Planmonats. Ohne Plan gibt es keine Posten zur Wahl; buchen geht trotzdem.
    private async Task LoadPlanAsync()
    {
        var month = draft.PlanMonth;
        var result = await PlanApi.GetAsync(month.Year, month.Month, owner);
        plan = result.Succeeded ? result.Value : null;
    }

    private static string MonthKey(DateOnly month) => month.ToString("yyyy-MM", CultureInfo.InvariantCulture);

    // Die drei Monate um das Datum; ein gespeicherter Planmonat außerhalb (über einen Posten) bleibt wählbar.
    private IEnumerable<DateOnly> PlanMonths() =>
        draft.PlanMonthOptions.Contains(draft.PlanMonth) ? draft.PlanMonthOptions : draft.PlanMonthOptions.Append(draft.PlanMonth).Order();

    private async Task OnPlanMonthChanged(string value)
    {
        if (DateOnly.TryParseExact(value + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var month)
            && month != draft.PlanMonth)
        {
            draft.SetPlanMonth(month);
            await LoadPlanAsync();
        }
    }

    private void OnPositionChanged(int index, string value) =>
        draft.ChoosePosition(index, plan?.Positions.FirstOrDefault(p => p.Id == ParseId(value)));

    private void OnTransferPositionChanged(string value) => draft.TransferPositionId = ParseId(value);

    // Leere Auswahl heißt "", sonst die Kennung als Text. So lassen sich Auswahlfelder an Guid? binden.
    private static string Key(Guid? id) => id?.ToString() ?? "";

    private static Guid? ParseId(string? text) => Guid.TryParse(text, out var id) ? id : null;

    private void SetKind(string kind) => draft.SetKind(kind);

    private void OnAmountChanged(decimal? amount) => draft.SetAmount(amount);

    private void OnLineAmountChanged(int index, decimal? amount) => draft.SetLineAmount(index, amount);

    private void OnAccountChosen(Guid? id) => draft.AccountId = id;

    private void OnCounterAccountChosen(Guid? id) => draft.CounterAccountId = id;

    private void OnTransferSourcePotChanged(string pot) => draft.TransferSourcePot = pot;

    private void OnTransferTargetPotChanged(string pot) => draft.TransferTargetPot = pot;

    private void OnPotChanged(int index, string pot) => draft.Lines[index].Pot = pot;

    private async Task OnDateChanged(string value)
    {
        dateText = value;
        if (DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            // Rückt das Datum zu weit, wechselt der Planmonat mit; dann gelten die Posten des neuen Monats.
            var before = draft.PlanMonth;
            draft.Date = date;
            if (draft.PlanMonth != before)
            {
                await LoadPlanAsync();
            }
        }
    }

    // Wer eine Kategorie wählt, bekommt ihren vorgeschlagenen Topf vorgewählt und darf ihn ändern.
    private void OnCategoryChanged(int index, string value)
    {
        var category = Categories.FirstOrDefault(c => c.Id == ParseId(value));
        draft.ChooseCategory(index, category);
    }

    private void RemoveLine(int index) => draft.RemoveLine(index);

    // Einnahmen bieten nur Einnahme-Kategorien an, Ausgaben alle anderen (R3).
    // Die Kategorien kommen von der API schon nach Gruppen geordnet; GroupBy behält die Reihenfolge.
    private IEnumerable<IGrouping<string, CategoryResponse>> OfferedCategories() => Categories
        .Where(c => (c.Group == CategoryGroupKeys.Income) == (draft.Kind == BookingKinds.Income))
        .GroupBy(c => c.Group);

    private IEnumerable<string> OfferedPots() => draft.Kind == BookingKinds.Income
        ? [PotKeys.Income]
        : PotKeys.All.Where(p => p != PotKeys.Income);

    private void OpenNewCategory(int index)
    {
        newCategoryLine = index;
        newCategoryName = "";
        newCategoryPot = OfferedPots().First();
        newCategoryGroup = CategoryGroupKeys.All.First(g => (g == CategoryGroupKeys.Income) == (draft.Kind == BookingKinds.Income));
        newCategoryError = null;
    }

    private void CloseNewCategory() => newCategoryLine = null;

    private async Task SaveNewCategoryAsync()
    {
        var result = await CategoryApi.CreateAsync(new SaveCategoryRequest(newCategoryName, newCategoryGroup, newCategoryPot));
        if (!result.Succeeded)
        {
            newCategoryError = ErrorTexts.For(L, result.ErrorCode);
            return;
        }

        // Die neue Kategorie ist sofort in der Liste und in der Zeile gewählt.
        Categories.Add(result.Value!);
        draft.ChooseCategory(newCategoryLine!.Value, result.Value);
        newCategoryLine = null;
    }

    private async Task SaveAsync()
    {
        error = null;
        if (draft.AccountId is null)
        {
            error = L["BookingDialog_AccountRequired"];
            return;
        }

        busy = true;
        try
        {
            var request = draft.ToRequest();
            // Neu angelegt gehört die Buchung der Person, deren Zahlen gerade offen sind (Spec 68).
            var result = Existing is null
                ? await BookingApi.CreateAsync(request with { OwnerId = owner })
                : await BookingApi.UpdateAsync(Existing.Id, request);

            if (result.Succeeded)
            {
                await CloseAsync(true);
            }
            else
            {
                error = ErrorTexts.For(L, result.ErrorCode);
            }
        }
        finally
        {
            busy = false;
        }
    }
}
