@page "/registrieren"
@using BlazorBlueprint.Components
@layout AuthLayout
@using Duofy.ApiClient
@using Duofy.Schemas
@inject IAuthApi AuthApi
@inject IInstanceApi InstanceApi
@inject AppBrand Brand
@inject NavigationManager Navigation
@inject IJSRuntime Js
@using Microsoft.Extensions.Logging
@inject ILogger<Register> Log
@inject IStringLocalizer<SharedResources> L

@* Die Registrierung. Ablauf: Eingaben prüfen, Konto bei der API anlegen, gleich
   anmelden und zur Startseite gehen, oder mit returnUrl zur Seite, von der die Person kam.

   Neu in diesem Beispiel:
   - @page legt die Adresse der Seite fest.
   - @layout wählt das Layout: Anmelden und Registrieren haben keine App-Leiste.
   - @inject holt einen Dienst (hier die Verbindung zur API) in die Seite.
   - @bind-Value verbindet ein Eingabefeld mit einer Variablen in beide Richtungen.

   Wer sich registrieren darf, entscheidet der Server (Spec 70): Die Seite fragt ihn nach dem Modus und sagt ihn,
   nimmt das Token einer Einladung aus ?einladung= und zeigt das Feld Einrichtungscode, solange der Server noch
   keinen Admin hat. Geht die Registrierung nach dem Modus nicht, ist der Knopf ausgegraut, und der Hinweis sagt
   warum. Antwortet der Server nicht, entscheidet er beim Abschicken selbst.

   Auf der gehosteten Version (Spec 53) gilt das Konto erst mit bestätigter Adresse: Die Anmeldung gleich nach der
   Registrierung antwortet dann email_not_confirmed, und die Seite sagt, dass eine Mail mit dem Link unterwegs ist. *@

<PageTitle>@L["Register_Title"] · @Brand.Name</PageTitle>

<div class="auth-header">
    <h1 class="page-title">@L["Register_Title"]</h1>
    <p class="auth-lead">@L["Register_Lead"]</p>
</div>

@if (error is not null)
{
    <BbAlert Variant="AlertVariant.Danger" Class="mb-4">@error</BbAlert>
}

@if (confirmTo is not null)
{
    <BbAlert Variant="AlertVariant.Success" Class="mb-4" data-testid="register-confirm-notice">@L["Register_ConfirmNotice", confirmTo]</BbAlert>
    <DuofyButton Href="@ReturnAddress.With("/anmelden", ReturnUrl)" TestId="register-to-sign-in" FullWidth="true">@L["Auth_ToSignIn"]</DuofyButton>
}
else
{

@if (ModeNotice is { } notice)
{
    <BbAlert Variant="AlertVariant.Info" Class="mb-4" id="register-mode-notice" data-testid="register-mode-notice">@notice</BbAlert>
}

@* Die Prüfungen stehen unter ihrem Feld und zeigen sich nach dem ersten Abschicken; die Texte kommen über den Fehlercode aus
   der Ressourcendatei. Alles, was geprüft wird, auch die Zustimmung, liegt im Formular. *@
<form novalidate class="stack" @onsubmit="OnSubmitAsync" @onsubmit:preventDefault="true">
    <div class="field-stack">
        <div class="field-pair">
            <div class="field">
                <FieldLabel For="register-first-name-input" Text="@L["Field_FirstName"]" />
                <TextInput id="register-first-name-input" maxlength="@(AccountRules.NameMaxLength)" @bind-Value="firstName" aria-invalid="@Flag(ValidateFirstName(firstName))" aria-describedby="@Describe(null, "register-first-name", ValidateFirstName(firstName))" autocomplete="given-name" data-testid="register-first-name" />
                @if (Flag(ValidateFirstName(firstName)) is not null)
                {
                    <p class="field-error" id="register-first-name-error" role="alert">@ValidateFirstName(firstName)</p>
                }
            </div>
            <div class="field">
                <FieldLabel For="register-last-name-input" Text="@L["Field_LastName"]" />
                <TextInput id="register-last-name-input" maxlength="@(AccountRules.NameMaxLength)" @bind-Value="lastName" aria-invalid="@Flag(ValidateLastName(lastName))" aria-describedby="@Describe(null, "register-last-name", ValidateLastName(lastName))" autocomplete="family-name" data-testid="register-last-name" />
                @if (Flag(ValidateLastName(lastName)) is not null)
                {
                    <p class="field-error" id="register-last-name-error" role="alert">@ValidateLastName(lastName)</p>
                }
            </div>
        </div>
        <div class="field">
            <FieldLabel For="register-email-input" Text="@L["Field_Email"]" />
            <TextInput id="register-email-input" Type="email" placeholder="@L["Auth_EmailPlaceholder"]" @bind-Value="email" aria-invalid="@Flag(ValidateEmail(email))" aria-describedby="@Describe(null, "register-email", ValidateEmail(email))" autocomplete="email" data-testid="register-email" />
            @if (Flag(ValidateEmail(email)) is not null)
                {
                    <p class="field-error" id="register-email-error" role="alert">@ValidateEmail(email)</p>
                }
        </div>
        <div class="field">
            <FieldLabel For="register-password-input" Text="@L["Field_Password"]" />
            <TextInput id="register-password-input" Type="password" @bind-Value="password" autocomplete="new-password" aria-invalid="@Flag(ValidatePassword(password))" aria-describedby="@Describe("register-password-hint", "register-password", ValidatePassword(password))" data-testid="register-password" />
            <p class="small muted" id="register-password-hint">@L["Field_PasswordHint"]</p>
            @if (Flag(ValidatePassword(password)) is not null)
                {
                    <p class="field-error" id="register-password-error" role="alert">@ValidatePassword(password)</p>
                }
        </div>
        @if (instance?.SetupPending == true)
        {
            <div class="field">
                <FieldLabel For="register-setup-code-input" Text="@L["Field_SetupCode"]" />
                <TextInput id="register-setup-code-input" @bind-Value="setupCode" aria-describedby="register-setup-code-hint" autocomplete="off" data-testid="register-setup-code" />
                <p class="small muted" id="register-setup-code-hint">@L["Register_SetupCodeHint"]</p>
            </div>
        }
    </div>

    <div class="stack-sm">
        <div class="check-row">
            <BbCheckbox Id="register-terms" @bind-Checked="acceptedTerms" aria-invalid="@Flag(acceptedTerms ? null : "x")"
                        AriaDescribedBy="@Describe(null, "register-terms", acceptedTerms ? null : "x")" data-testid="register-terms" />
            <FieldLabel For="register-terms" Text="@L["Register_AcceptTerms"]" />
        </div>
        @if (submitted && !acceptedTerms)
        {
            <p class="field-error" id="register-terms-error" role="alert">@ErrorTexts.For(L, ErrorCodes.TermsNotAccepted)</p>
        }
    </div>

    @if (Blocked)
    {
        @* Der Modus lässt diese Registrierung nicht zu. Der Knopf ist ausgegraut und tut nichts, bleibt aber erreichbar:
           aria-disabled statt disabled, damit ein Screenreader ihn findet und den Hinweis oben vorliest. *@
        <DuofyButton Kind="ButtonKind.Secondary" Text="@L["Register_Submit"]" TestId="register-submit" FullWidth="true" Class="mt-4 unavailable" aria-disabled="true" aria-describedby="register-mode-notice" />
    }
    else
    {
        <DuofyButton Text="@(busy ? L["Register_Pending"] : L["Register_Submit"])" TestId="register-submit" FullWidth="true" Class="mt-4" Submit="true" Disabled="busy" />
    }
</form>

<p class="auth-switch">
    @L["Register_HaveAccount"]
    <a href="@ReturnAddress.With("/anmelden", ReturnUrl)">@L["Register_LoginLink"]</a>
</p>
}

@code {
    // Kommt aus der Adresse: /registrieren?returnUrl=/einladung/abc
    [SupplyParameterFromQuery(Name = "returnUrl")]
    [Parameter]
    public string? ReturnUrl { get; set; }

    // Das Token einer Einladung zur Registrierung: /registrieren?einladung=abc (Spec 70, R4).
    [SupplyParameterFromQuery(Name = "einladung")]
    [Parameter]
    public string? Invitation { get; set; }

    // Was der Server anbietet; null, solange er nicht geantwortet hat oder nicht erreichbar ist.
    private InstanceResponse? instance;
    private string setupCode = "";

    private string firstName = "";
    private string lastName = "";
    private string email = "";
    private string password = "";
    private bool acceptedTerms;

    // Erst nach dem ersten Abschicken zeigen die Felder, dass sie falsch sind (aria-invalid und der Verweis auf den Fehlertext).
    private bool submitted;
    private bool busy;
    private string? error;

    // Die Adresse, an die die Mail zum Bestätigen ging; gesetzt, sobald das Konto auf Bestätigung wartet.
    private string? confirmTo;

    private bool HasInvitation => !string.IsNullOrWhiteSpace(Invitation);

    private bool HasSetupCode => instance?.SetupPending == true && !string.IsNullOrWhiteSpace(setupCode);

    // Der Hinweis zum Modus; ohne Einladung im Modus invite und immer im Modus closed.
    private string? ModeNotice => instance?.RegistrationMode switch
    {
        RegistrationModes.Invite when !HasInvitation => L["Register_InviteOnly"],
        RegistrationModes.Closed => L["Register_Closed"],
        _ => null,
    };

    // Nur der Einrichtungscode kommt am Modus vorbei, solange der Server keinen Admin hat.
    private bool Blocked => ModeNotice is not null && !HasSetupCode;

    protected override async Task OnInitializedAsync()
    {
        var result = await InstanceApi.GetAsync();
        instance = result.Succeeded ? result.Value : null;
    }

    // Jede Prüfung liefert null, wenn alles passt, sonst den Text, der unter dem Feld steht.
    // Die Texte kommen über den Fehlercode aus der Ressourcendatei (siehe ErrorTexts). 
    private string? ValidateFirstName(string value) =>
        string.IsNullOrWhiteSpace(value) ? ErrorTexts.For(L, ErrorCodes.FirstNameRequired) : null;

    private string? ValidateLastName(string value) =>
        string.IsNullOrWhiteSpace(value) ? ErrorTexts.For(L, ErrorCodes.LastNameRequired) : null;

    private string? ValidateEmail(string value) =>
        value.Contains('@') && value.Contains('.') ? null : ErrorTexts.For(L, ErrorCodes.EmailInvalid);

    private string? ValidatePassword(string value) =>
        value.Length >= AccountRules.PasswordMinLength ? null : ErrorTexts.For(L, ErrorCodes.PasswordTooShort);

    private string? Flag(string? problem) => submitted && problem is not null ? "true" : null;

    // Verweist auf den Hinweis unter dem Feld und, solange das Feld falsch ist, auch auf seinen Fehlertext.
    private string? Describe(string? hintId, string fieldId, string? problem)
    {
        var ids = new List<string>();
        if (hintId is not null) ids.Add(hintId);
        if (submitted && problem is not null) ids.Add($"{fieldId}-error");
        return ids.Count == 0 ? null : string.Join(' ', ids);
    }

    private bool AllValid => ValidateFirstName(firstName) is null && ValidateLastName(lastName) is null
        && ValidateEmail(email) is null && ValidatePassword(password) is null && acceptedTerms;

    // Abschicken: Mit Fehlern springt der Fokus auf das erste falsche Feld, in der Reihenfolge der Seite.
    private async Task OnSubmitAsync()
    {
        submitted = true;
        if (AllValid)
        {
            await SubmitAsync();
            return;
        }
        var first = ValidateFirstName(firstName) is not null ? "register-first-name-input"
            : ValidateLastName(lastName) is not null ? "register-last-name-input"
            : ValidateEmail(email) is not null ? "register-email-input"
            : ValidatePassword(password) is not null ? "register-password-input"
            : "register-terms";
        try
        {
            await using var module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Duofy.Shared/focus-notice.js");
            await module.InvokeVoidAsync("focusById", first);
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or InvalidOperationException)
        {
            Log.LogWarning(exception, "Der Fokus ließ sich nicht auf das erste falsche Feld setzen.");
        }
    }

    private async Task SubmitAsync()
    {
        if (Blocked) return;
        error = null;

        busy = true;
        try
        {
            var registered = await AuthApi.RegisterAsync(new RegisterRequest(
                firstName.Trim(), lastName.Trim(), email.Trim(), password, acceptedTerms,
                HasSetupCode ? setupCode.Trim() : null,
                HasInvitation ? Invitation!.Trim() : null));
            if (!registered.Succeeded)
            {
                error = ErrorTexts.For(L, registered.ErrorCode);
                return;
            }

            // Die API meldet nach dem Registrieren nicht selbst an; das tun wir gleich hinterher.
            var signedIn = await AuthApi.LoginAsync(new LoginRequest(email.Trim(), password));
            if (signedIn.ErrorCode == ErrorCodes.EmailNotConfirmed)
            {
                confirmTo = email.Trim();
                return;
            }
            // Mit returnUrl geht es danach dorthin zurück, zum Beispiel zur Einladung, von der die Person kam.
            var target = ReturnAddress.IsLocalPath(ReturnUrl) ? ReturnUrl! : "/";
            Navigation.NavigateTo(signedIn.Succeeded ? target : ReturnAddress.With("/anmelden", ReturnUrl));
        }
        finally
        {
            busy = false;
        }
    }
}
