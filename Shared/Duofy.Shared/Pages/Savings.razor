@page "/sparen"
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@implements IDisposable
@inject ISavingsGoalApi GoalApi
@inject IDebtApi DebtApi
@inject ICategoryApi CategoryApi
@inject IAccountChoices AccountChoices
@inject FormDialogs Forms
@inject IAppHost Host
@inject AppChrome Chrome
@inject ActiveMember Member
@inject TimeProvider Time
@inject IStringLocalizer<SharedResources> L

@* Die Seite Sparen (Issue 29 und 30): ein Ort für Sparziele, Schulden und Kredite. Die Sparziele stehen mit ihrem Stand
   da; den Stand rechnet die API aus den zugeordneten Buchungen, die Seite rechnet nichts selbst. Schulden und Kredite
   zeigen vorerst ihren Leerzustand. Wessen Zahlen die Seite zeigt, bestimmt der Umschalter; ohne die Freigabe "savings"
   (Ansehen) sagt die Seite, dass die Person den Bereich nicht teilt. *@

<PageTitle>@L["Savings_Title"]</PageTitle>

@* In der App steht der Titel in der oberen Leiste und das Plus im Layout (AppChrome). *@
<AppPageHeading Text="@L["Savings_Title"]" />
@if (!Host.IsApp)
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mb-2">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">@L["Savings_Title"]</RadzenText>
        @if (Sees)
        {
            <RadzenButton Text="@L["Savings_AddGoal"]" Icon="add" ButtonStyle="ButtonStyle.Primary"
                          Click="@(_ => AddGoalAsync())" Class="@GrantLock.Class(CanAdd)" @attributes="GrantLock.Attributes(CanAdd)"
                          data-testid="savings-goal-add" />
        }
    </RadzenStack>
}

<Notice Message="message" />

@if (!Sees)
{
    <NotShared />
}
else
{
    <GrantReason Show="@(!(CanAdd && CanEdit && CanDelete))" />

    <RadzenStack Gap="1rem">
        <RadzenCard Variant="Variant.Outlined" data-testid="savings-section-goals">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-mb-1">@L["Savings_Section_goals"]</RadzenText>
            @if (loaded && goals.Count == 0)
            {
                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-text-secondary-color rz-m-0" data-testid="savings-empty-goals">@L["Savings_Empty_goals"]</RadzenText>
            }
            <RadzenStack Gap="0.5rem">
                @foreach (var goal in goals)
                {
                    <RadzenCard Variant="Variant.Outlined" data-testid="@($"savings-goal-{goal.Id}")">
                        <RadzenStack Gap="0.25rem">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-m-0 fill" data-testid="@($"savings-goal-name-{goal.Id}")">@goal.Name</RadzenText>
                                <RadzenButton Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@(_ => EditGoalAsync(goal))"
                                              Class="@GrantLock.Class(CanEdit)" @attributes="GrantLock.Attributes(CanEdit)"
                                              aria-label="@L["Savings_EditGoal", goal.Name]" data-testid="@($"savings-goal-edit-{goal.Id}")" />
                                <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@(_ => DeleteGoalAsync(goal))"
                                              Class="@GrantLock.Class(CanDelete)" @attributes="GrantLock.Attributes(CanDelete)"
                                              aria-label="@L["Savings_DeleteGoal", goal.Name]" data-testid="@($"savings-goal-delete-{goal.Id}")" />
                            </RadzenStack>

                            <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" Class="rz-m-0" data-testid="@($"savings-goal-balance-{goal.Id}")">@BalanceText(goal)</RadzenText>
                            @if (goal.TargetAmount is { } target)
                            {
                                <RadzenProgressBar Value="@ProgressOf(goal)" Max="100" ShowValue="false"
                                                   aria-hidden="true" data-testid="@($"savings-goal-progress-{goal.Id}")" />
                            }
                            @if (goal.Reached)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-m-0" data-testid="@($"savings-goal-reached-{goal.Id}")">@L["Savings_Reached"]</RadzenText>
                            }
                            @if (goal.TargetDate is { } due)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color rz-m-0">@L["Savings_TargetDate", due.ToString("dd.MM.yyyy", German)]</RadzenText>
                            }
                            @if (AccountName(goal) is { } accountName)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color rz-m-0" data-testid="@($"savings-goal-account-{goal.Id}")">@L["Savings_OnAccount", accountName]</RadzenText>
                            }

                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                <RadzenButton Text="@L["Savings_Deposit"]" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(_ => MoveAsync(goal, SavingsMoveKind.Deposit))"
                                              Class="@GrantLock.Class(CanMove)" @attributes="GrantLock.Attributes(CanMove)"
                                              aria-label="@L["Savings_DepositTo", goal.Name]" data-testid="@($"savings-goal-deposit-{goal.Id}")" />
                                <RadzenButton Text="@L["Savings_Withdraw"]" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(_ => MoveAsync(goal, SavingsMoveKind.Withdrawal))"
                                              Class="@GrantLock.Class(CanMove)" @attributes="GrantLock.Attributes(CanMove)"
                                              aria-label="@L["Savings_WithdrawFrom", goal.Name]" data-testid="@($"savings-goal-withdraw-{goal.Id}")" />
                            </RadzenStack>
                        </RadzenStack>
                    </RadzenCard>
                }
            </RadzenStack>
        </RadzenCard>

        @foreach (var (section, kind) in DebtSections)
        {
            <RadzenCard Variant="Variant.Outlined" data-testid="@($"savings-section-{section}")">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Class="rz-mb-1">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-m-0">@L[$"Savings_Section_{section}"]</RadzenText>
                    <RadzenButton Text="@L[$"Savings_Add_{section}"]" Icon="add" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(_ => AddDebtAsync(kind))"
                                  Class="@GrantLock.Class(CanAdd)" @attributes="GrantLock.Attributes(CanAdd)"
                                  data-testid="@($"debt-add-{kind}")" />
                </RadzenStack>
                @if (loaded && DebtsOf(kind).Count == 0)
                {
                    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-text-secondary-color rz-m-0" data-testid="@($"savings-empty-{section}")">@L[$"Savings_Empty_{section}"]</RadzenText>
                }
                <RadzenStack Gap="0.5rem">
                    @foreach (var debt in DebtsOf(kind))
                    {
                        <RadzenCard Variant="Variant.Outlined" data-testid="@($"debt-{debt.Id}")">
                            <RadzenStack Gap="0.25rem">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenStack Gap="0" Class="fill">
                                        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-m-0" data-testid="@($"debt-name-{debt.Id}")">@debt.Name</RadzenText>
                                        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color rz-m-0" data-testid="@($"debt-creditor-{debt.Id}")">@L["Savings_DebtTo", debt.Creditor]</RadzenText>
                                    </RadzenStack>
                                    <RadzenButton Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@(_ => EditDebtAsync(debt))"
                                                  Class="@GrantLock.Class(CanEdit)" @attributes="GrantLock.Attributes(CanEdit)"
                                                  aria-label="@L["Savings_EditDebt", debt.Name]" data-testid="@($"debt-edit-{debt.Id}")" />
                                    <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click="@(_ => DeleteDebtAsync(debt))"
                                                  Class="@GrantLock.Class(CanDelete)" @attributes="GrantLock.Attributes(CanDelete)"
                                                  aria-label="@L["Savings_DeleteDebt", debt.Name]" data-testid="@($"debt-delete-{debt.Id}")" />
                                </RadzenStack>

                                <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.P" Class="rz-m-0" data-testid="@($"debt-open-{debt.Id}")">@L["Savings_DebtOpen", Money(debt.Open), Money(debt.OriginalAmount)]</RadzenText>
                                <RadzenProgressBar Value="@DebtProgress(debt)" Max="100" ShowValue="false"
                                                   aria-hidden="true" data-testid="@($"debt-progress-{debt.Id}")" />
                                @if (debt.Settled)
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-m-0" data-testid="@($"debt-settled-{debt.Id}")">@L["Savings_DebtSettled"]</RadzenText>
                                }
                                @if (debt.DueDate is { } due)
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color rz-m-0">@L["Savings_DebtDue", due.ToString("dd.MM.yyyy", German)]</RadzenText>
                                }
                                @if (debt.Note is { } note)
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color rz-m-0">@note</RadzenText>
                                }
                                @if (!debt.Settled)
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenButton Text="@L["Savings_DebtPay"]" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(_ => PayAsync(debt))"
                                                  Class="@GrantLock.Class(CanMove)" @attributes="GrantLock.Attributes(CanMove)"
                                                  aria-label="@L["Savings_DebtPayFor", debt.Name]" data-testid="@($"debt-pay-{debt.Id}")" />
                                </RadzenStack>
                                }
                            </RadzenStack>
                        </RadzenCard>
                    }
                </RadzenStack>
            </RadzenCard>
        }

        @* Ein ruhiger Hinweis auf echte Hilfe, ohne Rechtsaussage. *@
        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" Class="rz-text-secondary-color rz-m-0" data-testid="savings-help">@L["Savings_Help"]</RadzenText>
    </RadzenStack>
}

@code {

    // Deutsche Schreibweise für Beträge (1.234,50) und Daten (01.11.2026), auch wenn das Gerät anders eingestellt ist.
    private static readonly CultureInfo German = new("de-DE");

    private List<SavingsGoalResponse> goals = [];
    private List<DebtResponse> debts = [];
    private Guid? debtCategoryId;

    // Die Abschnitte für Schulden und Kredite: Name des Abschnitts und Art der Einträge darin.
    private static readonly (string Section, string Kind)[] DebtSections = [("debts", DebtKinds.Claim), ("loans", DebtKinds.Loan)];

    private List<DebtResponse> DebtsOf(string kind) => debts.Where(d => d.Kind == kind).ToList();

    // Der Fortschritt in Prozent für den Balken: wie viel vom Ursprungsbetrag schon bezahlt ist.
    private static double DebtProgress(DebtResponse debt) =>
        debt.OriginalAmount > 0m ? (double)Math.Clamp(debt.Paid / debt.OriginalAmount * 100m, 0m, 100m) : 0d;
    private IReadOnlyList<AccountChoice> accounts = [];
    private bool loaded;
    private NoticeMessage? message;

    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

    // Was die Freigabe des gewählten Mitglieds erlaubt (Spec 68); bei "Ich" alles.
    private bool Sees => Member.Allows(GrantAreas.Savings, AccessLevelKeys.View);
    private bool CanAdd => Member.Allows(GrantAreas.Savings, AccessLevelKeys.Create);
    private bool CanEdit => Member.Allows(GrantAreas.Savings, AccessLevelKeys.Edit);
    private bool CanDelete => Member.Allows(GrantAreas.Savings, AccessLevelKeys.Delete);

    // Einzahlen und Entnehmen legt eine Buchung an; es braucht Anlegen im Bereich Sparen und in den Buchungen.
    private bool CanMove => CanAdd && Member.Allows(GrantAreas.Book, AccessLevelKeys.Create);

    protected override async Task OnInitializedAsync()
    {
        Chrome.Set(this, L["Savings_Title"], AddGoalAsync, L["Savings_AddGoal"]);
        // Erst nach dem ersten Laden zuhören: Das Laden selbst meldet sich auch als Änderung.
        await Member.LoadAsync();
        Member.Changed += OnMemberChanged;
        await LoadAsync();
    }

    public void Dispose()
    {
        Member.Changed -= OnMemberChanged;
        Chrome.Release(this);
    }

    private void OnMemberChanged() => _ = InvokeAsync(async () =>
    {
        message = null;
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        Chrome.LockPlus(this, Sees && !CanAdd ? GrantLock.ReasonId : null);
        goals = [];
        debts = [];
        loaded = false;
        if (!Sees)
        {
            return;
        }

        var result = await GoalApi.ListAsync(owner: Member.Owner);
        if (result.Succeeded)
        {
            goals = result.Value!.ToList();
        }
        else
        {
            message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        }

        var debtResult = await DebtApi.ListAsync(owner: Member.Owner);
        if (debtResult.Succeeded)
        {
            debts = debtResult.Value!.ToList();
        }
        else
        {
            message = new NoticeMessage(ErrorTexts.For(L, debtResult.ErrorCode), NoticeSeverity.Error);
        }

        // Die Konten nur für die Namen und die Dialoge; ohne sie fehlt der Kontoname, sonst nichts.
        var choices = await AccountChoices.ListAsync(Member.Owner);
        accounts = choices.Succeeded ? choices.Value! : [];
        loaded = true;
    }

    private static string Money(decimal amount) => amount.ToString("N2", German) + " €";

    private string BalanceText(SavingsGoalResponse goal) => goal.TargetAmount is { } target
        ? L["Savings_BalanceOf", Money(goal.Balance), Money(target)]
        : L["Savings_Balance", Money(goal.Balance)];

    // Der Fortschritt in Prozent für den Balken: nicht unter 0 und nicht über 100.
    private static double ProgressOf(SavingsGoalResponse goal) =>
        goal.TargetAmount is { } target and > 0m ? (double)Math.Clamp(goal.Balance / target * 100m, 0m, 100m) : 0d;

    private string? AccountName(SavingsGoalResponse goal) =>
        goal.AccountId is { } id ? accounts.FirstOrDefault(a => a.Id == id)?.Name : null;

    private async Task AddGoalAsync()
    {
        if (CanAdd)
        {
            await ShowGoalDialogAsync(existing: null, L["SavingsGoalDialog_TitleNew"]);
        }
    }

    private async Task EditGoalAsync(SavingsGoalResponse goal)
    {
        if (CanEdit)
        {
            await ShowGoalDialogAsync(goal, L["SavingsGoalDialog_TitleEdit"]);
        }
    }

    private async Task ShowGoalDialogAsync(SavingsGoalResponse? existing, string title)
    {
        var parameters = new FormParameters<SavingsGoalDialog>()
            .Add(x => x.Title, title)
            .Add(x => x.Existing, existing)
            .Add(x => x.Accounts, accounts);
        var outcome = await Forms.OpenAsync<SavingsGoalDialog, bool>(title, parameters);
        if (outcome.Saved)
        {
            message = new NoticeMessage(L["Savings_GoalSaved"], NoticeSeverity.Success);
            await LoadAsync();
        }
    }

    private async Task MoveAsync(SavingsGoalResponse goal, SavingsMoveKind kind)
    {
        if (!CanMove)
        {
            return;
        }
        string title = L[kind == SavingsMoveKind.Deposit ? "SavingsMove_TitleDeposit" : "SavingsMove_TitleWithdrawal", goal.Name];
        var parameters = new FormParameters<SavingsMoveDialog>()
            .Add(x => x.Title, title)
            .Add(x => x.Draft, SavingsMoveDraft.ForNew(kind, goal.Id, goal.Name, goal.AccountId, Today))
            .Add(x => x.Accounts, accounts);
        var outcome = await Forms.OpenAsync<SavingsMoveDialog, bool>(title, parameters);
        if (outcome.Saved)
        {
            message = new NoticeMessage(L["Savings_MoveSaved"], NoticeSeverity.Success);
            await LoadAsync();
        }
    }

    private async Task AddDebtAsync(string kind)
    {
        if (CanAdd)
        {
            await ShowDebtDialogAsync(existing: null, kind, L[kind == DebtKinds.Loan ? "DebtDialog_TitleNewLoan" : "DebtDialog_TitleNewClaim"]);
        }
    }

    private async Task EditDebtAsync(DebtResponse debt)
    {
        if (CanEdit)
        {
            await ShowDebtDialogAsync(debt, debt.Kind, L["DebtDialog_TitleEdit"]);
        }
    }

    private async Task ShowDebtDialogAsync(DebtResponse? existing, string kind, string title)
    {
        var parameters = new FormParameters<DebtDialog>()
            .Add(x => x.Title, title)
            .Add(x => x.Existing, existing)
            .Add(x => x.Kind, kind);
        var outcome = await Forms.OpenAsync<DebtDialog, bool>(title, parameters);
        if (outcome.Saved)
        {
            message = new NoticeMessage(L["Savings_DebtSaved"], NoticeSeverity.Success);
            await LoadAsync();
        }
    }

    // Eine Zahlung ist eine Ausgabe in der eingebauten Kategorie "Schulden".
    private async Task PayAsync(DebtResponse debt)
    {
        if (!CanMove)
        {
            return;
        }
        if (debtCategoryId is null)
        {
            var categories = await CategoryApi.ListAsync(Member.Owner);
            debtCategoryId = categories.Succeeded ? categories.Value!.FirstOrDefault(c => c.Key == "finance.debt")?.Id : null;
        }
        if (debtCategoryId is not { } categoryId)
        {
            message = new NoticeMessage(ErrorTexts.For(L, ErrorCodes.CategoryNotFound), NoticeSeverity.Error);
            return;
        }
        string title = L["DebtPayment_Title", debt.Name];
        var parameters = new FormParameters<DebtPaymentDialog>()
            .Add(x => x.Title, title)
            .Add(x => x.Draft, DebtPaymentDraft.ForNew(debt.Id, debt.Name, categoryId, accounts.FirstOrDefault(a => a.IsDefault && a.Active)?.Id, Today))
            .Add(x => x.Accounts, accounts);
        var outcome = await Forms.OpenAsync<DebtPaymentDialog, bool>(title, parameters);
        if (outcome.Saved)
        {
            message = new NoticeMessage(L["Savings_PaymentSaved"], NoticeSeverity.Success);
            await LoadAsync();
        }
    }

    private async Task DeleteDebtAsync(DebtResponse debt)
    {
        if (!CanDelete)
        {
            return;
        }
        var result = await DebtApi.DeleteAsync(debt.Id);
        message = result.Succeeded
            ? new NoticeMessage(L["Savings_DebtDeleted"], NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await LoadAsync();
    }

    private async Task DeleteGoalAsync(SavingsGoalResponse goal)
    {
        if (!CanDelete)
        {
            return;
        }
        var result = await GoalApi.DeleteAsync(goal.Id);
        message = result.Succeeded
            ? new NoticeMessage(L["Savings_GoalDeleted"], NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await LoadAsync();
    }
}
