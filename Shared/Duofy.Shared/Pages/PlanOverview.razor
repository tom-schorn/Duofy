@page "/plan"
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@implements IDisposable
@inject IPlanApi PlanApi
@inject IHouseholdApi HouseholdApi
@inject IAppHost Host
@inject AppChrome Chrome
@inject ActiveMember Member
@inject TimeProvider Time
@inject IStringLocalizer<SharedResources> L

@* Die Plan-Übersicht (Spec 23): Wer auf Plan tippt, sieht zuerst die Monate, nicht gleich den laufenden. Die Liste hat
   alle Monate mit Plan, den laufenden und die drei kommenden, den neuesten oben. Der laufende ist hervorgehoben und
   beschriftet; jede Zeile zeigt den Frei-Betrag, mit einem enthaltenen Übertrag als solchen benannt (Spec 66, R9), oder
   "noch nicht angelegt" und führt zu /plan/{Jahr}/{Monat}.

   Die Seite rechnet nichts: Den Frei-Betrag schickt die API (PlanFigures.Free). Eine Zeile ist ein gewöhnlicher Link,
   darum geht sie mit Tastatur, Vorlese-Programm und als Adresse zum Merken. Ein Monat ohne Plan wird erst beim Öffnen
   angelegt, nicht beim Anschauen der Liste. Mit dem Umschalter zeigt die Seite die Monate eines anderen Mitglieds
   (Spec 68) oder des Haushalts (Spec 69). *@

<PageTitle>@L["Nav_Plan"]</PageTitle>

<AppPageHeading Text="@L["Nav_Plan"]" />
@if (!Host.IsApp)
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-mb-2">@L["Nav_Plan"]</RadzenText>
}

@if (Member.IsHousehold)
{
    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-mb-2" data-testid="household-name">@Member.Household?.Name</RadzenText>
}

<Notice Message="message" />

@if (!SeesPlan)
{
    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-text-secondary-color" data-testid="not-shared">@L["Grant_NotShared"]</RadzenText>
}
else if (rows is not null)
{
    <ul class="plan-months page-wide" aria-label="@L["PlanOverview_Months"]" data-testid="plan-months">
        @foreach (var row in rows)
        {
            <li>
                <a href="@row.Href" class="@RowClass(row)" aria-current="@(row.IsCurrent ? "date" : null)"
                   data-testid="@($"plan-month-row-{row.Key}")">
                    <span class="plan-month-name">
                        @MonthTitle(row)
                        @if (row.IsCurrent)
                        {
                            <span class="plan-month-badge">@L["PlanOverview_Current"]</span>
                        }
                    </span>
                    @if (row.Free is { } free)
                    {
                        <span class="plan-month-free">
                            <RadzenIcon Icon="payments" aria-hidden="true" />
                            @L[row.WithCarryOver ? "PlanOverview_FreeWithCarryOver" : "PlanOverview_Free", MoneyText.Format(free)]
                        </span>
                    }
                    else
                    {
                        <span class="plan-month-free plan-month-free--none">@L["PlanOverview_NotCreated"]</span>
                    }
                </a>
            </li>
        }
    </ul>
}

@code {

    private static readonly CultureInfo German = new("de-DE");

    private IReadOnlyList<PlanOverviewRow>? rows;
    private NoticeMessage? message;

    // Beim Haushalt gibt es keine Freigabe zu prüfen: Er zeigt die Monate aller gezählten Mitglieder (Spec 69).
    private bool SeesPlan => Member.IsHousehold || Member.Allows(GrantAreas.Plan, AccessLevelKeys.View);

    protected override async Task OnInitializedAsync()
    {
        Chrome.Set(this, L["Nav_Plan"]);
        // Erst nach dem ersten Laden zuhören: Das Laden selbst meldet sich auch als Änderung.
        await Member.LoadAsync();
        Member.Changed += OnMemberChanged;
        await LoadAsync();
    }

    public void Dispose()
    {
        Member.Changed -= OnMemberChanged;
        Chrome.Release(this);
    }

    // Ein anderes Mitglied oder der Haushalt gewählt: die Monate der neuen Sicht holen.
    private void OnMemberChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        message = null;
        rows = null;
        if (!SeesPlan)
        {
            return;
        }

        var known = new List<(int Year, int Month, decimal Free, bool WithCarryOver)>();
        string? errorCode = null;
        if (Member.IsHousehold)
        {
            if (Member.Household is { } household)
            {
                var result = await HouseholdApi.ListPlansAsync(household.Id);
                errorCode = result.ErrorCode;
                known.AddRange(result.Succeeded ? result.Value!.Select(m => (m.Year, m.Month, m.Free, m.CarryOver is not null)) : []);
            }
        }
        else
        {
            var result = await PlanApi.ListMonthsAsync(Member.Owner);
            errorCode = result.ErrorCode;
            known.AddRange(result.Succeeded ? result.Value!.Select(m => (m.Year, m.Month, m.Free, m.CarryOver is not null)) : []);
        }

        if (errorCode is not null)
        {
            message = new NoticeMessage(ErrorTexts.For(L, errorCode), NoticeSeverity.Error);
        }

        // Auch ohne Liste bleiben der laufende und die kommenden Monate wählbar.
        rows = PlanOverviewRows.Build(known, DateOnly.FromDateTime(Time.GetLocalNow().DateTime));
    }

    private string MonthTitle(PlanOverviewRow row) => new DateOnly(row.Year, row.Month, 1).ToString("MMMM yyyy", German);

    private static string RowClass(PlanOverviewRow row) => row.IsCurrent ? "plan-month plan-month--current" : "plan-month";
}
