@page "/plan"
@using BlazorBlueprint.Icons.Lucide.Components
@attribute [Authorize]
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@implements IDisposable
@inject IPlanApi PlanApi
@inject IHouseholdApi HouseholdApi
@inject AppChrome Chrome
@inject ActiveMember Member
@inject TimeProvider Time
@inject IStringLocalizer<SharedResources> L

@* Die Plan-Übersicht (Spec 23, Spec 82) wie im alten Duofy: Monatskarten mit Verplanbar, Anstehend und drei Topf-Balken. Die Liste
   hat alle Monate mit Plan, den laufenden und die drei kommenden, den neuesten oben. Eine Karte ist ein gewöhnlicher Link, darum
   geht sie mit Tastatur, Vorlese-Programm und als Adresse zum Merken. Ein Monat ohne Plan wird erst beim Öffnen angelegt, nicht
   beim Anschauen der Liste; deshalb fragt die Seite nur Monate mit Plan ab.

   Die Seite rechnet nichts: Verplanbar schickt die API, der Rest steht in MonthCards. Die Karten stehen sofort da und füllen sich,
   sobald ihr Monat geladen ist. Mit dem Umschalter zeigt die Seite die Monate eines anderen Mitglieds (Spec 68) oder des Haushalts
   (Spec 69). *@

<PageTitle>@L["PlanOverview_Title"]</PageTitle>

<PageHead Title="@L["PlanOverview_Title"]" Lead="@L["PlanOverview_Lead"]" />

@if (Member.IsHousehold)
{
    <h2 class="section-title notice" data-testid="household-name">@Member.Household?.Name</h2>
}

<Notice Message="message" />

@if (!SeesPlan)
{
    <p class="muted" data-testid="not-shared">@L["Grant_NotShared"]</p>
}
else if (rows is not null)
{
    <MonthCardList Rows="rows" Cards="cards" />
}

@code {

    private static readonly CultureInfo German = new("de-DE");

    private IReadOnlyList<PlanOverviewRow>? rows;
    private readonly Dictionary<string, MonthCard> cards = [];
    private NoticeMessage? message;

    // Zählt die Ladevorgänge: Wechselt die Sicht, während Karten laden, bleibt das Ergebnis der alten Sicht liegen.
    private int loading;
    private bool disposed;

    // Beim Haushalt gibt es keine Freigabe zu prüfen: Er zeigt die Monate aller gezählten Mitglieder (Spec 69).
    private bool SeesPlan => Member.IsHousehold || Member.Allows(GrantAreas.Plan, AccessLevelKeys.View);

    protected override async Task OnInitializedAsync()
    {
        Chrome.Set(this, L["Nav_MyPlan"]);
        // Erst nach dem ersten Laden zuhören: Das Laden selbst meldet sich auch als Änderung.
        await Member.LoadAsync();
        Member.Changed += OnMemberChanged;
        await LoadAsync();
    }

    public void Dispose()
    {
        disposed = true;
        Member.Changed -= OnMemberChanged;
        Chrome.Release(this);
    }

    // Ein anderes Mitglied oder der Haushalt gewählt: die Monate der neuen Sicht holen.
    private void OnMemberChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        var run = ++loading;
        message = null;
        rows = null;
        cards.Clear();
        if (!SeesPlan)
        {
            return;
        }

        var known = new List<(int Year, int Month, decimal Free, bool WithCarryOver)>();
        string? errorCode = null;
        if (Member.IsHousehold)
        {
            if (Member.Household is { } household)
            {
                var result = await HouseholdApi.ListPlansAsync(household.Id);
                errorCode = result.ErrorCode;
                known.AddRange(result.Succeeded ? result.Value!.Select(m => (m.Year, m.Month, m.Free, m.CarryOver is not null)) : []);
            }
        }
        else
        {
            var result = await PlanApi.ListMonthsAsync(Member.Owner);
            errorCode = result.ErrorCode;
            known.AddRange(result.Succeeded ? result.Value!.Select(m => (m.Year, m.Month, m.Free, m.CarryOver is not null)) : []);
        }

        if (errorCode is not null)
        {
            message = new NoticeMessage(ErrorTexts.For(L, errorCode), NoticeSeverity.Error);
        }

        // Auch ohne Liste bleiben der laufende und die kommenden Monate wählbar.
        rows = PlanOverviewRows.Build(known, DateOnly.FromDateTime(Time.GetLocalNow().DateTime));

        // Die Karten füllen sich von oben nach unten, die Seite ist schon vorher benutzbar.
        _ = InvokeAsync(() => FillCardsAsync(run, rows.Where(r => r.Free is not null).ToList()));
    }

    private async Task FillCardsAsync(int run, IReadOnlyList<PlanOverviewRow> withPlan)
    {
        foreach (var row in withPlan)
        {
            var card = await LoadCardAsync(row);
            if (disposed || run != loading)
            {
                return;
            }
            if (card is not null)
            {
                cards[row.Key] = card;
                StateHasChanged();
            }
        }
    }

    // Eine Karte, die nicht lädt, bleibt bei Verplanbar aus der Liste; der Grund steht im Monat selbst, wenn man ihn öffnet.
    private async Task<MonthCard?> LoadCardAsync(PlanOverviewRow row)
    {
        if (Member.IsHousehold)
        {
            if (Member.Household is not { } household)
            {
                return null;
            }
            var plan = await HouseholdApi.GetPlanAsync(household.Id, row.Year, row.Month);
            return plan.Succeeded ? MonthCards.ForHousehold(plan.Value!) : null;
        }
        var own = await PlanApi.GetAsync(row.Year, row.Month, Member.Owner);
        return own.Succeeded ? MonthCards.ForPerson(own.Value!) : null;
    }

}
