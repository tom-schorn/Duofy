@using BlazorBlueprint.Icons.Lucide.Components
@using Duofy.Schemas
@using Duofy.Shared.Services
@inject IStringLocalizer<SharedResources> L

@* Die Wahl der Zahlungsart im Vertragsdialog (Schritt 3, Spec 17, Issue 15): Symbol über dem Text, je Zahlungsart ein
   Knopf. Wie bei der Kontoauswahl ist es eine Gruppe von Optionsfeldern: Tastatur (Pfeiltasten, Tab) und Vorlese-Programme
   ("Dauerauftrag, Optionsfeld, 2 von 5") kommen vom Browser. Die Beschriftung steht im StepField darüber; die Gruppe
   trägt sie als legend für Vorlese-Programme noch einmal. Die Wahl ist nicht nur an der Farbe zu erkennen (dicker Rand,
   fetter Text, Häkchen). Der Dialog gibt den Wert hinein und bekommt die Wahl über ValueChanged zurück; leer ("")
   heißt: noch nicht gewählt, dann ist kein Knopf gewählt. *@

<fieldset class="payment-select" role="radiogroup" id="@InputId" data-testid="@TestId" aria-describedby="@($"{InputId}-error")">
    <legend class="visually-hidden">@L["Field_PaymentMethod"]</legend>
    <div class="payment-options">
        @foreach (var method in PaymentMethods.All)
        {
            var key = method;
            <label class="payment-option">
                <input type="radio" name="@group" value="@key" checked="@(Value == key)" @onchange="() => ChooseAsync(key)"
                       data-testid="@($"{TestId}-{key}")" />
                <span class="payment-icon" data-icon="@key"><LucideIcon Name="@PaymentMethodIconSet.SymbolName(key)" Size="16" aria-hidden="true" /></span>
                <span class="payment-option-name">@L[$"PaymentMethod_{key}"]</span>
            </label>
        }
    </div>
</fieldset>

@code {
    private readonly string group = $"payment-select-{Guid.NewGuid():N}";

    /// <summary>Die gewählte Zahlungsart, siehe <see cref="PaymentMethods"/>; "" solange keine gewählt ist.</summary>
    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Die Id des Felds; daran hängen Beschriftung und Fehler des StepField.</summary>
    [Parameter, EditorRequired]
    public string InputId { get; set; } = "";

    [Parameter]
    public string? TestId { get; set; }

    private Task ChooseAsync(string key) => ValueChanged.InvokeAsync(key);
}
