@* Die Wahl eines Kontos im Vertragsdialog (Schritt 3, Spec 17): Symbol und Name je Konto (Issue 16). Die Beschriftung steht
   im StepField darüber; die Gruppe trägt sie für Vorlese-Programme noch einmal als legend. Der Dialog gibt weiter Wert,
   Konten und den Text für "kein Konto" hinein und bekommt die Wahl über ValueChanged zurück.

   Aufgelöste Konten werden nicht angeboten, außer das gespeicherte; so bleibt es beim Ändern sichtbar. *@

<AccountSelect Value="Value" ValueChanged="ValueChanged" Accounts="Accounts" EmptyText="@EmptyText" Label="@Label"
               HideLabel="true" InputId="@InputId" DescribedBy="@($"{InputId}-error")" TestId="@TestId" />

@code {
    /// <summary>Das gewählte Konto; null heißt: die leere Wahl mit <see cref="EmptyText"/>.</summary>
    [Parameter]
    public Guid? Value { get; set; }

    [Parameter]
    public EventCallback<Guid?> ValueChanged { get; set; }

    [Parameter]
    public IReadOnlyList<AccountChoice> Accounts { get; set; } = [];

    /// <summary>Was die leere Wahl bedeutet, etwa "Standardkonto" oder "(kein eigenes Konto)".</summary>
    [Parameter, EditorRequired]
    public string EmptyText { get; set; } = "";

    /// <summary>Die Beschriftung der Gruppe, dieselbe wie im StepField darüber.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>Die Id des Felds; daran hängen Beschriftung und Fehler des StepField.</summary>
    [Parameter, EditorRequired]
    public string InputId { get; set; } = "";

    [Parameter]
    public string? TestId { get; set; }
}
