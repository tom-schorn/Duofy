@page "/einladung/{Token}"
@using BlazorBlueprint.Components
@layout AuthLayout
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@inject IHouseholdApi HouseholdApi
@inject ActiveMember Member
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L

@* Ein Einladungslink (R5, R6). Die Seite geht auch ohne Anmeldung: Sie zeigt, welcher Haushalt einlädt,
   wer einlädt und bis wann, aber nie die Mitglieder. Wer nicht angemeldet ist, meldet sich an oder
   registriert sich und kommt danach hierher zurück (returnUrl); wer angemeldet ist, tritt bei.

   Wer schon in einem Haushalt ist, sieht Beitreten ausgegraut mit dem Grund (A21), statt angeboten und dann
   abgelehnt zu werden; das already_in_household der API bleibt das Netz darunter. Nach dem Beitreten frischt
   die Seite den Umschalter auf (Spec 69, A12), damit er "Haushalt" ohne Neustart anbietet. *@

<PageTitle>@L["Invitation_Title"]</PageTitle>

<div class="auth-header">
    <h1 class="page-title">@L["Invitation_Title"]</h1>
</div>

@if (error is not null)
{
    <BbAlert Variant="AlertVariant.Danger" Class="mb-4" data-testid="invitation-error">@error</BbAlert>
}

@if (preview is not null)
{
    <div class="stack">
        <p>@L["Invitation_Text", preview.InvitedBy, preview.HouseholdName]</p>
        <p class="muted">
            @L["Invitation_Until", preview.ExpiresAt.ToLocalTime().ToString("dd.MM.yyyy", German)]
        </p>

        <AuthorizeView>
            <Authorized>
                @if (inHousehold)
                {
                    @* aria-disabled statt disabled, damit ein Screenreader den Knopf findet und den Grund vorliest. *@
                    <p id="invitation-join-reason" data-testid="invitation-join-reason">@L["Error_already_in_household"]</p>
                    <DuofyButton Kind="ButtonKind.Secondary" Text="@L["Invitation_Join"]" TestId="invitation-join" FullWidth="true" Class="unavailable" aria-disabled="true" aria-describedby="invitation-join-reason" />
                }
                else
                {
                    <p>@L["Invitation_JoinHint"]</p>
                    <DuofyButton Text="@L["Invitation_Join"]" OnClick="@(_ => JoinAsync())" TestId="invitation-join" FullWidth="true" Disabled="busy" />
                }
            </Authorized>
            <NotAuthorized>
                <p>@L["Invitation_SignInHint"]</p>
                <DuofyButton Href="@ReturnAddress.With("/anmelden", Here)" TestId="invitation-sign-in" FullWidth="true">@L["Invitation_SignIn"]</DuofyButton>
                <DuofyButton Href="@ReturnAddress.With("/registrieren", Here)" Kind="ButtonKind.Secondary" TestId="invitation-register" FullWidth="true">@L["Invitation_Register"]</DuofyButton>
            </NotAuthorized>
        </AuthorizeView>
    </div>
}

@code {
    private static readonly CultureInfo German = new("de-DE");

    [Parameter] public string Token { get; set; } = "";

    private InvitationPreview? preview;
    private string? error;
    private bool busy;

    // True, wenn die angemeldete Person schon in einem Haushalt ist; dann ist Beitreten ausgegraut.
    private bool inHousehold;

    private string Here => $"/einladung/{Token}";

    protected override async Task OnParametersSetAsync()
    {
        var result = await HouseholdApi.PreviewInvitationAsync(Token);
        preview = result.Succeeded ? result.Value : null;
        error = result.Succeeded ? null : ErrorTexts.For(L, result.ErrorCode);

        // Ohne Anmeldung gibt es keinen eigenen Haushalt. Angemeldet fragt die Seite über den Umschalter, der den
        // Haushalt ohnehin kennt. Scheitert das Laden, bleibt Beitreten angeboten und die API entscheidet.
        var state = await Authentication.GetAuthenticationStateAsync();
        inHousehold = false;
        if (state.User.Identity?.IsAuthenticated == true)
        {
            await Member.RefreshAsync();
            inHousehold = Member.Household is not null;
        }
    }

    private async Task JoinAsync()
    {
        busy = true;
        try
        {
            var joined = await HouseholdApi.AcceptInvitationAsync(Token);
            if (!joined.Succeeded)
            {
                error = ErrorTexts.For(L, joined.ErrorCode);
                return;
            }
            await Member.RefreshAsync();
            Navigation.NavigateTo("/haushalt");
        }
        finally
        {
            busy = false;
        }
    }
}
