@* Der Kopf der Startseite (Spec 33, R1): Begrüßung und Frei-Betrag des Monats im Farbblock der Variante Frei.
   Die Flächenfarbe und die Schrift kommen wie bei jedem Farbblock aus app.css; auf dem Block steht immer der Haupttext.
   Für Vorlese-Programme ist der Block eine Gruppe mit Titel und Betrag als Name, die Begrüßung ist die Überschrift der Seite.
   Der Link unten führt in den Monat, aus dem die Zahl kommt (R7). *@
<div class="color-block color-block--free start-hero" role="group" aria-label="@Label" data-testid="start-hero">
    <h1 class="start-greeting">@Greeting</h1>
    @if (ViewOf is not null)
    {
        <p class="color-block-note start-view-of" data-testid="start-view-of">@ViewOf</p>
    }
    <p class="color-block-title" data-testid="start-free">@Title</p>
    <p class="color-block-amount">@Shown</p>
    @if (Note is not null)
    {
        <p class="color-block-note">@Note</p>
    }
    <a class="start-link" href="@Href" data-testid="start-hero-link">@LinkText</a>
</div>

@code {
    [Parameter, EditorRequired] public string Greeting { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public decimal Amount { get; set; }
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter, EditorRequired] public string LinkText { get; set; } = "";

    /// <summary>Statt des Betrags ein eigener Text, zum Beispiel "Alles verplant" bei null.</summary>
    [Parameter] public string? AmountText { get; set; }

    /// <summary>Ein Zusatz unter dem Betrag, zum Beispiel der enthaltene Übertrag.</summary>
    [Parameter] public string? Note { get; set; }

    /// <summary>Wessen Zahlen es sind, wenn nicht die eigenen ("Zahlen von Ben").</summary>
    [Parameter] public string? ViewOf { get; set; }

    private string Shown => AmountText ?? MoneyText.Format(Amount);

    private string Label => Note is null ? $"{Title}: {Shown}" : $"{Title}: {Shown}. {Note}";
}
