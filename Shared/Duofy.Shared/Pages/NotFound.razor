@page "/not-found"
@using Radzen
@using Radzen.Blazor
@layout MainLayout
@inject IStringLocalizer<SharedResources> L

@* Wird gezeigt, wenn eine Adresse zu keiner Seite passt. Alle Texte kommen aus
   SharedResources.resx; im Markup steht nur der Schlüssel. *@

<PageTitle>@L["NotFound_Title"]</PageTitle>

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-mb-2">@L["NotFound_Title"]</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-mb-4">@L["NotFound_Text"]</RadzenText>
<LinkButton Href="/">@L["NotFound_BackToStart"]</LinkButton>
