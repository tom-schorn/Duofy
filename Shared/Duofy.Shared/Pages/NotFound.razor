@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<SharedResources> L

@* Wird gezeigt, wenn eine Adresse zu keiner Seite passt. Alle Texte kommen aus
   SharedResources.resx; im Markup steht nur der Schlüssel. *@

<PageTitle>@L["NotFound_Title"]</PageTitle>
<PageHead Title="@L["NotFound_Title"]" />
<p class="mb-4">@L["NotFound_Text"]</p>
<DuofyButton Href="/">@L["NotFound_BackToStart"]</DuofyButton>
