@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@inject IPlanApi PlanApi
@inject ActiveMember Member
@inject IStringLocalizer<SharedResources> L
@inject IAppHost Host

@* Der Dialog für einen Posten: einen einmaligen anlegen (R3) oder einen vorhandenen ändern.
   Ein geänderter Posten aus einem Vertrag gilt danach als von Hand geändert; das entscheidet die API.
   Geprüft wird beim Speichern von der API; ihre Fehler stehen oben im Dialog. *@

<MudDialog>
    <DialogContent>
        @if (Host.IsApp)
        {
            <FullScreenFormHeader Title="@MudDialog.Title" SaveText="@L["PlanPositionDialog_Save"]" SaveTestId="position-save"
                                  Busy="busy" OnClose="Cancel" OnSave="SaveAsync" />
        }
        <MudStack Spacing="3">

            @if (error is not null)
            {
                <MudAlert Severity="Severity.Error" data-testid="position-error">@error</MudAlert>
            }

            <MudTextField T="string" @bind-Value="label" Label="@L["Field_PositionLabel"]"
                          MaxLength="PlanRules.LabelMaxLength" data-testid="position-label" />

            <MudNumericField T="decimal?" @bind-Value="amount" Culture="German" Format="0.00" Min="0"
                             HideSpinButtons="true" Label="@L["Field_PlannedAmount"]" data-testid="position-amount" />

            <MudNumericField T="int?" @bind-Value="dueDay" Min="1" Max="DateTime.DaysInMonth(Year, Month)"
                             Label="@L["Field_DueDay"]" data-testid="position-day" />

            <NativeSelect Value="@pot" ValueChanged="OnPotChanged" Label="@L["Field_Pot"]" data-testid="position-pot">
                @foreach (var key in PlanView.PotOrder)
                {
                    <option value="@key">@L[$"Pot_{key}"]</option>
                }
            </NativeSelect>

            <NativeSelect Value="@Key(categoryId)" ValueChanged="OnCategoryChanged" Label="@L["Field_Category"]"
                          data-testid="position-category">
                <option value="">@L["PlanPositionDialog_Choose"]</option>
                @foreach (var group in OfferedCategories())
                {
                    <optgroup label="@L[$"CategoryGroup_{group.Key}"]">
                        @foreach (var category in group)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </optgroup>
                }
            </NativeSelect>

            @* Ohne Konto zahlt das Standardkonto. *@
            <NativeSelect Value="@Key(accountId)" ValueChanged="OnAccountChanged" Label="@L["Field_PayingAccount"]"
                          data-testid="position-account">
                <option value="">@L["PlanPositionDialog_DefaultAccount"]</option>
                @foreach (var account in Accounts.Where(a => a.Active || a.Id == accountId))
                {
                    <option value="@account.Id">@account.Name</option>
                }
            </NativeSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (!Host.IsApp)
        {
            <MudButton OnClick="Cancel">@L["PlanDialog_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="SaveAsync"
                       data-testid="position-save">@L["PlanPositionDialog_Save"]</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {

    private static readonly CultureInfo German = new("de-DE");

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int Year { get; set; }

    [Parameter] public int Month { get; set; }

    /// <summary>Der Posten, der geändert wird; null beim Anlegen eines einmaligen Postens.</summary>
    [Parameter] public PlanPositionResponse? Existing { get; set; }

    [Parameter] public List<CategoryResponse> Categories { get; set; } = [];

    [Parameter] public IReadOnlyList<AccountChoice> Accounts { get; set; } = [];

    private string label = "";
    private decimal? amount;
    private int? dueDay;
    private string pot = PotKeys.Needs;
    private Guid? categoryId;
    private Guid? accountId;
    private string? error;
    private bool busy;

    // Die Person, für die der Dialog geöffnet wurde; sie bleibt, auch wenn der Umschalter inzwischen woanders steht (Spec 68, A15).
    private Guid? owner;

    protected override void OnInitialized()
    {
        owner = Member.Owner;
        if (Existing is { } position)
        {
            (label, amount, dueDay, pot, categoryId, accountId) =
                (position.Label, position.AmountPlanned, position.DueDay, position.Pot, position.CategoryId, position.AccountId);
        }
    }

    private static string Key(Guid? id) => id?.ToString() ?? "";

    private static Guid? ParseId(string? text) => Guid.TryParse(text, out var id) ? id : null;

    // Einnahmen bieten nur Einnahme-Kategorien an, alle anderen Töpfe die übrigen.
    private IEnumerable<IGrouping<string, CategoryResponse>> OfferedCategories() => Categories
        .Where(c => (c.Group == CategoryGroupKeys.Income) == (pot == PotKeys.Income))
        .GroupBy(c => c.Group);

    // Wechselt der Topf zwischen Einnahmen und den anderen, passt die Kategorie nicht mehr.
    private void OnPotChanged(string value)
    {
        if ((value == PotKeys.Income) != (pot == PotKeys.Income))
        {
            categoryId = null;
        }
        pot = value;
    }

    // Wer eine Kategorie wählt, bekommt ihren vorgeschlagenen Topf vorgewählt.
    private void OnCategoryChanged(string value)
    {
        categoryId = ParseId(value);
        if (Categories.FirstOrDefault(c => c.Id == categoryId) is { } category)
        {
            pot = category.SuggestedPot;
        }
    }

    private void OnAccountChanged(string value) => accountId = ParseId(value);

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        error = null;
        busy = true;
        try
        {
            // Fehlende Werte gehen als 0 an die API; sie weist sie mit ihrem Code ab, so gibt es die Regeln nur dort.
            var result = Existing is null
                ? await PlanApi.CreatePositionAsync(Year, Month,
                    new CreatePositionRequest(label.Trim(), amount ?? 0m, dueDay ?? 0, categoryId, pot, accountId), owner)
                : await PlanApi.UpdatePositionAsync(Year, Month, Existing.Id,
                    new UpdatePositionRequest(label.Trim(), amount ?? 0m, dueDay ?? 0, categoryId, pot, accountId,
                        ClearAccountId: accountId is null), owner);

            if (result.Succeeded)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                error = ErrorTexts.For(L, result.ErrorCode);
            }
        }
        finally
        {
            busy = false;
        }
    }
}
