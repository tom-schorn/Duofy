@page "/konto"
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]
@using Duofy.ApiClient
@using Duofy.Schemas
@implements IDisposable
@inject IAuthApi AuthApi
@inject IAppHost Host
@inject AppChrome Chrome
@inject IUserApi UserApi
@inject IInstanceApi InstanceApi
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L

@* Das Konto: Name ändern, Adresse ändern, Passwort ändern, abmelden, Konto löschen.
   Jeder Abschnitt ist eine eigene Karte mit eigener Meldung (Erfolg oder Fehler).

   Solange der Server keinen Admin hat und ein Einrichtungscode eingestellt ist, kann ein bestehendes Konto mit
   dem Code Admin werden (Spec 70, R1). Der einzige Admin kann sein Konto nicht löschen (R5); der Knopf ist dann
   ausgegraut, und darunter steht warum.

   Eine neue Adresse braucht das aktuelle Passwort (Spec 53, R5). Auf der gehosteten Version gilt sie erst, wenn die
   Person den Link aus der Mail an die neue Adresse öffnet; bis dahin zeigt die Seite die alte. Auf einem selbst
   betriebenen Server gilt sie sofort. *@

<PageTitle>@L["Account_Title"]</PageTitle>

<AppPageHeading Text="@L["Account_Title"]" />
@if (!Host.IsApp)
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-mb-1">@L["Account_Title"]</RadzenText>
}
@if (email is not null)
{
    <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-text-secondary-color rz-mb-4">@L["Account_Email", email]</RadzenText>
}

<RadzenStack Gap="1rem">

    <RadzenCard Variant="Variant.Outlined" data-testid="account-names">
        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-mb-2">@L["Account_NamesHeading"]</RadzenText>
        <Notice Message="namesMessage" />
        <div class="field">
            <FieldLabel For="account-first-name-input" Text="@L["Field_FirstName"]" />
            <RadzenTextBox @bind-Value="firstName" id="account-first-name-input" MaxLength="AccountRules.NameMaxLength"
                           data-testid="account-first-name" />
        </div>
        <div class="field">
            <FieldLabel For="account-last-name-input" Text="@L["Field_LastName"]" />
            <RadzenTextBox @bind-Value="lastName" id="account-last-name-input" MaxLength="AccountRules.NameMaxLength"
                           data-testid="account-last-name" />
        </div>
        <RadzenButton Text="@L["Account_NamesSave"]" ButtonStyle="ButtonStyle.Primary" Class="rz-mt-2" Click="@(_ => SaveNamesAsync())"
                      data-testid="account-names-save" />
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined" data-testid="account-email">
        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-mb-1">@L["Account_EmailHeading"]</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" Class="rz-mb-2">@(hosted ? L["Account_EmailHintHosted"] : L["Account_EmailHintSelfHosted"])</RadzenText>
        <Notice Message="emailMessage" />
        <div class="field">
            <FieldLabel For="account-new-email-input" Text="@L["Field_NewEmail"]" />
            <RadzenTextBox @bind-Value="newEmail" id="account-new-email-input" type="email"
                           Placeholder="@L["Auth_EmailPlaceholder"]" autocomplete="email"
                           data-testid="account-new-email" />
        </div>
        <div class="field">
            <FieldLabel For="account-email-password-input" Text="@L["Field_CurrentPassword"]" />
            <RadzenPassword @bind-Value="emailPassword" id="account-email-password-input" autocomplete="current-password"
                            data-testid="account-email-password" />
        </div>
        <RadzenButton Text="@L["Account_EmailSave"]" ButtonStyle="ButtonStyle.Primary" Class="rz-mt-2" Disabled="changingEmail"
                      Click="@(_ => ChangeEmailAsync())" data-testid="account-email-save" />
    </RadzenCard>

    @* Die Zielquoten (Spec 66, R8): ganze Prozent, zusammen 100. Neue Monate übernehmen sie. *@
    <RadzenCard Variant="Variant.Outlined" data-testid="account-quotas">
        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-mb-1">@L["Account_QuotasHeading"]</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" Class="rz-mb-2">@L["Account_QuotasHint"]</RadzenText>
        <Notice Message="quotasMessage" />
        @foreach (var pot in QuotaPots)
        {
            var key = pot;
            <div class="field">
                <FieldLabel For="" id="@($"account-quota-{key}-label")" Text="@L["Account_QuotaField", L[$"Pot_{key}"]]" />
                <RadzenNumeric TValue="int" Value="quotas[key]" ValueChanged="v => quotas[key] = v" Min="0" Max="100"
                               ShowUpDown="false"
                               InputAttributes="@(new Dictionary<string, object> { ["aria-labelledby"] = $"account-quota-{key}-label" })"
                               data-testid="@($"account-quota-{key}")" />
            </div>
        }
        <RadzenButton Text="@L["Account_QuotasSave"]" ButtonStyle="ButtonStyle.Primary" Class="rz-mt-2" Click="@(_ => SaveQuotasAsync())"
                      data-testid="account-quotas-save" />
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined">
        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-mb-2">@L["Account_PasswordHeading"]</RadzenText>
        <Notice Message="passwordMessage" />
        <div class="field">
            <FieldLabel For="account-current-password-input" Text="@L["Field_CurrentPassword"]" />
            <RadzenPassword @bind-Value="currentPassword" id="account-current-password-input" autocomplete="current-password"
                            data-testid="account-current-password" />
        </div>
        <div class="field">
            <FieldLabel For="account-new-password-input" Text="@L["Field_NewPassword"]" />
            <RadzenPassword @bind-Value="newPassword" id="account-new-password-input" autocomplete="new-password"
                            aria-describedby="account-new-password-hint"
                            data-testid="account-new-password" />
            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color rz-display-block"
                        id="account-new-password-hint">@L["Field_PasswordHint"]</RadzenText>
        </div>
        <RadzenButton Text="@L["Account_PasswordSave"]" ButtonStyle="ButtonStyle.Primary" Class="rz-mt-2" Click="@(_ => ChangePasswordAsync())"
                      data-testid="account-password-save" />
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined" data-testid="account-sessions">
        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-mb-2">@L["Account_SessionsHeading"]</RadzenText>
        <Notice Message="sessionsMessage" />
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenButton Text="@L["Account_SignOut"]" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Primary"
                          Click="@(_ => SignOutAsync())" data-testid="account-sign-out" />
            <RadzenButton Text="@L["Account_SignOutEverywhere"]" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Primary"
                          Click="@(_ => SignOutEverywhereAsync())" data-testid="account-sign-out-everywhere" />
        </RadzenStack>
        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-mt-2">@L["Account_SignOutEverywhereHint"]</RadzenText>
    </RadzenCard>

    @if (setupPending && !isAdmin)
    {
        <RadzenCard Variant="Variant.Outlined" data-testid="account-admin">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-mb-1">@L["Account_AdminHeading"]</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" Class="rz-mb-2">@L["Account_AdminText"]</RadzenText>
            <Notice Message="adminMessage" />
            <div class="field">
                <FieldLabel For="account-setup-code-input" Text="@L["Field_SetupCode"]" />
                <RadzenTextBox @bind-Value="setupCode" id="account-setup-code-input" Immediate="true" autocomplete="off"
                               data-testid="account-setup-code" />
            </div>
            <RadzenButton Text="@L["Account_ClaimAdmin"]" ButtonStyle="ButtonStyle.Primary" Class="rz-mt-2" Disabled="claiming"
                          Click="@(_ => ClaimAdminAsync())" data-testid="account-claim-admin" />
        </RadzenCard>
    }
    else if (adminMessage is not null)
    {
        <Notice Message="adminMessage" />
    }

    <RadzenCard Variant="Variant.Outlined">
        <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" Class="rz-mb-2">@L["Account_DangerHeading"]</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1" TagName="TagName.P" Class="rz-mb-2">@L["Account_DangerText"]</RadzenText>
        @if (isAdmin)
        {
            @* Die API antwortet last_admin. Ausgegraut statt angeboten und abgelehnt; aria-disabled statt disabled,
               damit ein Screenreader den Knopf findet und den Grund darunter vorliest. *@
            <RadzenButton Text="@L["Account_DeleteLink"]" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base"
                          Class="unavailable"
                          aria-disabled="true" aria-describedby="account-delete-reason"
                          data-testid="account-delete-link" />
            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" Class="rz-text-secondary-color rz-display-block rz-mt-1"
                        id="account-delete-reason" data-testid="account-delete-reason">@L["Account_DeleteLastAdminReason"]</RadzenText>
        }
        else
        {
            <LinkButton Href="/konto/loeschen" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Base"
                        data-testid="account-delete-link">@L["Account_DeleteLink"]</LinkButton>
        }
    </RadzenCard>

</RadzenStack>

@code {

    private string? email;
    private string firstName = "";
    private string lastName = "";
    private string currentPassword = "";
    private string newPassword = "";
    private NoticeMessage? namesMessage;
    private NoticeMessage? passwordMessage;
    private NoticeMessage? sessionsMessage;
    private NoticeMessage? quotasMessage;
    private NoticeMessage? adminMessage;
    private NoticeMessage? emailMessage;
    private string newEmail = "";
    private string emailPassword = "";
    private bool changingEmail;
    private bool hosted;
    private bool isAdmin;
    private bool setupPending;
    private bool claiming;
    private string setupCode = "";

    private static readonly string[] QuotaPots = [PotKeys.Needs, PotKeys.Wants, PotKeys.Savings];

    // Bis die API antwortet, stehen die Startwerte 50/30/20 in den Feldern.
    private readonly Dictionary<string, int> quotas = new() { [PotKeys.Needs] = 50, [PotKeys.Wants] = 30, [PotKeys.Savings] = 20 };

    // Beim Öffnen der Seite den Titel für die App-Leiste setzen (ohne Plus-Knopf), dann die
    // aktuellen Daten von der API holen und in die Felder schreiben.
    protected override async Task OnInitializedAsync()
    {
        Chrome.Set(this, L["Account_Title"]);
        var me = await UserApi.GetMeAsync();
        if (me.Succeeded)
        {
            email = me.Value!.Email;
            firstName = me.Value.FirstName;
            lastName = me.Value.LastName;
            isAdmin = me.Value.IsInstanceAdmin;
        }
        else
        {
            namesMessage = new NoticeMessage(ErrorTexts.For(L, me.ErrorCode), NoticeSeverity.Error);
        }

        // Ohne Antwort des Servers gibt es kein Angebot, Admin zu werden.
        var instance = await InstanceApi.GetAsync();
        setupPending = instance.Succeeded && instance.Value!.SetupPending;
        hosted = instance.Succeeded && instance.Value!.Hosted;

        var stored = await UserApi.GetQuotasAsync();
        if (stored.Succeeded)
        {
            ShowQuotas(stored.Value!);
        }
        else
        {
            quotasMessage = new NoticeMessage(ErrorTexts.For(L, stored.ErrorCode), NoticeSeverity.Error);
        }
    }

    private void ShowQuotas(QuotaSettings settings)
    {
        quotas[PotKeys.Needs] = settings.Needs;
        quotas[PotKeys.Wants] = settings.Wants;
        quotas[PotKeys.Savings] = settings.Savings;
    }

    // Ob die drei Werte zusammen 100 ergeben, prüft die API (quota_invalid); der Text sagt dann, was gilt.
    private async Task SaveQuotasAsync()
    {
        var result = await UserApi.UpdateQuotasAsync(new QuotaSettings(quotas[PotKeys.Needs], quotas[PotKeys.Wants], quotas[PotKeys.Savings]));
        if (result.Succeeded)
        {
            ShowQuotas(result.Value!);
            quotasMessage = new NoticeMessage(L["Account_QuotasSaved"], NoticeSeverity.Success);
        }
        else
        {
            quotasMessage = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        }
    }

    private async Task ClaimAdminAsync()
    {
        claiming = true;
        try
        {
            var result = await UserApi.ClaimAdminAsync(new ClaimAdminRequest(setupCode.Trim()));
            if (result.Succeeded)
            {
                isAdmin = result.Value!.IsInstanceAdmin;
                setupPending = false;
                setupCode = "";
                adminMessage = new NoticeMessage(L["Account_AdminClaimed"], NoticeSeverity.Success);
            }
            else
            {
                adminMessage = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
            }
        }
        finally
        {
            claiming = false;
        }
    }

    private async Task SaveNamesAsync()
    {
        var result = await UserApi.UpdateMeAsync(new UpdateMeRequest(firstName.Trim(), lastName.Trim()));
        namesMessage = result.Succeeded
            ? new NoticeMessage(L["Account_NamesSaved"], NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
    }

    // Die API prüft Adresse, Passwort und ob die Adresse frei ist; die Seite zeigt nur das Ergebnis.
    private async Task ChangeEmailAsync()
    {
        changingEmail = true;
        try
        {
            var requested = newEmail.Trim();
            var result = await UserApi.ChangeEmailAsync(new ChangeEmailRequest(requested, emailPassword));
            if (!result.Succeeded)
            {
                emailMessage = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
                return;
            }
            newEmail = "";
            emailPassword = "";
            if (result.Value is { } me)
            {
                email = me.Email;
                emailMessage = new NoticeMessage(L["Account_EmailChanged"], NoticeSeverity.Success);
            }
            else
            {
                emailMessage = new NoticeMessage(L["Account_EmailPending", requested], NoticeSeverity.Success);
            }
        }
        finally
        {
            changingEmail = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        var result = await UserApi.ChangePasswordAsync(new ChangePasswordRequest(currentPassword, newPassword));
        if (result.Succeeded)
        {
            currentPassword = "";
            newPassword = "";
            passwordMessage = new NoticeMessage(L["Account_PasswordChanged"], NoticeSeverity.Success);
        }
        else
        {
            passwordMessage = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        }
    }

    public void Dispose() => Chrome.Release(this);

    private async Task SignOutAsync()
    {
        await AuthApi.LogoutAsync();
        Navigation.NavigateTo("/anmelden");
    }

    private async Task SignOutEverywhereAsync()
    {
        var result = await AuthApi.LogoutEverywhereAsync();
        if (result.Succeeded)
        {
            Navigation.NavigateTo("/anmelden");
        }
        else
        {
            sessionsMessage = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        }
    }
}
