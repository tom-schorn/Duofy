@page "/plan/{Year:int}/{Month:int}"
@using BlazorBlueprint.Icons.Lucide.Components
@attribute [Authorize]
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@using Duofy.Shared.Charts
@using Duofy.Shared.Pages.Month
@implements IDisposable
@inject IPlanApi PlanApi
@inject ICategoryApi CategoryApi
@inject IAccountChoices AccountChoices
@inject IAccountApi AccountApi
@inject PositionActions Actions
@inject FormDialogs Forms
@inject AppChrome Chrome
@inject ActiveMember Member
@inject TimeProvider Time
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L

@* Der Monatsplan (Spec 66, Spec 82) wie im alten Duofy: oben zurück und Blättern, Titel und Knöpfe, drei schlichte Kennzahlen,
   die Reiter und im Reiter Plan der Sankey aus den Posten und die Posten nach Töpfen mit Balken und Kästchen, dazu je Topf die
   Zeile Ungeplant aus den Buchungen ohne Posten.

   Die Seite rechnet nichts selbst. Gebuchte Beträge, Quoten und Unterschiede schickt die API mit; nach jeder Änderung holt die
   Seite den Monat neu. Der gewählte Reiter bleibt beim Blättern zwischen den Monaten.

   Mit dem Umschalter zeigt die Seite den Monat eines anderen Mitglieds (Spec 68). Was dessen Freigabe nicht erlaubt, ist
   ausgegraut, und der Grund steht einmal oben; ohne Planung Ansehen sagt die Seite nur, dass die Person diesen Bereich nicht
   teilt. *@

<PageTitle>@MonthTitle</PageTitle>

@* Mit "Haushalt" im Umschalter zeigt die Seite den Haushaltsplan (Spec 69); dort arbeitet man auch, für jede Person unter ihren Freigaben (Spec 125). *@
@if (Member.IsHousehold)
{
    <MonthNav BackHref="/plan" BackText="@L["Plan_BackToMonths"]" />
    <HouseholdPlanView Heading="@MonthTitle" Year="year" Month="month" />
}
else
{
<MonthNav BackHref="/plan" BackText="@L["Plan_BackToMonths"]" />

@* Der Kopf mit Drucken, Buchung und Posten anlegen ist derselbe wie im Haushaltsplan (Spec 125, R1). *@
<PlanHead Title="@MonthTitle" Lead="@(Member.Name is { } who ? L["Plan_LeadOf", who].Value : L["Plan_Lead"].Value)" CompactLead="true" Show="SeesPlan" CanAdd="CanAdd" CanBook="CanBook"
          OnPrint="PrintAsync" OnBooking="NewBookingAsync" OnAdd="AddAsync" />

@if (!SeesPlan)
{
    <p class="muted" data-testid="not-shared">@NotSharedText.For(L, Member, GrantAreas.Plan)</p>
}
else
{
<GrantReason Show="AnyLocked" />

<Notice Message="message" />

@if (plan is not null)
{
    @* Vier gleich große Kennzahlen (Spec 82, R15). Der Übertrag (R9) ist die vierte: in keinem Topf und keiner Quote,
       eintragen und zurücknehmen nur hier. *@
    <div class="metrics" data-testid="month-metrics">
        <div data-testid="month-block-income"><Metric Title="@L["Month_Income"]" Amount="IncomeTotal" /></div>
        <div data-testid="month-block-free"><Metric Title="@L["Month_Allocatable"]" Amount="FreeTotal" Over="FreeTotal < 0m" AmountText="@(FreeTotal == 0m ? L["Month_AllPlanned"].Value : null)" Note="@FreeNote" /></div>
        <div data-testid="month-block-unpaid"><Metric Title="@L["Month_Unpaid"]" Amount="UnpaidTotal" AmountText="@UnpaidText" Note="@(SeesBookings ? L["Month_UnpaidNote"].Value : NotSharedText.For(L, Member, GrantAreas.Book))" /></div>
        <div data-testid="plan-carry-over" data-print="hide">
            @{ var carryOvers = MonthView.CarryOverRows(plan.Overview?.CarryOvers); }
            <div class="metric metric--carry" role="group" aria-labelledby="carry-over-title">
                <p class="metric-title" id="carry-over-title">@L["Plan_CarryOver"]</p>
                @if (carryOvers.Count > 0)
                {
                    @foreach (var row in carryOvers)
                    {
                        <p class="metric-line" data-testid="@(row.Incoming ? "plan-carry-over-in" : "plan-carry-over-out")">
                            <span>@L[row.Incoming ? "Month_CarryOverIn" : "Month_CarryOverOut", row.Month.ToString("MMMM", German)]</span>
                            <b class="num @(row.Amount < 0m ? "over" : null)">@Money(row.Amount)</b>
                        </p>
                    }
                }
                else if (plan.CarryOver.Exists)
                {
                    <p class="metric-line"><span>@L["Plan_CarryOverBooked", Money(plan.CarryOver.Amount ?? 0m)]</span></p>
                }
                else
                {
                    <p class="metric-note">@L["Plan_CarryOverNone"]</p>
                }
                <div class="metric-action">
                    @if (plan.CarryOver.Exists)
                    {
                        <DuofyButton Kind="ButtonKind.Ghost" Small="true" Text="@L["Plan_CarryOverRemove"]" OnClick="@(_ => RemoveCarryOverAsync())"
                                     Class="@GrantLock.Class(CanRemoveCarryOver)" @attributes="GrantLock.Attributes(CanRemoveCarryOver)"
                                     TestId="plan-carry-over-remove" />
                    }
                    else
                    {
                        <DuofyButton Kind="ButtonKind.Secondary" Small="true" Text="@L["Plan_CarryOverEnter"]" OnClick="@(_ => CarryOverAsync())"
                                     Class="@GrantLock.Class(CanCarryOver)" @attributes="GrantLock.Attributes(CanCarryOver)"
                                     TestId="plan-carry-over-open" />
                    }
                </div>
            </div>
        </div>
    </div>
}

<MonthTabs Active="tab" ActiveChanged="SelectTab" BookingCount="@(SeesBookings ? plan?.Overview?.Bookings.Count : null)" />
<div role="tabpanel" id="month-panel" aria-labelledby="@($"month-tab-{MonthTabs.Key(tab)}")">
@if (plan is not null)
{
    @if (tab == MonthTab.Bookings)
    {
        @if (SeesBookings)
        {
            <MonthBookings Rows="MonthView.BookingRows(plan.Overview?.Bookings ?? [], AccountName, Purpose, plan.Positions, CategoryName)" CarryOvers="MonthView.CarryOverRows(plan.Overview?.CarryOvers)" />
        }
        else
        {
            <p class="muted" data-testid="bookings-not-shared">@NotSharedText.For(L, Member, GrantAreas.Book)</p>
        }
    }
    else if (tab == MonthTab.Review)
    {
        var review = MonthView.ForPerson(plan, Today, AccountName, null, CategoryName);
        <MonthReview Model="review" SeesBookings="SeesBookings" Today="Today">
            <Balances>
                <AccountBalances Rows="BalanceRows" NotShared="!SeesAccounts" AsOf="@L["Month_AccountsAsOfToday"]" />
            </Balances>
        </MonthReview>
    }
    else
    {
        @* Geänderte Verträge: vorher und nachher je Unterschied, alle oder einzeln übernehmen (R2). *@
        <PlanChangesCard Changes="plan.Changes" OnApply="ApplyAsync" CanApplyAll="CanApplyAll" CanApplyChange="CanApplyChange" FieldText="FieldText" />

        @if (plan.Positions.Count == 0)
        {
            <p class="empty-state notice" data-testid="plan-empty">@L["Plan_Empty"]</p>
        }

        @* Die Posten nach Topf (Spec 24, R5). *@
        @foreach (var group in PlanView.GroupsWithUnplanned(plan))
        {
            <PotSection Pot="@group.Pot" Sum="PlanView.PotPlanned(plan, group.Pot)" Booked="PlanView.PotBooked(plan, group.Pot)" Limit="LimitOf(group.Pot)">
                @foreach (var position in group.Positions)
                {
                    var current = position;
                    var done = position.DoneAt is not null;
                    <li class="@(done ? "plan-row row-done" : "plan-row")" data-testid="@($"plan-position-{position.Id}")">
                        <div class="list-row">
                            <span class="list-row-lift">
                                <TickBox Checked="done" Label="@L[done ? "Plan_Untick" : "Plan_Tick", position.Label]" OnToggle="@(() => ToggleAsync(current))"
                                         Class="@GrantLock.Class(CanToggle(position))" @attributes="GrantLock.Attributes(CanToggle(position))"
                                         data-testid="@($"plan-tick-{position.Id}")" />
                            </span>
                            <button type="button" class="list-row-body list-row-open @GrantLock.Class(CanEdit)" @onclick="() => EditAsync(current)" @attributes="GrantLock.Attributes(CanEdit)"
                                    aria-label="@L["Plan_Edit", position.Label]" data-testid="@($"plan-edit-{position.Id}")">
                                <span class="list-row-title">@position.Label</span>
                                <span class="list-row-detail">@Caption(position)</span>
                            </button>
                            @{ var linked = SeesBookings ? BookingPurpose.LinesOf(plan.Overview?.Bookings ?? [], position.Id, CategoryName, L) : []; }
                            @if (linked.Count > 0)
                            {
                                <span class="list-row-lift">
                                    <PositionBookingsToggle Count="linked.Count" Label="@position.Label" PanelId="@($"position-bookings-panel-{position.Id}")"
                                                            Open="expanded.Contains(position.Id)" OnToggle="@(() => Toggle(current.Id))"
                                                            TestId="@($"position-bookings-{position.Id}-toggle")" />
                                </span>
                            }
                            <span class="list-row-amount" data-testid="@($"plan-amounts-{position.Id}")">
                                @Money(position.AmountPlanned)
                                @if (position.Booked != 0m && position.Booked != position.AmountPlanned)
                                {
                                    <span class="list-row-detail">@L["Plan_BookedOf", Money(position.Booked)]</span>
                                }
                            </span>
                            @if (SeesBookings && linked.Count == 0)
                            {
                                <span class="list-row-lift">
                                    <DuofyButton Kind="ButtonKind.Ghost" Icon="plus" IconOnly="true" Small="true" OnClick="@(_ => BookAsync(current.Id))"
                                                 Class="@GrantLock.Class(CanBook)" @attributes="GrantLock.Attributes(CanBook)"
                                                 AriaLabel="@($"{L["Plan_PositionBookingAdd"]}: {position.Label}")" TestId="@($"position-bookings-{position.Id}-add")" />
                                </span>
                            }
                        </div>
                        @if (linked.Count > 0)
                        {
                            <PositionBookings Label="@position.Label" TestId="@($"position-bookings-{position.Id}")"
                                              PanelId="@($"position-bookings-panel-{position.Id}")" Open="expanded.Contains(position.Id)"
                                              Rows="linked" CanAdd="CanBook" OnAdd="@(() => BookAsync(current.Id))" />
                        }
                    </li>
                }
                @if (SeesBookings && group.Pot != PotKeys.Income)
                {
                    <PotUnplannedRow Pot="@group.Pot" Rows="BookingPurpose.UnplannedLinesOf(plan.Overview?.Bookings ?? [], group.Pot, CategoryName, L)" />
                }
            </PotSection>
        }

    }
}
</div>
@if (plan is not null)
{
    <PersonMonthPrint Plan="plan" Title="@MonthTitle" Subject="@PrintSubject" Year="year" Month="month" />
}
}
}

@code {

    private static readonly CultureInfo German = new("de-DE");

    /// <summary>Das Jahr aus der Adresse /plan/{Jahr}/{Monat}; ohne Angabe der laufende Monat.</summary>
    [Parameter] public int? Year { get; set; }

    /// <summary>Der Monat aus der Adresse, 1 bis 12.</summary>
    [Parameter] public int? Month { get; set; }

    /// <summary>Der Name des Parameters in der Adresse, mit dem die Monatsseite gleich den Buchungsdialog öffnet (Spec 51, R4).</summary>
    public const string BookQuery = "buchen";

    [SupplyParameterFromQuery(Name = BookQuery)] public int? Book { get; set; }

    // Der Dialog geht erst nach dem Zeichnen auf, und nur einmal: Danach ist der Parameter aus der Adresse.
    private bool bookingPending;

    private int year;
    private int month;
    private bool opened;
    private PlanResponse? plan;
    private List<CategoryResponse> categories = [];
    private IReadOnlyList<AccountChoice> accounts = [];

    // Die Konten mit ihrem heutigen Stand für die Karte Kontostände in der Auswertung (Tom, 03.11.2026).
    private IReadOnlyList<AccountResponse> balances = [];

    private IReadOnlyList<AccountBalanceRow> BalanceRows => balances
        .Select(a => new AccountBalanceRow(a.Id, a.Name, a.Type, a.Balance, a.CountsAsAvailable))
        .ToList();
    private NoticeMessage? message;

    private MonthTab tab = MonthTab.Plan;

    // Das Druckbild (Spec 82, R20): wessen Plan, der Übertrag als Text und je Topf seine Posten.
    private string PrintSubject => Member.Owner is null ? L["Nav_MyPlan"].Value : L["Print_PlanOf", Member.Name ?? ""].Value;

    // Die Posten, deren Buchungen gerade aufgeklappt sind.
    private readonly HashSet<Guid> expanded = [];

    private void Toggle(Guid positionId)
    {
        if (!expanded.Remove(positionId))
        {
            expanded.Add(positionId);
        }
    }

    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

    private void SelectTab(MonthTab selected)
    {
        tab = selected;
        // Die Erklärspalte erklärt den offenen Reiter (Spec 82, R13).
        Chrome.SetHelpTopic(this, HelpTopicOf(selected));
    }

    private string HelpTopicOf(MonthTab selected) => Member.IsHousehold ? HelpTopics.HouseholdPlan : selected switch
    {
        MonthTab.Bookings => HelpTopics.Bookings,
        MonthTab.Review => HelpTopics.Review,
        _ => HelpTopics.Month,
    };

    private string? AccountName(Guid id) => accounts.FirstOrDefault(a => a.Id == id)?.Name;

    private string? CategoryName(Guid id) => categories.FirstOrDefault(c => c.Id == id)?.Name;

    // Wofür eine Buchung war (Spec 51, R10).
    private string Purpose(BookingResponse booking) => BookingPurpose.For(booking, plan?.Positions ?? [], CategoryName, AccountName, L);

    private string MonthTitle => new DateOnly(year, month, 1).ToString("MMMM yyyy", German);

    private decimal IncomeTotal => plan?.Overview?.Income ?? plan?.PlannedIncome ?? 0m;
    private decimal FreeTotal => plan?.Overview?.Free ?? 0m;
    private decimal UnpaidTotal => plan is null ? 0m : MonthView.Unpaid(plan.Positions);

    // Ohne Sicht auf die Buchungen (Spec 68, Fund S3) kommt jeder gebuchte Betrag als 0; der offene Rest wäre falsch.
    private string? UnpaidText => !SeesBookings ? "–" : UnpaidTotal == 0m ? L["Month_AllPaid"].Value : null;

    // Was die Quote eines Topfs bei diesen Einnahmen erlaubt.
    private decimal LimitOf(string pot) => Math.Round(IncomeTotal * (plan?.Quotas.FirstOrDefault(q => q.Pot == pot)?.Target ?? 0) / 100m, 2);

    // Was in Verplanbar steckt (Spec 66, R9): der Übertrag, sobald einer da ist.
    private string FreeNote
    {
        get
        {
            var incoming = MonthView.CarryOverRows(plan?.Overview?.CarryOvers).Where(c => c.Incoming).ToList();
            return incoming.Count > 0
                ? L["Month_FreeCarryOver", MoneyText.Format(incoming.Sum(c => c.Amount))].Value
                : L["Month_FreeNote"].Value;
        }
    }


    // Was die Freigabe des gewählten Mitglieds erlaubt (Spec 68); bei "Ich" alles. Abhaken und der Übertrag
    // legen Buchungen auf Konten an, Haken zurück und Übertrag entfernen löschen sie.
    private bool SeesPlan => Member.Allows(GrantAreas.Plan, AccessLevelKeys.View);
    private bool CanAdd => Member.Allows(GrantAreas.Plan, AccessLevelKeys.Create);
    private bool CanEdit => Member.Allows(GrantAreas.Plan, AccessLevelKeys.Edit);
    private bool CanDelete => Member.Allows(GrantAreas.Plan, AccessLevelKeys.Delete);
    private bool SeesBookings => Member.Allows(GrantAreas.Book, AccessLevelKeys.View);
    private bool CanBook => Member.Allows(GrantAreas.Book, AccessLevelKeys.Create) && SeesAccounts;
    private bool SeesAccounts => Member.Allows(GrantAreas.Accounts, AccessLevelKeys.View);
    private bool CanTick => Member.Allows(GrantAreas.Book, AccessLevelKeys.Edit) && SeesAccounts;
    private bool CanUntick => Member.Allows(GrantAreas.Book, AccessLevelKeys.Delete);
    private bool CanApply => CanEdit && Member.Allows(GrantAreas.Commitments, AccessLevelKeys.View);

    // Ein Unterschied, der einen Posten entfernt, ist Löschen (Spec 68, A18).
    private bool CanApplyChange(PlanChangeResponse change) => CanApply && (CanDelete || change.Kind != PlanChangeKinds.NoLongerDue);

    // "Alle übernehmen" entfernt jeden nicht geschützten Posten, der nicht mehr fällig ist. Ob einer davon Buchungen
    // hat (die API lässt ihn dann stehen), weiß die Seite nicht; gesperrt ist deshalb schon, wenn einer in der Liste steht.
    private bool CanApplyAll => CanApply && (CanDelete || plan?.Changes.Any(c => !c.Protected && c.Kind == PlanChangeKinds.NoLongerDue) != true);
    private bool CanCarryOver => CanEdit && CanTick;
    private bool CanRemoveCarryOver => CanDelete && CanUntick;
    private bool AnyLocked => !(CanAdd && CanEdit && CanDelete && CanTick && CanUntick && CanApply);

    private bool CanToggle(PlanPositionResponse position) => Actions.CanToggle(Member.Owner, position.DoneAt is not null);

    /// <summary>
    /// Der Monat der Adresse; ohne Jahr und Monat (Aufruf ohne Adresse) der laufende. Ein Monat, den es nicht gibt
    /// (13, Jahr 0), ergibt null.
    /// </summary>
    private (int Year, int Month)? Requested()
    {
        if (Year is not { } requestedYear || Month is not { } requestedMonth)
        {
            var today = DateOnly.FromDateTime(Time.GetLocalNow().DateTime);
            return (today.Year, today.Month);
        }
        return requestedMonth is >= 1 and <= 12 && requestedYear is >= PlanRules.FirstYear and <= PlanRules.LastYear
            ? (requestedYear, requestedMonth)
            : null;
    }

    protected override async Task OnInitializedAsync()
    {
        // Die Seite zeigt den Monat der Adresse; der Knopf im Seitenkopf legt einen einmaligen Posten an.
        var today = DateOnly.FromDateTime(Time.GetLocalNow().DateTime);
        (year, month) = (today.Year, today.Month);
        var requested = Requested();
        if (requested is { } open)
        {
            (year, month) = open;
        }
        Chrome.Set(this, L["Nav_MyPlan"]);
        Chrome.SetHelpTopic(this, HelpTopicOf(tab));
        // Erst nach dem ersten Laden zuhören: Das Laden selbst meldet sich auch als Änderung.
        await Member.LoadAsync();
        Member.Changed += OnMemberChanged;
        if (requested is null)
        {
            // Einen Monat, den es nicht gibt, ersetzt die Übersicht; zurück führt dann nichts auf die kaputte Adresse.
            Navigation.NavigateTo("/plan", replace: true);
            return;
        }
        await LoadAllAsync();
        opened = true;
        bookingPending = Book == 1 && !Member.IsHousehold;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!bookingPending)
        {
            return;
        }
        bookingPending = false;
        Navigation.NavigateTo($"/plan/{year}/{month}", replace: true);
        await NewBookingAsync();
        StateHasChanged();
    }

    // Die Adresse zeigt einen anderen Monat (Link, Zurück-Knopf des Browsers): diesen Monat holen. Der erste Aufruf
    // gehört dem Öffnen oben, und ein Monat, auf den die Seite selbst gepaart hat, steht schon da.
    protected override async Task OnParametersSetAsync()
    {
        if (!opened)
        {
            return;
        }
        if (Requested() is not { } requested)
        {
            Navigation.NavigateTo("/plan", replace: true);
            return;
        }
        if (requested == (year, month))
        {
            return;
        }
        (year, month) = requested;
        message = null;
        if (!Member.IsHousehold && SeesPlan)
        {
            await LoadAsync();
        }
    }

    // Wer die Seite verlässt, während eine Anfrage läuft, soll danach nichts mehr auslösen: kein Neuladen, kein Zeichnen.
    private bool disposed;

    public void Dispose()
    {
        disposed = true;
        Member.Changed -= OnMemberChanged;
        Chrome.Release(this);
    }

    // Ein anderes Mitglied gewählt: alles für dessen Monat neu holen.
    private void OnMemberChanged() => _ = InvokeAsync(async () =>
    {
        message = null;
        await LoadAllAsync();
        if (!disposed)
        {
            StateHasChanged();
        }
    });

    /// <summary>Kategorien, Konten und der Monat der gewählten Person; was sie nicht teilt, bleibt leer.</summary>
    private async Task LoadAllAsync()
    {
        plan = null;
        if (!SeesPlan)
        {
            return;
        }

        // Kategorien und Konten brauchen die Dialoge und der Hinweis auf geänderte Verträge.
        var categoryResult = await CategoryApi.ListAsync(Member.Owner);
        categories = categoryResult.Succeeded ? categoryResult.Value!.ToList() : [];
        var accountResult = SeesAccounts
            ? await AccountChoices.ListAsync(Member.Owner)
            : ApiResult<IReadOnlyList<AccountChoice>>.Success([]);
        accounts = accountResult.Succeeded ? accountResult.Value! : [];
        var balanceResult = SeesAccounts
            ? await AccountApi.ListAsync(activeOnly: true, owner: Member.Owner)
            : ApiResult<IReadOnlyList<AccountResponse>>.Success([]);
        balances = balanceResult.Succeeded ? balanceResult.Value! : [];
        if (!categoryResult.Succeeded || !accountResult.Succeeded)
        {
            message = new NoticeMessage(ErrorTexts.For(L, categoryResult.ErrorCode ?? accountResult.ErrorCode), NoticeSeverity.Error);
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await PlanApi.GetAsync(year, month, Member.Owner);
        if (disposed)
        {
            return;
        }
        if (result.Succeeded)
        {
            plan = result.Value;
        }
        else
        {
            plan = null;
            message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        }
    }

    /// <summary>Zeigt das Ergebnis einer Änderung und holt den Monat neu.</summary>
    private async Task AfterAsync(ApiResult result, string successKey)
    {
        if (disposed)
        {
            return;
        }
        message = result.Succeeded
            ? new NoticeMessage(L[successKey], NoticeSeverity.Success)
            : new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
        await LoadAsync();
    }

    // Posten und Buchungen laufen über dieselbe Logik wie im Haushaltsplan (Spec 125); die Seite zeigt nur, was zurückkommt.
    private PersonChoices Known => new(categories, accounts, CanDelete);

    private async Task ApplyResultAsync(PositionActionResult result)
    {
        if (disposed)
        {
            return;
        }
        message = result.Message ?? message;
        if (result.Reload)
        {
            await LoadAsync();
        }
    }

    // Die schnelle Aktion "Neue Buchung" (Spec 24, R12); mit Posten die Buchung zu diesem Posten (Spec 51, R7).
    private Task NewBookingAsync() => BookAsync(null);

    private async Task BookAsync(Guid? positionId) =>
        await ApplyResultAsync(await Actions.NewBookingAsync(year, month, Member.Owner, Member.Name, null, Known, positionId));

    private async Task AddAsync() => await ApplyResultAsync(await Actions.AddAsync(year, month, Member.Owner, null, Known));

    private async Task EditAsync(PlanPositionResponse position) =>
        await ApplyResultAsync(await Actions.EditAsync(year, month, Member.Owner, Member.Name, position.Id, position, Known));

    private async Task ToggleAsync(PlanPositionResponse position) =>
        await ApplyResultAsync(await Actions.ToggleAsync(year, month, Member.Owner, Member.Name, position));

    // Gedruckt wird das Druckbild; das Stylesheet nimmt Leisten und Knöpfe weg. Scheitert das, sagt die Seite es.
    private async Task PrintAsync()
    {
        if (await Actions.PrintAsync() is { } failure)
        {
            message = failure;
        }
    }

    /// <summary>Einen Unterschied übernehmen, oder mit null alle, die nicht geschützt sind.</summary>
    private async Task ApplyAsync(PlanChangeResponse? change)
    {
        if (change is null ? !CanApplyAll : !CanApplyChange(change))
        {
            return;
        }
        var request = change is null
            ? new ApplyPlanChangesRequest()
            : new ApplyPlanChangesRequest([new PlanChangeItem(change.PositionId, change.PositionId is null ? change.CommitmentId : null)]);
        var result = await PlanApi.ApplyChangesAsync(year, month, request, Member.Owner);
        if (result.Succeeded)
        {
            plan = result.Value;
            message = new NoticeMessage(L["Plan_ChangesApplied"], NoticeSeverity.Success);
        }
        else
        {
            message = new NoticeMessage(ErrorTexts.For(L, result.ErrorCode), NoticeSeverity.Error);
            await LoadAsync();
        }
    }

    private async Task CarryOverAsync()
    {
        if (!CanCarryOver)
        {
            return;
        }
        string title = L["PlanCarryOverDialog_Title"];
        var parameters = new FormParameters<PlanCarryOverDialog>()
            .Add(x => x.Year, year)
            .Add(x => x.Month, month)
            .Add(x => x.CarryOver, plan!.CarryOver)
            .Add(x => x.Accounts, accounts);
        var outcome = await Forms.OpenAsync<PlanCarryOverDialog, bool>(title, parameters);
        if (outcome.Saved)
        {
            message = new NoticeMessage(L["Plan_CarryOverSaved"], NoticeSeverity.Success);
            await LoadAsync();
        }
    }

    private async Task RemoveCarryOverAsync()
    {
        if (CanRemoveCarryOver && await Forms.ConfirmAsync(L["Plan_CarryOverRemoveText"], L["Plan_CarryOverRemoveTitle"], L["Plan_CarryOverRemoveConfirm"], L["Plan_ConfirmCancel"]))
        {
            await AfterAsync(await PlanApi.DeleteCarryOverAsync(year, month, Member.Owner), "Plan_CarryOverRemoved");
        }
    }

    // Unter der Bezeichnung wie im alten Duofy: Kategorie, Tag, Zahlungsart und woher der Posten kommt.
    private string Caption(PlanPositionResponse position)
    {
        var parts = new List<string>();
        if (CategoryName(position.CategoryId) is { } category)
        {
            parts.Add(category);
        }
        parts.Add(L["Plan_DueDay", position.DueDay]);
        parts.Add(L[$"PaymentMethod_{position.PaymentMethod}"]);
        parts.Add(L[position.CommitmentId is null ? "Plan_OneOff" : "Plan_FromContract"]);
        if (position.PassThrough)
        {
            parts.Add(L["Plan_PassThrough"]);
        }
        if (position.ChangedByHand)
        {
            parts.Add(L["Plan_ChangedByHand"]);
        }
        return string.Join(" · ", parts);
    }

    // Ein Wert aus dem Hinweis auf geänderte Verträge, lesbar gemacht: Beträge mit Komma, Namen statt Kennungen.
    private string FieldText(string field, string? value)
    {
        if (value is null)
        {
            return field is PlanFields.Account ? L["Plan_DefaultAccount"] : L["Plan_Empty_Value"];
        }
        return field switch
        {
            PlanFields.Amount => Money(decimal.Parse(value, CultureInfo.InvariantCulture)),
            PlanFields.DueDay => L["Plan_DueDay", value],
            PlanFields.Pot => L[$"Pot_{value}"],
            PlanFields.Type => L[$"CommitmentType_{value}"],
            PlanFields.PaymentMethod => L[$"PaymentMethod_{value}"],
            PlanFields.PassThrough => L[value == "true" ? "Plan_Yes" : "Plan_No"],
            PlanFields.Category => categories.FirstOrDefault(c => c.Id.ToString() == value)?.Name ?? L["Plan_Unknown"],
            PlanFields.Account or PlanFields.CounterAccount => accounts.FirstOrDefault(a => a.Id.ToString() == value)?.Name ?? L["Plan_Unknown"],
            _ => value,
        };
    }

    private static string Money(decimal amount) => amount.ToString("N2", German) + " €";
}
