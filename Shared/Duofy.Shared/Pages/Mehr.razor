@page "/mehr"
@using BlazorBlueprint.Icons.Lucide.Components
@attribute [Authorize]
@implements IDisposable
@inject AppChrome Chrome
@inject IAuthApi AuthApi
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L
@inject ILegalApi LegalApi
@inject IUserApi UserApi
@using Duofy.ApiClient

@* Mehr am Handy: oben das Profil mit der Auswahl, wessen Zahlen die Seiten zeigen (Spec 82, R11), darunter, was man
   seltener braucht: Konten, Verträge, das Benutzerkonto, Admin (nur wer den Server verwaltet, Spec 70), Lizenzen, Rechtstexte
   und das Abmelden. Sparen und der Haushalt haben eigene Ziele in der unteren Leiste und stehen deshalb nicht hier; den
   Knopf für hell und dunkel trägt die obere Leiste. *@

<PageTitle>@L["Nav_More"]</PageTitle>
<PageHead Title="@L["Nav_More"]" />

<section class="card mb-4" aria-labelledby="more-profile-title" data-testid="more-profile">
    <div class="row">
        <span class="avatar" aria-hidden="true">@Initials</span>
        <div class="stack-sm fill">
            <h2 class="sub-title" id="more-profile-title">@displayName</h2>
            <span class="small muted">@email</span>
        </div>
    </div>
    <p class="field-label mt-3 mb-2">@L["MemberSwitch_Label"]</p>
    <MemberSwitch />
</section>

@* Jeder Eintrag ist ein Link im Aussehen eines Knopfs; nur das Abmelden ist ein echter Knopf. Das Symbol steht vor dem Text. *@
<div class="card" data-testid="more-list">
    <div class="stack-sm">
        <DuofyButton Href="/konten" Kind="ButtonKind.Ghost" TestId="more-accounts" Class="more-entry"><LucideIcon Name="wallet" Size="16" aria-hidden="true" /> @L["Nav_Accounts"]</DuofyButton>
        <DuofyButton Href="/vertraege" Kind="ButtonKind.Ghost" TestId="more-contracts" Class="more-entry"><LucideIcon Name="file-text" Size="16" aria-hidden="true" /> @L["More_Contracts"]</DuofyButton>
        <DuofyButton Href="/konto" Kind="ButtonKind.Ghost" TestId="more-user-account" Class="more-entry"><LucideIcon Name="user" Size="16" aria-hidden="true" /> @L["More_UserAccount"]</DuofyButton>
        @if (isAdmin)
        {
            <DuofyButton Href="/admin" Kind="ButtonKind.Ghost" TestId="more-admin" Class="more-entry"><LucideIcon Name="shield" Size="16" aria-hidden="true" /> @L["More_Admin"]</DuofyButton>
        }
        <DuofyButton Href="/lizenzen" Kind="ButtonKind.Ghost" TestId="more-licenses" Class="more-entry"><LucideIcon Name="scale" Size="16" aria-hidden="true" /> @L["More_Licenses"]</DuofyButton>
        @foreach (var name in legalDocuments)
        {
            <DuofyButton Href="@LegalPages.PathOf(name)" Kind="ButtonKind.Ghost" TestId="@($"more-legal-{name}")" Class="more-entry"><LucideIcon Name="file-text" Size="16" aria-hidden="true" /> @L[LegalPages.LabelKeyOf(name)]</DuofyButton>
        }
        <DuofyButton Kind="ButtonKind.Ghost" Icon="log-out" Text="@L["Account_SignOut"]" OnClick="SignOutAsync" TestId="more-sign-out" Class="more-entry" />
    </div>
</div>

@code {
    // Die Rechtstexte, die dieser Server anbietet (Spec 70, R8); ohne Antwort des Servers gibt es keine Links.
    private IReadOnlyList<string> legalDocuments = [];

    // Ob die Person den Server verwaltet; ohne Antwort des Servers nicht.
    private bool isAdmin;
    private string displayName = "";
    private string email = "";

    private string Initials => string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    protected override void OnInitialized() => Chrome.Set(this, L["Nav_More"]);

    protected override async Task OnInitializedAsync()
    {
        var result = await LegalApi.ListAsync();
        if (result.Succeeded)
        {
            legalDocuments = LegalPages.Known(result.Value!.Documents);
        }

        var me = await UserApi.GetMeAsync();
        isAdmin = me.Succeeded && me.Value!.IsInstanceAdmin;
        if (me.Succeeded)
        {
            displayName = $"{me.Value!.FirstName} {me.Value.LastName}".Trim();
            email = me.Value.Email;
        }
    }

    private async Task SignOutAsync()
    {
        await AuthApi.LogoutAsync();
        Navigation.NavigateTo("/anmelden");
    }

    public void Dispose() => Chrome.Release(this);
}
