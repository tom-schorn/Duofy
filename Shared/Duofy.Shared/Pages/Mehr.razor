@page "/mehr"
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]
@implements IDisposable
@inject IAppHost Host
@inject AppChrome Chrome
@inject IAuthApi AuthApi
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L
@inject ILegalApi LegalApi
@inject IUserApi UserApi
@using Duofy.ApiClient

@* Mehr: alles, was man seltener braucht. Sparen, Konten, Verträge, die Verwaltung des Haushalts und das Benutzerkonto, der Schalter für
   hell und dunkel (die obere Leiste der App hat keinen mehr) und das Abmelden. Wer den Server verwaltet, findet
   hier auch Admin (Spec 70); alle anderen sehen den Eintrag nicht.

   Den Schalter reicht das App-Layout als CascadingValue. Im Browser gibt es ihn nicht, dort
   bleibt der Schalter in der oberen Leiste. *@

<PageTitle>@L["Nav_More"]</PageTitle>

<AppPageHeading Text="@L["Nav_More"]" />
@if (!Host.IsApp)
{
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="rz-mb-2">@L["Nav_More"]</RadzenText>
}

@* Radzens Knopf kann nicht zu einer Adresse führen, deshalb ist jeder Eintrag ein LinkButton (ein Link im Aussehen
   eines Knopfs); nur das Abmelden ist ein echter Knopf. Das Symbol steht vor dem Text. *@
<RadzenCard Variant="Variant.Outlined" Class="rz-p-2" data-testid="more-list">
    <RadzenStack Gap="0">
        <LinkButton Href="/sparen" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Class="more-entry"
                    data-testid="more-savings"><RadzenIcon Icon="savings" /> @L["Nav_Savings"]</LinkButton>
        <LinkButton Href="/konten" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Class="more-entry"
                    data-testid="more-accounts"><RadzenIcon Icon="account_balance" /> @L["Nav_Accounts"]</LinkButton>
        <LinkButton Href="/vertraege" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Class="more-entry"
                    data-testid="more-contracts"><RadzenIcon Icon="description" /> @L["More_Contracts"]</LinkButton>
        <LinkButton Href="/haushalt" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Class="more-entry"
                    data-testid="more-household"><RadzenIcon Icon="groups" /> @L["More_Household"]</LinkButton>
        <LinkButton Href="/konto" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Class="more-entry"
                    data-testid="more-user-account"><RadzenIcon Icon="person" /> @L["More_UserAccount"]</LinkButton>
        @if (isAdmin)
        {
            <LinkButton Href="/admin" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Class="more-entry"
                        data-testid="more-admin"><RadzenIcon Icon="admin_panel_settings" /> @L["More_Admin"]</LinkButton>
        }
        @if (Mode is not null)
        {
            <div class="more-item" data-testid="more-mode">
                <ThemeChoiceSwitch Choice="Mode.Choice" ChoiceSelected="Mode.Select" />
            </div>
        }
        <LinkButton Href="/lizenzen" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Class="more-entry"
                    data-testid="more-licenses"><RadzenIcon Icon="gavel" /> @L["More_Licenses"]</LinkButton>
        @foreach (var name in legalDocuments)
        {
            <LinkButton Href="@LegalPages.PathOf(name)" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Class="more-entry"
                        data-testid="@($"more-legal-{name}")"><RadzenIcon Icon="article" /> @L[LegalPages.LabelKeyOf(name)]</LinkButton>
        }
        <RadzenButton Click="SignOutAsync" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Class="more-entry"
                      Icon="logout" Text="@L["Account_SignOut"]" data-testid="more-sign-out" />
    </RadzenStack>
</RadzenCard>

@code {
    [CascadingParameter]
    private ModeSwitch? Mode { get; set; }

    // Die Rechtstexte, die dieser Server anbietet (Spec 70, R8); ohne Antwort des Servers gibt es keine Links.
    private IReadOnlyList<string> legalDocuments = [];

    // Ob die Person den Server verwaltet; ohne Antwort des Servers nicht.
    private bool isAdmin;

    protected override void OnInitialized() => Chrome.Set(this, L["Nav_More"]);

    protected override async Task OnInitializedAsync()
    {
        var result = await LegalApi.ListAsync();
        if (result.Succeeded)
        {
            legalDocuments = LegalPages.Known(result.Value!.Documents);
        }

        var me = await UserApi.GetMeAsync();
        isAdmin = me.Succeeded && me.Value!.IsInstanceAdmin;
    }

    private async Task SignOutAsync()
    {
        await AuthApi.LogoutAsync();
        Navigation.NavigateTo("/anmelden");
    }

    public void Dispose() => Chrome.Release(this);
}
