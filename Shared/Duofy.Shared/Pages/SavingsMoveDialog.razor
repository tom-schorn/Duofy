@using Radzen
@using Radzen.Blazor
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@inject IBookingApi BookingApi
@inject ActiveMember Member
@inject DialogService Dialogs
@inject IStringLocalizer<SharedResources> L
@inject IAppHost Host

@* Der Dialog "Einzahlen" und "Entnehmen" bei einem Sparziel (Issue 30). Daraus entsteht eine Umbuchung zwischen dem
   Sparkonto und einem anderen Konto, deren Zeile dem Ziel zugeordnet ist; der Stand des Ziels kommt danach neu von der
   API. Die Eingaben stehen in `draft`, einem SavingsMoveDraft. *@

<div>
    @if (Host.IsApp)
        {
            <FullScreenFormHeader Title="@Title" SaveText="@L["SavingsMove_Save"]" SaveTestId="savings-move-save"
                                  Busy="busy" OnClose="Cancel" OnSave="SaveAsync" />
        }
        <RadzenStack Gap="1rem">
            @if (error is not null)
            {
                <ErrorAlert AlertStyle="AlertStyle.Danger" Text="@error" data-testid="savings-move-error" />
            }

            <div class="field">
                <FieldLabel id="savings-move-amount-label" Text="@L["Field_Amount"]" />
                <RadzenNumeric TValue="decimal?" @bind-Value="draft.Amount" Culture="German" Format="0.00" ShowUpDown="false"
                               InputAttributes="@(new Dictionary<string, object> { ["aria-labelledby"] = "savings-move-amount-label" })"
                               data-testid="savings-move-amount" />
            </div>

            <NativeSelect Value="@Key(draft.OtherAccountId)" ValueChanged="OnOtherChanged"
                          Label="@L[draft.Kind == SavingsMoveKind.Deposit ? "SavingsMove_From" : "SavingsMove_To"]"
                          data-testid="savings-move-other">
                <option value="">@L["SavingsMove_ChooseAccount"]</option>
                @foreach (var account in Accounts.Where(a => a.Active))
                {
                    <option value="@account.Id">@account.Name</option>
                }
            </NativeSelect>

            <NativeSelect Value="@Key(draft.SavingsAccountId)" ValueChanged="OnSavingsChanged"
                          Label="@L["SavingsMove_SavingsAccount"]" data-testid="savings-move-savings">
                <option value="">@L["SavingsMove_ChooseAccount"]</option>
                @foreach (var account in Accounts.Where(a => a.Active))
                {
                    <option value="@account.Id">@account.Name</option>
                }
            </NativeSelect>

            <NativeSelect Value="@draft.Pot" ValueChanged="OnPotChanged"
                          Label="@L[draft.Kind == SavingsMoveKind.Deposit ? "SavingsMove_PotFrom" : "SavingsMove_PotTo"]"
                          data-testid="savings-move-pot">
                <option value="@PotKeys.Needs">@L["Pot_needs"]</option>
                <option value="@PotKeys.Wants">@L["Pot_wants"]</option>
            </NativeSelect>

            @if (!Host.IsApp)
            {
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Text="@L["SavingsGoalDialog_Cancel"]" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="@(_ => Cancel())" />
                    <RadzenButton Text="@L["SavingsMove_Save"]" ButtonStyle="ButtonStyle.Primary" Disabled="busy" Click="@(_ => SaveAsync())"
                                  data-testid="savings-move-save" />
                </RadzenStack>
            }
        </RadzenStack>
</div>

@code {

    private static readonly CultureInfo German = new("de-DE");

    /// <summary>Der Titel für die Kopfzeile in der App; im Browser steht er in der Titelzeile des Fensters.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Die Eingaben, vorbelegt mit Ziel, Richtung, Sparkonto des Ziels und Datum von heute.</summary>
    [Parameter, EditorRequired]
    public SavingsMoveDraft Draft { get; set; } = default!;

    /// <summary>Die Konten der Person.</summary>
    [Parameter]
    public IReadOnlyList<AccountChoice> Accounts { get; set; } = [];

    private SavingsMoveDraft draft = default!;
    private string? error;
    private bool busy;

    // Die Person, für die der Dialog geöffnet wurde; sie bleibt, auch wenn der Umschalter inzwischen woanders steht.
    private Guid? owner;

    protected override void OnInitialized()
    {
        owner = Member.Owner;
        draft = Draft;
    }

    private static string Key(Guid? id) => id?.ToString() ?? "";

    private void OnOtherChanged(string value) => draft = draft with { OtherAccountId = Guid.TryParse(value, out var id) ? id : null };

    private void OnSavingsChanged(string value) => draft = draft with { SavingsAccountId = Guid.TryParse(value, out var id) ? id : null };

    private void OnPotChanged(string value) => draft.SetPot(value);

    private void Cancel() => Dialogs.Close();

    private async Task SaveAsync()
    {
        error = null;
        if (!draft.IsAmountValid)
        {
            error = ErrorTexts.For(L, ErrorCodes.AmountInvalid);
            return;
        }
        if (!draft.HasAccounts)
        {
            error = L["SavingsMove_NeedAccounts"];
            return;
        }

        busy = true;
        try
        {
            var result = await BookingApi.CreateAsync(draft.ToRequest(owner));
            if (result.Succeeded)
            {
                Dialogs.Close(true);
            }
            else
            {
                error = ErrorTexts.For(L, result.ErrorCode);
            }
        }
        finally
        {
            busy = false;
        }
    }
}
