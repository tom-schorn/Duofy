@page "/"
@using BlazorBlueprint.Components
@attribute [Authorize]
@using System.Globalization
@using Duofy.ApiClient
@using Duofy.Schemas
@using Duofy.Shared.Charts
@implements IDisposable
@inject IUserApi UserApi
@inject IPlanApi PlanApi
@inject IAccountApi AccountApi
@inject IHouseholdApi HouseholdApi
@inject AppChrome Chrome
@inject ActiveMember Member
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject AppBrand Brand
@inject IStringLocalizer<SharedResources> L

@* Die Startseite (Spec 33, Issue #94): Begrüßung und Verplanbar des laufenden Monats groß im Kopf, direkt darunter die Zeile mit den
   verfügbaren Konten und ihrer Summe, der Weg zu einer neuen Buchung, was in den nächsten Tagen fällig ist und je Topf eine Zeile
   "<gebucht> von <geplant>". Wer in einem Haushalt ist, sieht darunter einen kleineren Haushaltsblock, dann die Jahreslinie
   (ein Balken je Monat bis heute); solange es keinen Haushalt gibt, steht der Hinweis darauf da. Jeder Block führt zur passenden
   Seite. Am PC stehen die Blöcke in zwei Spalten, am Handy in einer.

   Die Seite rechnet nichts: Die Zahlen schickt die API, MonthView wählt aus (wie in der Monatsübersicht). Sie legt
   auch keinen Monat an, nur weil jemand die Startseite sieht: Erst fragt sie die Übersicht des Jahres, und nur wenn der
   laufende darin steht, holt sie ihn; sonst steht der Leerzustand mit dem Weg zum Anlegen da.

   Die Zahlen sind die der Person, die im Umschalter gewählt ist, oder die des Haushalts (Spec 68, Spec 69); bei der Wahl
   des Haushalts gibt es weder einen zweiten Haushaltsblock noch Konten und Jahreslinie.
   [Authorize] heißt: Nur wer angemeldet ist, sieht die Seite; alle anderen schickt der Router zur Anmeldung.
   Der Knopf Neue Buchung bucht für die Person, deren Zahlen gerade offen sind; ohne deren Freigabe ist er ausgegraut. *@

<PageTitle>@Brand.Name</PageTitle>

<Notice Message="message" />

<GrantReason Show="!CanBook" />

@if (error is not null)
{
    <BbAlert Variant="AlertVariant.Danger">@error</BbAlert>
}
else if (firstName is not null)
{
    @* page-wide: Ab 1280 px nutzt die Seite die Breite wie die anderen Hauptseiten (docs/layout.md). *@
    <div class="stack-lg">
    @if (!SeesPlan)
    {
        <h1 class="start-greeting">@L["Start_Greeting", firstName]</h1>
        <p class="month-hint" data-testid="start-not-shared">@L["Grant_NotShared"]</p>
    }
    else if (!loaded || failed)
    {
        <h1 class="start-greeting">@L["Start_Greeting", firstName]</h1>
    }
    else if (model is null)
    {
        <h1 class="start-greeting">@L["Start_Greeting", firstName]</h1>
        <StartSection Title="@L["Start_NoPlanTitle", MonthName].Value" TestId="start-empty"
                      Href="@(Member.Owner is null && !Member.IsHousehold ? MonthHref : null)" LinkText="@L["Start_NoPlanLink", MonthName].Value">
            <p>@(Member.Owner is null && !Member.IsHousehold ? L["Start_NoPlanText"].Value : L["Start_NoPlanOther", ViewName ?? ""].Value)</p>
        </StartSection>
    }
    else
    {
        <StartHero Greeting="@L["Start_Greeting", firstName].Value" Title="@L["Start_FreeIn", MonthName].Value"
                   Amount="model.Free" AmountText="@(model.Free == 0m ? L["Month_AllPlanned"].Value : null)"
                   Note="@StartFreeNote.For(model, bookingsMissing, L)" Accounts="accounts"
                   ViewOf="@(ViewName is null ? null : L["Start_ViewOf", ViewName].Value)"
                   Href="@MonthHref" LinkText="@L["Start_OpenMonth", MonthName].Value" />

        @if (!Member.IsHousehold && !Member.Allows(GrantAreas.Accounts, AccessLevelKeys.View))
        {
            @* Ohne die Freigabe der Konten fehlt die Kontenzeile; ein kurzer Hinweis sagt es, statt sie still wegzulassen (Spec 126). *@
            <p class="month-hint" data-testid="start-accounts-not-shared">@L["Grant_NotShared"]</p>
        }

        @if (!Member.IsHousehold)
        {
            <div class="page-actions" data-testid="start-actions">
                <DuofyButton OnClick="AddBookingAsync" Class="@GrantLock.Class(CanBook)" @attributes="GrantLock.Attributes(CanBook)" TestId="start-new-booking">@L["Month_ActionBooking"]</DuofyButton>
            </div>
        }

        <div class="start-grid">
            <StartSection Title="@L["Month_DueHeading"].Value" TestId="start-due" Href="@MonthHref" LinkText="@L["Start_OpenPlan"].Value">
                @if (!SeesBookings)
                {
                    <p class="month-hint">@L["Grant_NotShared"]</p>
                }
                else if (model.Due.Count == 0)
                {
                    <p class="month-hint">@L["Month_DueEmpty"]</p>
                }
                else
                {
                    <LineTable Caption="@L["Month_DueCaption"]" HideCaption="true" Rows="DueRows" />
                }
            </StartSection>

            <StartSection Title="@L["Start_PotsTitle"].Value" TestId="start-pots" Href="@MonthHref" LinkText="@L["Start_OpenPots"].Value">
                <StartPots Pots="model.Pots" TestId="start-pot" />
            </StartSection>
        </div>

        @if (deviating.Count > 0)
        {
            @* Ruhiger Hinweis (Issue #34): Der Richtwert ist ein Anhaltspunkt, kein Alarm; es gibt keine Warnfarbe. *@
            <StartSection Title="@L["Start_GuidelineTitle"].Value" TestId="start-guideline"
                          Href="@(Member.IsHousehold ? MonthHref : $"/haushaltsplan/{today.Year}/{today.Month}")" LinkText="@L["Start_GuidelineLink"].Value">
                <p>@L["Start_GuidelineText", string.Join(", ", deviating)]</p>
            </StartSection>
        }
    }

    @if (householdModel is not null && Member.Household is { } together)
    {
        @* Der kleinere Haushaltsblock unter dem eigenen (Issue #94, R4): Verplanbar des Haushalts und seine Töpfe. *@
        <StartSection Title="@L["Start_HouseholdTitle"].Value" TestId="start-household"
                      Href="@($"/haushaltsplan/{today.Year}/{today.Month}")" LinkText="@L["Start_HouseholdOpen"].Value">
            <p class="metric-title">@L["Start_HouseholdFree", MonthName]</p>
            <p class="start-amount start-amount--small" data-testid="start-household-free">@(householdModel.Free == 0m ? L["Month_AllPlanned"].Value : MoneyText.Format(householdModel.Free))</p>
            <StartPots Pots="householdModel.Pots" TestId="start-household-pot" />
        </StartSection>
    }

    @if (!Member.IsHousehold && yearMonths.Count > 0)
    {
        @* Die Jahreslinie (Issue #94, R5): was in jedem Monat dieses Jahres übrig war oder fehlte. *@
        <StartSection Title="@L["Start_YearTitle"].Value" TestId="start-year-section" Href="/plan" LinkText="@L["Start_YearOpen"].Value">
            <StartYearLine Months="yearMonths" Today="today" />
        </StartSection>
    }

    @if (loaded && Member.Household is null)
    {
        <StartSection Title="@L["Start_TogetherTitle"].Value" TestId="start-household-hint" Href="/haushalt" LinkText="@L["Start_TogetherLink"].Value">
            <p>@L["Start_TogetherText"]</p>
        </StartSection>
    }
    </div>
}

@code {
    // Wie viele Zahlungen die Startseite zeigt; alle weiteren stehen im Plan.
    private const int DueShown = 5;

    private static readonly CultureInfo German = new("de-DE");

    private string? ownFirstName;

    // Wen die Begrüßung nennt: die gewählte Person, sonst man selbst (Spec 126, R3).
    private string? firstName => Member.Name ?? ownFirstName;
    private string? error;
    private NoticeMessage? message;
    private bool loaded;
    private bool failed;
    private MonthOverviewModel? model;
    private IReadOnlyList<string> bookingsMissing = [];
    private IReadOnlyList<string> deviating = [];
    private IReadOnlyList<(string Name, decimal Balance)>? accounts;
    private MonthOverviewModel? householdModel;
    private IReadOnlyList<PlanOverviewMonthResponse> yearMonths = [];
    private DateOnly today;

    private bool SeesPlan => Member.IsHousehold || Member.Allows(GrantAreas.Plan, AccessLevelKeys.View);

    // Gebuchtes und Fälliges zeigt die API nur mit Sicht auf die Buchungen (Spec 68); der Haushalt sagt selbst, wessen fehlt.
    private bool SeesBookings => Member.IsHousehold || Member.Allows(GrantAreas.Book, AccessLevelKeys.View);

    // Buchen braucht die Freigabe Anlegen der Buchungen und die Konten (Spec 68); bei "Ich" geht es immer.
    private bool CanBook =>
        Member.Allows(GrantAreas.Book, AccessLevelKeys.Create) && Member.Allows(GrantAreas.Accounts, AccessLevelKeys.View);

    private string MonthName => new DateOnly(today.Year, today.Month, 1).ToString("MMMM", German);

    private string MonthHref => $"/plan/{today.Year}/{today.Month}";

    // Wessen Zahlen es sind, wenn nicht die eigenen: das gewählte Mitglied oder der Haushalt.
    private string? ViewName => Member.IsHousehold ? Member.Household?.Name : Member.Name;

    private IReadOnlyList<LineTableRow> DueRows => model!.Due
        .Take(DueShown)
        .Select(d => new LineTableRow(
            d.Label,
            d.Open,
            string.Join(" · ", new[] { L["Month_DueOn", d.Due.ToString("d", German)].Value, d.Owner }.OfType<string>()),
            Trailing: Badge(d.Overdue),
            TestId: $"start-due-item-{(d.Overdue ? "overdue" : "upcoming")}"))
        .ToList();

    // Beides ist gekennzeichnet, getrennt durch das Wort und nicht nur durch eine Farbe.
    private RenderFragment Badge(bool overdue) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "month-due-badge");
        builder.AddContent(2, L[overdue ? "Month_Overdue" : "Month_Upcoming"].Value);
        builder.CloseElement();
    };

    protected override void OnInitialized() => Chrome.Set(this, L["Nav_Start"]);

    // Neue Buchungen entstehen nur im Monat (Spec 51, R3, R4): Die Monatsseite öffnet den Dialog selbst.
    private Task AddBookingAsync()
    {
        if (CanBook)
        {
            var now = DateOnly.FromDateTime(Time.GetLocalNow().DateTime);
            Navigation.NavigateTo($"/plan/{now.Year}/{now.Month}?{Plan.BookQuery}=1");
        }
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Member.Changed -= OnMemberChanged;
        Chrome.Release(this);
    }

    // Ein anderes Mitglied oder der Haushalt gewählt: die Zahlen der neuen Sicht holen.
    private void OnMemberChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    protected override async Task OnInitializedAsync()
    {
        await Member.LoadAsync();
        Member.Changed += OnMemberChanged;

        var me = await UserApi.GetMeAsync();
        if (me.Succeeded)
        {
            ownFirstName = me.Value!.FirstName;
        }
        else if (me.ErrorCode != ClientErrorCodes.NotSignedIn)
        {
            // Ist die Anmeldung zu Ende, zeigt die Seite keinen Fehler: Der Router schickt zur Anmeldung (Spec 97, R4).
            error = ErrorTexts.For(L, me.ErrorCode);
        }

        await LoadAsync();
    }

    // Holt den laufenden Monat der gewählten Sicht, ohne einen Monat anzulegen: erst die Liste der Monate fragen.
    private async Task LoadAsync()
    {
        today = DateOnly.FromDateTime(Time.GetLocalNow().DateTime);
        model = null;
        bookingsMissing = [];
        deviating = [];
        accounts = null;
        householdModel = null;
        yearMonths = [];
        message = null;
        loaded = false;
        failed = false;
        if (!SeesPlan)
        {
            return;
        }

        if (Member.IsHousehold)
        {
            await LoadHouseholdAsync();
        }
        else
        {
            await LoadPersonAsync();
        }
        loaded = true;
    }

    // Ein Fehler beim Laden zeigt die Meldung und keinen Leerzustand: Der würde sagen, es gäbe keinen Plan.
    private void Fail(string? errorCode)
    {
        failed = true;
        if (errorCode == ClientErrorCodes.NotSignedIn)
        {
            // Keine Meldung bei beendeter Anmeldung: Es folgt die Weiterleitung zur Anmeldung (Spec 97, R4).
            return;
        }
        message = new NoticeMessage(ErrorTexts.For(L, errorCode), NoticeSeverity.Error);
    }

    private async Task LoadPersonAsync()
    {
        // Eine Anfrage für das ganze Jahr: Sie zeigt, ob der laufende Monat einen Plan hat, und füttert die Jahreslinie.
        var overview = await PlanApi.GetOverviewAsync(today.Year, Member.Owner);
        bool hasMonth;
        if (overview.Succeeded)
        {
            yearMonths = overview.Value!;
            hasMonth = yearMonths.Any(m => m.Year == today.Year && m.Month == today.Month);
        }
        else if (overview.ErrorCode == ClientErrorCodes.NotFound)
        {
            // Ein älterer Server kennt die Übersicht noch nicht (App und Server werden zu verschiedenen Zeiten aktualisiert):
            // Alles andere kommt aus den bisherigen Aufrufen, es fehlt nur die Jahreslinie, und es gibt keine Fehlermeldung.
            var months = await PlanApi.ListMonthsAsync(Member.Owner);
            if (!months.Succeeded)
            {
                Fail(months.ErrorCode);
                return;
            }
            hasMonth = months.Value!.Any(m => m.Year == today.Year && m.Month == today.Month);
        }
        else
        {
            Fail(overview.ErrorCode);
            return;
        }

        // Der Haushaltsblock hängt nicht am Plan des Monats, und er steht in jeder Sicht gleich da (Spec 126, R3).
        await LoadHouseholdBlockAsync();
        if (!hasMonth)
        {
            return;
        }

        var plan = await PlanApi.GetAsync(today.Year, today.Month, Member.Owner);
        if (!plan.Succeeded)
        {
            Fail(plan.ErrorCode);
            return;
        }
        model = MonthView.ForPerson(plan.Value!, today, _ => null);
        await LoadAccountsAsync();
    }

    // Die verfügbaren Konten unter Verplanbar (Issue #94, R1). Die Zeile ist ein Zusatz: Fehlt die Freigabe für die Konten oder
    // scheitert das Laden, fehlt nur sie; die Konten selbst zeigt die Kontenseite mit ihrem Fehler.
    private async Task LoadAccountsAsync()
    {
        if (!Member.Allows(GrantAreas.Accounts, AccessLevelKeys.View))
        {
            return;
        }

        var result = await AccountApi.ListAsync(activeOnly: true, owner: Member.Owner);
        if (result.Succeeded)
        {
            accounts = result.Value!.Where(a => a.CountsAsAvailable).Select(a => (a.Name, a.Balance)).ToList();
        }
    }

    // Wer im Haushalt ist, bekommt unter dem eigenen Block den Haushaltsblock und den Richtwert-Hinweis: dafür kommt der
    // Haushaltsplan des Monats dazu. Beides ist ein Zusatz. Scheitert das Laden, fehlt er nur; den Fehler zeigt der Haushaltsplan
    // selbst, sobald jemand ihn öffnet, und die Startseite bleibt ruhig.
    private async Task LoadHouseholdBlockAsync()
    {
        if (Member.Household is not { } household)
        {
            return;
        }

        var months = await HouseholdApi.ListPlansAsync(household.Id);
        if (!months.Succeeded || !months.Value!.Any(m => m.Year == today.Year && m.Month == today.Month))
        {
            return;
        }

        var plan = await HouseholdApi.GetPlanAsync(household.Id, today.Year, today.Month);
        if (plan.Succeeded)
        {
            householdModel = MonthView.ForHousehold(plan.Value!, today);
            deviating = DeviatingNames(plan.Value!);
        }
    }

    // Die Vornamen derer, die in einem Topf deutlich vom Richtwert abweichen (Toleranz und Abstand legt GuidelineView fest).
    private static IReadOnlyList<string> DeviatingNames(HouseholdPlanResponse plan) => GuidelineView.From(plan).People
        .Where(person => person.HasIncome && person.OutsideRows.Count > 0)
        .Select(person => person.Name)
        .ToList();

    private async Task LoadHouseholdAsync()
    {
        if (Member.Household is not { } household)
        {
            return;
        }

        var months = await HouseholdApi.ListPlansAsync(household.Id);
        if (!months.Succeeded)
        {
            Fail(months.ErrorCode);
            return;
        }
        if (!months.Value!.Any(m => m.Year == today.Year && m.Month == today.Month))
        {
            return;
        }

        var plan = await HouseholdApi.GetPlanAsync(household.Id, today.Year, today.Month);
        if (!plan.Succeeded)
        {
            Fail(plan.ErrorCode);
            return;
        }
        model = MonthView.ForHousehold(plan.Value!, today);
        bookingsMissing = plan.Value!.BookingsMissing ?? [];
        deviating = DeviatingNames(plan.Value!);
    }
}
