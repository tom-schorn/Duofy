<Project Sdk="Microsoft.NET.Sdk">

  <!-- Der plattformneutrale Kern der Erinnerungen in der App (Spec 84): was mit einem stillen Signal geschieht, was
       "Bezahlt" und "Später" tun und wie ein Gerät angemeldet wird. Die Teile, die nur Android oder Windows kennen
       (Token holen, Benachrichtigung zeigen, Signal empfangen), stehen hinter Schnittstellen in Mobile\Duofy; so lässt
       sich der Kern ohne Telefon und ohne die MAUI-Workload testen. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Duofy.ApiClient\Duofy.ApiClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Duofy.Push.Tests" />
  </ItemGroup>

</Project>
