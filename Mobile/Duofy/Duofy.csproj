<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Ausgeliefert wird die App vorerst nur für Android (iOS und Mac sind nicht geplant).
       Das Windows-Ziel gibt es nur zum Testen am PC, und nur auf Windows. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Duofy</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>

    <!-- Enable XAML source generation for faster build times and improved performance.
         This generates C# code from XAML at compile time instead of runtime inflation.
         To disable, remove this line.
         For individual files, you can override by setting Inflator metadata:
           <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
           <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- Name unter dem Symbol auf dem Telefon -->
    <ApplicationTitle>Duofy</ApplicationTitle>

    <!-- Paketname für Google Play. Er lässt sich nach der Veröffentlichung nicht mehr ändern. -->
    <ApplicationId>de.tomschorn.duofy</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Mindestens Android 7.0 (API 24). Die Zielversion 36 steht im AndroidManifest.xml. -->
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Windows-Testziel: nur auf Windows, nur zum Testen am PC. Eigene Gruppen mit Bedingung, damit die
       Android-Einstellungen oben unverändert bleiben. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFrameworks>$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Ohne Paketierung: startet direkt aus dem Build-Ordner, ohne Installation. -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <!-- Release: signiertes App-Bundle (AAB) für Google Play. Schlüsseldatei und Passwörter
       kommen aus Umgebungsvariablen und stehen nie im Repository. Bei "env:" liest MSBuild
       das Passwort selbst aus der Umgebungsvariable, es taucht nicht im Befehl auf. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(DUOFY_KEYSTORE_PATH)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(DUOFY_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:DUOFY_KEYSTORE_PASSWORD</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:DUOFY_KEY_PASSWORD</AndroidSigningKeyPass>
  </PropertyGroup>

  <!-- Debug: Die Netzwerk-Konfiguration erlaubt unverschlüsseltes HTTP zum Testen im WLAN.
       Sie ersetzt die strengere Datei aus Platforms\Android\Resources\xml. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidResource Remove="Platforms\Android\Resources\xml\network_security_config.xml" />
    <AndroidResource Include="Platforms\Android\DebugResources\xml\network_security_config.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
  </ItemGroup>

  <!-- Einstellungen der App: die Adresse der API. appsettings.Debug.json und eine eigene
       appsettings.local.json (nicht einchecken) gelten nur in Debug-Builds. -->
  <ItemGroup>
    <EmbeddedResource Include="appsettings.json" />
    <EmbeddedResource Include="appsettings.Debug.json" Condition="'$(Configuration)' == 'Debug'" />
    <EmbeddedResource Include="appsettings.local.json" Condition="'$(Configuration)' == 'Debug' And Exists('appsettings.local.json')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Duofy.ApiClient\Duofy.ApiClient.csproj" />
    <ProjectReference Include="..\..\Shared\Duofy.Shared\Duofy.Shared.csproj" />
  </ItemGroup>

</Project>
