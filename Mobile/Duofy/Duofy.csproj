<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Ausgeliefert wird die App für Android (Google Play) und Windows (Microsoft Store, Issue #40; iOS und Mac sind
       nicht geplant). Das Windows-Ziel gibt es nur auf Windows: unverpackt zum Testen am PC, als MSIX-Paket nur mit
       -p:DuofyStorePackage=true (siehe docs/store/README.md). -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Duofy</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>

    <!-- Enable XAML source generation for faster build times and improved performance.
         This generates C# code from XAML at compile time instead of runtime inflation.
         To disable, remove this line.
         For individual files, you can override by setting Inflator metadata:
           <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
           <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- Name unter dem Symbol auf dem Telefon (Plagevo, die gehostete Marke; der Paketname unten bleibt) -->
    <ApplicationTitle>Plagevo</ApplicationTitle>

    <!-- Paketname für Google Play. Er lässt sich nach der Veröffentlichung nicht mehr ändern. -->
    <ApplicationId>de.tomschorn.duofy</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Mindestens Android 7.0 (API 24). Die Zielversion 36 steht im AndroidManifest.xml. -->
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Windows-Testziel: nur auf Windows, nur zum Testen am PC. Eigene Gruppen mit Bedingung, damit die
       Android-Einstellungen oben unverändert bleiben. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFrameworks>$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Ohne Paketierung: startet direkt aus dem Build-Ordner, ohne Installation. -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <!-- Microsoft Store (Issue #40): nur mit -p:DuofyStorePackage=true wird ein MSIX-Paket gebaut. Das Manifest ist
       Platforms\Windows\Package.appxmanifest; die Werte aus dem Partner Center stehen dort als ERSETZEN-Platzhalter.
       Die Signatur übernimmt der Store, im Repository liegt kein Schlüssel. Ohne den Schalter bleibt alles wie oben.
       Der Befehl steht in docs/store/README.md. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows')) And '$(DuofyStorePackage)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <UapAppxPackageBuildMode>StoreUpload</UapAppxPackageBuildMode>
    <AppxBundle>Never</AppxBundle>
    <!-- Das Symbolpaket braucht Visual-Studio-Werkzeuge (mspdbcmf.exe); der Store verlangt es nicht. -->
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
  </PropertyGroup>

  <!-- Testpaket zum Querladen (Issue #40): Mit DUOFY_SIGN_THUMBPRINT (Fingerabdruck des Testzertifikats im
       Zertifikatspeicher des Benutzers, erzeugt von Mobile/Windows-Testpaket.ps1) wird das MSIX-Paket signiert und
       als Sideload-Paket gebaut. Ohne den Fingerabdruck bleibt es beim unsignierten Store-Paket oben. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows')) And '$(DuofyStorePackage)' == 'true' And '$(DUOFY_SIGN_THUMBPRINT)' != ''">
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint>$(DUOFY_SIGN_THUMBPRINT)</PackageCertificateThumbprint>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
  </PropertyGroup>

  <!-- Release: App-Bundle (AAB) für Google Play. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormat>aab</AndroidPackageFormat>
  </PropertyGroup>

  <!-- Signatur für Google Play: Schlüsseldatei und Passwörter kommen aus Umgebungsvariablen und stehen nie im
       Repository. Bei "env:" liest MSBuild das Passwort selbst aus der Umgebungsvariable, es taucht nicht im Befehl
       auf. Die Gruppe gilt nur, wenn DUOFY_KEYSTORE_PATH gesetzt ist: Ohne Pfad rief das SDK apksigner ohne
       Schlüsseldatei auf, und der Build endete mit MSB6006 ("java.exe wurde mit dem Code 2 beendet"). Ohne Pfad
       signiert das SDK mit dem Debug-Schlüssel; das genügt zum Testen auf dem eigenen Telefon, nicht für Google Play. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(DUOFY_KEYSTORE_PATH)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(DUOFY_KEYSTORE_PATH)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(DUOFY_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:DUOFY_KEYSTORE_PASSWORD</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:DUOFY_KEY_PASSWORD</AndroidSigningKeyPass>
  </PropertyGroup>

  <!-- Debug: Die Netzwerk-Konfiguration erlaubt unverschlüsseltes HTTP zum Testen im WLAN.
       Sie ersetzt die strengere Datei aus Platforms\Android\Resources\xml. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidResource Remove="Platforms\Android\Resources\xml\network_security_config.xml" />
    <AndroidResource Include="Platforms\Android\DebugResources\xml\network_security_config.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#14213D" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#14213D" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.14" />
  </ItemGroup>

  <!-- Einstellungen der App: die Adresse der API. appsettings.Debug.json und eine eigene
       appsettings.local.json (nicht einchecken) gelten nur in Debug-Builds. -->
  <ItemGroup>
    <EmbeddedResource Include="appsettings.json" />
    <EmbeddedResource Include="appsettings.Debug.json" Condition="'$(Configuration)' == 'Debug'" />
    <EmbeddedResource Include="appsettings.local.json" Condition="'$(Configuration)' == 'Debug' And Exists('appsettings.local.json')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Duofy.ApiClient\Duofy.ApiClient.csproj" />
    <ProjectReference Include="..\..\Shared\Duofy.Shared\Duofy.Shared.csproj" />
  </ItemGroup>

</Project>
