@using System.Text.Json
@inject IConfiguration Configuration

@* Cloudflare Web Analytics (Spec 79, R8): zählt Seitenaufrufe ohne Cookies, deshalb ohne Cookie-Hinweis. Nur mit
   einem Token aus Duofy:Analytics:Token (Umgebungsvariable Duofy__Analytics__Token); ohne Token kein Beacon, wie auf
   einem selbst betriebenen Server üblich. Das Token steht als JSON im Attribut; Razor schützt es dort vor Anführungszeichen. *@

@if (Token is { } token)
{
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon="@JsonSerializer.Serialize(new { token })"></script>
}

@code {
    public const string TokenKey = "Duofy:Analytics:Token";

    private string? Token => Configuration[TokenKey]?.Trim() is { Length: > 0 } token ? token : null;
}
