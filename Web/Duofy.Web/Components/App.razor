@using Duofy.Shared.Services
@using Duofy.Shared.Theme
@using Radzen.Blazor
<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Issue 5: Die gewählte Hell-Dunkel-Einstellung gilt schon beim ersten Zeichnen; eigenes Skript, kein Fremdskript. *@
    @((MarkupString)ThemeBoot.HeadMarkup)
    <ResourcePreloader />
    @* Die Theme-Datei von Radzen. Sie steht hier und nicht im Layout, damit sie beim Wechsel des Layouts nicht neu lädt. *@
    <RadzenTheme Theme="@RadzenVariables.LightTheme" @rendermode="PageRenderMode" />
    <link rel="stylesheet" href="_content/Duofy.Shared/app.css" />
    <link rel="stylesheet" href="Duofy.Web.styles.css" />
    <ImportMap />
    @* Das Symbol im Tab gehört zur Marke (Issue 8); mit eigenem Symbol für ein dunkles Fenster des Browsers. *@
    @if (Brand.FaviconDark is null)
    {
        <link rel="icon" type="@Brand.FaviconType" href="@Brand.FaviconLight" />
    }
    else
    {
        <link rel="icon" type="@Brand.FaviconType" href="@Brand.FaviconLight" media="(prefers-color-scheme: light)" />
        <link rel="icon" type="@Brand.FaviconType" href="@Brand.FaviconDark" media="(prefers-color-scheme: dark)" />
    }
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <WebRoutes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [Inject]
    private AppBrand Brand { get; set; } = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Die Seiten laufen über die dauerhafte Verbindung zum Server (InteractiveServer),
    // auch die Anmeldeseiten. Nur eine Seite mit [ExcludeFromInteractiveRouting] würde
    // als gewöhnliche Webseite ausgeliefert.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
