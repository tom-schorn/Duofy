<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Eine Weiterleitung beim Vorab-Rendern löst sonst intern eine Ausnahme aus
         (NavigationException), an der der Debugger jedes Mal anhält, obwohl nichts
         kaputt ist. Mit diesem Schalter leitet Blazor ohne Ausnahme weiter. -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Das SDK lädt das Paket mit _framework/blazor.web.js nur, wenn es beim Restore
         .razor-Dateien im Projekt sieht. Das Dockerfile stellt die Pakete aber nur mit den
         Projektdateien wieder her; ohne diesen Schalter fehlt das Skript dann im Image
         und keine Seite wird interaktiv. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <!-- Die Web-Variante kennt keine Datenbank. Alle Daten kommen über Duofy.ApiClient
       von der Duofy-API. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Duofy.ApiClient\Duofy.ApiClient.csproj" />
    <ProjectReference Include="..\..\Shared\Duofy.Shared\Duofy.Shared.csproj" />
  </ItemGroup>

  <!-- Die Vertragsseite las bisher direkt aus der Datenbank. Sie bleibt als Datei
       erhalten, wird aber nicht mitgebaut und ist damit nicht erreichbar, bis sie
       im Feature "Verträge" an die API angeschlossen wird. Zum Einschalten diese
       beiden Zeilen löschen. -->
  <ItemGroup>
    <Content Remove="Components\Pages\Commitments.razor" />
    <None Include="Components\Pages\Commitments.razor" />
  </ItemGroup>

</Project>
