<Project Sdk="Microsoft.NET.Sdk">

  <!-- Diese Tests lesen nur Projekt-, Manifest- und README-Dateien. Sie brauchen
       weder die MAUI-Workload noch das Android-SDK. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Die Wahl des Nachtmodus für Android (Spec 124, R5) kennt Android nicht und wird hier ohne die Workload getestet. -->
    <Compile Include="..\..\Mobile\Duofy\Platforms\Android\NightModeChoice.cs" Link="NightModeChoice.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
