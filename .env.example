# Duofy — Vorlage für die eigene .env
#
#     cp .env.example .env
#
# Pflicht sind zwei Werte: ein Datenbankpasswort und ein JWT-Geheimnis. Alles
# andere hat eine Vorgabe, die für die meisten passt.

# --- Datenbank ---------------------------------------------------------------
# Frei wählbar. Diese Werte gelten nur beim **ersten** Start: sie legen die
# Datenbank an. Ändert man sie später, passiert nichts — die Datenbank liegt
# dann schon im Volume und bleibt, wie sie ist.
POSTGRES_DB=duofy
POSTGRES_USER=duofy
POSTGRES_PASSWORD=

# --- Anmeldung ---------------------------------------------------------------
# Das Geheimnis, mit dem Anmelde-Token unterschrieben werden. Nicht ausdenken,
# erzeugen lassen:
#
#     openssl rand -hex 32
#
# Wer es ändert, wirft alle angemeldeten Nutzer heraus. Wer es weitergibt, gibt
# jedem die Möglichkeit, sich als beliebiger Nutzer auszugeben.
JWT_SECRET=

# Wie lange man angemeldet bleibt, in Sekunden — gezählt ab der **letzten**
# Benutzung. Jeder Aufruf schiebt das Ende nach hinten: wer Duofy regelmäßig
# benutzt, meldet sich nie wieder an, eine vergessene Sitzung läuft ab.
#
#   2592000  = 30 Tage, die Vorgabe
#    604800  =  7 Tage
#   7776000  = 90 Tage
#
# Die Sitzung liegt in einem Cookie, das JavaScript nicht auslesen kann, und
# „Abmelden" beendet sie sofort — nicht erst, wenn sie ohnehin abgelaufen wäre.
REFRESH_LIFETIME_SECONDS=2592000

# Nur über HTTPS ausliefern. Auf `false` setzen, wenn Duofy bei dir über
# einfaches http läuft, etwa nur im Heimnetz: Browser verwerfen sichere Cookies
# auf http-Adressen, und ohne Cookie bleibt niemand angemeldet.
COOKIE_SECURE=true

# --- Version -----------------------------------------------------------------
# Welche Ausgabe der Images gezogen wird.
#
#   leer lassen  → latest, also der neueste Release
#   1.2.0        → genau diese Version, ändert sich nie von allein
#   dev          → der aktuelle Stand aus dem develop-Branch, kann kaputt sein
#
# Wer selbst hostet, fährt mit einer festen Version am ruhigsten: dann ändert
# sich nichts unter dir, solange du nicht selbst ziehst.
DUOFY_TAG=

# --- Erreichbarkeit ----------------------------------------------------------
# Der Port auf deinem Rechner. Standard ist 8080, also http://localhost:8080
DUOFY_PORT=8080
