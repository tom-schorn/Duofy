# Environment variables for Duofy.
# Copy this file to .env and fill in the values. Never commit .env.
# .NET does not read .env by itself: set the variables in your shell or IDE,
# or use `dotnet user-secrets` for local development (see README).

# --- Duofy.Backend --------------------------------------------------------------
# PostgreSQL connection of the API. Only the API talks to the database.
ConnectionStrings__Duofy=Host=localhost;Port=5432;Database=duofy;Username=duofy;Password=change-me

# Sign-in requests per minute and client address on /api/v1/auth/* (default 10).
RateLimiting__AuthPermitLimit=10

# Connection addresses that the sign-in limit does not apply to, comma-separated.
# Meant for the web container behind a tunnel, which calls the API for all web
# users (deploy/docker-compose.yml sets it). Empty by default: everybody is limited.
RateLimiting__ExemptAddresses=

# Networks (CIDR, comma-separated) whose requests may name the client address in
# CF-Connecting-IP and the scheme in X-Forwarded-Proto, such as the network of a
# Cloudflare Tunnel. Also read by Duofy.Web. Empty by default: no proxy is trusted.
Duofy__TrustedProxies=

# Sites that may show the Duofy.Web pages in an iframe, such as your own Home
# Assistant: https://host[:port], several separated by spaces, no path, no slash
# at the end, no *. An invalid value stops the start. Empty by default: only the
# web version itself may embed its pages. See "Einbetten" in the README first.
Duofy__FrameAncestors=

# Directory of the keys that protect tokens and mailed links. Set it to a lasting
# place (in the container /keys on a volume) so a restart or an update keeps
# everybody signed in. Empty: ASP.NET's default place. Keep the directory secret.
# The web app reads the same setting; run outside Compose, give it its own directory.
Duofy__KeysDirectory=

# Public address under which people reach the Duofy web pages (scheme and host,
# optionally a path); the page /einladung/<token> lives there. Links that people
# pass on, such as household invitations (<PublicUrl>/einladung/<token>), always
# use this address, never the one a client happens to be connected through.
# Without it no invitation can be created (409 public_url_missing).
# Registration invitations of the administrator use it too
# (<PublicUrl>/registrieren?einladung=<token>).
Duofy__PublicUrl=https://duofy.example.de

# One-time setup code for the first administrator of this server. While no
# administrator exists, whoever registers with this code, or enters it on the
# page Benutzerkonto with an existing account (Admin werden), becomes the
# administrator, in every registration mode. Once an administrator exists the
# code has no effect. Empty by default: then nobody can become administrator,
# and the API logs "Kein Einrichtungscode gesetzt: Es kann kein Admin entstehen."
# at every start. The code needs at least 16 characters: a shorter one counts as
# not set, exactly like an empty one, and the API logs "Einrichtungscode kürzer
# als 16 Zeichen" at every start. Choose a long random value and keep it secret.
Duofy__SetupCode=

# Who may register: open (anybody), invite (only with an invitation link of the
# administrator) or closed (nobody). Default and fallback for unknown values:
# invite. For local development set it to open, or set a setup code.
Duofy__RegistrationMode=invite

# Legal texts: imprint, privacy policy and terms, each a plain text file on the server
# (shown as plain text with line breaks, no markup). Served without sign-in at
# /api/v1/legal and linked in the app as Impressum, Datenschutz and Nutzungsbedingungen.
# Empty by default; a text that is not set, unreadable, empty or larger than 200 KB is
# treated as missing, and the log names it (never its path). Example value: /etc/duofy/imprint.txt
Duofy__ImprintFile=
Duofy__PrivacyFile=
Duofy__TermsFile=

# Hosted version (spec 53): true switches mail on. Then a new account must
# confirm its address (link valid 24 hours) before it can sign in, "Passwort
# vergessen" mails a link (valid one hour), an email change is confirmed through
# the new address, and invitations can be mailed. Default false: a self-hosted
# server never sends mail; the administrator creates password reset links on
# the admin page instead. With true, Duofy__Mail__Host, Duofy__Mail__Port,
# Duofy__Mail__From and Duofy__PublicUrl are required: without them the API
# stops at start and the log names the missing setting. It also stops when
# Duofy__PublicUrl is not https or Duofy__Mail__UseTls is false (spec 79).
Duofy__Hosted=false

# Name and logo in the header, on the sign-in page and in the browser tab of Duofy.Web. Empty: Plagevo (with its
# logo) when Duofy__Hosted=true, otherwise Duofy. "Plagevo" or "Duofy" force that brand; any other name is shown
# without a logo. Duofy.Web reads Duofy__Hosted as well, so set it there too.
Duofy__AppName=

# SMTP server for the hosted version (ignored when Duofy__Hosted=false).
# UseTls=true (default) encrypts: port 465 from the start, every other port
# with STARTTLS, which the server must offer. Keep the password secret.
Duofy__Mail__Host=
Duofy__Mail__Port=587
Duofy__Mail__User=
Duofy__Mail__Password=
Duofy__Mail__From=duofy@example.de
# Name shown next to the sender address (default Plagevo).
Duofy__Mail__FromName=Plagevo
Duofy__Mail__UseTls=true

# --- Duofy.Web --------------------------------------------------------------
# Address of the API as seen from the web server (server to server, no CORS).
Duofy__ApiBaseAddress=http://localhost:5080/

# Token of Cloudflare Web Analytics (manual setup). When set, the page asks for consent
# and loads Cloudflare's script only after the person agrees. Empty by default: no
# question, no analytics, nothing is loaded.
Duofy__Analytics__Token=

# Website ID of the Crisp chat (Crisp dashboard, Settings, Website Settings, Setup instructions).
# When set, the page asks for consent for the chat and loads the script from Crisp only
# after the person agrees. Empty by default: no chat, no question, nothing is loaded.
Crisp__WebsiteId=

# --- Duofy (Android app) ----------------------------------------------------
# The app reads its API address from Mobile/Duofy/appsettings*.json (Api:BaseAddress).
# Signing of release bundles (AAB) for Google Play:
DUOFY_KEYSTORE_PATH=/path/to/duofy-release.keystore
DUOFY_KEYSTORE_PASSWORD=change-me
DUOFY_KEY_ALIAS=duofy
DUOFY_KEY_PASSWORD=change-me
