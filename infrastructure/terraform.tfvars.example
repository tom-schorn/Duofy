# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

cloudflare_api_token  = "..."
cloudflare_account_id = "..."
cloudflare_zone_id    = "..."
cloudflare_tunnel_id  = "..."

domain             = "example.com"
frontend_subdomain = "app"
backend_subdomain  = "api"

# ─── Backend host ────────────────────────────────────
# Lines marked "default" can be omitted — they are listed so every value the
# backend needs is visible in one place.
docker_host           = "ssh://root@203.0.113.10"              # default
cloudflared_network   = "infrastructure_cloudflared_network"   # default
reverse_proxy_network = "reverse_proxy_stack_public"           # default
backend_environment   = "development"                          # default
backend_memory_mb     = 256                                    # default

# ─── Database ────────────────────────────────────────
# The host is a container name resolved on the Docker network, not an IP.
postgres_host     = "postgres" # default
postgres_port     = 5432       # default
postgres_db       = "duofy"    # default
postgres_user     = "duofy"    # default
postgres_password = "..."      # required

# ─── App secrets ─────────────────────────────────────
jwt_secret = "..." # required
 