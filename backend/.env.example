ENVIRONMENT=development
DEBUG=true

# CORS — Frontend läuft auf einer anderen Domain, Origins explizit auflisten
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL — Duofy braucht eine EIGENE Datenbank. Teilt man eine mit einem
# anderen Projekt, kollidieren die Migrationsstände:
#   CREATE DATABASE duofy;
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=duofy
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# JWT — erzeugen mit: openssl rand -hex 32
JWT_SECRET=changeme
JWT_LIFETIME_SECONDS=3600
