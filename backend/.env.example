ENVIRONMENT=development
DEBUG=true

# CORS — Frontend läuft auf einer anderen Domain, Origins explizit auflisten
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL
# Vorerst der Florabase-Server — aber eine EIGENE Datenbank anlegen,
# sonst kollidiert Duofys alembic_version mit der von Florabase:
#   CREATE DATABASE duofy;
POSTGRES_HOST=changeme
POSTGRES_PORT=5432
POSTGRES_DB=duofy
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# JWT — erzeugen mit: openssl rand -hex 32
JWT_SECRET=changeme
JWT_LIFETIME_SECONDS=3600
