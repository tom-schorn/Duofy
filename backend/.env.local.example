ENVIRONMENT=development
DEBUG=true

# Frontend and backend run on different origins in development, so the allowed
# origins are listed explicitly rather than guessed.
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL — Duofy needs a database of its OWN. Sharing one with another project
# makes the migration states collide:
#   CREATE DATABASE duofy;
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=duofy
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=changeme

# How long a session survives without being used, in seconds. Counted from the
# last request, so every visit pushes the end back. 2592000 is thirty days.
REFRESH_LIFETIME_SECONDS=2592000

# MUST stay false locally. The dev server runs over `http://localhost`, and
# browsers discard cookies marked secure on http addresses. Set it to true and the
# session cookie never arrives — every reload signs you out, with no error message,
# because it was the browser that refused it.
COOKIE_SECURE=false

# Leave this commented out. `localhost:5173` and `localhost:8000` are the same host
# on different ports, so the cookie applies to both and `SameSite=lax` lets it
# through.
#
# It is only set when frontend and backend sit on different subdomains of one
# domain, as they do in the environment on the server — where Terraform sets it.
#COOKIE_DOMAIN=
