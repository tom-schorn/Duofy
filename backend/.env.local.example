ENVIRONMENT=development
DEBUG=true

# CORS — Frontend läuft auf einer anderen Domain, Origins explizit auflisten
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL — Duofy braucht eine EIGENE Datenbank. Teilt man eine mit einem
# anderen Projekt, kollidieren die Migrationsstände:
#   CREATE DATABASE duofy;
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=duofy
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# JWT — erzeugen mit: openssl rand -hex 32
JWT_SECRET=changeme

# Wie lange der Access-Token gilt. Ohne diese Zeile gelten 900 Sekunden, also
# 15 Minuten — das ist die Vorgabe und der richtige Wert. Sie steht hier nur,
# damit man sie zum Ausprobieren kurz herunterdrehen kann; ein kleiner Wert
# zeigt, ob das Erneuern im Frontend tatsächlich greift.
# JWT_LIFETIME_SECONDS=900

# Wie lange eine Sitzung ohne Benutzung hält. Vorgabe 2592000, also 30 Tage.
# REFRESH_LIFETIME_SECONDS=2592000

# --- Cookie mit der Sitzung --------------------------------------------------

# MUSS lokal aus sein. Der Entwicklungsserver läuft über `http://localhost`, und
# Browser verwerfen als sicher markierte Cookies auf http-Adressen. Bleibt der
# Wert auf `true`, kommt das Cookie nie an und man ist nach jedem Neuladen wieder
# abgemeldet — ohne Fehlermeldung, denn abgelehnt hat es der Browser.
COOKIE_SECURE=false

# Leer lassen. `localhost:5173` und `localhost:8000` sind derselbe Host, nur
# andere Ports — das Cookie gilt für beide, und `SameSite=lax` lässt es durch.
#
# Gesetzt wird die Variable nur, wenn Frontend und Backend auf verschiedenen
# Unterdomänen einer Domain liegen, wie in der Dev-Umgebung auf dem Server. Dort
# setzt sie Terraform.
# COOKIE_DOMAIN=
